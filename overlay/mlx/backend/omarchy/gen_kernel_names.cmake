# Generates kernel_names.h: the ComputeKernel enum order as a string table
# baked into libmlx, so the GPU profiler names dispatches at record time.
# Inputs: COMPUTE_H (path to compute.h), OUTPUT (header path).

file(READ "${COMPUTE_H}" src)
# Strip comments first: brace/bracket characters inside comments must not
# truncate the enum body.
string(REGEX REPLACE "//[^\n]*" "" src "${src}")
string(REGEX REPLACE "/\\*([^*]|\\*[^/])*\\*/" "" src "${src}")
string(REGEX MATCH "enum class ComputeKernel[^{]*\\{([^}]*)\\}" _ "${src}")
set(body "${CMAKE_MATCH_1}")
if(NOT body)
  message(FATAL_ERROR "ComputeKernel enum not found in ${COMPUTE_H}")
endif()
string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_]*" names "${body}")

set(content "// Generated by gen_kernel_names.cmake; do not edit.\n#pragma once\n")
string(APPEND content
  "static const char* const kComputeKernelNames[] = {\n")
foreach(name IN LISTS names)
  string(APPEND content "    \"${name}\",\n")
endforeach()
string(APPEND content "};\n")
string(APPEND content
  "inline const char* compute_kernel_name(\n"
  "    mlx::core::omarchy::ComputeKernel kernel) {\n"
  "  const auto index = static_cast<size_t>(kernel);\n"
  "  return index < sizeof(kComputeKernelNames) / sizeof(kComputeKernelNames[0])\n"
  "             ? kComputeKernelNames[index]\n"
  "             : \"<unknown>\";\n"
  "}\n")
file(WRITE "${OUTPUT}" "${content}")
