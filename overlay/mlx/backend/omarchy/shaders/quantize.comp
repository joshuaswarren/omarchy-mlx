#version 460

// Affine quantization. One invocation owns one contiguous group, derives
// float32 scale and bias with the pinned MLX endpoint rule, and writes the
// group's low-bit codes LSB-first. Scales and biases use the input storage
// dtype, but packing uses the unrounded float32 parameters.
//
// Two packing families, following upstream's CPU quantized.cpp and Metal
// affine_quantize exactly:
//   * bits 2/4/8 pack power-of-two codes into uint32 words, 32/bits values
//     per word, low bits first (the original path).
//   * bits 3/5/6 pack byte-oriented: 8 values span 3 bytes (bits 3), 8
//     values span 5 bytes (bits 5), 4 values span 3 bytes (bits 6); each
//     value takes bits positions of one little-endian bitstream, lowest
//     value first. The output array is still typed uint32; the bytes
//     simply tile into it little-endian. Byte stores land as the
//     commuting atomicAnd/atomicOr lane pair proven in cast_int.comp,
//     because one group's byte run can straddle a word another group
//     owns. No dynamic shift-then-mask byte extraction anywhere: every
//     extraction is a register shift of a value this thread built.
//
// With -DFP_MODE the shader quantizes the non-affine modes instead
// (mxfp4: e8m0 scale + fp4 e2m1 elements, group 32; nvfp4: e4m3 scale +
// fp4 e2m1 elements, group 16, optional global scale; mxfp8: e8m0 scale +
// fp8 e4m3 elements, group 32). The conversions mirror the pinned Metal
// fp4.h / fp8.h bit for bit: e8m0 scales round up so the block maximum
// stays representable, e4m3 scales use the PyTorch round-to-nearest-even
// encode with saturation to 448, fp4 elements use the threshold table,
// and the element domain is w * (global_enc / decoded_scale) exactly as
// Metal writes it. Scale bytes and fp4 nibbles store one byte per two
// elements, low element in the low nibble.

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
#ifdef FP_MODE
// Packed codes as little-endian bytes inside uint32 words. Readable
// because scale bytes insert lanes with atomics.
layout(set = 0, binding = 1, std430) buffer Packed {
  uint values[];
} packed_data;
// One scale byte per group, addressed through the word view.
layout(set = 0, binding = 2, std430) buffer Scales {
  uint values[];
} scales_data;
// Optional nvfp4 global scale as one float32 word; dummy binding when
// absent (never read without the has-global-scale flag).
layout(set = 0, binding = 3, std430) readonly buffer GlobalScale {
  uint values[];
} global_scale_data;
#else
layout(set = 0, binding = 1, std430) buffer Packed {
  uint values[];
} packed_data;
layout(set = 0, binding = 2, std430) writeonly buffer Scales {
  STORAGE_TYPE values[];
} scales_data;
layout(set = 0, binding = 3, std430) writeonly buffer Biases {
  STORAGE_TYPE values[];
} biases_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

// Push-constant routing (FP_MODE): operation carries bits (4 or 8),
// reduce_size the group size (16 or 32); flags bit 1 (value 2) marks a
// bound global scale, whose word offset rides in aux_size.

float round_away_from_zero(float value) {
  return sign(value) * floor(abs(value) + 0.5);
}

// AGX (Honeykrisp) rounding contract, measured on a 13-inch M1 (Mesa
// 26.1.7): (1) GLSL "/" lands up to 1 ulp from the correctly rounded
// quotient - 80/25 and 10/25 one ulp low, 6.55859375/0.030016447 one
// ulp high, which flipped one affine code at the exact 218.5
// round-away boundary - while llvmpipe and the pinned CPU/Metal
// reference are correctly rounded. (2) GLSL fma() lowers to plain
// OpFMul/OpFAdd and the AGX compiler contracts those pairs into a
// native fused op that does not deliver the IEEE fused result, so
// fma-based Markstein refinement cannot restore correct rounding
// here. Reproduce the reference bits with a Dekker exact-residual
// refinement using only precise (NoContraction) IEEE multiplies and
// adds: the Veltkamp split (8193 = 2^13 + 1 for binary32) makes
// r = a - q*b exact, and one correction step q + r*(1/b) rounds to the
// correctly rounded quotient. When q is already correctly rounded the
// residual is exactly zero and the value is unchanged, so llvmpipe
// stays bit-identical. Degenerate and split-range-edge inputs keep the
// native result. Every division feeding the pinned bit-exact affine
// contract goes through this helper.
float precise_div(float a, float b) {
  float q = a / b;
  if (b == 0.0 || isnan(q) || isinf(q) || q == 0.0 ||
      abs(b) < 1.1754944e-38 || abs(b) > 2.8e30 ||
      abs(q) > 2.8e30) {
    return q;
  }
  precise float p = q * b;
  if (isnan(p) || isinf(p)) {
    return q;
  }
  precise float bsplit = b * 8193.0;
  precise float b_hi = bsplit - (bsplit - b);
  precise float b_lo = b - b_hi;
  precise float qsplit = q * 8193.0;
  precise float q_hi = qsplit - (qsplit - q);
  precise float q_lo = q - q_hi;
  precise float err =
      ((q_hi * b_hi - p) + q_hi * b_lo + q_lo * b_hi) + q_lo * b_lo;
  precise float r = (a - p) - err;
  precise float correction = r * (1.0 / b);
  return q + correction;
}

#ifdef FP_MODE
uint fp8_encode(float value) {
  uint fp8_max = 543u << 21u;
  uint denorm_mask = 141u << 23u;
  uint f_bits = floatBitsToUint(value);
  uint sign = f_bits & 0x80000000u;
  f_bits ^= sign;

  uint f_bits_low =
      floatBitsToUint(uintBitsToFloat(f_bits) + uintBitsToFloat(denorm_mask));
  uint result_low = (f_bits_low - denorm_mask) & 0xFFu;

  uint mant_odd = (f_bits >> 20u) & 1u;
  uint f_bits_high = f_bits + (((7u - 127u) << 23u) + 0x7FFFFu);
  f_bits_high += mant_odd;
  uint result_high = (f_bits_high >> 20u) & 0xFFu;

  uint result = (f_bits < (121u << 23u)) ? result_low : result_high;
  result = (f_bits >= fp8_max) ? 0x7Eu : result;
  return result | (sign >> 24u);
}

float fp8_decode(uint bits) {
  float magnitude = unpackHalf2x16((bits & 127u) << 7u).x * 256.0;
  return ((bits & 128u) != 0u) ? -magnitude : magnitude;
}

// Smallest E8M0 >= x so a block's largest elements do not saturate;
// matches the Metal fp8_e8m0 constructor plus mx_scale_round_up.
uint e8m0_encode(float x) {
  if (isnan(x) || isinf(x)) {
    return 0xFFu;
  }
  if (x <= 0.0) {
    // Metal's log2 path saturates negative and zero scales to code 0
    // (2^-127); GLSL log2 is undefined at zero, so pin it here.
    return 0x00u;
  }
  int n = int(round(log2(x)));
  n = clamp(n, -127, 127);
  uint bits = uint(n + 127);
  float decoded = uintBitsToFloat(bits == 0u ? 0x400000u : bits << 23u);
  if (bits < 0xFEu && decoded < x) {
    bits += 1u;
  }
  return bits;
}

float e8m0_decode(uint bits) {
  return uintBitsToFloat(bits == 0u ? 0x400000u : bits << 23u);
}

// FP4 E2M1 threshold encode, the Metal fp4_e2m1 table exactly.
uint fp4_encode(float x) {
  if (isnan(x)) {
    return 0x7u;
  }
  uint sign = (floatBitsToUint(x) >> 31u) & 1u;
  float a = abs(x);
  uint m;
  if (a > 5.0) {
    m = 0x7u;
  } else if (a >= 3.5) {
    m = 0x6u;
  } else if (a > 2.5) {
    m = 0x5u;
  } else if (a >= 1.75) {
    m = 0x4u;
  } else if (a > 1.25) {
    m = 0x3u;
  } else if (a >= 0.75) {
    m = 0x2u;
  } else if (a > 0.25) {
    m = 0x1u;
  } else {
    m = 0x0u;
  }
  return m | (sign << 3u);
}

// Byte insert with the commuting atomicAnd/atomicOr lane pair from
// cast_int.comp: byte runs of neighbouring groups share words.
void store_byte(uint word_base, uint byte_in_run, uint value) {
  uint addr = word_base + (byte_in_run >> 2u);
  uint shift = (byte_in_run & 3u) * 8u;
  atomicAnd(packed_data.values[addr], ~(0xFFu << shift));
  atomicOr(packed_data.values[addr], (value & 0xFFu) << shift);
}
#endif

void main() {
  uint bits = params.operation;
  uint group_size = params.reduce_size;
  uint stride = gl_NumWorkGroups.x * 256u;
#ifdef FP_MODE
  float maxval = (bits == 8u) ? 448.0 : 6.0;
  bool has_global_scale = (params.flags & 2u) != 0u;
  float global_enc = 1.0;
  if (has_global_scale) {
    global_enc =
        uintBitsToFloat(global_scale_data.values[params.aux_size]);
    global_enc = 2688.0 / global_enc;
  }
  for (uint group = gl_GlobalInvocationID.x; group < params.count;
       group += stride) {
    uint input_base = params.lhs_offset + group * group_size;
    float amax = 0.0;
    for (uint lane = 0u; lane < group_size; ++lane) {
      amax = max(amax, abs(LOAD_VALUE(input_data.values[input_base + lane])));
    }
    float scale_dec = amax / maxval;
    uint q_scale;
    float decoded;
    if (group_size == 16u) {
      // nvfp4: e4m3 scale carrying the global encode factor.
      scale_dec *= global_enc;
      q_scale = fp8_encode(scale_dec);
      decoded = fp8_decode(q_scale);
    } else {
      // mxfp4 / mxfp8: round-up e8m0 scale.
      q_scale = e8m0_encode(scale_dec);
      decoded = e8m0_decode(q_scale);
    }
    float inv = (decoded == 0.0) ? 0.0 : global_enc / decoded;

    // Scale byte: one per group, inserted by lane atomics.
    uint scale_addr = params.rhs_offset + group;
    uint scale_shift = (scale_addr & 3u) * 8u;
    atomicAnd(scales_data.values[scale_addr >> 2u], ~(0xFFu << scale_shift));
    atomicOr(scales_data.values[scale_addr >> 2u], q_scale << scale_shift);

    // Elements: byte b holds elements 2b (low nibble) and 2b+1 for fp4,
    // one byte per element for fp8. Each group's byte run is word
    // aligned in length, so whole-word accumulators never straddle
    // groups and plain stores suffice for the codes.
    uint bytes_per_group = group_size / (bits == 8u ? 1u : 2u);
    uint word_base = params.output_offset + group * (bytes_per_group / 4u);
    uint packed = 0u;
    for (uint lane = 0u; lane < group_size; ++lane) {
      float value =
          LOAD_VALUE(input_data.values[input_base + lane]) * inv;
      uint code = (bits == 8u) ? fp8_encode(value) : fp4_encode(value);
      if (bits == 8u) {
        // Byte index = lane; whole word every four elements.
        packed |= code << ((lane & 3u) * 8u);
        if ((lane & 3u) == 3u) {
          packed_data.values[word_base + lane / 4u] = packed;
          packed = 0u;
        }
      } else {
        // Byte index = lane / 2 within the word, low element in the
        // low nibble. Whole word every eight elements.
        packed |= code <<
            ((((lane >> 1u) & 3u) * 8u) + ((lane & 1u) * 4u));
        if ((lane & 7u) == 7u) {
          packed_data.values[word_base + lane / 8u] = packed;
          packed = 0u;
        }
      }
    }
  }
#else
  uint is_byte_bits =
      (bits == 3u || bits == 5u || bits == 6u) ? 1u : 0u;
  uint pack_factor = is_byte_bits == 1u
      ? (bits == 6u ? 4u : 8u)
      : (32u / bits);
  uint bytes_per_pack = is_byte_bits == 1u ? (bits == 5u ? 5u : 3u) : 0u;
  uint words_per_group = is_byte_bits == 1u
      ? group_size / pack_factor * bytes_per_pack / 4u
      : group_size / pack_factor;
  uint group_bytes = group_size * bits / 8u;
  float n_bins = float((1u << bits) - 1u);

  for (uint group = gl_GlobalInvocationID.x; group < params.count;
       group += stride) {
    uint input_base = params.lhs_offset + group * group_size;
    float w_min = uintBitsToFloat(0x7f800000u);
    float w_max = 0.0;
    for (uint lane = 0u; lane < group_size; ++lane) {
      float value = LOAD_VALUE(input_data.values[input_base + lane]);
      w_min = min(w_min, value);
      w_max = max(w_max, value);
    }

    bool min_dominant = abs(w_min) > abs(w_max);
    float scale = max(precise_div(w_max - w_min, n_bins), 1e-7);
    scale = min_dominant ? scale : -scale;
    float edge = min_dominant ? w_min : w_max;
    float q0 = round_away_from_zero(precise_div(edge, scale));
    float bias = 0.0;
    if (q0 != 0.0) {
      scale = precise_div(edge, q0);
      bias = edge;
    }

    scales_data.values[params.rhs_offset + group] = STORE_VALUE(scale);
    biases_data.values[params.aux_offset + group] = STORE_VALUE(bias);
    if (is_byte_bits == 1u) {
      // Byte-oriented packing: a pack of codes spans up to 40 bits
      // (bits 5), so each pack accumulates into a low/high register
      // pair; the pack's bytes then insert with the lane-atomic pair
      // (one group's byte run can straddle a word another group owns).
      uint byte_base = params.output_offset * 4u + group * group_bytes;
      uint packs = group_size / pack_factor;
      for (uint pack = 0u; pack < packs; ++pack) {
        uint lo = 0u;
        uint hi = 0u;
        for (uint lane = 0u; lane < pack_factor; ++lane) {
          float value = LOAD_VALUE(
              input_data.values[input_base + pack * pack_factor + lane]);
          float quantized = clamp(
              round_away_from_zero(precise_div(value - bias, scale)), 0.0, n_bins);
          uint q = uint(quantized);
          uint bitpos = lane * bits;
          if (bitpos < 32u) {
            lo |= q << bitpos;
            if (bitpos + bits > 32u) {
              hi |= q >> (32u - bitpos);
            }
          } else {
            hi |= q << (bitpos - 32u);
          }
        }
        for (uint b = 0u; b < bytes_per_pack; ++b) {
          uint byte_value =
              (b < 4u) ? ((lo >> (b * 8u)) & 0xFFu) : (hi & 0xFFu);
          uint addr = byte_base + pack * bytes_per_pack + b;
          uint shift = (addr & 3u) * 8u;
          atomicAnd(packed_data.values[addr >> 2u], ~(0xFFu << shift));
          atomicOr(packed_data.values[addr >> 2u], byte_value << shift);
        }
      }
    } else {
      uint packed_base = params.output_offset + group * words_per_group;
      for (uint word_index = 0u; word_index < words_per_group;
           ++word_index) {
        uint packed = 0u;
        for (uint lane = 0u; lane < pack_factor; ++lane) {
          uint input_index = word_index * pack_factor + lane;
          float value = LOAD_VALUE(input_data.values[input_base + input_index]);
          float quantized = clamp(
              round_away_from_zero(precise_div(value - bias, scale)), 0.0, n_bins);
          packed |= uint(quantized) << (lane * bits);
        }
        packed_data.values[packed_base + word_index] = packed;
      }
    }
  }
#endif
}
