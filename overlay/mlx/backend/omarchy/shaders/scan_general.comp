// General-axis scan (cumulative sum, product, min, max, and log-sum-exp):
// any axis in any position, forward or reverse, inclusive or exclusive, over
// float, integer, bool, and complex64 storage. One invocation owns one line
// along the scan axis and walks it serially, the shape the suffix scan
// kernel uses; the accumulator stays float32 for every float dtype, the
// input width for every integer dtype (narrow wraps match the upstream
// narrow kernels because modular reduction commutes with the truncated
// store), and a vec2 pair for complex64.
//
// Push-constant routing: dims is the input rank, shape[] the extents,
// in_strides[] the input strides, out_strides[] the output strides, matrix_m
// the scan axis, reduce_size the operation selector (0 Sum, 1 Prod, 2 Min,
// 3 Max, 4 LogAddExp), flags bit 0 the reverse flag, and operation the
// inclusive flag (0 inclusive, 1 exclusive) exactly as scan_suffix.comp
// defines it.
#version 460

#extension GL_GOOGLE_include_directive : require
#include "omarchy_trig.h"

#if defined(USE_FP16) || defined(USE_BF16) || defined(USE_I16) ||              \
    defined(USE_U16)
#extension GL_EXT_shader_16bit_storage : require
#endif
#if defined(USE_BF16) || defined(USE_I16) || defined(USE_U16)
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif
#if defined(USE_I64) || defined(USE_U64)
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#endif

#ifdef USE_FP16
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#define ACC_TYPE float
#define FLOAT_ACC 1
#elif defined(USE_BF16)
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#define ACC_TYPE float
#define FLOAT_ACC 1
#elif defined(USE_I32) || defined(USE_I8) || defined(USE_I16)
#define STORAGE_TYPE int
#define LOAD_VALUE(x) STORAGE_TYPE(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#define ACC_TYPE int
#elif defined(USE_U32) || defined(USE_U8) || defined(USE_U16)
#define STORAGE_TYPE uint
#define LOAD_VALUE(x) STORAGE_TYPE(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#define ACC_TYPE uint
#elif defined(USE_I64)
#define ACC_TYPE int64_t
#elif defined(USE_U64)
#define ACC_TYPE uint64_t
#elif defined(USE_COMPLEX)
#define ACC_TYPE vec2
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#define ACC_TYPE float
#define FLOAT_ACC 1
#endif

// Transports: BYTE (bool, int8, uint8) reads one byte per item through the
// gather-style word load and the constant-shift select chain proven in
// scatter.comp; HALF binds a uint16_t storage view; WORD64 binds 64-bit
// words; COMPLEX binds vec2 pairs. Everything else keeps the typed
// STORAGE_TYPE view the float and 32-bit kernels always used.
#if defined(USE_BOOL) || defined(USE_I8) || defined(USE_U8)
#define BYTE 1
#elif defined(USE_I16) || defined(USE_U16)
#define HALF 1
#elif defined(USE_I64) || defined(USE_U64)
#define WORD64 1
#elif defined(USE_COMPLEX)
#define COMPLEX 1
#endif

layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Input {
#ifdef BYTE
  uint values[];
#elif defined(HALF)
  uint16_t values[];
#elif defined(WORD64)
  uint64_t values[];
#elif defined(COMPLEX)
  vec2 values[];
#else
  STORAGE_TYPE values[];
#endif
} input_data;
// Not writeonly: the byte transport inserts lanes with atomics, and the
// omarchy allocator page-rounds every buffer so the word holding the last
// lane is inside the allocation.
layout(set = 0, binding = 2, std430) buffer Output {
#ifdef BYTE
  uint values[];
#elif defined(HALF)
  uint16_t values[];
#elif defined(WORD64)
  uint64_t values[];
#elif defined(COMPLEX)
  vec2 values[];
#else
  STORAGE_TYPE values[];
#endif
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

#if defined(USE_I32) || defined(USE_I8) || defined(USE_I16)
// -2147483648 has no direct GLSL literal; the C-style two-step avoids the
// unary-minus-parses-first trap.
#define MAX_SENTINEL 2147483647
#define MIN_SENTINEL (-2147483647 - 1)
#elif defined(USE_U32) || defined(USE_U8) || defined(USE_U16)
#define MAX_SENTINEL 0xffffffffu
#define MIN_SENTINEL 0u
#elif defined(USE_I64)
#define MAX_SENTINEL 9223372036854775807L
#define MIN_SENTINEL (-9223372036854775807L - 1)
#elif defined(USE_U64)
#define MAX_SENTINEL 0xffffffffffffffffUL
#define MIN_SENTINEL 0UL
#else
#define MAX_SENTINEL uintBitsToFloat(0x7f800000u)
#define MIN_SENTINEL uintBitsToFloat(0xff800000u)
#endif

ACC_TYPE init_value(uint operation) {
  if (operation == 0u) {
#ifdef USE_COMPLEX
    return ACC_TYPE(0.0, 0.0);
#else
    return ACC_TYPE(0);
#endif
  }
  if (operation == 1u) {
#ifdef USE_COMPLEX
    return ACC_TYPE(1.0, 0.0);
#else
    return ACC_TYPE(1);
#endif
  }
  if (operation == 2u) {
#ifdef USE_COMPLEX
    return ACC_TYPE(MAX_SENTINEL, MAX_SENTINEL);
#else
    return ACC_TYPE(MAX_SENTINEL);
#endif
  }
#ifdef USE_COMPLEX
  if (operation == 4u) {
    // LogAddExp accumulates from -inf; the imaginary zero matches the
    // upstream complex -inf constant.
    return ACC_TYPE(MIN_SENTINEL, 0.0);
  }
  return ACC_TYPE(MIN_SENTINEL, MIN_SENTINEL);
#else
  return ACC_TYPE(MIN_SENTINEL);
#endif
}

#ifdef USE_COMPLEX
bool complex_is_nan(ACC_TYPE value) {
  return isnan(value.x) || isnan(value.y);
}

// Lexicographic (real, then imaginary) ordering, the same rule the
// upstream complex compare kernels use.
bool complex_less(ACC_TYPE a, ACC_TYPE b) {
  return (a.x < b.x) || (a.x == b.x && a.y < b.y);
}

ACC_TYPE combine(ACC_TYPE acc, ACC_TYPE next, uint operation) {
  if (operation == 0u) {
    return acc + next;
  }
  if (operation == 1u) {
    return ACC_TYPE(acc.x * next.x - acc.y * next.y,
                    acc.x * next.y + acc.y * next.x);
  }
  if (operation == 4u) {
    // The upstream complex LogAddExp (binary_ops.h): maxval plus the
    // complex log1p of the corrected exponential difference. NaN wins
    // first, and the infinities short-circuit to the maximum.
    const float POS_INF = uintBitsToFloat(0x7f800000u);
    const float NEG_INF = uintBitsToFloat(0xff800000u);
    if (complex_is_nan(acc) || complex_is_nan(next)) {
      return ACC_TYPE(uintBitsToFloat(0x7fc00000u), 0.0);
    }
    bool ge = (acc.x > next.x) || (acc.x == next.x && acc.y >= next.y);
    vec2 maxv = ge ? acc : next;
    vec2 minv = ge ? next : acc;
    if (minv.x == NEG_INF || maxv.x == POS_INF) {
      return maxv;
    }
    float m = exp(minv.x - maxv.x);
    // The imaginary-part difference is unbounded (data), so the trig
    // goes through the shared reduction: accurate to 5e5, NaN above.
    vec2 dexp = vec2(m * omarchy_trig_cos(minv.y - maxv.y),
                     m * omarchy_trig_sin(minv.y - maxv.y));
    vec2 one_plus = dexp + vec2(1.0, 0.0);
    float arg = (one_plus.x == 0.0 && one_plus.y == 0.0)
        ? 0.0
        : atan(one_plus.y, one_plus.x);
    return maxv + vec2(log(length(one_plus)), arg);
  }
  // The same numpy-rule minimum/maximum the reduce kernel uses: a NaN
  // operand is itself the result.
  if (complex_is_nan(acc)) {
    return acc;
  }
  if (complex_is_nan(next)) {
    return next;
  }
  if (operation == 2u) {
    return complex_less(next, acc) ? next : acc;
  }
  return complex_less(acc, next) ? next : acc;
}
#else
// Natural log of 1 + x through the Goldberg correction, the same helper
// elementwise.comp uses (GLSL has no log1p builtin).
float log1p_impl(float x) {
  float u = 1.0f + x;
  if (u == 1.0f) {
    return x;
  }
  return log(u) * (x / (u - 1.0f));
}

ACC_TYPE combine(ACC_TYPE acc, ACC_TYPE next, uint operation) {
  if (operation == 0u) {
    return acc + next;
  }
  if (operation == 1u) {
    return acc * next;
  }
#ifdef FLOAT_ACC
  if (operation == 4u) {
    // The upstream LogAddExp (binary_ops.h): NaN operands win first, the
    // maximum is returned directly at the infinities, which also keeps
    // -inf + -inf from producing NaN.
    const float POS_INF = uintBitsToFloat(0x7f800000u);
    const float NEG_INF = uintBitsToFloat(0xff800000u);
    const float QUIET_NAN = uintBitsToFloat(0x7fc00000u);
    if (isnan(acc) || isnan(next)) {
      return QUIET_NAN;
    }
    ACC_TYPE maxv = max(acc, next);
    ACC_TYPE minv = min(acc, next);
    if (minv == NEG_INF || maxv == POS_INF) {
      return maxv;
    }
    return maxv + log1p_impl(exp(minv - maxv));
  }
  // Min and Max follow the upstream NaN convention: any NaN in the scan
  // poisons every later element. A plain ordered compare silently drops
  // a NaN carried in the running value, so the poison is held once it
  // enters.
  if (isnan(acc)) {
    return acc;
  }
  if (isnan(next)) {
    return next;
  }
#endif
  if (operation == 2u) {
    return acc < next ? acc : next;
  }
  return acc > next ? acc : next;
}
#endif

#ifdef BYTE
// Honeykrisp miscompiles shift-then-mask byte extraction with a
// data-dependent shift amount (receipt 2026-09-02-masked-scatter-m1-fix,
// diag68); the constant-shift select chain is the receipt-proven
// equivalent (the same macro compare_bool.comp and cast_int.comp use).
#define BYTE_AT(word, lane)                                                  \
  ((lane) == 0u ? ((word) & 0xFFu)                                           \
       : (lane) == 1u ? (((word) >> 8u) & 0xFFu)                             \
       : (lane) == 2u ? (((word) >> 16u) & 0xFFu)                            \
                      : (((word) >> 24u) & 0xFFu))
#endif

ACC_TYPE load_item(uint item) {
  uint addr = params.lhs_offset + item;
#ifdef BYTE
  uint byte = BYTE_AT(input_data.values[addr >> 2u], addr & 3u);
#if defined(USE_I8)
  return (byte & 0x80u) != 0u ? int(byte) - 256 : int(byte);
#elif defined(USE_U8)
  return uint(byte);
#else
  return byte != 0u ? 1 : 0;
#endif
#elif defined(HALF)
  uint16_t bits = input_data.values[addr];
#if defined(USE_I16)
  uint extended = uint(bits);
  return (extended & 0x8000u) != 0u ? int(extended) - 65536 : int(extended);
#else
  return uint(bits);
#endif
#elif defined(WORD64)
  return ACC_TYPE(input_data.values[addr]);
#elif defined(COMPLEX)
  return input_data.values[addr];
#else
  return LOAD_VALUE(input_data.values[addr]);
#endif
}

// The output dtype follows the ops-layer contract: cumsum(bool) produces
// int32 and every other scan keeps the input dtype. Byte outputs insert
// lanes with atomics so adjacent lines sharing one word stay exact; the
// line-per-invocation shape means two invocations can share a word
// whenever the fresh output packs four byte elements into it.
void store_item(uint item, ACC_TYPE value) {
  uint addr = params.output_offset + item;
#ifdef BYTE
#if defined(USE_BOOL)
  if (params.reduce_size == 0u) {
    // bool cumsum: the output array is int32.
    output_data.values[addr] = uint(value);
    return;
  }
#endif
  uint narrow;
#if defined(USE_I8)
  narrow = uint(value) & 0xFFu;
#elif defined(USE_U8)
  narrow = value & 0xFFu;
#else
  narrow = value > 0 ? 1u : 0u;
#endif
  uint shift = (addr & 3u) * 8u;
  atomicAnd(output_data.values[addr >> 2u], ~(0xFFu << shift));
  atomicOr(output_data.values[addr >> 2u], narrow << shift);
#elif defined(HALF)
  output_data.values[addr] = uint16_t(uint(value) & 0xFFFFu);
#elif defined(WORD64)
  output_data.values[addr] = uint64_t(value);
#elif defined(COMPLEX)
  output_data.values[addr] = value;
#else
  output_data.values[addr] = STORE_VALUE(value);
#endif
}

void main() {
  uint line = gl_GlobalInvocationID.x;
  if (line >= params.output_size) {
    return;
  }
  uint axis = params.matrix_m;
  uint rem = line;
  // Relative base: load_item and store_item add the absolute buffer
  // offsets themselves.
  uint in_off = 0u;
  uint out_off = 0u;
  for (int d = int(params.dims) - 1; d >= 0; --d) {
    if (d == int(axis)) {
      // The scan-axis coordinate stays zero in the base offset; the walk
      // below adds it in per element.
      continue;
    }
    uint coord = rem % params.shape[d];
    rem /= params.shape[d];
    in_off += coord * params.in_strides[d];
    out_off += coord * params.out_strides[d];
  }
  uint length = params.shape[axis];
  uint in_step = params.in_strides[axis];
  uint out_step = params.out_strides[axis];
  bool reverse = (params.flags & 1u) != 0u;
  ACC_TYPE value = init_value(params.reduce_size);
  for (uint t = 0u; t < length; ++t) {
    uint j = reverse ? length - 1u - t : t;
    ACC_TYPE next = load_item(in_off + j * in_step);
    if (params.operation == 0u) {
      // Inclusive: the running value covers the current element.
      value = combine(value, next, params.reduce_size);
      store_item(out_off + j * out_step, value);
    } else {
      // Exclusive: the running value covers only earlier elements.
      store_item(out_off + j * out_step, value);
      value = combine(value, next, params.reduce_size);
    }
  }
}
