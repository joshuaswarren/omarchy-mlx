#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// Fused-SwiGLU epilogue for the swiglu two-matmul decomposition: gate and
// value f32 totals come from two cooperative-matrix int8 matmuls (raw
// flags-bit1 outputs, no WS/B applied), and this kernel applies
// gate = G * WS[col] + B[col], value = V * WS[n+col] + B[n+col], and
// stores bf16(silu(gate) * value) with ONE bf16 rounding - the exact op
// sequence and expression text of the scalar swiglu kernel
// (int8_matmul_f32fma.comp), so the bits match the naive kill switch.
//
// Grid-strides over the rows*n outputs; count rides params.count and n
// params.matrix_n; WS/B ride shape[1]/shape[2] as in every int8 kernel.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InG {
  float values[];
} in_g;
layout(set = 0, binding = 1, std430) readonly buffer InV {
  float values[];
} in_v;
layout(set = 0, binding = 2, std430) readonly buffer InWS {
  float values[];
} in_ws;
layout(set = 0, binding = 3, std430) readonly buffer InB {
  float values[];
} in_b;
layout(set = 0, binding = 4, std430) buffer OutBF16 {
  uint16_t values[];
} out_bf16;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

void main() {
  const uint n = params.matrix_n;
  const uint ws_base = params.shape[1];
  const uint b_base = params.shape[2];
  for (uint idx = gl_GlobalInvocationID.x; idx < params.count;
       idx += gl_NumWorkGroups.x * 256u) {
    const uint col = idx % n;
    float gate = in_g.values[idx] * in_ws.values[ws_base + col] +
        in_b.values[b_base + col];
    float value = in_v.values[idx] * in_ws.values[ws_base + n + col] +
        in_b.values[b_base + n + col];
    out_bf16.values[params.output_offset + idx] =
        bf16_store(gate / (1.0f + exp(-gate)) * value);
  }
}
