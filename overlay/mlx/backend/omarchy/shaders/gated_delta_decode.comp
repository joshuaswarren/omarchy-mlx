//
// Fused gated-delta-rule decode step (GatedDeltaUpdate, T=1). Replaces the
// composed per-token op chain that Qwen3.5-style GDN linear-attention layers
// run per decoded token: state decay, kv reduction, delta, outer-product
// state update, and the output projection over the updated state.
//
// One thread per Dv row walks that row of the state twice (kv pass,
// update+output pass); k and q ride shared memory, and the state tile of
// the workgroup's rows is staged through shared memory (see the geometry
// note above main). Every intermediate is float32 and each row reduces
// sequentially over Dk in ascending order, so the arithmetic matches the
// composed fallback's per-row sums.
//
// Exactness contract (bf16 arm): q/k/v are bf16 bit patterns widened exactly
// (bf16 bits are the f32 top half); g/beta arrive f32 (the fast.cpp caller
// promotes them to the q/k dtype; bf16 widening is exact); state and the
// final state store stay f32; the output store rounds to bf16 RNE, the same
// store cast.comp applies everywhere. See receipts/2026-09-21-gdn-decode-fused.

#version 460

#extension GL_EXT_shader_16bit_storage : require
#ifdef QKV_BF16
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer QBuf  { uint16_t v[]; } q_buf;
layout(set = 0, binding = 1, std430) readonly buffer KBuf  { uint16_t v[]; } k_buf;
layout(set = 0, binding = 2, std430) readonly buffer VBuf  { uint16_t v[]; } v_buf;
layout(set = 0, binding = 3, std430) readonly buffer GBuf  { uint16_t v[]; } g_buf;
layout(set = 0, binding = 4, std430) readonly buffer BBuf  { uint16_t v[]; } b_buf;
layout(set = 0, binding = 5, std430) readonly buffer SIn   { float    v[]; } s_in;
layout(set = 0, binding = 6, std430) writeonly buffer YBuf { uint16_t v[]; } y_buf;
layout(set = 0, binding = 7, std430) buffer         SOut  { float    v[]; } s_out;
// Raw-gates mode (flag bit 8): the gate chain rides in-kernel. Slot 3
// carries a, slot 4 carries b (bf16); slots 8/9 carry A_log (bf16) and
// dt_bias (bf16).
layout(set = 0, binding = 8, std430) readonly buffer ALogBuf { uint16_t v[]; } alog_buf;
layout(set = 0, binding = 9, std430) readonly buffer DtBuf   { uint16_t v[]; } dt_buf;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;   // Dk
  uint matrix_n;   // Dv
  uint matrix_k;   // Hv
  uint flags;
  float alpha;
  float beta_f;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if ((bits & 0x7fff0000u) == 0x7f800000u) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

// Geometry: Dk == Dv == 128 (dispatch-gated), 128 threads per workgroup,
// ROWS Dv rows per workgroup, Dv / ROWS workgroups per head
// (gl_WorkGroupID.y). The ROWS x Dk f32 state tile is staged through shared
// memory with coalesced loads and stores (thread t owns column t of every
// tile row), so the per-row sequential walks read shared memory instead of
// one 512-byte-strided global word per lane per step.
//
// Bit identity with the one-workgroup-per-head kernel this replaces: that
// kernel's source (`kv += s * g * k[i]`, `ns = s * g + delta * k[i]`,
// `out += ns * q[i]`) compiled, after Honeykrisp's rank-based
// reassociation of non-exact float chains, to kv = fma(s, k[i] * g, kv),
// ns = fma(s, g, delta * k[i]), out = fma(ns, q[i], out) (AGX NIR dump,
// receipts/2026-09-29-jw16-decode-gdn-lse-argmax). The same source reading
// a shared tile regroups differently, so the walks below are written so each
// step is a two-operand chain the compiler can only contract one way:
// k[i] * g is a per-workgroup table (one rounding, the same fmul), and
// delta * k[i] is precise, leaving s * g as the only product next to it.
// The walks and the gate prologue sit in their own functions because
// glslang propagates `precise` backward through everything that feeds a
// precise value inside one function.
const uint ROWS = 32u;
const uint TILE_STRIDE = 129u;  // padded: row r, column i -> bank (r + i) % 32

shared float sk[128];
shared float sq[128];
shared float skg[128];
shared float tile[ROWS * TILE_STRIDE];

// kv = sum over ascending i of s[i] * (k[i] * g), contracted per step.
float gdn_kv_walk(uint trow, uint dk) {
  float kv_acc = 0.0f;
  for (uint i = 0u; i < dk; ++i) {
    kv_acc += tile[trow + i] * skg[i];
  }
  return kv_acc;
}

// ns = s * g + dk_term, contracted (dk_term arrives rounded).
float gdn_decay_add(float s, float g, float dk_term) {
  return s * g + dk_term;
}

// Gate prologue (g, beta) for one head.
vec2 gdn_gates(uint head) {
  float g;
  float beta;
  if ((params.flags & 8u) != 0u) {
    // Raw-gates prologue. Matches the composed decode chain's rounding:
    // beta = sigmoid(b) in f32 then rounded to bf16; g =
    // exp(-exp(A_log_f32) * softplus(a + dt_bias)) in f32 then rounded to
    // bf16 (the same roundings the eager chain applies before the kernel
    // widened the bf16 values exactly).
    float b_in = bf16_load(b_buf.v[params.aux_offset + head]);
    float beta_f = 1.0f / (1.0f + exp(-b_in));
    beta = bf16_load(bf16_store(beta_f));
    float a_in = bf16_load(g_buf.v[params.shape[0] + head]);
    // A_log rides bf16 in the Qwen3.8 checkpoint; flag bit 9 selects an
    // f32 A_log (the Qwen3.5-9B conversion stores it f32) read as two
    // little-endian u16 words — the same f32 word the eager chain's
    // astype(f32) leaves untouched, so no rounding difference.
    float a_log;
    if ((params.flags & 512u) != 0u) {
      uint base = params.in_strides[0] + 2u * head;
      a_log = uintBitsToFloat(uint(alog_buf.v[base]) |
                              (uint(alog_buf.v[base + 1u]) << 16u));
    } else {
      a_log = bf16_load(alog_buf.v[params.in_strides[0] + head]);
    }
    // dt_bias rides bf16 in the Qwen3.8 checkpoint; widening is exact.
    float dt = bf16_load(dt_buf.v[params.in_strides[1] + head]);
    // The eager chain rounds x = a + dt_bias to bf16 (bf16 + bf16 stays
    // bf16) and softplus(x) to bf16; replicate those roundings exactly.
    float x = bf16_load(bf16_store(a_in + dt));
    // softplus = logaddexp(0, x): the eager chain lowers nn.softplus to
    // LogAddExp, computed here with the elementwise kernel's exact
    // formula max(a,b) + log1p(exp(-|a-b|)) (log1p in the corrected
    // ratio form, log(u) * x / (u - 1)), then rounded to bf16.
    float u = 1.0f + exp(-abs(x));
    float l1p = (u == 1.0f) ? exp(-abs(x)) : log(u) * (exp(-abs(x)) / (u - 1.0f));
    float sp = bf16_load(bf16_store(max(x, 0.0f) + l1p));
    // The eager chain keeps g in f32 end to end (compute_g returns f32);
    // exp(A_log) and the product stay f32, so no bf16 round here: the
    // bf16 roundings the eager path applies are on x, sp, and beta.
    g = exp(-(exp(a_log) * sp));
  } else {
    g = bf16_load(g_buf.v[params.shape[0] + head]);
    beta = bf16_load(b_buf.v[params.aux_offset + head]);
  }
  return vec2(g, beta);
}

void main() {
  uint dk = params.matrix_m;
  uint dv = params.matrix_n;
  uint hv = params.matrix_k;
  uint head = gl_WorkGroupID.x;
  uint row0 = gl_WorkGroupID.y * ROWS;
  uint lane = gl_LocalInvocationID.x;

  if (head >= hv) {
    return;
  }
  vec2 gates = gdn_gates(head);
  float g = gates.x;
  float beta = gates.y;
  sk[lane] = bf16_load(k_buf.v[params.rhs_offset + head * dk + lane]);
  sq[lane] = bf16_load(q_buf.v[params.lhs_offset + head * dk + lane]);
  skg[lane] = sk[lane] * g;
  uint head_base = head * dv * dk;
  uint tile_base = params.shape[1] + head_base + row0 * dk;
  for (uint r = 0u; r < ROWS; ++r) {
    tile[r * TILE_STRIDE + lane] = s_in.v[tile_base + r * dk + lane];
  }
  barrier();

  if (lane < ROWS) {
    uint row = row0 + lane;
    uint trow = lane * TILE_STRIDE;
    float kv_acc = gdn_kv_walk(trow, dk);
    precise float delta =
        (bf16_load(v_buf.v[params.aux_size + head * dv + row]) - kv_acc) * beta;

    float o_acc = 0.0f;
    for (uint i = 0u; i < dk; ++i) {
      precise float dk_term = delta * sk[i];
      float ns = gdn_decay_add(tile[trow + i], g, dk_term);
      tile[trow + i] = ns;
      o_acc += ns * sq[i];
    }
    y_buf.v[params.output_offset + head * dv + row] = bf16_store(o_acc);
  }
  barrier();
  uint out_base = params.shape[2] + head_base + row0 * dk;
  for (uint r = 0u; r < ROWS; ++r) {
    s_out.v[out_base + r * dk + lane] = tile[r * TILE_STRIDE + lane];
  }
}
