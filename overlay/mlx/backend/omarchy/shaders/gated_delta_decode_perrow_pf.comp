shared uint s_gdn_is_last;
#endif /* GDN_DV_SPLIT */
#endif /* GDN_NORM_FUSED */
#endif /* GDN_CONV_FUSED */
layout(set = 0, binding = 3, std430) readonly buffer GBuf  { uint16_t v[]; } g_buf;
layout(set = 0, binding = 4, std430) readonly buffer BBuf  { uint16_t v[]; } b_buf;
#ifdef STATE_BF16
layout(set = 0, binding = 5, std430) readonly buffer SIn   { u16vec4  v[]; } s_in;
#else
layout(set = 0, binding = 5, std430) readonly buffer SIn   { vec4     v[]; } s_in;
#endif
#if defined(GDN_DV_SPLIT) && defined(GDN_NORM_FUSED)
layout(set = 0, binding = 6, std430) coherent buffer YBuf { uint16_t v[]; } y_buf;
#else
layout(set = 0, binding = 6, std430) writeonly buffer YBuf { uint16_t v[]; } y_buf;
#endif
#ifdef STATE_BF16
