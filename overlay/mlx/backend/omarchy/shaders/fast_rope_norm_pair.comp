//
// Paired fused q/k RMSNorm + rotary embedding: both rope_rms_norm calls of
// one decode layer in one dispatch (the fast_trio_rope_pair idea carried to
// the bf16 norm-carrying form). Workgroup w < params.lhs_size owns query row
// w; later workgroups own key row (w - lhs_size). Each side reproduces
// shaders/fast_rope_norm.comp EXACTLY - same RMS reduction tree, same
// (weight * norm) * value multiply order with the same bf16 RNE rounds, same
// rotary math - so each output row is bit-identical to the unfused
// FastRopeNorm dispatch of that side. See fast_rope_norm.comp's header for
// the bit-exactness recipe this file keeps verbatim.
//
// Push-constant mapping (ComputeParams fields, 128-byte block):
//   count        rows_q + rows_k          lhs_size     rows_q
//   rhs_size     rows_k                   operation    floatBitsToUint(eps)
//   reduce_size  D                        dims         dims/2 (half_dims)
//   alpha        rope scale               beta         log(base)/half_dims
//   flags        bit0 forward, bit1 passthrough (unreachable: the host
//                requires dims == D), bit2 q head/seq transpose,
//                bit3 k head/seq transpose
//   lhs_offset   query input item offset  rhs_offset   key input item offset
//   output_offset query output item off   aux_size     key output item off
//                (fresh row-contiguous output, or the producer-direct KV
//                window element offset - window feature stride is 1)
//   aux_offset   offset-array item off    matrix_m     offset stride
//   matrix_n     query weight item off    matrix_k     key weight item off
//   shape        [heads_q, heads_k, T, D]
//   in_strides   [q_matrix, q_time, k_matrix, k_time]
//   out_strides  [q_matrix, q_time, k_matrix, k_time]
//
#version 460
#ifdef APPLE_REDUCTION
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif

#extension GL_GOOGLE_include_directive : require
#include "omarchy_trig.h"

layout(set = 0, binding = 0, std430) readonly buffer InQ {
  uint values[];
} in_q;
layout(set = 0, binding = 1, std430) readonly buffer InK {
  uint values[];
} in_k;
layout(set = 0, binding = 2, std430) writeonly buffer OutQ {
  uint values[];
} out_q;
layout(set = 0, binding = 3, std430) writeonly buffer OutK {
  uint values[];
} out_k;
layout(set = 0, binding = 4, std430) readonly buffer WeightQ {
  uint values[];
} weight_q;
layout(set = 0, binding = 5, std430) readonly buffer WeightK {
  uint values[];
} weight_k;
layout(set = 0, binding = 6, std430) readonly buffer Offsets {
  int values[];
} offset_data;

// Workgroup width. 256 = the shipped build. ROPE_NORM_THREADS=128 builds
// the D<=128 variant (Qwen3-4B Q/K rows are 128 wide; the 256-thread
// workgroup idles half its threads there). N_SUBGROUPS scales the
// second-level reduction read so the 128 build (4 subgroups) never
// consumes stale shared slots 4..7. Adding the zero partials of subgroups
// 4..7 in the 256 build is exact in fp, so both builds are byte-identical
// for D<=128 rows.
#ifndef ROPE_NORM_THREADS
#define ROPE_NORM_THREADS 256u
#endif
const uint N_SUBGROUPS = ROPE_NORM_THREADS / 32u;

layout(local_size_x = ROPE_NORM_THREADS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float block_values[ROPE_NORM_THREADS];
#ifdef APPLE_REDUCTION
shared float subgroup_values[N_SUBGROUPS];
#endif
shared float rounded[ROPE_NORM_THREADS];

float rope_load(uint abs_index, bool q_side) {
  uint word = q_side ? in_q.values[abs_index >> 1u]
                     : in_k.values[abs_index >> 1u];
  uint bits = ((abs_index & 1u) == 0u) ? (word & 0xFFFFu) : (word >> 16u);
  return uintBitsToFloat(bits << 16u);
}

float weight_load(uint abs_index, bool q_side) {
  uint word = q_side ? weight_q.values[abs_index >> 1u]
                     : weight_k.values[abs_index >> 1u];
  uint bits = ((abs_index & 1u) == 0u) ? (word & 0xFFFFu) : (word >> 16u);
  return uintBitsToFloat(bits << 16u);
}

void rope_store(uint word_index, uint value, bool q_side) {
  if (q_side) {
    out_q.values[word_index] = value;
  } else {
    out_k.values[word_index] = value;
  }
}

uint bf16_bits(float value) {
  uint bits = floatBitsToUint(value);
  return isnan(value)
      ? ((bits >> 16u) | 0x40u)
      : ((bits + 0x7fffu + ((bits >> 16u) & 1u)) >> 16u);
}

float rope_round(float value) {
  uint bits = floatBitsToUint(value);
  uint rounded = isnan(value)
      ? ((bits >> 16u) | 0x40u)
      : ((bits + 0x7fffu + ((bits >> 16u) & 1u)) >> 16u);
  return uintBitsToFloat(rounded << 16u);
}

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint time = params.shape[2];
  bool forward = (params.flags & 1u) != 0u;
  bool passthrough = (params.flags & 2u) != 0u;
  uint half_dims = params.dims;
  uint row_length = params.reduce_size;
  float eps = uintBitsToFloat(params.operation);
  // One workgroup owns one rotation row of one side: global row <
  // lhs_size is a query row, the rest are key rows. The grid clamps at
  // 65535 workgroups, so rows past that must be reached with a
  // grid-stride loop (the fast_norm.comp pattern). Every thread takes
  // the same trip count, so the barriers below stay uniform.
  for (uint row = gl_WorkGroupID.x; row < params.count;
       row += gl_NumWorkGroups.x) {

  bool q_side = row < params.lhs_size;
  uint srow = q_side ? row : (row - params.lhs_size);
  uint heads = q_side ? params.shape[0] : params.shape[1];
  bool head_seq_transpose =
      (params.flags & (q_side ? 4u : 8u)) != 0u;
  uint in_mat_stride = q_side ? params.in_strides[0] : params.in_strides[2];
  uint in_time_stride = q_side ? params.in_strides[1] : params.in_strides[3];
  uint out_mat_stride = q_side ? params.out_strides[0] : params.out_strides[2];
  uint out_time_stride = q_side ? params.out_strides[1] : params.out_strides[3];
  uint in_offset = q_side ? params.lhs_offset : params.rhs_offset;
  uint out_offset = q_side ? params.output_offset : params.aux_size;
  uint weight_offset = q_side ? params.matrix_n : params.matrix_k;

  uint mat = srow / time;
  uint t = srow - mat * time;
  uint b = mat / heads;
  uint head = mat - b * heads;
  uint in_base;
  if (head_seq_transpose) {
    in_base = b * (time * in_time_stride) + t * in_time_stride +
        head * in_mat_stride;
  } else {
    in_base = t * in_time_stride + mat * in_mat_stride;
  }
  uint out_row = t * out_time_stride + mat * out_mat_stride;

#ifdef APPLE_REDUCTION
  precise float value = (thread < row_length)
      ? rope_load(in_offset + in_base + thread, q_side)
      : 0.0;
  precise float squared = value * value;
  float subgroup_sum = subgroupAdd(squared);
  if (gl_SubgroupInvocationID == 0u) {
    subgroup_values[gl_SubgroupID] = subgroup_sum;
  }
  barrier();
  float partial = gl_SubgroupID == 0u && gl_SubgroupInvocationID < N_SUBGROUPS
      ? subgroup_values[gl_SubgroupInvocationID]
      : 0.0;
  float row_sum = subgroupAdd(partial);
  if (gl_LocalInvocationIndex == 0u) {
    block_values[0] = row_sum;
  }
  barrier();
  float mean_square = block_values[0] / float(row_length);
  precise float norm = inversesqrt(mean_square + eps);
  barrier();
  precise float weight = (thread < row_length)
      ? weight_load(weight_offset + thread, q_side)
      : 0.0;
  precise float weight_norm = weight * norm;
  rounded[thread] = (thread < row_length) ? rope_round(value * weight_norm)
                                          : 0.0;
  barrier();
#else
  // fast_norm.comp reduction tree, verbatim: one f32 sum-of-squares per
  // thread (threads past the row length contribute exactly the same 0.0 the
  // fast_norm grid-stride loop produces), stride-128..1 shared pairing with
  // a barrier per step, f32 divide by the row length, inversesqrt.
  // The squared register lives ONLY in this block; it is discarded below
  // (the production kernel discards it after the reduction tree too).
  float squared = 0.0;
  if (thread < row_length) {
    squared = rope_load(in_offset + in_base + thread, q_side);
    squared = squared * squared;
  }
  block_values[thread] = squared;
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      block_values[thread] += block_values[thread + stride];
    }
    barrier();
  }
  // fast_norm.comp re-loads `value` after the reduction barrier. We do the
  // same: the production kernel carries the squared value in a register
  // across the reduction barrier and re-loads the input inside its output
  // loop. Honeykrisp's nir_opt_reassociate sees a fresh memory load and
  // cannot contract the (value * norm) * weight chain with the squared form;
  // sharing the squared register across the barrier lets NIR group the
  // multiplies into an ffma that drifts by 1 bf16 ULP at the rounding
  // boundary. The re-load here is what makes the fused reduction bit-
  // identical to the production chain (verified row-by-row; see
  // the private DecodeGap9 NIR diffs).
  float mean_square = block_values[0] / float(row_length);
  // The fast_norm.comp production script inserts a barrier() between the
  // reduction tree's last iteration and the output multiply chain. We
  // mirror it: the reduction loop's last barrier() runs at stride=1, so the
  // visible state across the divide is the same, but the explicit barrier
  // makes it impossible for NIR to fold block_values[0] / float(row_length)
  // into the (value * norm) chain downstream.
  barrier();
  precise float norm = inversesqrt(mean_square + eps);
  // Re-load the input value (production's output loop reads from input_data
  // fresh; same address, same bits, but a separate memory op that breaks
  // any NIR carry-through).
  precise float value = (thread < row_length)
      ? rope_load(in_offset + in_base + thread, q_side)
      : 0.0;
  precise float weight = (thread < row_length)
      ? weight_load(weight_offset + thread, q_side)
      : 0.0;
  // MIRROR PRODUCTION'S EXACT MULTIPLY ORDER: fast_norm.comp's compiled
  // SPIR-V emits (weight * norm) * value (verified in
  // the private DecodeGap9 NIR diff of fast_rms_norm_bf16:
  //   %171 = InverseSqrt(...)             -> norm
  //   %190 = weight loaded as f32
  //   %225 = FMul %190 %171               -> weight * norm
  //   %227 = FMul %225 %297               -> (weight*norm) * value
  // ). An order-of-multiplication change in fp32 shifts the bf16 rounding
  // boundary by 1 ULP at the rounding tie line, so this exact order is
  // bit-identity for production. The two precise intermediates pin the
  // shape so nir_opt_reassociate cannot fold the chain (25 NoContraction
  // decorations on this shader; verified via glslangValidator).
  precise float weight_norm = weight * norm;
  rounded[thread] = (thread < row_length) ? rope_round(value * weight_norm)
                                          : 0.0;
  barrier();
#endif

  // Production bf16 word math from fast_rope.comp with shared[] standing in
  // for the loads. Threads own one output word each; word pairs of one row.
  if (thread < (row_length / 2u)) {
    uint k = thread;
  float offset = float(offset_data.values[params.aux_offset + b * params.matrix_m]);
  float position = params.alpha * (float(t) + offset);
  uint word_base = (out_offset + out_row) >> 1u;
  float v0;
  float v1;
  if (passthrough) {
    uint d0 = 2u * k;
    uint d1 = d0 + 1u;
    if (d0 >= 2u * half_dims) {
      // Tail: the normalized-rounded values pass through (the unfused
      // kernel passes the raw input through; the norm it replaced already
      // ran above).
      v0 = rounded[d0];
      v1 = rounded[d1];
    } else {
      float vals[2];
      for (uint side = 0u; side < 2u; ++side) {
        uint d = d0 + side;
        uint i = d % half_dims;
        float inv_freq = exp(-float(i) * params.beta);
        float theta = position * inv_freq;
        float cos_t = rope_round(omarchy_trig_cos(theta));
        float sin_t = rope_round(omarchy_trig_sin(theta));
        float x1 = rounded[i];
        float x2 = rounded[i + half_dims];
        float xa = rope_round(x1 * cos_t);
        float xb = rope_round(x2 * sin_t);
        float xc = rope_round(x1 * sin_t);
        float xd = rope_round(x2 * cos_t);
        vals[side] = (d < half_dims) ? (forward ? (xa - xb) : (xb + xa))
                                     : (forward ? (xc + xd) : (xd - xc));
      }
      v0 = vals[0];
      v1 = vals[1];
    }
  } else {
    // Half-split rotation over the full row (dims == D).
    bool r1_side = k < (half_dims >> 1u);
    uint j0 = r1_side ? (2u * k) : (half_dims + 2u * (k - (half_dims >> 1u)));
    uint j1 = j0 + 1u;
    uint i0 = r1_side ? j0 : (j0 - half_dims);
    uint i1 = i0 + 1u;
    float inv0 = exp(-float(i0) * params.beta);
    float inv1 = exp(-float(i1) * params.beta);
    float cos0 = rope_round(omarchy_trig_cos(position * inv0));
    float sin0 = rope_round(omarchy_trig_sin(position * inv0));
    float cos1 = rope_round(omarchy_trig_cos(position * inv1));
    float sin1 = rope_round(omarchy_trig_sin(position * inv1));
    float xa = rounded[i0];
    float xb = rounded[i0 + half_dims];
    float xc = rounded[i1];
    float xd = rounded[i1 + half_dims];
    if (r1_side) {
      v0 = forward ? (rope_round(xa * cos0) - rope_round(xb * sin0))
                   : (rope_round(xb * sin0) + rope_round(xa * cos0));
      v1 = forward ? (rope_round(xc * cos1) - rope_round(xd * sin1))
                   : (rope_round(xd * sin1) + rope_round(xc * cos1));
    } else {
      v0 = forward ? (rope_round(xa * sin0) + rope_round(xb * cos0))
                   : (rope_round(xb * cos0) - rope_round(xa * sin0));
      v1 = forward ? (rope_round(xc * sin1) + rope_round(xd * cos1))
                   : (rope_round(xd * cos1) - rope_round(xc * sin1));
    }
  }
    rope_store(word_base + k, bf16_bits(v0) | (bf16_bits(v1) << 16u),
               q_side);
  }
  // Release the shared rounded[]/block_values[] state before the next
  // stride iteration rewrites it: without this trailing barrier a fast
  // thread could enter row N+1's norm phase while a slow thread still
  // reads row N's rounded values.
  barrier();
  }
}
