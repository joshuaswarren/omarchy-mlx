//
// Numerically stable softmax over the last axis. One workgroup handles one
// row with a shared-memory max reduction, an exp-sum reduction, and a
// normalize pass. Workgroups grid-stride over rows. All arithmetic runs in
// float32 for every storage dtype, which covers the upstream precise flag.
//
// Causal mode (flags bit 0, aux_size = query length, aux_offset = key
// length minus query length): row r is query position r % aux_size and
// only columns <= aux_offset + position take part; the rest store an
// exact zero. This is what the additive f16 / bf16 causal mask produced
// - a masked score plus the storage floor exponentiates to exactly zero
// and never wins the max - without the mask add pass, so attention's
// scores matmul may leave masked columns unwritten. aux_offset rides the
// u32 two's complement and is negative when the query outgrew the key:
// rows before the first admissible key then have zero valid columns and
// store an exact-zero row, so a fully masked row never reaches the 1/0
// normalization as a NaN.

#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 1, std430) readonly buffer Sink {
  STORAGE_TYPE values[];
} sink_data;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
  // Lockstep tail of ComputeParams (mlx compute.h): a shader may
  // declare any prefix of the struct, so these appended fields keep
  // every existing SPIR-V interface byte-identical.
  uint q_rowstride;
  uint k_rowstride;
  uint v_rowstride;
  uint o_rowstride;
  uint q_headstride;
  uint k_headstride;
  uint v_headstride;
  uint q_batchstride;
  uint k_batchstride;
  uint v_batchstride;
  // Windowed-dispatch transport: out_row_stride is the full output row
  // width for windowed matmul-family dispatches (0 = use matrix_n);
  // window_lo is the global first row / element for row- or
  // index-windowed dispatches (0 = unwindowed); window_hi is Take's
  // exclusive row-window bound (0 = unwindowed).
  uint out_row_stride;
  uint window_lo;
  uint window_hi;
} params;

shared float block_values[256];

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  bool has_sink = params.operation == 1u;
  bool causal = (params.flags & 1u) != 0u;
  // Row-windowed dispatches start at window_lo (0 = unwindowed).
  for (uint row = gl_WorkGroupID.x + params.window_lo;
       row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;
    // Signed on purpose: aux_offset is negative when the query outgrew
    // the key, and a row before the first admissible key must clamp to
    // zero valid columns - in u32 the wrap would read the whole row and
    // drive the 1/0 normalization to NaN.
    uint valid = row_length;
    if (causal) {
      int admissible =
          int(params.aux_offset) + int(row % params.aux_size) + 1;
      valid = uint(clamp(admissible, 0, int(row_length)));
    }
    float sink_value = 0.0;
    if (has_sink) {
      uint head = params.matrix_m == 0u
          ? 0u
          : (row / params.matrix_m) % params.matrix_n;
      sink_value = LOAD_VALUE(
          sink_data.values[params.rhs_offset + head]);
    }

    float local_max = uintBitsToFloat(0xff800000u);
    for (uint index = thread; index < valid; index += 256u) {
      float next = LOAD_VALUE(input_data.values[start + index]);
      if (isnan(next) || next > local_max) {
        local_max = next;
      }
    }
    block_values[thread] = local_max;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] =
            max(block_values[thread], block_values[thread + stride]);
      }
      barrier();
    }
    float row_max = block_values[0];
    if (has_sink && sink_value > row_max) {
      row_max = sink_value;
    }
    barrier();

    float local_sum = 0.0;
    for (uint index = thread; index < valid; index += 256u) {
      local_sum += exp(LOAD_VALUE(input_data.values[start + index]) - row_max);
    }
    if (has_sink && thread == 0u) {
      local_sum += exp(sink_value - row_max);
    }
    block_values[thread] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float normalizer = 1.0 / block_values[0];
    barrier();

    for (uint index = thread; index < row_length; index += 256u) {
      float value = index < valid
          ? exp(LOAD_VALUE(input_data.values[start + index]) - row_max) *
              normalizer
          : 0.0;
      output_data.values[params.output_offset + row * row_length + index] =
          STORE_VALUE(value);
    }
    barrier();
  }
}
