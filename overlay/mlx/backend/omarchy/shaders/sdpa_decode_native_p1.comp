//
// Native-shape pass 1 of the long-context decode SDPA (Jw16DecodeGap's
// named lever, receipts 2026-09-17). The fused SdpaDecodeNativeF16 kernel
// keeps one workgroup per head, so each of its 32 subgroups walks k/32
// sequential keys no matter how many blocks the two-pass splits into - the
// walk is latency-bound in that serial depth. Native Metal instead runs
// sdpa_vector_2pass_1 with grid = heads x blocks and ONE 32-thread
// simdgroup per block, so the serial depth is k/blocks (~8 at the
// 128-block crossover) with heads*blocks concurrent chains.
//
// This kernel is that shape: one workgroup per (head, block), one subgroup
// of 32 lanes, no shared memory and no barrier. Each workgroup reproduces
// the fused kernel's per-block loop exactly - same key order (stride-fold
// block + t*blocks), same fma/exp chain, same subgroupAdd over the dim
// lanes - and stores the same intermediates the fused kernel kept in
// shared memory: the f32 block max, the f32 exp sum, and the 32 packed f16
// output-pair words. Pass 2 (sdpa_decode_native_p2.comp) folds them with
// the fused kernel's pass-2 code unchanged, so the pair is bit-identical
// to the fused two-pass it replaces.
//
// The bf16 compile (-DBF16_IO, FamDecodeFast 2026-10-04) keeps the same
// block structure but widens loads exactly (bf16 bits are the f32 top
// half) and stores each output pair as two f32 words instead of packed
// f16 - the composition's probs*V accumulation is f32, so f16-packed
// partials would round twice where the fallback rounds once. Pass 2 folds
// the f32 partials and narrows once through the cast.comp RNE pair, the
// same single rounding the f32-score composition applies. Its parity
// contract is therefore the composition within f32 accumulation order,
// not the fused f16 two-pass.

#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#ifdef BF16_IO
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif

#ifdef BF16_IO
layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;
#else
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
#endif
#ifdef BF16_IO
layout(set = 0, binding = 0, std430) readonly buffer Query {
  uint16_t values[];
} query_data;
layout(set = 0, binding = 1, std430) readonly buffer Key {
  uint16_t values[];
} key_data;
layout(set = 0, binding = 2, std430) readonly buffer Value {
  uint16_t values[];
} value_data;
#else
layout(set = 0, binding = 0, std430) readonly buffer Query {
  float16_t values[];
} query_data;
layout(set = 0, binding = 1, std430) readonly buffer Key {
  float16_t values[];
} key_data;
layout(set = 0, binding = 2, std430) readonly buffer Value {
  float16_t values[];
} value_data;
#endif
layout(set = 0, binding = 3, std430) writeonly buffer Scratch {
  uint values[];
} scratch_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

const uint SIMD = 32u;
const float FINITE_MIN = -3.4028234663852886e38;

// Query-head width, matching the fused kernel: PAIRS dim pairs per lane,
// so SDPA_DIM must be a multiple of 64. Scratch words per head: blocks max
// words + blocks sum words + PAIRS*blocks*SIMD packed output-pair words.
// Shared with pass 2; keep the two shaders' layouts in lockstep.
#ifndef SDPA_DIM
#define SDPA_DIM 64u
#endif
const uint PAIRS = SDPA_DIM / 64u;
#ifdef BF16_IO
// f32 partial pairs: two words per lane pair, so the per-(head, block)
// stride doubles against the packed-f16 layout. Shared with pass 2; keep
// the two shaders' layouts in lockstep.
const uint SCRATCH_STRIDE_FACTOR = 2u + 2u * SIMD * PAIRS;
#else
const uint SCRATCH_STRIDE_FACTOR = 2u + SIMD * PAIRS;
#endif

#ifdef BF16_IO
// The cast.comp widening, verbatim: the bf16 bits are the f32 top half.
float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}
#define LD16(x) bf16_load(x)
#else
#define LD16(x) float(x)
#endif

float native_exp(float x) {
  return exp(x);
}

// The bf16 leg runs on any device (lavapipe reports subgroup_size=8, and
// a per-key cross-thread reduce was miscompiled there), so it borrows the
// one-pass arm's phase structure at block scale instead: serial full-dot
// scores into a shared stream, the same strided max/sum trees, and one
// thread per output dim. Scratch per (head, block) is [max, sum, o[256]]
// = 2 + SDPA_DIM words - pass 2 folds the blocks. The f16 arm keeps its
// subgroupAdd path and its subgroup_size==32 gate.
#ifdef BF16_IO
shared float s_qrow[SDPA_DIM];
shared float s_block[258];
shared float s_tree[256];
#endif

void main() {
#ifndef BF16_IO

  uint lane = gl_SubgroupInvocationID;
  uint head = gl_WorkGroupID.x;
  uint block = gl_WorkGroupID.y;
  uint blocks = params.flags;
  uint repeats = params.matrix_m / params.matrix_n;
  uint kv_head = head / repeats;
  uint q_base = params.lhs_offset + head * params.shape[0];
  uint q_dim = 2u * lane;
  float q0[PAIRS];
  float q1[PAIRS];
  for (uint p = 0u; p < PAIRS; ++p) {
    q0[p] = params.alpha *
        LD16(query_data.values[q_base + (p * 64u + q_dim) * params.shape[3]]);
    q1[p] = params.alpha * LD16(
        query_data.values[q_base + (p * 64u + q_dim + 1u) * params.shape[3]]);
  }

  // The fused kernel's per-block online state, verbatim.
  float max_score = FINITE_MIN;
  float sum_exp_score = 0.0;
  float o0[PAIRS];
  float o1[PAIRS];
  for (uint p = 0u; p < PAIRS; ++p) {
    o0[p] = 0.0;
    o1[p] = 0.0;
  }
  for (uint key = block; key < params.matrix_k; key += blocks) {
    uint k_base = params.rhs_offset + kv_head * params.shape[1] +
        key * params.shape[2] + q_dim * params.in_strides[0];
    float score = 0.0;
    for (uint p = 0u; p < PAIRS; ++p) {
      score = fma(
          q0[p],
          LD16(key_data.values[k_base + p * 64u * params.in_strides[0]]),
          score);
      score = fma(
          q1[p],
          LD16(key_data.values[
              k_base + (p * 64u + 1u) * params.in_strides[0]]),
          score);
    }
    score = subgroupAdd(score);
    float new_max = max(max_score, score);
    float factor = native_exp(max_score - new_max);
    float exp_score = native_exp(score - new_max);
    max_score = new_max;
    sum_exp_score = fma(sum_exp_score, factor, exp_score);
    uint v_base = params.aux_offset + kv_head * params.in_strides[1] +
        key * params.in_strides[2] + q_dim * params.in_strides[3];
    for (uint p = 0u; p < PAIRS; ++p) {
      o0[p] = fma(
          o0[p],
          factor,
          exp_score * LD16(value_data.values[
              v_base + p * 64u * params.in_strides[3]]));
      o1[p] = fma(
          o1[p],
          factor,
          exp_score * LD16(value_data.values[
              v_base + (p * 64u + 1u) * params.in_strides[3]]));
    }
  }

  uint head_base = head * blocks * SCRATCH_STRIDE_FACTOR;
  if (lane == 0u) {
    scratch_data.values[head_base + block] = floatBitsToUint(max_score);
    scratch_data.values[head_base + blocks + block] =
        floatBitsToUint(sum_exp_score);
  }
  for (uint p = 0u; p < PAIRS; ++p) {
    scratch_data.values[head_base + 2u * blocks +
                        (p * blocks + block) * SIMD + lane] =
        packHalf2x16(vec2(o0[p], o1[p]));
  }
}
#else
  uint thread = gl_LocalInvocationID.x;
  uint head = gl_WorkGroupID.x;
  uint block = gl_WorkGroupID.y;
  uint blocks = params.flags;
  uint repeats = params.matrix_m / params.matrix_n;
  uint kv_head = head / repeats;
  uint k_len = params.matrix_k;
  uint chunk = (k_len + blocks - 1u) / blocks;

  if (thread < SDPA_DIM) {
    s_qrow[thread] = params.alpha * bf16_load(
        query_data.values[params.lhs_offset +
            head * params.shape[0] + thread * params.shape[3]]);
  }
  barrier();

  // Scores for this block's strided keys: one full-width dot per key,
  // 16-wide K tiles exactly as the one-pass arm issues them.
  for (uint i = thread; i < chunk; i += 1024u) {
    uint key = block + i * blocks;
    uint k_base = params.rhs_offset + kv_head * params.shape[1] +
        key * params.shape[2];
    float accumulator = 0.0;
    for (uint d = 0u; d < SDPA_DIM; d += 16u) {
      float kv[16];
      for (uint e = 0u; e < 16u; ++e) {
        kv[e] = bf16_load(
            key_data.values[k_base + (d + e) * params.in_strides[0]]);
      }
      for (uint e = 0u; e < 16u; ++e) {
        accumulator += s_qrow[d + e] * kv[e];
      }
    }
    s_block[i] = accumulator;
  }
  barrier();

  // Row max over the block: strided scan then the 256-lane binary tree,
  // the one-pass arm's code with s_block[i] in place of s_stream[key].
  if (thread < 256u) {
    float local_max = uintBitsToFloat(0xff800000u);
    for (uint i = thread; i < chunk; i += 256u) {
      float next = s_block[i];
      if (isnan(next) || next > local_max) {
        local_max = next;
      }
    }
    s_tree[thread] = local_max;
  }
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      s_tree[thread] = max(s_tree[thread], s_tree[thread + stride]);
    }
    barrier();
  }
  float row_max = s_tree[0];
  barrier();

  // Denominator: strided sequential exp-sum per lane, then the tree.
  if (thread < 256u) {
    float local_sum = 0.0;
    for (uint i = thread; i < chunk; i += 256u) {
      local_sum += exp(s_block[i] - row_max);
    }
    s_tree[thread] = local_sum;
  }
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      s_tree[thread] += s_tree[thread + stride];
    }
    barrier();
  }
  float block_sum = s_tree[0];
  barrier();

  // Output dim per thread: ascending-key 16-wide V tiles with exact-zero
  // tail padding, storing the unnormalized block partial so pass 2 folds
  // with the exp(max_b - M) factors.
  uint head_base = head * blocks * (2u + SDPA_DIM);
  if (thread == 0u) {
    scratch_data.values[head_base + block] = floatBitsToUint(row_max);
    scratch_data.values[head_base + blocks + block] =
        floatBitsToUint(block_sum);
  }
  if (thread < SDPA_DIM) {
    uint d = thread;
    float accumulator = 0.0;
    uint i = 0u;
    uint v_base = params.aux_offset + kv_head * params.in_strides[1] +
        d * params.in_strides[3];
    for (; i + 16u <= chunk; i += 16u) {
      float vv[16];
      for (uint e = 0u; e < 16u; ++e) {
        vv[e] = bf16_load(
            value_data.values[v_base +
                (block + (i + e) * blocks) * params.in_strides[2]]);
      }
      for (uint e = 0u; e < 16u; ++e) {
        accumulator += exp(s_block[i + e] - row_max) * vv[e];
      }
    }
    for (uint e = 0u; e < 16u; ++e) {
      uint index = i + e;
      if (index < chunk) {
        accumulator += exp(s_block[index] - row_max) *
            bf16_load(value_data.values[v_base +
                (block + index * blocks) * params.in_strides[2]]);
      }
    }
    scratch_data.values[head_base + 2u * blocks + block * SDPA_DIM + d] =
        floatBitsToUint(accumulator);
  }
}
#endif