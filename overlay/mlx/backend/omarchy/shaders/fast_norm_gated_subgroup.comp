//
// DRAFT (w7H, for w88 review): FastNormGatedOnly zero-barrier variant for the
// small-D decode rows (9B: D=128, 24 dispatches/token; the 256-thread
// workgroup runs half-idle on a 128-wide row and pays three barriers plus a
// shared-memory round trip per launch).
//
// One 32-lane subgroup per row, single pass, register-resident: the row
// (x, gate) loads once into registers, the sum of squares reduces with one
// subgroupAdd, and the output pass applies silu(gate) * normed * weight
// straight from registers. No barriers, no shared memory. Row length must be
// 32-lane divisible and <= MAX_READS*32 (128 and 256 both qualify).
//
// Reduction order differs from fast_norm_gated.comp (documented; `precise`
// prevents implicit FMA). Gate semantics identical: silu(gate) * normed * w.

#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)

layout(local_size_x = 32) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 1, std430) readonly buffer Weight {
  STORAGE_TYPE values[];
} weight_data;
layout(set = 0, binding = 2, std430) readonly buffer Gate {
  STORAGE_TYPE values[];
} gate_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
} params;

const uint SIMD = 32u;
const uint MAX_READS = 8u;  // D<=256: 8 elements per lane at D=256, 4 at D=128

void main() {
  uint lane = gl_LocalInvocationID.x;  // this workgroup IS one subgroup
  uint row_length = params.reduce_size;
  float eps = params.alpha;

  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;
    uint gstart = params.aux_offset + row * row_length;
    uint n_reads = row_length / SIMD;

    precise float reg_x[MAX_READS];
    precise float reg_gate[MAX_READS];
    precise float reg_sq = 0.0;
    for (uint i = 0u; i < n_reads; ++i) {
      reg_x[i] = LOAD_VALUE(input_data.values[start + lane * n_reads + i]);
      reg_gate[i] = LOAD_VALUE(gate_data.values[gstart + lane * n_reads + i]);
      reg_sq += reg_x[i] * reg_x[i];
    }

    float total = subgroupAdd(reg_sq);
    float mean_square = total / float(row_length);
    float norm = inversesqrt(mean_square + eps);

    for (uint i = 0u; i < n_reads; ++i) {
      uint index = lane * n_reads + i;
      float weight =
          (params.lhs_size == 1u)
              ? LOAD_VALUE(weight_data.values[params.rhs_offset])
              : LOAD_VALUE(weight_data.values[params.rhs_offset + index]);
      float gate = reg_gate[i];
      float sigmoid_value = 1.0 / (1.0 + exp(-gate));
      precise float silu = gate * sigmoid_value;
      precise float norm_weight = norm * weight;
      precise float result = reg_x[i] * norm_weight;
      precise float prod = silu * result;
      output_data.values[params.output_offset + row * row_length + index] =
          STORE_VALUE(prod);
    }
  }
}
