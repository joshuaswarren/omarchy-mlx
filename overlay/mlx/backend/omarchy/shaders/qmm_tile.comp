#version 460

// m-tiled QuantizedMatmul for prefill (matrix_m > 1): out[m, n] = x @
// dequant(w) with w packed along the packed axis in the low bits first
// (affine bits 2/4/8, uint32 words) or as lane-atomic little-endian
// byte packs of 8/3, 8/5, or 4/3 bytes (affine bits 3/5/6), one affine
// scale and bias per group_size elements; with -DFP_MODE the fp modes
// instead (fp4 e2m1 / fp8 e4m3 element bytes, one scale byte per group,
// no bias). The per-element kernel (qmm.comp) unpacks the weight word
// and applies scale/bias INLINE PER MAC, so unpack work is m x n x k
// per matmul - at m=1023 that dominates prefill
// (receipts/2026-09-04-prefill-census.md lever 1). Here one
// workgroup owns an m-tile x 16-column n-tile of the output and
// dequantizes each 16 x 16 weight block ONCE into shared float before
// every row-thread consumes it, amortizing the unpack across the m-tile.
// Each output is one ascending-k f32 reduction. PRECISE_ACCUM uses explicit
// multiply/adds so drivers cannot contract the large-prefill fallback
// differently; the established kernel retains its fused expression.
// Shared tiles are float, not the storage dtype: the per-element kernel
// keeps scale*q+bias at f32 precision inside the dot, and rounding the
// dequantized weight to the storage dtype here would change results.
// Push-constant routing matches qmm.comp exactly (operation carries
// bits, reduce_size the group size, flags bit 0 the non-transposed
// layout; affine bindings 2/3 the separate scale/bias streams with
// aux_offset/aux_size their base items, FP_MODE binding 2 the
// scale-byte stream). matrix_k is always a multiple of
// group_size (16, 32, 64, or 128, checked in dispatch), hence of the
// 16-wide k-tile in the transposed layouts; only the non-transposed
// affine layouts can leave a partial k-tile, which bound-checks.

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

const uint TILE = 16u;
#ifdef REGISTER_BLOCK
const uint TILE_M = 32u;
const uint ROWS_PER_THREAD = 4u;
const uint W_ROWS_PER_THREAD = 2u;
layout(local_size_x = 16, local_size_y = 8) in;
#else
const uint TILE_M = 16u;
const uint ROWS_PER_THREAD = 1u;
const uint W_ROWS_PER_THREAD = 1u;
layout(local_size_x = 16, local_size_y = 16) in;
#endif

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  STORAGE_TYPE values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
#ifdef FP_MODE
// Scale bytes addressed through the word view; no bias term.
layout(set = 0, binding = 2, std430) readonly buffer ScaleBias {
  uint values[];
} scale_bias;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
#else
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  STORAGE_TYPE values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  STORAGE_TYPE values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
  // Lockstep tail of ComputeParams (mlx compute.h): a shader may
  // declare any prefix of the struct, so these appended fields keep
  // every existing SPIR-V interface byte-identical.
  uint q_rowstride;
  uint k_rowstride;
  uint v_rowstride;
  uint o_rowstride;
  uint q_headstride;
  uint k_headstride;
  uint v_headstride;
  uint q_batchstride;
  uint k_batchstride;
  uint v_batchstride;
  // Windowed-dispatch transport: out_row_stride is the full output row
  // width for windowed matmul-family dispatches (0 = use matrix_n);
  // window_lo is the global first row / element for row- or
  // index-windowed dispatches (0 = unwindowed); window_hi is Take's
  // exclusive row-window bound (0 = unwindowed).
  uint out_row_stride;
  uint window_lo;
  uint window_hi;
} params;

// Constant-shift select chain from scatter.comp: runtime word and lane,
// constant shift per lane.
uint byte_at(uint word, uint lane) {
  return (lane == 0u)
      ? (word & 0xFFu)
      : (lane == 1u)
      ? ((word >> 8u) & 0xFFu)
      : (lane == 2u)
      ? ((word >> 16u) & 0xFFu)
      : ((word >> 24u) & 0xFFu);
}

#ifdef FP_MODE
float fp8_decode(uint bits) {
  float magnitude = unpackHalf2x16((bits & 127u) << 7u).x * 256.0;
  return ((bits & 128u) != 0u) ? -magnitude : magnitude;
}

float e8m0_decode(uint bits) {
  return uintBitsToFloat(bits == 0u ? 0x400000u : bits << 23u);
}

// FP4 E2M1 decode via the fp16 bit trick from the Metal fp4_e2m1
// constructor: (bits & 7) << 9 reinterprets the exponent and mantissa
// as fp16 subnormals, the missing 2^14 lands in the scale factor.
float fp4_decode(uint code) {
  float magnitude = unpackHalf2x16((code & 7u) << 9u).x * 16384.0;
  return ((code & 8u) != 0u) ? -magnitude : magnitude;
}
#else
// Affine byte-pack decode: element e of a pack, upstream extract table
// (all constant shifts; e routes between constant expressions).
uint q3_at(uint e, uint c0, uint c1, uint c2) {
  if (e == 0u) return c0 & 0x7u;
  if (e == 1u) return (c0 >> 3) & 0x7u;
  if (e == 2u) return ((c0 >> 6) & 0x3u) + ((c1 & 0x1u) << 2);
  if (e == 3u) return (c1 >> 1) & 0x7u;
  if (e == 4u) return (c1 >> 4) & 0x7u;
  if (e == 5u) return ((c1 >> 7) & 0x1u) + ((c2 & 0x3u) << 1);
  if (e == 6u) return (c2 >> 2) & 0x7u;
  return (c2 >> 5) & 0x7u;
}

uint q5_at(uint e, uint c0, uint c1, uint c2, uint c3, uint c4) {
  if (e == 0u) return c0 & 0x1fu;
  if (e == 1u) return ((c0 >> 5) & 0x7u) + ((c1 & 0x3u) << 3);
  if (e == 2u) return (c1 >> 2) & 0x1fu;
  if (e == 3u) return ((c1 >> 7) & 0x1u) + ((c2 & 0xfu) << 1);
  if (e == 4u) return ((c2 >> 4) & 0xfu) + ((c3 & 0x1u) << 4);
  if (e == 5u) return (c3 >> 1) & 0x1fu;
  if (e == 6u) return ((c3 >> 6) & 0x3u) + ((c4 & 0x7u) << 2);
  return (c4 >> 3) & 0x1fu;
}

uint q6_at(uint e, uint c0, uint c1, uint c2) {
  if (e == 0u) return c0 & 0x3fu;
  if (e == 1u) return ((c0 >> 6) & 0x3u) + ((c1 & 0xfu) << 2);
  if (e == 2u) return ((c1 >> 4) & 0xfu) + ((c2 & 0x3u) << 4);
  return (c2 >> 2) & 0x3fu;
}
#endif

shared float tile_x[TILE_M][16];
shared float tile_w[16][16];

// Weight layout routing mirrors qmm.comp: flags bit 0 set means
// non-transposed weights ([batch, Kp, N], scales [batch, K/group_size,
// N]); shape[0] carries the batch count B and the tile loops run once
// per batch slice with per-slice x/w/scale bases. Only strides differ
// between the layouts, selected as uniform values before the loops.
// FP_MODE dispatches a flat 2D w shared across the flattened x rows
// (batch = 1), both layouts first-class via the same flag.
void main() {
  uint lx = gl_LocalInvocationID.x;
  uint ly = gl_LocalInvocationID.y;
  uint bits = params.operation;
  uint group_size = params.reduce_size;
  bool non_transposed = (params.flags & 1u) != 0u;
#ifdef FP_MODE
  uint batch = 1u;
  uint fp_pack_factor = (bits == 8u) ? 1u : 2u;
#else
  uint batch = params.shape[0];
#endif
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
  uint m_tiles = params.matrix_m / TILE_M +
      uint(params.matrix_m % TILE_M != 0u);
  uint n_tiles = params.matrix_n / TILE +
      uint(params.matrix_n % TILE != 0u);
  // Transposed: groups run along K, so K is a multiple of group_size
  // (16/32/64/128) and of the 16-wide k-tile: no k tail. Non-transposed:
  // groups run along N and K only needs pack alignment, so the final
  // k-tile can be partial and must bound-check.
  uint k_tiles = params.matrix_k / TILE +
      uint(non_transposed && (params.matrix_k % TILE != 0u));
  // Grid-stride over both tile axes keeps the kernel correct under any
  // dispatch clamping, the same contract matmul.comp uses.
  for (uint b = 0u; b < batch; ++b) {
  for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
       tile_row += gl_NumWorkGroups.y) {
    for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
         tile_col += gl_NumWorkGroups.x) {
      uint column = tile_col * TILE + lx;
      // Non-transposed: w batch slice [K, Np], groups along N, scale
      // [k][n / gs], fixed lane per thread. Transposed: [N, Kp],
      // groups along K, scale [n][k / gs].
      uint w_slice = params.rhs_offset + b * w_batch_words;
      uint p_slice = params.aux_offset + b * param_batch;
      float accumulators[ROWS_PER_THREAD];
      for (uint row_part = 0u; row_part < ROWS_PER_THREAD; ++row_part) {
        accumulators[row_part] = 0.0;
      }
      for (uint tile = 0u; tile < k_tiles; ++tile) {
        uint k_base = tile * TILE;
        uint x_k = k_base + lx;
        for (uint row_part = 0u; row_part < ROWS_PER_THREAD; ++row_part) {
          uint local_row = ly * ROWS_PER_THREAD + row_part;
          uint row = tile_row * TILE_M + local_row;
          tile_x[local_row][lx] =
              row < params.matrix_m && x_k < params.matrix_k
              ? LOAD_VALUE(input_x.values[params.lhs_offset +
                    b * x_batch_rows + row * params.matrix_k + x_k])
              : 0.0;
        }
#ifdef REGISTER_BLOCK
        if (ly < 2u) {
          uint local_k = ly * 8u;
          uint k = k_base + local_k;
          uint words_per_row = params.matrix_k / 8u;
          uint groups_per_row = params.matrix_k / 64u;
          uint packed = 0u;
          float scale = 0.0;
          float bias = 0.0;
          if (column < params.matrix_n) {
            packed = input_w.values[
                w_slice + column * words_per_row + k / 8u];
            scale = LOAD_VALUE(scales.values[
                p_slice + column * groups_per_row + k / 64u]);
            bias = LOAD_VALUE(biases.values[
                params.aux_size + b * param_batch +
                column * groups_per_row + k / 64u]);
          }
          tile_w[local_k + 0u][lx] = scale * float(packed & 0xFu) + bias;
          tile_w[local_k + 1u][lx] =
              scale * float((packed >> 4u) & 0xFu) + bias;
          tile_w[local_k + 2u][lx] =
              scale * float((packed >> 8u) & 0xFu) + bias;
          tile_w[local_k + 3u][lx] =
              scale * float((packed >> 12u) & 0xFu) + bias;
          tile_w[local_k + 4u][lx] =
              scale * float((packed >> 16u) & 0xFu) + bias;
          tile_w[local_k + 5u][lx] =
              scale * float((packed >> 20u) & 0xFu) + bias;
          tile_w[local_k + 6u][lx] =
              scale * float((packed >> 24u) & 0xFu) + bias;
          tile_w[local_k + 7u][lx] = scale * float(packed >> 28u) + bias;
        }
#else
        for (uint w_part = 0u; w_part < W_ROWS_PER_THREAD; ++w_part) {
          uint local_k = ly + w_part * gl_WorkGroupSize.y;
          uint k = k_base + local_k;
          float dequant = 0.0;
          if (column < params.matrix_n &&
              (!non_transposed || k < params.matrix_k)) {
#ifdef FP_MODE
          if (non_transposed) {
            // FP_MODE non-transposed: w [K, Np] fp bytes packed along
            // N, scale bytes [k][column / group_size].
            uint n_bytes_per_row = params.matrix_n * bits / 8u;
            uint scale_addr = p_slice +
                k * (params.matrix_n / group_size) +
                column / group_size;
            uint scale_byte = byte_at(
                scale_bias.values[scale_addr >> 2u], scale_addr & 3u);
            float scale = (group_size == 16u) ? fp8_decode(scale_byte)
                                              : e8m0_decode(scale_byte);
            uint byte_addr = w_slice * 4u +
                k * n_bytes_per_row + column / fp_pack_factor;
            uint packed_byte = byte_at(
                input_w.values[byte_addr >> 2u], byte_addr & 3u);
            uint code = (bits == 8u)
                ? packed_byte
                : (((column & 1u) == 0u) ? (packed_byte & 0xFu)
                                         : (packed_byte >> 4u));
            float value =
                (bits == 8u) ? fp8_decode(code) : fp4_decode(code);
            dequant = scale * value;
          } else {
            // FP_MODE transposed: w [N, Kp], scale bytes
            // [column][k / group_size].
            uint groups_per_row = params.matrix_k / group_size;
            uint scale_addr = p_slice +
                column * groups_per_row + k / group_size;
            uint scale_byte = byte_at(
                scale_bias.values[scale_addr >> 2u], scale_addr & 3u);
            float scale = (group_size == 16u) ? fp8_decode(scale_byte)
                                              : e8m0_decode(scale_byte);
            uint byte_addr = (w_slice + column * (params.matrix_k *
                                   bits / 32u)) *
                    4u +
                k / fp_pack_factor;
            uint packed_byte = byte_at(
                input_w.values[byte_addr >> 2u], byte_addr & 3u);
            uint code = (bits == 8u)
                ? packed_byte
                : (((k & 1u) == 0u) ? (packed_byte & 0xFu)
                                    : (packed_byte >> 4u));
            float value =
                (bits == 8u) ? fp8_decode(code) : fp4_decode(code);
            dequant = scale * value;
          }
#else
          bool is_byte_bits =
              (bits == 3u || bits == 5u || bits == 6u);
          uint pack_factor = is_byte_bits
              ? (bits == 6u ? 4u : 8u)
              : (32u / bits);
          uint bytes_per_pack =
              is_byte_bits ? (bits == 5u ? 5u : 3u) : 1u;
          uint value_mask = (1u << bits) - 1u;
          uint words_per_row = params.matrix_k * bits / 32u;
          uint groups_per_row = params.matrix_k / group_size;
          uint scale_base = p_slice +
              (non_transposed ? column / group_size
                              : column * groups_per_row);
          uint bias_base = params.aux_size + b * param_batch +
              (non_transposed ? column / group_size
                              : column * groups_per_row);
          float scale;
          float bias;
          uint q;
          if (non_transposed) {
            uint n_bytes_per_row = params.matrix_n * bits / 8u;
            uint group_bytes =
                (group_size / pack_factor) * bytes_per_pack;
            scale = LOAD_VALUE(scales.values[
                scale_base + k * (params.matrix_n / group_size)]);
            bias = LOAD_VALUE(biases.values[
                bias_base + k * (params.matrix_n / group_size)]);
            if (is_byte_bits) {
              uint byte_addr = w_slice * 4u + k * n_bytes_per_row +
                  (column / group_size) * group_bytes +
                  ((column % group_size) / pack_factor) *
                      bytes_per_pack;
              uint c0 = byte_at(
                  input_w.values[byte_addr >> 2u], byte_addr & 3u);
              uint c1 = byte_at(
                  input_w.values[(byte_addr + 1u) >> 2u],
                  (byte_addr + 1u) & 3u);
              uint c2 = byte_at(
                  input_w.values[(byte_addr + 2u) >> 2u],
                  (byte_addr + 2u) & 3u);
              uint e = column % pack_factor;
              q = (bits == 3u)
                  ? q3_at(e, c0, c1, c2)
                  : (bits == 5u)
                  ? q5_at(e, c0, c1, c2, byte_at(
                        input_w.values[(byte_addr + 3u) >> 2u],
                        (byte_addr + 3u) & 3u), byte_at(
                        input_w.values[(byte_addr + 4u) >> 2u],
                        (byte_addr + 4u) & 3u))
                  : q6_at(e, c0, c1, c2);
            } else {
              uint word = input_w.values[
                  w_slice + k * (params.matrix_n * bits / 32u) +
                  column / pack_factor];
              q = (word >> ((column % pack_factor) * bits)) &
                  value_mask;
            }
          } else {
            scale = LOAD_VALUE(scales.values[
                scale_base + k / group_size]);
            bias = LOAD_VALUE(biases.values[
                bias_base + k / group_size]);
            if (is_byte_bits) {
              uint byte_addr = (w_slice + column * words_per_row) *
                      4u +
                  (k / pack_factor) * bytes_per_pack;
              uint c0 = byte_at(
                  input_w.values[byte_addr >> 2u], byte_addr & 3u);
              uint c1 = byte_at(
                  input_w.values[(byte_addr + 1u) >> 2u],
                  (byte_addr + 1u) & 3u);
              uint c2 = byte_at(
                  input_w.values[(byte_addr + 2u) >> 2u],
                  (byte_addr + 2u) & 3u);
              uint e = k % pack_factor;
              q = (bits == 3u)
                  ? q3_at(e, c0, c1, c2)
                  : (bits == 5u)
                  ? q5_at(e, c0, c1, c2, byte_at(
                        input_w.values[(byte_addr + 3u) >> 2u],
                        (byte_addr + 3u) & 3u), byte_at(
                        input_w.values[(byte_addr + 4u) >> 2u],
                        (byte_addr + 4u) & 3u))
                  : q6_at(e, c0, c1, c2);
            } else {
              uint word = input_w.values[
                  w_slice + column * words_per_row + k / pack_factor];
              q = (word >> ((k % pack_factor) * bits)) & value_mask;
            }
          }
          dequant = scale * float(q) + bias;
#endif
          }
          tile_w[local_k][lx] = dequant;
        }
#endif
        barrier();

        for (uint index = 0u; index < TILE; ++index) {
          float weight = tile_w[index][lx];
          for (uint row_part = 0u; row_part < ROWS_PER_THREAD; ++row_part) {
            uint local_row = ly * ROWS_PER_THREAD + row_part;
#ifdef PRECISE_ACCUM
            precise float product = tile_x[local_row][index] * weight;
            accumulators[row_part] += product;
#else
            accumulators[row_part] += tile_x[local_row][index] * weight;
#endif
          }
        }
        barrier();
      }
      for (uint row_part = 0u; row_part < ROWS_PER_THREAD; ++row_part) {
        uint row = tile_row * TILE_M + ly * ROWS_PER_THREAD + row_part;
        if (row < params.matrix_m && column < params.matrix_n) {
          output_data.values[params.output_offset +
              b * params.matrix_m * params.matrix_n +
              row * params.matrix_n + column] =
              STORE_VALUE(accumulators[row_part]);
        }
      }
    }
  }
  }
}
