//
// Fused causal-prefill scaled-dot-product attention for head_dim=256, GQA,
// bf16 storage — v3 LAYOUT.
//
// v1 (2026-10-04): 2 rows/lane with full D_v=256 accumulators = 512
// live f32 registers -> spill -> 3646 ms at the (1,8,2,1024,4096,256)
// M2 probe (239x composed). v2 (2026-10-05): D_v-split lanes (128
// accumulators, no spill) but EVERY lane recomputed the softmax stats
// and every lane exponentiated the whole score tile for the PV
// weights — 32x redundant exp; 1169-1172 ms (76x composed).
//
// v3: the softmax stats and the PV weights are computed ONCE by the 16
// row-owner lanes into shared memory; the PV fold is a pure
// shared-read fma against the D_v-split accumulators.
//   - Stats + weights (lanes r < Q_TILE, one row each):
//       m_new = max(m_old, max_c s_p[r][c])
//       s_w[r][c] = exp(s_p[r][c] - m_new)      (masked = +0.0 exact)
//       rescale  = m_old > -inf ? exp(m_old - m_new) : 0.0
//       l_new = rescale * l_old + sum_c s_w[r][c]
//     written to s_m/s_l/s_rescale/s_w; 16 x (32 + 2) exps per tile.
//   - Accumulator rescale: every lane folds s_rescale[r] into its
//     owned accumulators (128 f32 registers, no spill).
//   - PV: lane l owns D_v columns [8l, 8l+8) for all rows; per tile
//     16 rows x 32 keys x 8 cols = 4K shared-read fma. The warp's
//     32 x 8 uint16 = one contiguous 512-byte segment per key row.
// Shared footprint: Q 8 KiB + K/V 16 KiB + scores 2 KiB + weights
// 2 KiB + stats 208 B ~= 28.2 KiB, inside the 32 KiB device limit.
//
// Numerics contract unchanged (per-element arithmetic order within a
// row's score chain and within a column's accumulation chain is
// identical to v1/v2; only WHO computes the shared stats changed, and
// the values are identical by construction): bf16 RNE stores, f32
// accumulation, alpha once per score, FINITE_MIN masking. Dispatch
// gate, kill switch, stride layout and push-constant contract
// identical to v1/v2.

#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#ifndef SDPA_DIM
#define SDPA_DIM 256u
#endif
const uint Q_TILE = 16u;
const uint K_TILE = 32u;
const uint SIMD = 32u;
// D_v columns per lane: SDPA_DIM / SIMD = 8 columns... with 32 lanes
// and 256 columns that is 8; 16 rows x 8 cols = 128 accumulator
// registers per lane — still over budget. 4 columns per lane needs 64
// lanes for 256 columns; with 32 lanes the split is 8 columns and the
// accumulator count is 16 x 8 = 128 f32. The register budget supports
// 128 accumulators plus ~40 working registers on G13/G14 (255 limit),
// so Q_TILE=16 with an 8-column split is the configuration this file
// ships. (Q_TILE=32 would double the accumulators to 256 and spill.)
const uint COLS_PER_LANE = SDPA_DIM / SIMD;  // 8

layout(set = 0, binding = 0, std430) readonly buffer Query {
  uint16_t values[];
} query_data;
layout(set = 0, binding = 1, std430) readonly buffer Key {
  uint16_t values[];
} key_data;
layout(set = 0, binding = 2, std430) readonly buffer Value {
  uint16_t values[];
} value_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

const float FINITE_MIN = -3.4028234663852886e38;

float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16u);
}

shared uint16_t s_q[Q_TILE * SDPA_DIM];
shared uint16_t s_kv[K_TILE * SDPA_DIM];
shared float s_p[Q_TILE * K_TILE];
shared float s_w[Q_TILE * K_TILE];
shared float s_m[Q_TILE];
shared float s_l[Q_TILE];
shared float s_rescale[Q_TILE];

void main() {
  const uint lane = gl_LocalInvocationID.x;
  const uint group_q = gl_WorkGroupID.x;
  const uint head_bh = gl_WorkGroupID.y;

  const uint q_rows_total = params.matrix_m;
  const uint k_total = params.matrix_k;
  const uint q_start = group_q * Q_TILE;
  if (q_start >= q_rows_total) {
    return;
  }
  const uint q_count = min(Q_TILE, q_rows_total - q_start);

  const uint q_b = head_bh / params.matrix_n;
  const uint q_h = head_bh - q_b * params.matrix_n;
  const uint repeats = max(1u, params.shape[0]);
  const uint kv_h_idx = q_h / repeats;

  // Stage Q (bf16, reused every tile).
  for (uint i = lane; i < Q_TILE * SDPA_DIM; i += SIMD) {
    const uint r = i / SDPA_DIM;
    const uint d = i - r * SDPA_DIM;
    if (r < q_count) {
      const uint q_token = q_start + r;
      const uint q_off = params.lhs_offset +
          q_b * params.in_strides[0] +
          q_h * params.shape[1] +
          q_token * params.in_strides[1] +
          d * params.in_strides[3];
      s_q[i] = query_data.values[q_off];
    } else {
      s_q[i] = uint16_t(0u);
    }
  }
  barrier();

  // Per-lane output accumulators: lane l owns D_v columns
  // [COLS_PER_LANE*l, COLS_PER_LANE*(l+1)) for every row — 16 x 8 =
  // 128 f32 registers, inside the allocation budget.
  float acc[Q_TILE * COLS_PER_LANE];
  for (uint i = 0; i < Q_TILE * COLS_PER_LANE; ++i) {
    acc[i] = 0.0;
  }

  int causal_off = int(params.shape[3]);

  // Shared stats init (row-owner lanes).
  if (lane < Q_TILE) {
    s_m[lane] = FINITE_MIN;
    s_l[lane] = 0.0;
    s_rescale[lane] = 0.0;
  }
  barrier();

  for (uint k0 = 0; k0 < k_total; k0 += K_TILE) {
    const uint k_count = min(K_TILE, k_total - k0);

    // Stage K (bf16).
    for (uint i = lane; i < K_TILE * SDPA_DIM; i += SIMD) {
      const uint r = i / SDPA_DIM;
      const uint d = i - r * SDPA_DIM;
      if (r < k_count) {
        const uint k_row = k0 + r;
        const uint k_off = params.rhs_offset +
            q_b * params.in_strides[0] +
            kv_h_idx * params.shape[2] +
            k_row * params.in_strides[2] +
            d * params.in_strides[3];
        s_kv[i] = key_data.values[k_off];
      } else {
        s_kv[i] = uint16_t(0u);
      }
    }
    barrier();

    // QK^T, key-split: lane c computes the scores of key column c for
    // all Q_TILE rows (4K fma per lane, balanced with PV).
    if (lane < k_count) {
      const uint c = lane;
      const int k_idx = int(k0) + int(c);
      for (uint r = 0; r < q_count; ++r) {
        const int admissible = int(q_start + r) + causal_off;
        if (k_idx > admissible) {
          s_p[r * K_TILE + c] = FINITE_MIN;
          continue;
        }
        float accv = 0.0;
        for (uint d = 0; d < SDPA_DIM; d += 8u) {
          accv = fma(bf16_load(s_q[r * SDPA_DIM + d + 0u]),
              bf16_load(s_kv[c * SDPA_DIM + d + 0u]), accv);
          accv = fma(bf16_load(s_q[r * SDPA_DIM + d + 1u]),
              bf16_load(s_kv[c * SDPA_DIM + d + 1u]), accv);
          accv = fma(bf16_load(s_q[r * SDPA_DIM + d + 2u]),
              bf16_load(s_kv[c * SDPA_DIM + d + 2u]), accv);
          accv = fma(bf16_load(s_q[r * SDPA_DIM + d + 3u]),
              bf16_load(s_kv[c * SDPA_DIM + d + 3u]), accv);
          accv = fma(bf16_load(s_q[r * SDPA_DIM + d + 4u]),
              bf16_load(s_kv[c * SDPA_DIM + d + 4u]), accv);
          accv = fma(bf16_load(s_q[r * SDPA_DIM + d + 5u]),
              bf16_load(s_kv[c * SDPA_DIM + d + 5u]), accv);
          accv = fma(bf16_load(s_q[r * SDPA_DIM + d + 6u]),
              bf16_load(s_kv[c * SDPA_DIM + d + 6u]), accv);
          accv = fma(bf16_load(s_q[r * SDPA_DIM + d + 7u]),
              bf16_load(s_kv[c * SDPA_DIM + d + 7u]), accv);
        }
        s_p[r * K_TILE + c] = accv * params.alpha;
      }
    }
    barrier();

    // Stats + weights, ONCE per row (row-owner lanes; 16 x (32 + 2)
    // exps per tile — v2's 32x-redundant per-lane exp is gone).
    if (lane < q_count) {
      const uint r = lane;
      float tile_max = FINITE_MIN;
      for (uint c = 0; c < k_count; ++c) {
        float v = s_p[r * K_TILE + c];
        if (v > tile_max) {
          tile_max = v;
        }
      }
      const float new_max = max(s_m[r], tile_max);
      const float rescale =
          (s_m[r] > FINITE_MIN) ? exp(s_m[r] - new_max) : 0.0;
      float tile_sum = 0.0;
      for (uint c = 0; c < k_count; ++c) {
        float w = exp(s_p[r * K_TILE + c] - new_max);
        s_w[r * K_TILE + c] = w;
        tile_sum += w;
      }
      s_rescale[r] = rescale;
      s_l[r] = rescale * s_l[r] + tile_sum;
      s_m[r] = new_max;
    }
    barrier();

    // Accumulator rescale from the shared factor.
    for (uint r = 0; r < q_count; ++r) {
      const float rs = s_rescale[r];
      for (uint j = 0; j < COLS_PER_LANE; ++j) {
        acc[r * COLS_PER_LANE + j] = rs * acc[r * COLS_PER_LANE + j];
      }
    }
    barrier();

    // Stage V into the same shared block (K consumed).
    for (uint i = lane; i < K_TILE * SDPA_DIM; i += SIMD) {
      const uint r = i / SDPA_DIM;
      const uint d = i - r * SDPA_DIM;
      if (r < k_count) {
        const uint v_row = k0 + r;
        const uint v_off = params.aux_offset +
            q_b * params.in_strides[0] +
            kv_h_idx * params.shape[2] +
            v_row * params.in_strides[2] +
            d * params.in_strides[3];
        s_kv[i] = value_data.values[v_off];
      } else {
        s_kv[i] = uint16_t(0u);
      }
    }
    barrier();

    // PV fold, D_v-split: pure shared-read fma (weights precomputed).
    for (uint r = 0; r < q_count; ++r) {
      const uint col0 = COLS_PER_LANE * lane;
      for (uint c = 0; c < k_count; ++c) {
        float w = s_w[r * K_TILE + c];
        if (w == 0.0) {
          continue;
        }
        for (uint j = 0; j < COLS_PER_LANE; ++j) {
          acc[r * COLS_PER_LANE + j] =
              fma(w, bf16_load(s_kv[c * SDPA_DIM + col0 + j]),
                  acc[r * COLS_PER_LANE + j]);
        }
      }
    }
    barrier();
  }

  // Normalize and store: lane l writes its own D_v slice of every row,
  // contiguous 8-uint16 segments per (row, lane) — coalesced per row
  // across the warp.
  for (uint r = 0; r < q_count; ++r) {
    const float inv_sum = 1.0 / s_l[r];
    const uint q_token = q_start + r;
    const uint col0 = COLS_PER_LANE * lane;
    for (uint j = 0; j < COLS_PER_LANE; ++j) {
      const uint d = col0 + j;
      const uint out_off = params.output_offset +
          q_b * params.out_strides[0] +
          q_h * params.out_strides[1] +
          q_token * params.out_strides[2] +
          d * params.out_strides[3];
      output_data.values[out_off] =
          bf16_store(acc[r * COLS_PER_LANE + j] * inv_sum);
    }
  }
}
