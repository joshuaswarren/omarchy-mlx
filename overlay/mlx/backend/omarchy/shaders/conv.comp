#version 460

// Direct convolution for channels-last arrays. One thread owns an
// output element out[n, d?, h?, w, o] or one bounded chunk of its kernel
// window. Large windows reduce float32 partials in a second dispatch;
// every input load remains a straight-line per-thread read at a linear
// address (Honeykrisp caution: no divergent per-lane word loads).
// Out-of-range coordinates contribute zero via index guards, so padding
// needs no materialized buffer.
//
// The kernel is the general upstream Convolution semantics over 1-D,
// 2-D, and 3-D spatial ranks: groups (each output channel reads its
// group's channel slice and weight last axis), the kernel flip
// conv_transpose uses, input dilation (taps off the dilated grid
// contribute zero), kernel dilation, strides, and asymmetric padding.
//
// Push-constant routing (the fixed ComputeParams layout has no conv
// block, so the conv parameters ride the generic dims fields). Axes
// are packed outermost-first (depth, height, width) and absent axes
// read back as extent one with unit parameters:
//   dims               spatial rank (1, 2, or 3)
//   flags & 1          kernel flip (the transposed path)
//   flags & 2          write convolution partials
//   flags & 4          reduce a partial level
//   flags & 8          store the final partial level to output
//   matrix_m           innermost output extent (partial reduction: tile count)
//   matrix_n           output channels        rhs_gap   group count
//   reduce_size        channels per group
//   lhs_offset         input element offset   rhs_offset weight element
//   output_offset      output element offset
//   lhs_size           input dilation axis 0  (partial reduction: source count)
//   rhs_size           input dilation axis 1  (partial reduction: source offset)
//   alpha bits         input dilation axis 2
//   beta               products per partial   (large kernels)
//   output_size        input depth            (3-D; reduction dst offset)
//   matrix_k           input height           (2-D and 3-D)
//   aux_size           input width
//   lhs_gap            kernel depth           (3-D)
//   aux_offset         kernel height          (2-D and 3-D)
//   operation          kernel width
//   shape[0..dims-2]   output extents above the innermost axis
//   in_strides[0..2]   kernel stride per axis
//   in_strides[3]      output tile base       (large kernels, split dispatches; 0 otherwise)
//   out_strides[0..2]  low padding per axis
//   shape[2]           kernel dilation, depth (3-D)
//   shape[3]           kernel dilation, above-innermost axis
//   out_strides[3]     kernel dilation, innermost axis
#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  STORAGE_TYPE values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer Weight {
  STORAGE_TYPE values[];
} weight;
layout(set = 0, binding = 2, std430) buffer Partials {
  float values[];
} partial_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
} params;
// Per-axis accessors: axis 0 is the outermost spatial axis (depth in
// 3-D, height in 2-D, width in 1-D) and axis dims-1 the innermost.
// Absent axes read as extent one, stride one, zero padding, and unit
// dilation. The innermost output extent is derived from count because
// the fixed layout stores only the axes above it.

uint in_axis(uint a) {
  if (a + 1u == params.dims) {
    return params.aux_size;
  }
  if (a + 2u == params.dims) {
    return params.matrix_k;
  }
  if (a == 0u && params.dims == 3u) {
    return params.output_size;
  }
  return 1u;
}

uint kern_axis(uint a) {
  if (a + 1u == params.dims) {
    return params.operation;
  }
  if (a + 2u == params.dims) {
    return params.aux_offset;
  }
  if (a == 0u && params.dims == 3u) {
    return params.lhs_gap;
  }
  return 1u;
}

uint out_axis(uint a) {
  if (a + 1u == params.dims) {
    return params.matrix_m;
  }
  if (a >= params.dims) {
    return 1u;
  }
  return params.shape[a];
}
uint stride_axis(uint a) {
  return a < params.dims ? params.in_strides[a] : 1u;
}

uint pad_lo_axis(uint a) {
  return a < params.dims ? params.out_strides[a] : 0u;
}

uint kdil_axis(uint a) {
  if (a + 1u == params.dims) {
    return params.out_strides[3u];
  }
  if (a + 2u == params.dims) {
    return params.shape[3u];
  }
  if (a == 0u && params.dims == 3u) {
    return params.shape[2u];
  }
  return 1u;
}

uint idil_axis(uint a) {
  if (a >= params.dims) {
    return 1u;
  }
  if (a == 0u) {
    return params.lhs_size;
  }
  if (a == 1u) {
    return params.rhs_size;
  }
  return floatBitsToUint(params.alpha);
}

void main() {
  const bool write_partial = (params.flags & 2u) != 0u;
  const bool reduce_partials = (params.flags & 4u) != 0u;
  uint stride_threads = gl_NumWorkGroups.x * 256u;

  if (reduce_partials) {
    uint source_chunks = params.lhs_size;
    uint tile_count = params.matrix_m;
    uint chunk_terms = uint(params.beta);
    bool store_output = (params.flags & 8u) != 0u;
    for (uint work_index = gl_GlobalInvocationID.x;
         work_index < params.count;
         work_index += stride_threads) {
      uint group = work_index / tile_count;
      uint local_index = work_index % tile_count;
      uint source_begin = group * chunk_terms;
      uint source_end = source_begin +
          min(chunk_terms, source_chunks - source_begin);
      float accumulator = 0.0;
      for (uint source_chunk = source_begin;
           source_chunk < source_end;
           ++source_chunk) {
        accumulator += partial_data.values[
            params.rhs_size + source_chunk * tile_count + local_index];
      }
      if (store_output) {
        uint output_index = params.in_strides[3u] + local_index;
        output_data.values[params.output_offset + output_index] =
            STORE_VALUE(accumulator);
      } else {
        partial_data.values[params.output_size + work_index] = accumulator;
      }
    }
    return;
  }

  uint out_channels = params.matrix_n;
  uint in_channels_per_group = params.reduce_size;
  uint groups = params.rhs_gap;
  uint in_channels = in_channels_per_group * groups;
  uint out_channels_per_group = out_channels / groups;
  uint flip = params.flags & 1u;

  uint in_ext[3];
  uint kern_ext[3];
  uint out_ext[3];
  uint stride[3];
  uint pad_lo[3];
  uint kdil[3];
  uint idil[3];
  for (uint a = 0u; a < 3u; ++a) {
    in_ext[a] = in_axis(a);
    kern_ext[a] = kern_axis(a);
    out_ext[a] = out_axis(a);
    stride[a] = stride_axis(a);
    pad_lo[a] = pad_lo_axis(a);
    kdil[a] = kdil_axis(a);
    idil[a] = idil_axis(a);
  }
  uint in_ext_dilated[3];
  uint total_out_spatial = 1u;
  for (uint a = 0u; a < 3u; ++a) {
    in_ext_dilated[a] = in_ext[a] == 0u
        ? 0u
        : 1u + (in_ext[a] - 1u) * idil[a];
    total_out_spatial *= out_ext[a];
  }
  uint kernel_spatial = kern_ext[0u] * kern_ext[1u] * kern_ext[2u];
  uint kernel_products = kernel_spatial * in_channels_per_group;
  const uint max_chunk_products = 4096u;
  uint chunks = kernel_products == 0u
      ? 1u
      : 1u + (kernel_products - 1u) / max_chunk_products;
  uint tile_count = write_partial ? params.count / chunks : params.count;
  uint chunk_products = write_partial ? max_chunk_products : kernel_products;

  for (uint work_index = gl_GlobalInvocationID.x; work_index < params.count;
       work_index += stride_threads) {
    uint chunk = write_partial ? work_index / tile_count : 0u;
    uint local_index = write_partial ? work_index % tile_count : work_index;
    uint index = params.in_strides[3u] + local_index;
    uint batch = index / (total_out_spatial * out_channels);
    uint remainder = index % (total_out_spatial * out_channels);
    uint out_channel = remainder % out_channels;
    uint spatial = remainder / out_channels;
    uint coord[3];
    for (uint a = 3u; a-- > 0u;) {
      coord[a] = spatial % out_ext[a];
      spatial /= out_ext[a];
    }
    uint group = out_channel / out_channels_per_group;
    float accumulator = 0.0;
    uint product_begin = chunk * chunk_products;
    uint product_end = product_begin +
        min(chunk_products, kernel_products - product_begin);

    for (uint flat_product = product_begin;
         flat_product < product_end;
         ++flat_product) {
      uint channel = flat_product % in_channels_per_group;
      uint remaining_tap = flat_product / in_channels_per_group;
      uint k2 = remaining_tap % kern_ext[2u];
      remaining_tap /= kern_ext[2u];
      uint k1 = remaining_tap % kern_ext[1u];
      uint k0 = remaining_tap / kern_ext[1u];
      uint k0_window = flip != 0u ? (kern_ext[0u] - 1u - k0) : k0;
      uint k1_window = flip != 0u ? (kern_ext[1u] - 1u - k1) : k1;
      uint k2_window = flip != 0u ? (kern_ext[2u] - 1u - k2) : k2;
      int in_0 = int(coord[0u] * stride[0u]) - int(pad_lo[0u]) +
          int(k0_window * kdil[0u]);
      int in_1 = int(coord[1u] * stride[1u]) - int(pad_lo[1u]) +
          int(k1_window * kdil[1u]);
      int in_2 = int(coord[2u] * stride[2u]) - int(pad_lo[2u]) +
          int(k2_window * kdil[2u]);
      if (in_0 < 0 || in_0 >= int(in_ext_dilated[0u]) ||
          in_0 % int(idil[0u]) != 0 || in_1 < 0 ||
          in_1 >= int(in_ext_dilated[1u]) ||
          in_1 % int(idil[1u]) != 0 || in_2 < 0 ||
          in_2 >= int(in_ext_dilated[2u]) ||
          in_2 % int(idil[2u]) != 0) {
        continue;
      }
      uint tap_0 = uint(in_0) / idil[0u];
      uint tap_1 = uint(in_1) / idil[1u];
      uint tap_2 = uint(in_2) / idil[2u];
      uint input_base = params.lhs_offset +
          (((batch * in_ext[0u] + tap_0) * in_ext[1u] + tap_1) *
                    in_ext[2u] +
                tap_2) *
              in_channels +
          group * in_channels_per_group;
      uint weight_index = params.rhs_offset +
          out_channel * kernel_products + flat_product;
      accumulator += LOAD_VALUE(input_x.values[input_base + channel]) *
          LOAD_VALUE(weight.values[weight_index]);
    }
    if (write_partial) {
      partial_data.values[work_index] = accumulator;
    } else {
      output_data.values[params.output_offset + index] =
          STORE_VALUE(accumulator);
    }
  }
}
