//
// General-length FFT stage kernels: one thread per element, selected by the
// mode carried in push-constant reduce_size.
//
//   0 twiddle multiply     Cooley-Tukey factor stage: element j of its
//                          n-point transform gains w_n^(m0*T), j = m0*M + T.
//   1 Bluestein a-build    a[j] = x[j]*w[j] for j < n, zero-padded to the
//                          convolution length L. Reads the pipeline input in
//                          all three source modes (real promoted, half
//                          spectrum synthesized, plain complex).
//   2 Bluestein b-build    b[k] = conj-direction chirp for k in [0,n), folded
//                          to L-k, one at k = 0, zero between.
//   3 pointwise multiply   c = a * b, with c aliasing b (per-element
//                          read-then-write, safe).
//   4 Bluestein epilogue   y[j] = conv[j]*w[j], scaled by L/n on the inverse
//                          direction (the inner passes already contributed
//                          the 1/L factor or its absence), packed or strided
//                          store.
//
// Push-constant map: lhs_size = axis length n, rhs_size = axis sample stride,
// reduce_size = mode, output_size = M (twiddle) or L (Bluestein), count =
// elements this dispatch covers, operation bit 0 = inverse (positive-angle)
// direction, bits 1..3 reuse the fft_c2c pass-flag semantics on the
// Bluestein edges.
//
// Phase products stay exactly representable: twiddle m0*T < n <= 2^24 and
// Bluestein k^2 < 2^32 under the 32768 length bound, so both reduce exactly
// in u32 before the float conversion.

#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InComplex {
  vec2 values[];
} fft_in_complex;
// Read-only alias of the same binding for the promoted float32 input.
layout(set = 0, binding = 0, std430) readonly buffer InReal {
  float values[];
} fft_in_real;
// Read-write: modes 0/1/2/4 only store, mode 3 multiplies in place.
layout(set = 0, binding = 2, std430) buffer OutComplex {
  vec2 values[];
} fft_out_complex;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

vec2 cmul(vec2 a, vec2 b) {
  return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

// e^(+-i pi (k^2 mod 2n) / n), the Bluestein chirp (sign from inverse). k < 65536
// under the length bound, so k*k reduces exactly in u32.
// e^(+i 2 pi num/den) for 0 <= num < den, exact at every multiple of a
// quarter turn: the quadrant is split off in integer arithmetic and the
// residual angle is folded into [0, pi/4] before sin/cos, so cos(pi/2)
// is exactly 0 and the radix-2/4 butterflies match an exact reference.
// den < 2^30 keeps 4*num inside u32.
vec2 unit_twiddle(uint num, uint den) {
  uint quadrant = (4u * num) / den;
  uint rem = (4u * num) - quadrant * den;
  bool fold = (2u * rem) > den;
  uint r = fold ? den - rem : rem;
  float theta = 1.5707963267948966 * float(r) / float(den);
  float c = cos(theta);
  float s = sin(theta);
  if (fold) {
    float t = c;
    c = s;
    s = t;
  }
  if (quadrant == 1u) {
    return vec2(0.0 - s, c);
  }
  if (quadrant == 2u) {
    return vec2(0.0 - c, 0.0 - s);
  }
  if (quadrant == 3u) {
    return vec2(s, 0.0 - c);
  }
  return vec2(c, s);
}

vec2 twiddle(bool inverse, uint num, uint den) {
  vec2 w = unit_twiddle(num % den, den);
  return inverse ? w : vec2(w.x, 0.0 - w.y);
}

vec2 chirp(bool inverse, uint k, uint n) {
  uint reduced = (k * k) % (2u * n);
  return twiddle(inverse, reduced, 2u * n);
}

// Address of sample j of transform t in a dense row-major buffer whose
// axis extent is n with sample stride `stride`. Transforms interleave:
// t splits as (outer row, inner q) with q in [0, stride), matching the
// radix-2 pass kernel's base formula.
uint dense_address(uint t, uint j, uint n, uint stride) {
  return (t / stride) * n * stride + (t % stride) + j * stride;
}

void process(uint p) {
  uint n = params.lhs_size;
  uint stride = params.rhs_size;
  uint mode = params.reduce_size;
  bool inverse = (params.operation & 1u) != 0u;

  if (mode == 0u) {
    // Twiddle stage: p enumerates transform-local samples, t*n + j.
    uint trailing = params.output_size;
    uint t = p / n;
    uint j = p % n;
    uint phase = (j / trailing) * (j % trailing);
    vec2 w = twiddle(inverse, phase, n);
    uint at = params.lhs_offset + dense_address(t, j, n, stride);
    vec2 x = fft_in_complex.values[at];
    fft_out_complex.values[params.output_offset + at] = cmul(x, w);
  } else if (mode == 1u) {
    // Bluestein a-build: p enumerates the packed convolution buffer, t*L + j.
    uint conv_len = params.output_size;
    uint j = p % conv_len;
    uint t = p / conv_len;
    vec2 value = vec2(0.0, 0.0);
    if (j < n) {
      vec2 x;
      if ((params.operation & 4u) != 0u) {
        // Half-spectrum source: synthesize the full Hermitian input.
        uint half_bins = n / 2u + 1u;
        if (j <= n / 2u) {
          x = fft_in_complex.values[params.lhs_offset +
                                    dense_address(t, j, half_bins, stride)];
        } else {
          x = fft_in_complex.values[params.lhs_offset +
                                    dense_address(t, n - j, half_bins, stride)];
          x.y = -x.y;
        }
      } else {
        uint source = dense_address(t, j, n, stride);
        if ((params.operation & 2u) != 0u) {
          x = vec2(fft_in_real.values[params.lhs_offset + source], 0.0);
        } else {
          x = fft_in_complex.values[params.lhs_offset + source];
        }
      }
      value = cmul(x, chirp(inverse, j, n));
    }
    fft_out_complex.values[params.output_offset + p] = value;
  } else if (mode == 2u) {
    // Bluestein b-build: p enumerates the packed convolution buffer.
    uint conv_len = params.output_size;
    uint k = p % conv_len;
    vec2 value = vec2(1.0, 0.0);
    if (k > 0u && k < n) {
      value = chirp(!inverse, k, n);
    } else if (k > conv_len - n) {
      value = chirp(!inverse, conv_len - k, n);
    }
    fft_out_complex.values[params.output_offset + p] = value;
  } else if (mode == 3u) {
    vec2 a = fft_in_complex.values[params.lhs_offset + p];
    vec2 b = fft_out_complex.values[params.output_offset + p];
    fft_out_complex.values[params.output_offset + p] = cmul(a, b);
  } else if (mode == 4u) {
    // Bluestein epilogue: p enumerates t*n + j over the n-point results.
    uint conv_len = params.output_size;
    uint j = p % n;
    uint t = p / n;
    if ((params.operation & 8u) != 0u && j > n / 2u) {
      return; // packed half-spectrum store keeps only bins 0..n/2
    }
    vec2 value =
        cmul(fft_in_complex.values[params.lhs_offset + t * conv_len + j],
             chirp(inverse, j, n));
    float scale = inverse ? float(conv_len) / float(n) : 1.0;
    value *= scale;
    uint at = (params.operation & 8u) != 0u
        ? params.output_offset +
              dense_address(t, j, n / 2u + 1u, stride)
        : params.output_offset + dense_address(t, j, n, stride);
    fft_out_complex.values[at] = value;
  } else if (mode == 6u) {
    // Real-variant edge kernels between the packed half-spectrum layout
    // and the full dense spectrum. Flag bit 1 promotes a real input to
    // complex (rfft head); bit 2 synthesizes the full Hermitian spectrum
    // from a packed half-spectrum input (irfft head); with neither flag
    // the kernel truncates a full spectrum to its packed half (rfft
    // tail). Promotion and synthesis read every sample of the packed
    // input exactly once; truncation writes every packed bin exactly
    // once.
    bool input_real = (params.operation & 2u) != 0u;
    bool input_half = (params.operation & 4u) != 0u;
    uint half_bins = n / 2u + 1u;
    uint t;
    uint j;
    if (input_real || input_half) {
      t = p / n;
      j = p % n;
    } else {
      t = p / half_bins;
      j = p % half_bins;
    }
    if (input_real) {
      vec2 value = vec2(
          fft_in_real.values[params.lhs_offset + dense_address(t, j, n, stride)],
          0.0);
      fft_out_complex.values[params.output_offset +
                             dense_address(t, j, n, stride)] = value;
    } else if (input_half) {
      uint bin = j <= n / 2u ? j : n - j;
      vec2 value = fft_in_complex.values[params.lhs_offset +
                                         dense_address(t, bin, half_bins, stride)];
      if (j > n / 2u) {
        value.y = -value.y;
      }
      fft_out_complex.values[params.output_offset +
                             dense_address(t, j, n, stride)] = value;
    } else {
      vec2 value = fft_in_complex.values[params.lhs_offset +
                                         dense_address(t, j, n, stride)];
      fft_out_complex.values[params.output_offset +
                             dense_address(t, j, half_bins, stride)] = value;
    }
  } else {
    // Mode 5: factor-transpose permute. The Cooley-Tukey decomposition
    // leaves each level's output transposed: slot j = j1 + M*k0 holds the
    // bin that belongs at k0 + (n/M)*j1. Scatter src[j] to dst[pi(j)].
    uint trailing = params.output_size;
    uint t = p / n;
    uint j = p % n;
    uint permuted = (j / trailing) + (n / trailing) * (j % trailing);
    vec2 value =
        fft_in_complex.values[params.lhs_offset + dense_address(t, j, n, stride)];
    fft_out_complex.values[params.output_offset +
                           dense_address(t, permuted, n, stride)] = value;
  }
}

void main() {
  // One element per iteration across the full dispatch. An elementwise
  // stage over n = 2^24 elements needs 65,536 workgroups of 256, one past
  // the guaranteed 65,535 x-workgroup limit, so the host caps the x
  // dimension and every invocation grid-strides through params.count
  // (same convention as elementwise.comp).
  uint stride_threads = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  for (uint p = gl_GlobalInvocationID.x; p < params.count;
       p += stride_threads) {
    process(p);
  }
}
