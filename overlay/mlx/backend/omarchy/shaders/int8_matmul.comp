#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// Symmetric-int8 matmul with runtime-quantized activations (fast::Int8Matmul),
// m-tiled: one 256-thread workgroup owns a 16x16 output tile and walks K in
// 32-wide steps, staging X and W tiles into shared memory so every staged byte
// is reused across the opposite tile axis. The retired one-thread-per-element
// kernel re-read both byte streams per output element through the uint word
// view (~2 word loads per MAC); tiling amortizes each X byte across 16 columns
// and each W byte across 16 rows. Accumulation is EXACT and bit-identical to
// the naive kernel (kept as shaders/int8_matmul_naive.comp,
// MLX_OMARCHY_INT8_NAIVE=1): per-group int32 sums of int8 products (same
// ascending-k add order, so even wraparound matches), float(acc_g) * XS[m,g]
// accumulated in ascending group order, * WS[r] + B[r], one bf16 RNE store.
// Integer dot products (GL_EXT_shader_integer_dot_product) are NOT used: the
// driver advertises the feature bit but its compiler has no sdot lowering.
//
// With flags bit0 (swiglu) W is the fused [gate; value] fc1 of 2N rows; both
// row dots are computed per output element from the one staged X tile, and the
// store is bf16(silu(gate_total) * value_total) with no intermediate rounding.
//
// Push-constant routing is unchanged from the naive kernel: shape[0..2] carry
// the XS / WS / B element offsets; lhs_offset / rhs_offset / output_offset the
// stream bases. shape[3] is unused (0): instead of host-side logical chunks,
// the kernel grid-strides over both tile axes, which keeps every output written
// under any dispatch clamp - the same contract qmm_tile.comp and matmul.comp
// use. The host dispatches ceil(rows/16) x ceil(n/16) workgroups (each axis
// clamped to kMaxComputeGroupCountX).

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, std430) readonly buffer InX {
  uint words[];
} in_x;
layout(set = 0, binding = 1, std430) readonly buffer InXS {
  float values[];
} in_xs;
layout(set = 0, binding = 2, std430) readonly buffer InW {
  uint words[];
} in_w;
layout(set = 0, binding = 3, std430) readonly buffer InWS {
  float values[];
} in_ws;
layout(set = 0, binding = 4, std430) readonly buffer InB {
  float values[];
} in_b;
layout(set = 0, binding = 5, std430) buffer OutBF16 {
  uint16_t values[];
} out_bf16;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

const uint TILE = 16u;
const uint TILE_K = 32u;
const uint K_WORDS = TILE_K / 4u;
// +1 word of padding per row keeps the 16 tile rows on distinct shared banks.
const uint PAD_WORDS = K_WORDS + 1u;

shared uint tile_x[TILE][PAD_WORDS];
shared uint tile_wg[TILE][PAD_WORDS];
shared uint tile_wv[TILE][PAD_WORDS];

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

int sign_byte(uint word, uint lane) {
  return (int((word >> (lane * 8u)) & 0xffu) << 24) >> 24;
}

// One 4-byte word slot of a tile row: slot s of 128 covers row s / K_WORDS and
// words s % K_WORDS of that row, i.e. bytes k0 + 4*(s%K_WORDS) .. +3. When the
// row stride is word aligned (k_total % 4 == 0) the slot is one buffer word;
// otherwise its 4 bytes are gathered byte-wise through the same word view the
// naive kernel uses ((row * k_total + k_flat) / 4, low byte first). Bytes at
// k_flat >= k_eff are never accumulated by either kernel and stage as zero.
// stream selects the shared destination: 0 = X, 1 = gate W, 2 = value W.
void stage_stream(uint slot, uint row_base, uint row_limit, uint words_base,
                  uint k0, uint k_eff, bool aligned, uint stream) {
  uint r = slot / K_WORDS;
  uint w = slot - r * K_WORDS;
  uint row = row_base + r;
  uint row_clamped = min(row, row_limit - 1u);
  uint word = 0u;
  if (aligned) {
    uint kk = k0 + w * 4u;
    if (row < row_limit && kk < k_eff) {
      uint addr = words_base + (row_clamped * params.matrix_k + kk) / 4u;
      // Stream 0 is X (binding 0); the gate and value streams read W
      // (binding 2) at the same word-view addressing as the naive kernel.
      word = (stream == 0u) ? in_x.words[addr] : in_w.words[addr];
      if (kk + 4u > k_eff) {
        for (uint b = 0u; b < 4u; b++) {
          if (kk + b >= k_eff) {
            word &= ~(0xffu << (b * 8u));
          }
        }
      }
    }
  } else {
    for (uint b = 0u; b < 4u; b++) {
      uint k_flat = k0 + w * 4u + b;
      if (row < row_limit && k_flat < k_eff) {
        uint byte_addr = row_clamped * params.matrix_k + k_flat;
        uint word_addr = words_base + byte_addr / 4u;
        uint byte_val =
            ((stream == 0u ? in_x.words[word_addr] : in_w.words[word_addr]) >>
             ((byte_addr & 3u) * 8u)) &
            0xffu;
        word |= byte_val << (b * 8u);
      }
    }
  }
  if (stream == 0u) {
    tile_x[r][w] = word;
  } else if (stream == 1u) {
    tile_wg[r][w] = word;
  } else {
    tile_wv[r][w] = word;
  }
}

void main() {
  const uint rows = params.matrix_m;
  const uint n = params.matrix_n;
  const uint k_total = params.matrix_k;
  const uint group = params.reduce_size;
  const uint groups = k_total / group;
  const uint k_eff = groups * group;
  const bool swiglu = (params.flags & 1u) != 0u;
  const bool aligned = (k_total % 4u) == 0u;

  const uint n_tiles = (n + TILE - 1u) / TILE;
  const uint m_tiles = (rows + TILE - 1u) / TILE;
  const uint tid = gl_LocalInvocationID.y * TILE + gl_LocalInvocationID.x;
  const uint lx = gl_LocalInvocationID.x;
  const uint ly = gl_LocalInvocationID.y;

  // Grid-stride over both tile axes: correct under any dispatch clamping.
  for (uint tc = gl_WorkGroupID.x; tc < n_tiles; tc += gl_NumWorkGroups.x) {
    for (uint tr = gl_WorkGroupID.y; tr < m_tiles; tr += gl_NumWorkGroups.y) {
      const uint col = tc * TILE + lx;
      const uint row = tr * TILE + ly;
      const bool in_tile = row < rows && col < n;

      float gate_total = 0.0f;
      float value_total = 0.0f;
      int acc_g = 0;
      int acc_v = 0;
      uint g = 0u;
      uint k_next = group;

      for (uint k0 = 0u; k0 < k_eff; k0 += TILE_K) {
        barrier();
        // Stage the X rows, then the gate W rows, then (swiglu) the value
        // W rows: 256 threads, 128 word slots per stream.
        stage_stream(tid, tr * TILE, rows, params.lhs_offset / 4u, k0, k_eff,
                     aligned, 0u);
        if (tid >= TILE * K_WORDS) {
          stage_stream(tid - TILE * K_WORDS, tc * TILE, n,
                       params.rhs_offset / 4u, k0, k_eff, aligned, 1u);
        }
        if (swiglu && tid < TILE * K_WORDS) {
          stage_stream(tid, n + tc * TILE, 2u * n, params.rhs_offset / 4u, k0,
                       k_eff, aligned, 2u);
        }
        barrier();

        for (uint w = 0u; w < K_WORDS; w++) {
          uint xw = tile_x[ly][w];
          uint gw = tile_wg[lx][w];
          uint vw = swiglu ? tile_wv[lx][w] : 0u;
          for (uint b = 0u; b < 4u; b++) {
            int xv = sign_byte(xw, b);
            acc_g += xv * sign_byte(gw, b);
            if (swiglu) {
              acc_v += xv * sign_byte(vw, b);
            }
            uint k_flat = k0 + w * 4u + b;
            if (k_flat + 1u == k_next) {
              uint xs_idx = in_tile ? params.shape[0] + row * groups + g
                                    : params.shape[0];
              float xs = in_xs.values[xs_idx];
              gate_total += float(acc_g) * xs;
              if (swiglu) {
                value_total += float(acc_v) * xs;
              }
              acc_g = 0;
              acc_v = 0;
              g++;
              k_next += group;
            }
          }
        }
      }

      if (in_tile) {
        const uint ws_base = params.shape[1];
        const uint b_base = params.shape[2];
        if (swiglu) {
          float gate = gate_total * in_ws.values[ws_base + col] +
              in_b.values[b_base + col];
          float value = value_total * in_ws.values[ws_base + n + col] +
              in_b.values[b_base + n + col];
          out_bf16.values[params.output_offset + row * n + col] =
              bf16_store(gate / (1.0f + exp(-gate)) * value);
        } else {
          out_bf16.values[params.output_offset + row * n + col] = bf16_store(
              gate_total * in_ws.values[ws_base + col] +
              in_b.values[b_base + col]);
        }
      }
    }
  }
}
