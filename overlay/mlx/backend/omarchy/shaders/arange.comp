#version 460

#if defined(USE_I64) || defined(USE_U64)
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#endif
#if defined(USE_I32) || defined(USE_U32)
#define STORAGE_TYPE uint
#define STORE_VALUE(value) (value)
#define USE_I32_MATH 1
#elif defined(USE_I64) || defined(USE_U64)
#define STORAGE_TYPE uint64_t
#define STORE_VALUE(value) (value)
#define USE_I64_MATH 1
#elif defined(USE_FP16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define STORE_VALUE(value) STORAGE_TYPE(value)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(value) bf16_store(value)
#else
#define STORAGE_TYPE float
#define STORE_VALUE(value) STORAGE_TYPE(value)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
  // Lockstep tail of ComputeParams (mlx compute.h): a shader may
  // declare any prefix of the struct, so these appended fields keep
  // every existing SPIR-V interface byte-identical.
  uint q_rowstride;
  uint k_rowstride;
  uint v_rowstride;
  uint o_rowstride;
  uint q_headstride;
  uint k_headstride;
  uint v_headstride;
  uint q_batchstride;
  uint k_batchstride;
  uint v_batchstride;
  // Windowed-dispatch transport: out_row_stride is the full output row
  // width for windowed matmul-family dispatches (0 = use matrix_n);
  // window_lo is the global first row / element for row- or
  // index-windowed dispatches (0 = unwindowed); window_hi is Take's
  // exclusive row-window bound (0 = unwindowed).
  uint out_row_stride;
  uint window_lo;
  uint window_hi;
} params;

void main() {
  // Index-windowed dispatches start at window_lo (0 = unwindowed).
  uint index = gl_GlobalInvocationID.x + params.window_lo;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
#if defined(USE_I32_MATH)
    uint value = params.lhs_size + index * params.reduce_size;
#elif defined(USE_I64_MATH)
    uint64_t start =
        uint64_t(params.lhs_size) | (uint64_t(params.rhs_size) << 32u);
    uint64_t step =
        uint64_t(params.reduce_size) | (uint64_t(params.aux_size) << 32u);
    uint64_t value = start + uint64_t(index) * step;
#else
    float value = params.alpha + params.beta * float(index);
#endif
    // Index-windowed dispatches bind the output window at window_lo,
    // so the store index is window-relative; window_lo is 0 (identity)
    // for the single-dispatch path.
    output_data.values[params.output_offset + index -
                       params.window_lo] = STORE_VALUE(value);
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
