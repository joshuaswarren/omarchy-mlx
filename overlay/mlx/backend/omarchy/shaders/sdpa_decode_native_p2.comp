//
// Native-shape pass 2 of the long-context decode SDPA: the merge half of
// the fused SdpaDecodeNativeF16 two-pass, reading the block partials that
// sdpa_decode_native_p1.comp wrote to the scratch binding instead of
// shared memory. Everything else - the stride-fold lane/block loops, the
// exp factors, the shared-memory transpose, the SIMD reductions, and the
// f16 output-pair stores - is the fused kernel's pass-2 code unchanged,
// so the two-dispatch pair is bit-identical to the fused two-pass it
// replaces. One 1024-thread workgroup per head, as before.
//
// The bf16 compile (-DBF16_IO, FamDecodeFast 2026-10-04) reads the f32
// partial pairs pass 1 stored and narrows once through the cast.comp RNE
// bf16 pair - the same single rounding the f32-score composition applies
// to its matmul result. Parity contract: the composition within f32
// accumulation order (see the pass 1 comment).

#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#ifdef BF16_IO
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif

layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Scratch {
  uint values[];
} scratch_data;
#ifdef BF16_IO
layout(set = 0, binding = 1, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;
#else
layout(set = 0, binding = 1, std430) writeonly buffer Output {
  float16_t values[];
} output_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

const uint SIMD = 32u;
const float FINITE_MIN = -3.4028234663852886e38;

// Query-head width and scratch layout, matching pass 1: PAIRS dim pairs
// per lane, so SDPA_DIM must be a multiple of 64. Scratch words per head:
// blocks max words + blocks sum words + PAIRS*blocks*SIMD packed
// output-pair words. Shared with pass 1; keep the two shaders' layouts in
// lockstep.
#ifndef SDPA_DIM
#define SDPA_DIM 64u
#endif
const uint PAIRS = SDPA_DIM / 64u;
#ifdef BF16_IO
// f32 partial pairs: matches the pass 1 stride (2 words per lane pair).
const uint SCRATCH_STRIDE_FACTOR = 2u + 2u * SIMD * PAIRS;
#else
const uint SCRATCH_STRIDE_FACTOR = 2u + SIMD * PAIRS;
#endif

#ifdef BF16_IO
// The cast.comp RNE store, verbatim: bf16 bits are the f32 top half with
// round-to-nearest-even, the same single narrowing the composition's cast
// pass applies.
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#endif

shared float s_outputs[SIMD * SIMD];

float native_exp(float x) {
  return exp(x);
}

void store_pair(
    uint head,
    uint lane,
    uint pair,
    float x,
    float y,
    float denominator) {
  if (lane == 0u) {
    uint out_base = params.output_offset + head * SDPA_DIM +
        pair * 64u + 2u * gl_SubgroupID;
#ifdef BF16_IO
    output_data.values[out_base] = bf16_store(x / denominator);
    output_data.values[out_base + 1u] = bf16_store(y / denominator);
#else
    output_data.values[out_base] = float16_t(x / denominator);
    output_data.values[out_base + 1u] = float16_t(y / denominator);
#endif
  }
}

void main() {
  uint lane = gl_SubgroupInvocationID;
  uint sgid = gl_SubgroupID;
  uint head = gl_WorkGroupID.x;
  uint blocks = params.flags;
  uint head_base = head * blocks * SCRATCH_STRIDE_FACTOR;

  // Native sdpa_vector_2pass_2 max and denominator: each lane folds blocks
  // lane+32*b, then the hardware SIMD reduction merges the 32 lanes.
  float merged_max = FINITE_MIN;
  for (uint block = lane; block < blocks; block += SIMD) {
    merged_max =
        max(merged_max, uintBitsToFloat(scratch_data.values[head_base + block]));
  }
  merged_max = subgroupMax(merged_max);
  float denominator = 0.0;
  for (uint block = lane; block < blocks; block += SIMD) {
    float factor = native_exp(
        uintBitsToFloat(scratch_data.values[head_base + block]) - merged_max);
    denominator = fma(
        factor,
        uintBitsToFloat(scratch_data.values[head_base + blocks + block]),
        denominator);
  }
  denominator = subgroupAdd(denominator);

  // Each SIMD first folds blocks sgid+32*b for each lane's output pair,
  // preserving pass 2's loop order, then the native shared transpose and
  // SIMD reduction merge the 32 partial streams for output pair sgid.
  for (uint p = 0u; p < PAIRS; ++p) {
    float o0 = 0.0;
    float o1 = 0.0;
    for (uint block = sgid; block < blocks; block += SIMD) {
      float factor = native_exp(
          uintBitsToFloat(scratch_data.values[head_base + block]) - merged_max);
#ifdef BF16_IO
      uint pair_base = head_base + 2u * blocks +
          (p * blocks + block) * (2u * SIMD) + 2u * lane;
      float partial_x = uintBitsToFloat(scratch_data.values[pair_base]);
      float partial_y = uintBitsToFloat(scratch_data.values[pair_base + 1u]);
#else
      vec2 partial = unpackHalf2x16(scratch_data.values[
          head_base + 2u * blocks + (p * blocks + block) * SIMD + lane]);
      float partial_x = partial.x;
      float partial_y = partial.y;
#endif
      o0 = fma(factor, partial_x, o0);
      o1 = fma(factor, partial_y, o1);
    }
    s_outputs[lane * SIMD + sgid] = o0;
    barrier();
    float merged0 = subgroupAdd(s_outputs[sgid * SIMD + lane]);
    barrier();
    s_outputs[lane * SIMD + sgid] = o1;
    barrier();
    float merged1 = subgroupAdd(s_outputs[sgid * SIMD + lane]);
    store_pair(head, lane, p, merged0, merged1, denominator);
    // The next pair's write must not start before this pair's read ends.
    barrier();
  }
}
