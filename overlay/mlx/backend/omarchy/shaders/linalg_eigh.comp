//
// Wave 7: symmetric eigen-decomposition via cyclic Jacobi rotations,
// LAPACK syevd semantics: eigenvalues ascending, eigenvectors orthonormal
// columns. One workgroup per batch matrix. The work buffer starts as the
// uplo-mirrored dense A and converges to the diagonal; the vectors buffer
// starts at identity and accumulates the rotations. Convergence criterion:
// a sweep that performs no rotation, where |a_pq| below eps-scaled
// thresholds is zeroed instead of rotated; the host raises a named error
// through status 3 when the 60-sweep cap is hit, never a silently wrong
// answer. Eigenvalues sort ascending through a shared permutation, applied
// to the values output and, when vectors are requested, staged through the
// finished work buffer.
//
// Push-constant routing: matrix_n is N, output_size the batch matrix
// count, operation 1 when eigenvectors are requested, and flags bit 0 the
// upper-triangle convention (which triangle of the input holds the data).
#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) coherent buffer Work {
  float values[];
} work;
layout(set = 0, binding = 1, std430) coherent buffer Vectors {
  float values[];
} vectors;
layout(set = 0, binding = 2, std430) writeonly buffer Values {
  float values[];
} values;
layout(set = 0, binding = 3, std430) buffer Status {
  uint values[];
} status;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float red[256];
shared float rot_c;
shared float rot_s;
shared uint rot_count;
shared float rot_defect;
shared uint converged;
shared uint perm[1024];

void main() {
  uint tid = gl_LocalInvocationID.x;
  // The host chunks the batch so no dispatch exceeds 65535 workgroups;
  // aux_offset carries this dispatch's first matrix index (the field is
  // unused by every linalg shader).
  uint matrix = params.aux_offset + gl_WorkGroupID.x;
  uint n = params.matrix_n;
  uint base = matrix * n * n;
  bool compute_ev = params.operation == 1u;
  bool upper = (params.flags & 1u) != 0u;

  // Mirror the stored triangle into a full symmetric matrix.
  for (uint idx = tid; idx < n * n; idx += 256u) {
    uint r = idx / n;
    uint c = idx % n;
    uint rr = upper ? min(r, c) : max(r, c);
    uint cc = upper ? max(r, c) : min(r, c);
    work.values[base + idx] = work.values[base + rr * n + cc];
  }
  if (compute_ev) {
    // The vectors buffer starts at identity and accumulates the rotations.
    // Values-only mode binds `work` again as the dummy vectors slot, so the
    // init must not run: writing identity there would clobber the mirrored
    // matrix and Jacobi would report the spectrum of the identity.
    for (uint idx = tid; idx < n * n; idx += 256u) {
      uint r = idx / n;
      uint c = idx % n;
      vectors.values[base + idx] = (r == c) ? 1.0 : 0.0;
    }
  }
  if (tid == 0u) {
    rot_count = 0u;
    converged = 0u;
  }
  memoryBarrierBuffer();
  barrier();

  const uint max_sweeps = 60u;
  for (uint sweep = 0u; sweep < max_sweeps; ++sweep) {
    if (tid == 0u) {
      rot_count = 0u;
      rot_defect = 0.0;
    }
      memoryBarrierBuffer();
    barrier();
    for (uint p = 0u; p + 1u < n; ++p) {
      for (uint q = p + 1u; q < n; ++q) {
        if (tid == 0u) {
          float app = work.values[base + p * n + p];
          float aqq = work.values[base + q * n + q];
          float apq = work.values[base + p * n + q];
          // Pair-relative off-diagonal measure: drives both the skip
          // threshold and the sweep convergence test, so f32 rounding
          // noise around the threshold cannot spin forever.
          float scale = 0.5f * (abs(app) + abs(aqq));
          float defect = (scale > 0.0f) ? abs(apq) / scale : 0.0f;
          rot_defect = max(rot_defect, defect);
          if (apq == 0.0 || defect <= 1.1920929e-7f) {
            // Off-diagonal already negligible: pin it to exact zero.
            work.values[base + p * n + q] = 0.0;
            work.values[base + q * n + p] = 0.0;
            rot_c = 1.0;
            rot_s = 0.0;
          } else {
            float tau = (aqq - app) / (2.0 * apq);
            float t = (tau >= 0.0)
                ? 1.0 / (tau + sqrt(1.0 + tau * tau))
                : -1.0 / (-tau + sqrt(1.0 + tau * tau));
            rot_c = 1.0 / sqrt(1.0 + t * t);
            rot_s = t * rot_c;
            rot_count++;
          }
        }
          memoryBarrierBuffer();
        barrier();
        float c = rot_c;
        float s = rot_s;
        // Apply whenever a rotation was computed. Gating on c != 1.0 is
        // wrong: for a tiny-but-above-pin-threshold apq, c rounds to 1.0f
        // while s still carries the correction, and skipping here stalls
        // the pair forever (neither rotated nor pinned, defect above the
        // sweep convergence bound).
        if (s != 0.0) {
          // A <- G^T A G as two full-matrix passes: columns p,q of every
          // row, then rows p,q of every column.
          for (uint i = tid; i < n; i += 256u) {
            float x = work.values[base + i * n + p];
            float y = work.values[base + i * n + q];
            work.values[base + i * n + p] = c * x - s * y;
            work.values[base + i * n + q] = s * x + c * y;
          }
          memoryBarrierBuffer();
          barrier();
          for (uint j2 = tid; j2 < n; j2 += 256u) {
            float x = work.values[base + p * n + j2];
            float y = work.values[base + q * n + j2];
            work.values[base + p * n + j2] = c * x - s * y;
            work.values[base + q * n + j2] = s * x + c * y;
          }
          memoryBarrierBuffer();
          barrier();
          if (compute_ev) {
            for (uint i = tid; i < n; i += 256u) {
              float x = vectors.values[base + i * n + p];
              float y = vectors.values[base + i * n + q];
              vectors.values[base + i * n + p] = c * x - s * y;
              vectors.values[base + i * n + q] = s * x + c * y;
            }
            memoryBarrierBuffer();
            barrier();
          }
        }
      }
    }
    if (tid == 0u && (rot_count == 0u || rot_defect <= 1e-6f)) {
      converged = 1u;
    }
      memoryBarrierBuffer();
    barrier();
    if (converged == 1u) {
      break;
    }
  }
  if (tid == 0u && converged == 0u) {
    status.values[matrix] = 3u;
  }

  // Ascending insertion sort of the diagonal through a shared permutation.
  if (tid == 0u) {
    for (uint i = 0u; i < n; ++i) {
      perm[i] = i;
    }
    for (uint i = 1u; i < n; ++i) {
      uint pi = perm[i];
      float di = work.values[base + pi * n + pi];
      uint j2 = i;
      while (j2 > 0u &&
             work.values[base + perm[j2 - 1u] * n + perm[j2 - 1u]] > di) {
        perm[j2] = perm[j2 - 1u];
        j2--;
      }
      perm[j2] = pi;
    }
  }
  memoryBarrierBuffer();
  barrier();

  for (uint i = tid; i < n; i += 256u) {
    uint src = perm[i];
    values.values[matrix * n + i] = work.values[base + src * n + src];
  }
  // The staging block below overwrites work with the permuted vectors.
  // Threads that skip the values loop (tid >= n) reach it first, so a
  // barrier is required between the two loops: without one the values
  // loop can read a work diagonal cell after staging has replaced it
  // with vector data (observed as a wrong last eigenvalue at n = 9).
  memoryBarrierBuffer();
  barrier();

  if (compute_ev) {
    // Stage the permuted columns through the finished work buffer, which
    // no longer holds anything needed.
    for (uint idx = tid; idx < n * n; idx += 256u) {
      uint r = idx / n;
      uint c = idx % n;
      work.values[base + idx] = vectors.values[base + r * n + perm[c]];
    }
      memoryBarrierBuffer();
    barrier();
    for (uint idx = tid; idx < n * n; idx += 256u) {
      vectors.values[base + idx] = work.values[base + idx];
    }
  }
}
