//
// BENCH-ONLY stage-ablation copy of gated_delta_prefill_coopmat_batch.comp.
// NEVER SHIPPED, NEVER COMMITTED: lives only in a lane build tree and is
// dispatched only when MLX_OMARCHY_GDN_STUB is set. Wrong results by design;
// timing only. The -D switches truncate one stage class at a time while
// keeping the surrounding synchronization/staging structure:
//   STUB_NO_LOOPK  - drop the K^T.K / Q.K^T MMAs in loop 1 (staging stays)
//   STUB_NO_LOOPS  - drop the (gb K).S / (g Q).S MMAs in loop 1
//   STUB_NO_NEUMANN- Tinv := identity (skip the N/Neumann round-trip chain)
//   STUB_NO_DELTA  - delta := diag(beta)V - M2 without the Tinv MMA
//   STUB_NO_OUT    - y := 0 path without the QKt/out MMAs (state still walks)
//   STUB_NO_STATE  - state update waves removed (state stays h0)
//   STUB_SKELETON  - all MMAs dropped; staging + round trips + barriers only

#version 460

#if !defined(STUB_NO_LOOPK) && !defined(STUB_NO_LOOPS) && \
    !defined(STUB_NO_NEUMANN) && !defined(STUB_NO_DELTA) && \
    !defined(STUB_NO_OUT) && !defined(STUB_NO_STATE) && \
    !defined(STUB_SKELETON)
#error "bench stub shader built without a STUB_* switch"
#endif

#ifdef STUB_SKELETON
#define STUB_NO_LOOPK 1
#define STUB_NO_LOOPS 1
#define STUB_NO_NEUMANN 1
#define STUB_NO_DELTA 1
#define STUB_NO_OUT 1
#define STUB_NO_STATE 1
#endif

#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 32, local_size_y = 4, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer QBuf  { uint w[]; } q_buf;
layout(set = 0, binding = 1, std430) readonly buffer KBuf  { uint w[]; } k_buf;
layout(set = 0, binding = 2, std430) readonly buffer VBuf  { uint w[]; } v_buf;
layout(set = 0, binding = 3, std430) readonly buffer GBuf  { uint16_t v[]; } g_buf;
layout(set = 0, binding = 4, std430) readonly buffer BBuf  { uint16_t v[]; } b_buf;
layout(set = 0, binding = 5, std430) readonly buffer SIn    { float    v[]; } s_in;
layout(set = 0, binding = 6, std430) writeonly buffer YBuf { uint w[]; } y_buf;
layout(set = 0, binding = 7, std430) buffer         SOut { float    v[]; } s_out;
layout(set = 0, binding = 8, std430) readonly buffer MBuf  { uint8_t  v[]; } m_buf;
layout(set = 0, binding = 9, std430) readonly buffer GBufF { float     v[]; } g_buf_f;
layout(set = 0, binding = 10, std430) buffer         Snap   { float    v[]; } snap;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta_f;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint chunk;
  uint chunks;
} params;

const uint C = 8u;
const uint DK = 128u;
const uint KSTEPS = DK / 8u;

float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}

float bf16_word_lo(uint word) {
  return uintBitsToFloat((word & 0xffffu) << 16u);
}

float bf16_word_hi(uint word) {
  return uintBitsToFloat(word & 0xffff0000u);
}

uint bf16_pack(float lo, float hi) {
  uint lb = floatBitsToUint(lo);
  uint hb = floatBitsToUint(hi);
  if ((lb & 0x7fff0000u) == 0x7f800000u) lb = (lb & 0xffff0000u) | 0x40u;
  else lb = (lb + 0x7fffu + ((lb >> 16) & 1u)) >> 16;
  if ((hb & 0x7fff0000u) == 0x7f800000u) hb = (hb & 0xffff0000u) | 0x40u;
  else hb = (hb + 0x7fffu + ((hb >> 16) & 1u)) >> 16;
  return (hb << 16) | (lb & 0xffffu);
}

shared float s_state[4][KSTEPS * 64];
shared float s_k[2][4][64];
shared float s_kg[2][4][64];
shared float s_q[2][4][64];
shared float s_qg[2][4][64];
shared float kgc_all[4][4 * 64];
shared float v_s[4][64];
shared float rt_a[4][64];
shared float rt_b[4][64];
shared float gamma_s[4][8];
shared float beta_s[4][8];

uint g_sg;
uint g_e0;
uint g_r0;
uint g_c0;
uint g_koff;
uint g_qoff;
uint g_hv;
uint g_head;
uint g_valid;
float g_bg_r0;
float g_gam_r0;

coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> mat_a;
coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mat_b;
coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseA> mat_a2;
coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseB> mat_b2;
coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> acc;

void stage_kq(uint t0v, uint kk, uint p) {
  uint kbase = g_koff + (t0v + g_r0) * g_hv * DK + g_head * DK + kk * 8u + g_c0;
  uint qbase = g_qoff + (t0v + g_r0) * g_hv * DK + g_head * DK + kk * 8u + g_c0;
  float kv0 = 0.0;
  float kv1 = 0.0;
  float qv0 = 0.0;
  float qv1 = 0.0;
  if (g_r0 < g_valid) {
    uint kw = k_buf.w[kbase >> 1u];
    kv0 = bf16_word_lo(kw);
    kv1 = bf16_word_hi(kw);
    uint qw = q_buf.w[qbase >> 1u];
    qv0 = bf16_word_lo(qw);
    qv1 = bf16_word_hi(qw);
  }
  s_k[p][g_sg][g_e0] = kv0;
  s_k[p][g_sg][g_e0 + 1u] = kv1;
  s_kg[p][g_sg][g_e0] = kv0 * g_bg_r0;
  s_kg[p][g_sg][g_e0 + 1u] = kv1 * g_bg_r0;
  s_q[p][g_sg][g_e0] = qv0;
  s_q[p][g_sg][g_e0 + 1u] = qv1;
  s_qg[p][g_sg][g_e0] = qv0 * g_gam_r0;
  s_qg[p][g_sg][g_e0 + 1u] = qv1 * g_gam_r0;
}

coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> stub_acc() {
  return coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
}

void main() {
  const uint sg = gl_SubgroupID;
  const uint lane = gl_SubgroupInvocationID;
  const uint head = gl_WorkGroupID.x;
  const uint dv0 = (gl_WorkGroupID.y * 4u + sg) * 8u;
  const uint T = params.dims;
  const uint hv = params.matrix_k;
  const uint e0 = lane * 2u;
  const uint r0 = e0 / 8u;
  const uint c0 = e0 % 8u;

  g_sg = sg;
  g_e0 = e0;
  g_r0 = r0;
  g_c0 = c0;
  g_koff = params.rhs_offset;
  g_qoff = params.lhs_offset;
  g_hv = hv;
  g_head = head;

  const uint q_off = params.lhs_offset;
  const uint k_off = params.rhs_offset;
  const uint v_off = params.aux_size;
  const uint b_off = params.aux_offset;
  const uint g_off = params.shape[0];
  const uint h0_off = params.shape[1];
  const uint hf_off = params.shape[2];
  const bool g_f32 = (params.flags & 4u) != 0u;

  rt_a[sg][e0] = (r0 == c0) ? 1.0 : 0.0;
  rt_a[sg][e0 + 1u] = (r0 == c0 + 1u) ? 1.0 : 0.0;
  barrier();
  coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> eye;
  coopMatLoad(eye, rt_a[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
  coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> zero =
      coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);

  for (uint kk = 0u; kk < KSTEPS; ++kk) {
    uint idx = h0_off + (head * params.matrix_n + dv0 + c0) * DK + kk * 8u + r0;
    s_state[sg][kk * 64u + e0] = s_in.v[idx];
    s_state[sg][kk * 64u + e0 + 1u] = s_in.v[idx + DK];
  }

  for (uint t0 = 0u; t0 < T; t0 += C) {
    const uint valid = min(C, T - t0);
    g_valid = valid;

    float gv = 0.0;
    if (lane < valid) {
      float graw = g_f32
          ? g_buf_f.v[g_off + (t0 + lane) * hv + head]
          : bf16_load(g_buf.v[g_off + (t0 + lane) * hv + head]);
      gv = log(max(graw, 1.17549435e-38f));
    }
    if (lane < C) {
      gamma_s[sg][lane] = subgroupInclusiveAdd(gv);
      beta_s[sg][lane] = lane < valid
          ? bf16_load(b_buf.v[b_off + (t0 + lane) * hv + head])
          : 0.0f;
    }
    barrier();

    const float gamC = exp(gamma_s[sg][C - 1u]);
    const float beta_r0 = beta_s[sg][r0];
    const float gam_r0 = exp(gamma_s[sg][r0]);
    g_bg_r0 = beta_r0 * gam_r0;
    g_gam_r0 = gam_r0;
    const float dec_r0 =
        r0 < valid ? exp(gamma_s[sg][C - 1u] - gamma_s[sg][r0]) : 0.0;

    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> kkt =
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> qkt =
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> m2 =
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> tmp =
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0.0);
    stage_kq(t0, 0u, 0u);
    barrier();
    uint par = 0u;
    for (uint kk = 0u; kk < KSTEPS; ++kk) {
      if (kk + 1u < KSTEPS) {
        stage_kq(t0, kk + 1u, par ^ 1u);
      }
      coopMatLoad(mat_b, s_k[par][sg], 0, 8, gl_CooperativeMatrixLayoutColumnMajor);
#ifndef STUB_NO_LOOPK
      coopMatLoad(mat_a, s_k[par][sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
      kkt = coopMatMulAdd(mat_a, mat_b, kkt);
      coopMatLoad(mat_a, s_q[par][sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
      qkt = coopMatMulAdd(mat_a, mat_b, qkt);
#endif
      coopMatLoad(mat_a, s_kg[par][sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
      coopMatLoad(mat_b2, s_state[sg], kk * 64u, 8, gl_CooperativeMatrixLayoutRowMajor);
#ifndef STUB_NO_LOOPS
      m2 = coopMatMulAdd(mat_a, mat_b2, m2);
      coopMatLoad(mat_a, s_qg[par][sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
      tmp = coopMatMulAdd(mat_a, mat_b2, tmp);
#endif
      barrier();
      par ^= 1u;
    }

    coopMatStore(kkt, rt_a[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    float n0 = rt_a[sg][e0];
    float n1 = rt_a[sg][e0 + 1u];
    rt_a[sg][e0] = (c0 < r0)
        ? n0 * beta_r0 * exp(gamma_s[sg][r0] - gamma_s[sg][c0]) : 0.0;
    rt_a[sg][e0 + 1u] = (c0 + 1u < r0)
        ? n1 * beta_r0 * exp(gamma_s[sg][r0] - gamma_s[sg][c0 + 1u]) : 0.0;
    barrier();
    coopMatLoad(mat_a, rt_a[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mat_b, rt_a[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();

#ifdef STUB_NO_NEUMANN
    // Tinv := I; keep the same barrier/RT count for the timing structure.
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> tinv = eye;
    coopMatStore(tinv, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    coopMatLoad(mat_a2, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
#else
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> a1 =
        coopMatMulAdd(mat_a, mat_b, zero);
    coopMatStore(a1, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    coopMatLoad(mat_a2, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mat_b2, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> a2 =
        coopMatMulAdd(mat_a2, mat_b2, zero);
    coopMatStore(a2, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    coopMatLoad(mat_b2, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> a3 =
        coopMatMulAdd(mat_a2, mat_b2, zero);
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> msum =
        eye + a1 + a2 + a3;
    coopMatStore(msum, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    coopMatLoad(mat_b, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> tinv =
        msum - coopMatMulAdd(mat_a, mat_b, zero);
    coopMatStore(tinv, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    coopMatLoad(mat_a2, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
#endif

    uint vbase = v_off + (t0 + r0) * hv * params.matrix_n + head * params.matrix_n + dv0 + c0;
    float vv0 = 0.0;
    float vv1 = 0.0;
    if (r0 < valid) {
      uint vw = v_buf.w[vbase >> 1u];
      vv0 = bf16_word_lo(vw);
      vv1 = bf16_word_hi(vw);
    }
    v_s[sg][e0] = vv0 * beta_r0;
    v_s[sg][e0 + 1u] = vv1 * beta_r0;
    barrier();
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> bv;
    coopMatLoad(bv, v_s[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(bv - m2, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    coopMatLoad(mat_b, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> delta =
#ifdef STUB_NO_DELTA
        bv - m2;
#else
        coopMatMulAdd(mat_a2, mat_b, zero);
#endif

    coopMatStore(qkt, rt_a[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    float qe0 = rt_a[sg][e0];
    float qe1 = rt_a[sg][e0 + 1u];
    rt_a[sg][e0] = (c0 <= r0)
        ? qe0 * exp(gamma_s[sg][r0] - gamma_s[sg][c0]) : 0.0;
    rt_a[sg][e0 + 1u] = (c0 + 1u <= r0)
        ? qe1 * exp(gamma_s[sg][r0] - gamma_s[sg][c0 + 1u]) : 0.0;
    barrier();
    coopMatLoad(mat_a, rt_a[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(delta, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    coopMatLoad(mat_b2, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();

    coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> out_t =
#ifdef STUB_NO_OUT
        tmp;
#else
        coopMatMulAdd(mat_a, mat_b2, tmp);
#endif
    coopMatStore(out_t, rt_a[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    if (r0 < valid) {
      y_buf.w[(((t0 + r0) * hv + head) * params.matrix_n + dv0 + c0) >> 1u] =
          bf16_pack(rt_a[sg][e0], rt_a[sg][e0 + 1u]);
    }
    barrier();

#ifndef STUB_NO_STATE
    for (uint wave = 0u; wave < KSTEPS / 4u; ++wave) {
      for (uint j = 0u; j < 4u; ++j) {
        uint kk = wave * 4u + j;
        uint kbase = k_off + (t0 + r0) * hv * DK + head * DK + kk * 8u + c0;
        float kv0 = 0.0;
        float kv1 = 0.0;
        if (r0 < valid) {
          uint kw = k_buf.w[kbase >> 1u];
          kv0 = bf16_word_lo(kw);
          kv1 = bf16_word_hi(kw);
        }
        kgc_all[sg][j * 64u + e0] = kv0 * dec_r0;
        kgc_all[sg][j * 64u + e0 + 1u] = kv1 * dec_r0;
      }
      barrier();
      for (uint j = 0u; j < 4u; ++j) {
        uint kk = wave * 4u + j;
        coopMatLoad(mat_a, kgc_all[sg], j * 64u, 8, gl_CooperativeMatrixLayoutColumnMajor);
        coopmat<float, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> kd =
            coopMatMulAdd(mat_a, mat_b2, zero);
        coopMatStore(kd, rt_b[sg], 0, 8, gl_CooperativeMatrixLayoutRowMajor);
        subgroupBarrier();
        s_state[sg][kk * 64u + e0] =
            s_state[sg][kk * 64u + e0] * gamC + rt_b[sg][e0];
        s_state[sg][kk * 64u + e0 + 1u] =
            s_state[sg][kk * 64u + e0 + 1u] * gamC + rt_b[sg][e0 + 1u];
      }
      subgroupBarrier();
    }
#endif
  }

  for (uint kk = 0u; kk < KSTEPS; ++kk) {
    uint idx = hf_off + (head * params.matrix_n + dv0 + c0) * DK + kk * 8u + r0;
    s_out.v[idx] = s_state[sg][kk * 64u + e0];
    s_out.v[idx + DK] = s_state[sg][kk * 64u + e0 + 1u];
  }
}
