#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_bfloat16 : require

// Dense bf16 matmul on the Intel/ANV cooperative-matrix shape: bf16
// operands on the 8x16x16 bf16 x bf16 -> f32 subgroup shape ANV
// advertises (the XMX shape qmm_intel_bf16 already proves on BMG).
// Devices without the fp32 8x8x8 shape matmul_coopmat_bf16.comp needs
// would otherwise keep the scalar-FMA route. A 64-lane workgroup is
// two subgroups at subgroup size 32; each subgroup owns one 16-row
// half of the 32x32 output tile (two 8-row blocks). TILE_M=32 keeps
// every per-workgroup row span at or under the 64-row bound the Xe2
// tile-wedge receipt requires (receipts/2026-11-25-b60-xe-ubatch-tile
// -wedge.md): no dispatch here ever selects a >64-row tile.
//
// Each 16-wide k step stages an A 32x16 patch and a B 16x32 patch as
// bf16 into 2 KiB of shared with scalar 16-bit element loads, so every
// orientation, stride, element offset, and m/n/k tail behaves the same
// way (out-of-range elements stage zero, which is an exact matmad
// contribution; the drain masks rows and columns past matrix_m/n).
// Staged operands are the same bf16 values the buffer holds - no widen
// pass, no rounding change. The accumulator is f32 and alpha scales it
// at the drain, the same scale point matmul_coopmat_bf16 uses; stored
// bits therefore differ from the FMA route only in accumulation order,
// and parity is verified by tolerance/argmax, not bit equality.
//
// Push-constant layout matches matmul.comp. Transpose flags: 1 = rhs
// column-major, 4 = lhs column-major. Offsets, gaps, and batch strides
// are in ELEMENTS (the buffers are viewed as 16-bit arrays).

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint STEP_K = 16u;
const uint MAT_M = 8u;
const uint MAT_N = 16u;
const uint MAT_K = 16u;

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  bfloat16_t values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  bfloat16_t values[];
} input_b;
layout(set = 0, binding = 2, std430) readonly buffer InputC {
  uint values[];
} input_c;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
} params;

shared bfloat16_t a_s[TILE_M * STEP_K];      // 32x16 bf16 A patch, 1 KiB
shared bfloat16_t b_s[STEP_K * TILE_N];      // 16x32 bf16 B patch, 1 KiB
shared float drain_s[2u * MAT_M * MAT_N];    // per-subgroup 8x16 f32 scratch, 1 KiB

uint16_t out_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint sub = gl_SubgroupID;
  uint batch_index = gl_WorkGroupID.z;
  uint remaining = batch_index;
  uint a_batch = 0u;
  uint b_batch = 0u;
  for (uint axis = params.dims; axis > 0u; --axis) {
    uint coord = remaining % params.shape[axis - 1u];
    remaining /= params.shape[axis - 1u];
    a_batch += coord * params.in_strides[axis - 1u];
    b_batch += coord * params.out_strides[axis - 1u];
  }
  // Offsets are ELEMENT units, matching the 16-bit buffer views.
  uint a_slice = params.lhs_offset + a_batch;
  uint b_slice = params.rhs_offset + b_batch;
  uint out_matrix = params.matrix_m * params.matrix_n;
  uint out_slice = params.output_offset + batch_index * out_matrix;
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
  bool a_colmaj = (params.flags & 4u) != 0u;
  bool b_colmaj = (params.flags & 1u) != 0u;
  uint total_steps = (params.matrix_k + STEP_K - 1u) / STEP_K;

  for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
       tile_row += gl_NumWorkGroups.y) {
    uint row_base = tile_row * TILE_M;
    for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
         tile_col += gl_NumWorkGroups.x) {
      uint col_base = tile_col * TILE_N;

      // Each subgroup owns a 16-row half (two 8-row blocks x two 16-col
      // blocks). Keep the four accumulators as explicit scalars (not an
      // indexed array) so ANV/NIR never lowers them through scratch memory.
      coopmat<float, gl_ScopeSubgroup, MAT_M, MAT_N, gl_MatrixUseAccumulator>
          acc00 = coopmat<float, gl_ScopeSubgroup, MAT_M, MAT_N,
              gl_MatrixUseAccumulator>(0.0);
      coopmat<float, gl_ScopeSubgroup, MAT_M, MAT_N, gl_MatrixUseAccumulator>
          acc01 = coopmat<float, gl_ScopeSubgroup, MAT_M, MAT_N,
              gl_MatrixUseAccumulator>(0.0);
      coopmat<float, gl_ScopeSubgroup, MAT_M, MAT_N, gl_MatrixUseAccumulator>
          acc10 = coopmat<float, gl_ScopeSubgroup, MAT_M, MAT_N,
              gl_MatrixUseAccumulator>(0.0);
      coopmat<float, gl_ScopeSubgroup, MAT_M, MAT_N, gl_MatrixUseAccumulator>
          acc11 = coopmat<float, gl_ScopeSubgroup, MAT_M, MAT_N,
              gl_MatrixUseAccumulator>(0.0);

      for (uint step = 0u; step < total_steps; ++step) {
        uint k_base = step * STEP_K;
        uint width = min(STEP_K, params.matrix_k - k_base);

        // Stage A (32 rows x 16 k), masked rows and k tail zero-filled.
        for (uint j = 0u; j < 8u; ++j) {
          uint i = lid + 64u * j;
          uint rl = i / STEP_K;
          uint kk = i % STEP_K;
          uint row = row_base + rl;
          bfloat16_t v = bfloat16_t(0.0);
          if (row < params.matrix_m && kk < width) {
            v = a_colmaj
                ? input_a.values[a_slice + (k_base + kk) * params.lhs_gap + row]
                : input_a.values[a_slice + row * params.lhs_gap + k_base + kk];
          }
          a_s[i] = v;
        }
        // Stage B (16 k x 32 columns), same masking.
        for (uint j = 0u; j < 8u; ++j) {
          uint i = lid + 64u * j;
          uint kk = i / TILE_N;
          uint cl = i % TILE_N;
          uint col = col_base + cl;
          bfloat16_t v = bfloat16_t(0.0);
          if (kk < width && col < params.matrix_n) {
            v = b_colmaj
                ? input_b.values[b_slice + col * params.rhs_gap + k_base + kk]
                : input_b.values[b_slice + (k_base + kk) * params.rhs_gap + col];
          }
          b_s[i] = v;
        }
        barrier();

        // One matmad step: subgroup rows (sub*16 + rb*8 .. +8) against
        // both 16-column B blocks.
        if (sub < 2u) {
          coopmat<bfloat16_t, gl_ScopeSubgroup, MAT_M, MAT_K, gl_MatrixUseA>
              mat_a0;
          coopmat<bfloat16_t, gl_ScopeSubgroup, MAT_M, MAT_K, gl_MatrixUseA>
              mat_a1;
          coopmat<bfloat16_t, gl_ScopeSubgroup, MAT_K, MAT_N, gl_MatrixUseB>
              mat_b0;
          coopmat<bfloat16_t, gl_ScopeSubgroup, MAT_K, MAT_N, gl_MatrixUseB>
              mat_b1;
          coopMatLoad(
              mat_a0, a_s, (sub * 2u) * MAT_M * STEP_K, STEP_K,
              gl_CooperativeMatrixLayoutRowMajor);
          coopMatLoad(
              mat_a1, a_s, (sub * 2u + 1u) * MAT_M * STEP_K, STEP_K,
              gl_CooperativeMatrixLayoutRowMajor);
          coopMatLoad(
              mat_b0, b_s, 0u, TILE_N,
              gl_CooperativeMatrixLayoutRowMajor);
          coopMatLoad(
              mat_b1, b_s, MAT_N, TILE_N,
              gl_CooperativeMatrixLayoutRowMajor);
          acc00 = coopMatMulAdd(mat_a0, mat_b0, acc00);
          acc01 = coopMatMulAdd(mat_a0, mat_b1, acc01);
          acc10 = coopMatMulAdd(mat_a1, mat_b0, acc10);
          acc11 = coopMatMulAdd(mat_a1, mat_b1, acc11);
        }
        barrier();
      }

      // Both subgroups drain their own 8x16 accumulator block in parallel
      // through drain_s[sub * MAT_M * MAT_N ..], then scatter f32 to bf16
      // (alpha applied at the same point the f32 sibling scales).
      uint sub_lane = lid - sub * 32u;
      uint drain_base = sub * MAT_M * MAT_N;
#define DRAIN_ACC(ACC, RB_OFF, CB_OFF)                                         \
      if (sub < 2u) {                                                          \
        coopMatStore(                                                          \
            ACC, drain_s, drain_base, MAT_N,                                   \
            gl_CooperativeMatrixLayoutRowMajor);                               \
      }                                                                        \
      memoryBarrierShared();                                                   \
      barrier();                                                               \
      if (sub < 2u) {                                                          \
        for (uint idx = sub_lane; idx < MAT_M * MAT_N; idx += 32u) {           \
          uint r = idx / MAT_N;                                                \
          uint c = idx % MAT_N;                                                \
          uint row = row_base + (sub * 2u + (RB_OFF)) * MAT_M + r;             \
          uint col = col_base + (CB_OFF) * MAT_N + c;                          \
          if (row < params.matrix_m && col < params.matrix_n) {                \
            output_data.values[out_slice + row * params.matrix_n + col] =      \
                out_store(params.alpha * drain_s[drain_base + idx]);           \
          }                                                                    \
        }                                                                      \
      }                                                                        \
      barrier()

      DRAIN_ACC(acc00, 0u, 0u);
      DRAIN_ACC(acc01, 0u, 1u);
      DRAIN_ACC(acc10, 1u, 0u);
      DRAIN_ACC(acc11, 1u, 1u);
#undef DRAIN_ACC
    }
  }
}
