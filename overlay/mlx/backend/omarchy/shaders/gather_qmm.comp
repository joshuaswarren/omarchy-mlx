//
// Gathered affine quantized matmul (GatherQMM, GatherQQMM, and the
// quantized-weight QQMatmul path). One thread owns one output element:
// out[b, m, n] contracts the x row (lhs[b], m, :) with the dequantized
// packed-w row (rhs[b], n, :), where packed uint32 words hold 32 / bits
// quantized values along K in the low bits first and each group of
// group_size elements shares one scale (and one bias unless NO_BIAS).
// Binding 1 is a raw uint32 word buffer packing [all scale bytes |
// (all bias bytes) | all lhs index words | all rhs index words]; the
// scale/bias bytes arrive in the output dtype and are decoded from the
// words (PARAM_F32 bitcast, PARAM_FP16 half unpack, PARAM_BF16 word
// shift), so no sub-32-bit storage reads exist anywhere. Binding 0/3
// carry the float activations/output in the dtype storage.
//
// Push-constant routing: operation carries bits, reduce_size the group
// size, shape[0] the per-half index count S, in_strides[0]/out_strides[0]
// the lhs/rhs word offsets inside the packed buffer.
// Every load is a straight-line per-thread word or element read at a
// linear address inside uniform-trip-count loops (Honeykrisp caution:
// no per-lane divergent word loads, no broadcast-unravel addressing).

#version 460

#if defined(USE_FP16) || defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#endif
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

#if defined(USE_FP16) || defined(USE_BF16)
#define PARAM_BYTES 2u
#else
#define PARAM_BYTES 4u
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  STORAGE_TYPE values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer PackedParams {
  uint values[];
} packed_params;
layout(set = 0, binding = 2, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

#ifdef USE_OUT_GLOBAL_SCALE
// nvfp4 output global scale as one float32 word. Only the HGS kernel
// variants bind it: the packed w scale bytes still carry the encode
// factor 2688 / global_scale_w (quantize.comp folds it in, dequant.comp
// divides it back out), and this kernel decodes the bytes raw, so the
// correction is applied to the finished dot product here - the same
// per-output-row multiply the pinned Metal _hgs variants perform. The
// scalar view's own storage offset rides in aux_size.
layout(set = 0, binding = 4, std430) readonly buffer OutGlobalScale {
  uint values[];
} out_global_scale_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

// With -DFP_MODE the shader gathers the non-affine modes instead
// (mxfp4 / nvfp4 / mxfp8; always bias-free). The packed buffer carries
// [all scale bytes | all lhs index words | all rhs index words] like
// the NO_BIAS affine layout, but each group parameter is one byte: a
// round-up e8m0 code at group 32 (mxfp4/mxfp8) or an e4m3 code at
// group 16 (nvfp4). Element codes are fp4 e2m1 nibbles (bits 4, two
// per byte, low element low - the same lane positions as affine 4-bit
// words) or fp8 e4m3 bytes (bits 8, one per byte). Conversions mirror
// the pinned Metal fp4.h / fp8.h helpers bit for bit.
#ifdef FP_MODE
uint byte_at(uint word, uint lane) {
  return (lane == 0u)
      ? (word & 0xFFu)
      : (lane == 1u)
      ? ((word >> 8u) & 0xFFu)
      : (lane == 2u)
      ? ((word >> 16u) & 0xFFu)
      : ((word >> 24u) & 0xFFu);
}

float fp8_decode(uint bits) {
  float magnitude = unpackHalf2x16((bits & 127u) << 7u).x * 256.0;
  return ((bits & 128u) != 0u) ? -magnitude : magnitude;
}

float e8m0_decode(uint bits) {
  return uintBitsToFloat(bits == 0u ? 0x400000u : bits << 23u);
}

float fp4_decode(uint code) {
  float magnitude = unpackHalf2x16((code & 7u) << 9u).x * 16384.0;
  return ((code & 8u) != 0u) ? -magnitude : magnitude;
}

// One scale byte per group at byte_offset in the packed word buffer.
float decode_param(uint byte_offset) {
  uint word = packed_params.values[params.aux_offset + byte_offset / 4u];
  uint code = byte_at(word, byte_offset & 3u);
  return (params.reduce_size == 16u) ? fp8_decode(code) : e8m0_decode(code);
}

float decode_element(uint q) {
  return (params.operation == 4u) ? fp4_decode(q) : fp8_decode(q);
}

#define DECODE_VALUE(q) decode_element(q)
#else
// Decode one group parameter stored at byte_offset in the packed word
// buffer, in the output dtype.
float decode_param(uint byte_offset) {
  uint word = packed_params.values[params.aux_offset + byte_offset / 4u];
#if defined(USE_FP16)
  uint half_index = byte_offset / 2u;
  uint shifted = (half_index & 1u) == 0u ? word : word >> 16u;
  return unpackHalf2x16(shifted).x;
#elif defined(USE_BF16)
  uint half_index = byte_offset / 2u;
  uint bits = (half_index & 1u) == 0u ? word << 16u : word & 0xffff0000u;
  return uintBitsToFloat(bits);
#else
  return uintBitsToFloat(word);
#endif
}

#define DECODE_VALUE(q) float(q)
#endif

// Weight layout routing mirrors qmm.comp: flags bit 0 set means
// non-transposed weights (w batch slice [Kp, N], scales slice
// [K/group_size, N]). The gathered rhs index selects the whole batch
// slice, and both layouts pack the same per-slice word and parameter
// counts (matrix_n * words_per_row words, matrix_n * groups_per_row
// parameters), so only the per-step strides differ, selected once
// before the loop as uniform values. lhs indices index x's batch dims
// flat (lhs * matrix_m * matrix_k), which covers every input rank.
void main() {
  uint bits = params.operation;
  uint group_size = params.reduce_size;
  bool non_transposed = (params.flags & 1u) != 0u;
  uint pack_factor = 32u / bits;
  uint value_mask = (1u << bits) - 1u;
  uint words_per_row = params.matrix_k / pack_factor;
  uint groups_per_row = params.matrix_k / group_size;
  uint matrix = params.matrix_m * params.matrix_n;
#ifdef FP_MODE
  // fp scale codes are one byte per group; the affine kernels step in
  // PARAM_BYTES units, the fp kernel in single bytes.
  uint param_bytes = 1u;
#else
  uint param_bytes = PARAM_BYTES;
#endif
  uint w_row_words = params.matrix_n * words_per_row;
  uint scale_row_words = non_transposed
      ? params.matrix_k * (params.matrix_n / group_size)
      : params.matrix_n * groups_per_row;
  uint index_count = params.shape[0];
  uint lhs_word_base = params.in_strides[0];
  uint rhs_word_base = params.out_strides[0];
  uint total = index_count * matrix;
#ifdef USE_OUT_GLOBAL_SCALE
  float out_global_dec = uintBitsToFloat(
      out_global_scale_data.values[params.aux_size]) / 2688.0;
#endif
  uint stride = gl_NumWorkGroups.x * 256u;

  for (uint index = gl_GlobalInvocationID.x; index < total;
       index += stride) {
    uint batch = index / matrix;
    uint within = index - batch * matrix;
    uint row = within / params.matrix_n;
    uint column = within - row * params.matrix_n;
    uint lhs = packed_params.values[params.aux_offset + lhs_word_base +
        batch];
    uint rhs = packed_params.values[params.aux_offset + rhs_word_base +
        batch];
    uint x_base = params.lhs_offset +
        lhs * (params.matrix_m * params.matrix_k) +
        row * params.matrix_k;
    float accumulator = 0.0;
    // Flat k loop with every index derived from k. A nested group/word/
    // lane structure carrying a word_base induction variable miscompiles
    // on older Lavapipe (Mesa 22.3): the accumulated word offset pairs x
    // columns with the wrong packed words from the third word of a group
    // on, silently, for sub-byte codes. Derived indices keep the compiled
    // form straight-line and identical math everywhere.
    if (non_transposed) {
      // w batch slice [K, Np]: groups along N, scale [k][n / group_size];
      // the lane nibble and scale column are fixed per thread.
      uint w_base = params.rhs_offset + rhs * w_row_words +
          column / pack_factor;
      uint scale_base = rhs * scale_row_words + column / group_size;
      uint lane_shift = (column % pack_factor) * bits;
      uint param_step = params.matrix_n / group_size;
      for (uint k = 0u; k < params.matrix_k; ++k) {
        uint word = input_w.values[
            w_base + k * (params.matrix_n / pack_factor)];
        uint q = (word >> lane_shift) & value_mask;
        float scale = decode_param((scale_base + k * param_step) *
            param_bytes);
        float bias = 0.0;
#ifndef NO_BIAS
        // shape[1] is the byte base of the bias region inside the packed
        // buffer, placed after the whole scales region.
        bias = decode_param(params.shape[1] +
            (scale_base + k * param_step) * param_bytes);
#endif
        accumulator += LOAD_VALUE(input_x.values[x_base + k]) *
            (scale * DECODE_VALUE(q) + bias);
      }
    } else {
      // w batch slice [N, Kp]: groups along K, scale [n][k / group_size].
      uint w_base = params.rhs_offset + rhs * w_row_words +
          column * words_per_row;
      uint scale_base = rhs * scale_row_words + column * groups_per_row;
      for (uint k = 0u; k < params.matrix_k; ++k) {
        uint group = k / group_size;
        uint word = input_w.values[w_base + k / pack_factor];
        uint lane = k - (k / pack_factor) * pack_factor;
        // bitfieldExtract compiles to OpBitFieldUExtract; the equivalent
        // shift+mask misdecodes lanes 1..2 (reading the next lane's nibble,
        // lane 0 reading zero) on llvmpipe Mesa 22.3 when the lane comes
        // from a division-derived index.
        uint q = bitfieldExtract(word, int(lane * bits), int(bits));
        float scale = decode_param((scale_base + group) * param_bytes);
        float bias = 0.0;
#ifndef NO_BIAS
        // shape[1] is the byte base of the bias region inside the packed
        // buffer, placed after the whole scales region.
        bias = decode_param(params.shape[1] +
            (scale_base + group) * param_bytes);
#endif
        accumulator += LOAD_VALUE(input_x.values[x_base + k]) *
            (scale * DECODE_VALUE(q) + bias);
      }
    }
#ifdef USE_OUT_GLOBAL_SCALE
    accumulator *= out_global_dec;
#endif
    output_data.values[params.output_offset + index] =
        STORE_VALUE(accumulator);
  }
}
