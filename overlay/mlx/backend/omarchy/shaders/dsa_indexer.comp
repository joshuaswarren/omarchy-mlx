#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// GLM DSA fused indexer scores (fast::DsaIndexerScores), the omarchy
// native of omlx's steel_dsa_indexer_score metallib family.
//
//   OUT[b, 0, l, k] = sum_h max( sum_d Q[b,h,l,d] * K[b,0,k,d], 0 )
//                          * W[b, l, h]
//   with the causal + pooled-ratio mask applied before the ReLU, so a
//   masked position stores exact 0 (the parity-tested contract of this
//   lane's composed fallback; upstream's metallib instead writes
//   finfo.min in its epilogue - downstream top-k treats both the same).
//
// One workgroup owns one query row l of one batch b: it stages the
// H x D query panel and the H weights into shared memory once, then
// one thread per key column k computes the whole output element with
// H float32 accumulators (d-outer/h-inner loop, each K value loaded
// once per d). The H-wide per-head score tensor never exists in
// memory: traffic is (H*D + D + H) words per output row pair instead
// of the fallback's three materialized [B,H,L,K] passes.
//
// H (32 or 64) and D (128) ride push constants; the shared panel is
// declared at the H=64 size (32 KiB) and half-used at H=32. Hosts
// gate on max_compute_shared_memory_size before dispatch.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InQ {
  uint16_t values[];
} in_q;
layout(set = 0, binding = 1, std430) readonly buffer InK {
  uint16_t values[];
} in_k;
layout(set = 0, binding = 2, std430) readonly buffer InW {
  uint16_t values[];
} in_w;
layout(set = 0, binding = 3, std430) writeonly buffer OutS {
  uint16_t values[];
} out_s;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

// Routing (mirrors the int8 kernel's spare-slot convention):
//   shape[0] = H            (32 or 64)
//   shape[1] = D            (128)
//   shape[2] = L            (query rows)
//   shape[3] = K            (key columns)
//   in_strides[0] = causal_q_offset (int, K - L)
//   in_strides[1] = mask_ratio      (0 = disabled)
//   in_strides[2] = q batch stride  (elements)
//   in_strides[3] = k batch stride  (elements)
//   out_strides[0] = w batch stride (elements)
// Buffers bind at 0 like every kernel here; offsets use lhs/rhs/output.

shared float qs[64 * 128];
shared float ws[64];

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

float load_bf16(uint16_t raw) {
  return unpackHalf2x16(uint(raw) << 16).x;
}

void main() {
  const uint H = params.shape[0];
  const uint D = params.shape[1];
  const uint L = params.shape[2];
  const uint K = params.shape[3];
  const int causal_q_offset = int(params.in_strides[0]);
  const int mask_ratio = int(params.in_strides[1]);

  const uint row = gl_WorkGroupID.x;   // b * L + l
  const uint b = row / L;
  const uint l = row % L;

  // Stage the query panel and weights for this row.
  const uint q_base = params.lhs_offset + b * params.in_strides[2];
  for (uint i = gl_LocalInvocationID.x; i < H * D; i += 256u) {
    qs[i] = load_bf16(in_q.values[q_base + i]);
  }
  const uint w_base = params.rhs_offset + b * params.out_strides[0] + l * H;
  for (uint i = gl_LocalInvocationID.x; i < H; i += 256u) {
    ws[i] = load_bf16(in_w.values[w_base + i]);
  }
  barrier();

  const uint k_col = gl_WorkGroupID.y * 256u + gl_LocalInvocationID.x;
  if (k_col >= K) {
    return;
  }

  // Mask: causal is c <= causal_q_offset + l; pooled ratio adds
  // c < (causal_q_offset + l + 1) / mask_ratio. Invalid -> store 0.
  bool valid = true;
  if (mask_ratio > 0) {
    valid = (int(k_col) < (causal_q_offset + int(l) + 1) / mask_ratio);
  }
  if (valid && (params.flags & 1u) != 0u) {
    valid = (int(k_col) <= causal_q_offset + int(l));
  }

  float acc[64];
  if (valid) {
    for (uint h = 0u; h < H; ++h) {
      acc[h] = 0.0;
    }
    const uint k_base = params.rhs_offset + b * params.in_strides[3]
        + k_col * D;
    for (uint d = 0u; d < D; ++d) {
      const float kv = load_bf16(in_k.values[k_base + d]);
      for (uint h = 0u; h < H; ++h) {
        acc[h] += qs[h * D + d] * kv;
      }
    }
  }

  float total = 0.0;
  if (valid) {
    for (uint h = 0u; h < H; ++h) {
      total += max(acc[h], 0.0) * ws[h];
    }
  }
  out_s.values[params.output_offset + row * K + k_col] = bf16_store(total);
}
