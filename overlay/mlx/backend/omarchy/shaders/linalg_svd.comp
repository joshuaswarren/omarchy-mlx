//
// Wave 7, SVD phase 1: one-sided Jacobi sweeps over the C columns of the
// R x C work copy (LAPACK gesdd semantics, phase one of two). Every
// column pair rotates until all pairs are numerically orthogonal; a sweep
// with no rotation has converged, and the 60-sweep cap pins status 3 for
// the host, which raises a named error instead of returning factors that
// never were a decomposition. operation 0 also accumulates V into the
// first C x C dense cells of the u_out buffer; operation 1 (values only)
// extracts and sorts the singular values directly.
//
// Push-constant routing: matrix_m is R (kernel rows: M tall, N wide),
// matrix_n is C (kernel columns, min(M, N)), output_size the batch matrix
// count, and flags bit 0 the wide convention (the work copy holds A^T).
#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) coherent buffer Work {
  float values[];
} work;
layout(set = 0, binding = 1, std430) coherent buffer UOut {
  float values[];
} u_out;
layout(set = 0, binding = 2, std430) writeonly buffer SOut {
  float values[];
} s_out;
layout(set = 0, binding = 3, std430) buffer Status {
  uint values[];
} status;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float red[256];
shared float red2[256];
shared float red3[256];
shared float rot_c;
shared float rot_s;
shared uint rot_count;
shared float rot_defect;
shared uint converged;
shared float norms[1024];
shared uint perm[1024];

void main() {
  uint tid = gl_LocalInvocationID.x;
  uint r = params.matrix_m;
  uint c = params.matrix_n;
  // The host chunks the batch so no dispatch exceeds 65535 workgroups;
  // aux_offset carries this dispatch's first matrix index (the field is
  // unused by every linalg shader).
  uint matrix = params.aux_offset + gl_WorkGroupID.x;
  uint base = matrix * r * c;
  bool accumulate_v = params.operation == 0u;

  if (tid == 0u) {
    rot_count = 0u;
    converged = 0u;
  }
  memoryBarrierBuffer();
  if (accumulate_v) {
    // The host binds a fresh allocation as u_out; the V accumulation below
    // composes rotations as V <- V * G, so the seed must be the identity.
    // Without it V stays at whatever the allocator returned (observed as
    // zeros) and every downstream consumer of V is silently wrong.
    for (uint idx = tid; idx < c * c; idx += 256u) {
      uint row = idx / c;
      uint col = idx % c;
      u_out.values[matrix * c * c + idx] = (row == col) ? 1.0 : 0.0;
    }
  }
  memoryBarrierBuffer();
  barrier();
  const uint max_sweeps = 60u;
  for (uint sweep = 0u; sweep < max_sweeps; ++sweep) {
    if (tid == 0u) {
      rot_count = 0u;
      rot_defect = 0.0;
    }
      memoryBarrierBuffer();
    barrier();
    for (uint i = 0u; i + 1u < c; ++i) {
      for (uint j = i + 1u; j < c; ++j) {
        // Reduce w_i . w_j, ||w_i||^2, and ||w_j||^2 over R rows.
        float pd = 0.0;
        float pi = 0.0;
        float pj = 0.0;
        for (uint t = tid; t < r; t += 256u) {
          float x = work.values[base + t * c + i];
          float y = work.values[base + t * c + j];
          pd += x * y;
          pi += x * x;
          pj += y * y;
        }
        red[tid] = pd;
        red2[tid] = pi;
        red3[tid] = pj;
          memoryBarrierBuffer();
        barrier();
        for (uint stride = 128u; stride > 0u; stride >>= 1u) {
          if (tid < stride) {
            red[tid] += red[tid + stride];
            red2[tid] += red2[tid + stride];
            red3[tid] += red3[tid + stride];
          }
          memoryBarrierBuffer();
          barrier();
        }
        if (tid == 0u) {
          float dot = red[0];
          float n2i = red2[0];
          float n2j = red3[0];
          // Pair-relative orthogonality defect drives both the skip and
          // the sweep convergence test; f32 rounding noise cannot spin
          // the sweep loop the way a zero-rotation count can.
          float defect = (n2i > 0.0 && n2j > 0.0)
              ? abs(dot) / sqrt(n2i * n2j)
              : 0.0;
          rot_defect = max(rot_defect, defect);
          if (defect <= 1e-6f) {
            rot_c = 1.0;
            rot_s = 0.0;
          } else {
            float gamma = (n2j - n2i) / (2.0 * dot);
            float t = (gamma >= 0.0)
                ? 1.0 / (gamma + sqrt(1.0 + gamma * gamma))
                : -1.0 / (-gamma + sqrt(1.0 + gamma * gamma));
            rot_c = 1.0 / sqrt(1.0 + t * t);
            rot_s = t * rot_c;
            rot_count++;
          }
        }
          memoryBarrierBuffer();
        barrier();
        // Apply whenever a rotation was computed. Gating on rot_c == 1.0
        // is wrong: for a tiny-but-above-skip-threshold dot, rot_c rounds
        // to 1.0f while rot_s still carries the correction, and skipping
        // here stalls the pair forever between the skip and convergence
        // thresholds.
        if (rot_s == 0.0) {
          continue;
        }
        float cr = rot_c;
        float sr = rot_s;
        for (uint t = tid; t < r; t += 256u) {
          float x = work.values[base + t * c + i];
          float y = work.values[base + t * c + j];
          work.values[base + t * c + i] = cr * x - sr * y;
          work.values[base + t * c + j] = sr * x + cr * y;
        }
        if (accumulate_v) {
          memoryBarrierBuffer();
          barrier();
          for (uint t = tid; t < c; t += 256u) {
            float x = u_out.values[matrix * c * c + t * c + i];
            float y = u_out.values[matrix * c * c + t * c + j];
            u_out.values[matrix * c * c + t * c + i] = cr * x - sr * y;
            u_out.values[matrix * c * c + t * c + j] = sr * x + cr * y;
          }
        }
          memoryBarrierBuffer();
        barrier();
      }
    }
    if (tid == 0u && rot_defect <= 1e-6f) {
      converged = 1u;
    }
      memoryBarrierBuffer();
    barrier();
    if (converged == 1u) {
      break;
    }
  }
  if (tid == 0u && converged == 0u) {
    status.values[matrix] = 3u;
  }

  if (params.operation == 1u) {
    // Values-only: the column norms are the singular values; sort them
    // descending through a shared permutation.
    for (uint j = tid; j < c; j += 256u) {
      float part = 0.0;
      for (uint t = 0u; t < r; ++t) {
        float x = work.values[base + t * c + j];
        part += x * x;
      }
      norms[j] = sqrt(part);
    }
      memoryBarrierBuffer();
    barrier();
    if (tid == 0u) {
      for (uint j = 0u; j < c; ++j) {
        perm[j] = j;
      }
      for (uint i = 1u; i < c; ++i) {
        uint pi = perm[i];
        float di = norms[pi];
        uint j = i;
        while (j > 0u && norms[perm[j - 1u]] < di) {
          perm[j] = perm[j - 1u];
          j--;
        }
        perm[j] = pi;
      }
    }
      memoryBarrierBuffer();
    barrier();
    for (uint j = tid; j < c; j += 256u) {
      s_out.values[matrix * c + j] = norms[perm[j]];
    }
  }
}
