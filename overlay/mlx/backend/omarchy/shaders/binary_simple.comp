#version 460

// Lean fast path for contiguous / scalar-broadcast binary add, multiply,
// divide, and subtract on f32, f16, and bf16 storage. Avoids the 5.8 KB
// ElementwiseLite uber-shader (11-op switch, transcendental ops, N-D stride
// loop, and integer modulo) while keeping bit-identical float32 arithmetic
// and the same push-constant layout.

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE float16_t
#define LOAD_VAL(x) float(x)
#define STORE_VAL(v) float16_t(v)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE uint16_t
#define LOAD_VAL(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VAL(v) bf16_store(v)
#else
#define STORAGE float
#define LOAD_VAL(x) (x)
#define STORE_VAL(v) (v)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  STORAGE values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  STORAGE values[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  bool lhs_scalar = (params.lhs_size == 1u);
  bool rhs_scalar = (params.rhs_size == 1u);
  float lhs_s = lhs_scalar ? LOAD_VAL(input_a.values[params.lhs_offset]) : 0.0;
  float rhs_s = rhs_scalar ? LOAD_VAL(input_b.values[params.rhs_offset]) : 0.0;
  while (index < params.count) {
    float lhs =
        lhs_scalar ? lhs_s : LOAD_VAL(input_a.values[params.lhs_offset + index]);
    float rhs =
        rhs_scalar ? rhs_s : LOAD_VAL(input_b.values[params.rhs_offset + index]);
    float value;
    if (params.operation == 0u) {
      value = lhs + rhs;
    } else if (params.operation == 1u) {
      value = lhs * rhs;
    } else if (params.operation == 2u) {
      value = lhs / rhs;
    } else {
      value = lhs - rhs;
    }
    output_data.values[params.output_offset + index] = STORE_VAL(value);
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
