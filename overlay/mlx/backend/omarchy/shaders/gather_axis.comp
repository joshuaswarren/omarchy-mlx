//
// Axis-aware gather (take_along_axis). src and indices are broadcast to a
// common non-axis shape; out has the shape of the (dense) index array and
// out[t] copies src[src_elem(t)] where the axis coordinate is
// offset_neg_idx(indices[t]) and every other coordinate comes from t.
// params.operation selects the index interpretation: 0 = int32, 1 =
// uint32, 2 = int64 as two little-endian words. An index outside
// [0, src_axis_extent) writes a zero, the same documented deviation the
// axis-0 row gather makes; upstream leaves such reads undefined.
//
// SRC broadcasting: non-axis strides arrive explicitly (in_strides), so a
// broadcast src (zero strides on singleton-expanded axes) reads correctly.
// The index array must be dense; its flat element index is the output
// index t. USE_U32 and USE_I64 copy raw storage without conversion;
// 16-bit types store through their storage type.

#version 460

#ifdef USE_COMPLEX
#define STORAGE_TYPE vec2
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#elif defined(USE_FP16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#elif defined(USE_U32)
#define STORAGE_TYPE uint
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#elif defined(USE_BOOL)
#define STORAGE_TYPE uint
#define LOAD_BOOL_LANE(word, lane) (((word) >> ((lane) * 8u)) & 0xFFu)
#define STORE_BOOL(b) ((b) ? 1u : 0u)
#elif defined(USE_I64)
#define STORAGE_TYPE uvec2
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Source {
  STORAGE_TYPE values[];
} src_data;
layout(set = 0, binding = 1, std430) readonly buffer Indices {
  int values[];
} indices_data;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

void main() {
  uint t = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  uint axis_extent = params.reduce_size;
  uint m_axis = params.aux_size;
  uint post_size = params.output_size;
  uint dims = params.flags;
  uint pre_dims = params.matrix_m;
  while (t < params.count) {
    // t decomposes as slot * (m_axis * post_size) + ax * post_size +
    // post; the remainder must strip the full slot prefix, not just
    // slot * m_axis, or every slot past the first misreads post.
    uint slot = t / (m_axis * post_size);
    uint rem = t - slot * (m_axis * post_size);
    uint ax = rem / post_size;
    uint post = rem - ax * post_size;
    // Walk the non-axis dims: coordinates come from slot for the pre
    // dims and from post for the post dims, so src reads use explicit
    // strides and stay correct for broadcast sources.
    uint src_elem = 0u;
    uint coord_scale = 1u;
    for (uint i = dims; i > pre_dims; --i) {
      uint dim = params.shape[i - 1u];
      uint coord = (post / coord_scale) % dim;
      src_elem += coord * params.in_strides[i - 1u];
      coord_scale *= dim;
    }
    coord_scale = 1u;
    for (uint i = pre_dims; i > 0u; --i) {
      uint dim = params.shape[i - 1u];
      uint coord = (slot / coord_scale) % dim;
      src_elem += coord * params.in_strides[i - 1u];
      coord_scale *= dim;
    }
    uint word = uint(
        indices_data.values
            [params.rhs_offset + (params.operation == 2u ? t + t : t)]);
    uint index = axis_extent;
    if (params.operation == 0u) {
      // Negative int32 indices wrap: -1 maps to axis_extent - 1.
      index = word < 0x80000000u ? word : axis_extent + word;
    } else if (params.operation == 1u) {
      index = word;
    } else {
      uint high =
          uint(indices_data.values[params.rhs_offset + t + t + 1u]);
      if (high == 0u) {
        index = word;
      } else if (high == 0xFFFFFFFFu) {
        index = axis_extent + word;
      }
    }
#if defined(USE_COMPLEX) || defined(USE_U32) || defined(USE_I64)
    STORAGE_TYPE value = STORAGE_TYPE(0);
#else
    float value = 0.0;
#endif
#ifdef USE_BOOL
    uint in_elem = params.lhs_offset + src_elem +
        index * params.matrix_n;
    bool bvalue = (index < axis_extent)
        ? (LOAD_BOOL_LANE(src_data.values[in_elem >> 2u],
                          in_elem & 3u) != 0u)
        : false;
    uint out_elem = params.output_offset + t;
    uint out_byte = out_elem & 3u;
    atomicOr(output_data.values[out_elem >> 2u],
             STORE_BOOL(bvalue) << (out_byte * 8u));
#else
    if (index < axis_extent) {
      value = LOAD_VALUE(
          src_data.values[params.lhs_offset + src_elem +
                          index * params.matrix_n]);
    }
    output_data.values[params.output_offset + t] = STORE_VALUE(value);
#endif
    if (params.count - t <= stride) {
      break;
    }
    t += stride;
  }
}
