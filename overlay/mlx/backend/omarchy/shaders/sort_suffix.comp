//
// Sort/ArgSort over the last axis. One workgroup handles one row: it loads
// the row into shared memory as (key, index) pairs, pads the row to a
// power of two with a key that sorts after every real element, and runs a
// bitonic sort. Float and complex modes place NaNs after every non-NaN;
// other complex values compare lexicographically by real then imaginary.
// Integer modes sort as unsigned keys: uint32 compares by magnitude, and int32 reinterprets its
// bits into an order-preserving key by flipping the sign bit. Equal keys
// order by source index, so both the value variant and the ARGSORT index
// variant produce the unique stable order. Rows up to 1024 elements fit
// the shared arrays. The wide-row path (dispatch_sort_wide) reuses this
// kernel as its in-block stage: chunk mode slices each padded row into
// reduce_size-element chunks, passes the chunks-per-row count in
// rhs_size, and sorts each chunk with the block-parity direction the
// k <= 1024 network stages leave behind.
// Small rows use stable ranks to avoid a barrier at every bitonic stage.
// The rank loop is bounded to 128 elements; larger rows retain the network.

#version 460

#if defined(USE_I16) || defined(USE_U16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif

#if defined(USE_C64)
#define STORAGE_TYPE vec2
#define KEY_TYPE vec2
#define LOAD_KEY(x) (x)
#define STORE_KEY(k) (k)
#define PAD_KEY vec2(uintBitsToFloat(0x7fc00000u))
#elif defined(USE_FP16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_KEY(x) float(x)
#define STORE_KEY(k) STORAGE_TYPE(k)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_KEY(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_KEY(k) bf16_store(k)
#elif defined(USE_I32)
#define STORAGE_TYPE int
#define KEY_TYPE uint
// Order-preserving map from int32 to uint32: flip the sign bit. Negative
// words map below non-negative words, and the mapping is monotone.
#define LOAD_KEY(x) (uint(x) ^ 0x80000000u)
#define STORE_KEY(k) int((k) ^ 0x80000000u)
#define PAD_KEY 0xFFFFFFFFu
#elif defined(USE_I8) || defined(USE_U8)
// Byte elements ride uint32 words (one element per byte lane); the
// load widens to the compute word, int8 sign-extending first. Keys
// use the same order-preserving sign-bit flip as int32; uint8 keys
// compare by magnitude directly. The value-sort output inserts bytes
// with the commuting atomicAnd/atomicOr lane pair, so the output
// buffer is read-modify-write.
#define BYTE_STORAGE 1
#define KEY_TYPE uint
#define PAD_KEY 0xFFFFFFFFu
#ifdef USE_I8
#define LOAD_KEY(word, lane)                                                  \
  (uint(((BYTE_AT(word, lane) & 0x80u) != 0u                                  \
             ? int(BYTE_AT(word, lane) | 0xFFFFFF00u)                         \
             : int(BYTE_AT(word, lane))))                                     \
   ^ 0x80000000u)
#define STORE_BITS(key) ((key) ^ 0x80000000u)
#else
#define LOAD_KEY(word, lane) BYTE_AT(word, lane)
#define STORE_BITS(key) (key)
#endif
#elif defined(USE_I16) || defined(USE_U16)
// Half elements ride uint16_t storage (16-bit storage feature); the
// int16 load sign-extends. Same key maps as the 32-bit integer pair.
#define HALF_STORAGE 1
#define KEY_TYPE uint
#define PAD_KEY 0xFFFFFFFFu
#ifdef USE_I16
#define LOAD_KEY(h)                                                           \
  (uint((((h) & 0x8000u) != 0u ? int(uint(h) | 0xFFFF0000u) : int(uint(h))))  \
   ^ 0x80000000u)
#define STORE_BITS(key) ((key) ^ 0x80000000u)
#else
#define LOAD_KEY(h) (uint(h))
#define STORE_BITS(key) (key)
#endif
#define STORE_KEY(k) uint16_t(STORE_BITS(k))
#elif defined(USE_U32)
#define STORAGE_TYPE uint
#define KEY_TYPE uint
#define LOAD_KEY(x) (x)
#define STORE_KEY(k) (k)
#define PAD_KEY 0xFFFFFFFFu
#else
#define STORAGE_TYPE float
#define LOAD_KEY(x) float(x)
#define STORE_KEY(k) STORAGE_TYPE(k)
#endif

#ifdef BYTE_STORAGE
#define STORAGE_TYPE uint
#elif defined(HALF_STORAGE)
#define STORAGE_TYPE uint16_t
#endif

// Honeykrisp miscompiles data-dependent shift-then-mask byte
// extraction; four constant shifts picked by a select chain are the
// receipt-proven equivalent (scatter.comp BYTE_AT).
#define BYTE_AT(word, lane)                                                   \
  ((lane) == 0u ? ((word) & 0xFFu)                                            \
       : (lane) == 1u ? (((word) >> 8u) & 0xFFu)                              \
       : (lane) == 2u ? (((word) >> 16u) & 0xFFu)                             \
                      : (((word) >> 24u) & 0xFFu))

#ifndef KEY_TYPE
#define KEY_TYPE float
#endif

#ifndef PAD_KEY
#define PAD_KEY uintBitsToFloat(0x7fc00000u)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
#ifdef ARGSORT
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  uint values[];
} output_data;
#elif defined(BYTE_STORAGE)
layout(set = 0, binding = 2, std430) buffer Output {
  uint values[];
} output_data;
#else
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
} params;

shared KEY_TYPE row_keys[1024];
shared uint row_indices[1024];

#if defined(USE_I32) || defined(USE_U32) || defined(BYTE_STORAGE) ||           \
    defined(HALF_STORAGE)
// Strict order on (key, index). Equal keys break on the smaller source
// index, so duplicates keep the unique stable order.
bool key_less(KEY_TYPE key_a, uint index_a, KEY_TYPE key_b, uint index_b) {
  return key_a < key_b || (key_a == key_b && index_a < index_b);
}
#elif defined(USE_C64)
bool key_less(vec2 value_a, uint index_a, vec2 value_b, uint index_b) {
  bool nan_a = isnan(value_a.x) || isnan(value_a.y);
  bool nan_b = isnan(value_b.x) || isnan(value_b.y);
  if (nan_a != nan_b) {
    return nan_b;
  }
  if (nan_a) {
    return index_a < index_b;
  }
  return value_a.x < value_b.x ||
      (value_a.x == value_b.x &&
       (value_a.y < value_b.y ||
        (value_a.y == value_b.y && index_a < index_b)));
}
#else
// Strict order on (value, index) keys. A NaN key sorts after every number,
// and two NaN keys order by source index, which also keeps real NaNs ahead
// of the NaN padding.
bool key_less(float value_a, uint index_a, float value_b, uint index_b) {
  bool nan_a = isnan(value_a);
  bool nan_b = isnan(value_b);
  if (nan_a != nan_b) {
    return nan_b;
  }
  if (nan_a) {
    return index_a < index_b;
  }
  return value_a < value_b || (value_a == value_b && index_a < index_b);
}
#endif

// Chunk mode turns chunk-local load positions into row positions: the
// chunk's base inside its padded row is the chunk-within-row index times
// the chunk length, which rhs_size carries as chunks per row. Row mode
// keeps plain load positions.
uint index_base(uint row, uint index) {
  if (params.rhs_size == 0u) {
    return index;
  }
  return (row % params.rhs_size) * params.reduce_size + index;
}

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  uint padded = 1u;
  while (padded < row_length) {
    padded <<= 1u;
  }
  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;
    for (uint index = thread; index < padded; index += 256u) {
      if (index < row_length) {
#ifdef BYTE_STORAGE
        uint li = start + index;
        row_keys[index] =
            LOAD_KEY(input_data.values[li >> 2u], li & 3u);
#else
        row_keys[index] = LOAD_KEY(input_data.values[start + index]);
#endif
      } else {
        row_keys[index] = PAD_KEY;
      }
      row_indices[index] = index_base(row, index);
    }
    barrier();
    if (params.rhs_size == 0u && row_length <= 128u) {
      KEY_TYPE key = PAD_KEY;
      uint rank = 0u;
      if (thread < row_length) {
        key = row_keys[thread];
        for (uint other = 0u; other < row_length; ++other) {
          rank += uint(key_less(row_keys[other], other, key, thread));
        }
      }
      barrier();
      if (thread < row_length) {
        row_keys[rank] = key;
        row_indices[rank] = thread;
      }
    } else {
      for (uint k = 2u; k <= padded; k <<= 1u) {
        for (uint j = k >> 1u; j > 0u; j >>= 1u) {
          barrier();
          for (uint index = thread; index < padded; index += 256u) {
            uint partner = index ^ j;
            if (partner > index) {
              KEY_TYPE key = row_keys[index];
              uint index_key = row_indices[index];
              KEY_TYPE partner_key = row_keys[partner];
              uint partner_index_key = row_indices[partner];
              bool ascending = (index & k) == 0u;
              if (params.rhs_size != 0u && k == padded) {
                ascending = (row & 1u) == 0u;
              }
              bool swap = ascending
                  ? key_less(partner_key, partner_index_key, key, index_key)
                  : key_less(key, index_key, partner_key, partner_index_key);
              if (swap) {
                row_keys[index] = partner_key;
                row_indices[index] = partner_index_key;
                row_keys[partner] = key;
                row_indices[partner] = index_key;
              }
            }
          }
        }
      }
    }
    barrier();
    for (uint index = thread; index < row_length; index += 256u) {
#ifdef ARGSORT
      output_data.values[params.output_offset + row * row_length + index] =
          row_indices[index];
#elif defined(BYTE_STORAGE)
      {
        uint si = params.output_offset + row * row_length + index;
        uint sshift = (si & 3u) * 8u;
        atomicAnd(output_data.values[si >> 2u], ~(0xFFu << sshift));
        atomicOr(output_data.values[si >> 2u],
            (uint(STORE_BITS(row_keys[index])) & 0xFFu) << sshift);
      }
#else
      output_data.values[params.output_offset + row * row_length + index] =
          STORE_KEY(row_keys[index]);
#endif
    }
    barrier();
  }
}
