#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_bfloat16 : require

// RDNA/RADV-shaped qmm prefill coopmat: bf16 operands on the 16x16x16
// bf16 x bf16 -> f32 subgroup shape RADV advertises on GFX11+ (WMMA),
// for parts that have cooperative matrix but not the 8x8x8 fp32 shape
// the shipped qmm_coopmat.comp requires (measured: RADV GFX1201 lists
// only 16x16x16 shapes). A 64-lane workgroup is two subgroups at
// subgroup size 32; each subgroup owns one 16-row block (TILE_M=32).
// The A tile loads straight from the bf16 activation buffer as a bf16
// matrix operand - no widen pass and no x_s staging; B is dequantized
// 4-bit -> bf16 into shared w_s with the shipped f32 dequant math
// (rounded on store). Accumulator and drain are f32 like the shipped
// kernel. NOT bit-identical to the f32 route (bf16 operand rounding);
// correctness is verified by output tolerance against the FMA path.
// Q4 group-64 transposed bf16 only; matrix_m % 32 == 0 and
// matrix_k % 64 == 0 are host gates, so every tile is full.

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint STEP_K = 16u;
const uint CHUNK_K = 64u;
const uint MAT_M = 16u;
const uint MAT_N = 16u;
const uint MAT_K = 16u;
const uint W_STRIDE = 32u;
const uint NB = TILE_N / MAT_N; // 2 N-blocks per tile

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  bfloat16_t values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  uint16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  uint16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared bfloat16_t w_s[STEP_K * W_STRIDE]; // 16 x 32 bf16 dequant tile
shared float drain_s[MAT_M * MAT_N];      // one 16x16 f32 acc scratch

uint g_lid;
uint g_sub_rb;
uint g_wcol;
uint g_wpart;
uint g_k_chunks;
uint g_words_per_row;
uint g_groups_per_row;

uint16_t out_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

void qmm_tile(uint tile_row, uint tile_col, uint b) {
  uint row_base = tile_row * TILE_M;
  uint col_base = tile_col * TILE_N;
  uint w_slice = params.rhs_offset + b * params.shape[1];
  uint scale_slice = params.aux_offset + b * params.shape[2];
  uint bias_slice = params.aux_size + b * params.shape[2];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
  uint x_slice = params.lhs_offset + b * x_batch_rows;
  uint out_slice =
      params.output_offset + b * params.matrix_m * params.matrix_n;
  uint column = col_base + g_wcol;
  bool column_ok = column < params.matrix_n;
  uint w_row = w_slice + column * g_words_per_row;
  uint scale_row = scale_slice + column * g_groups_per_row;
  uint bias_row = bias_slice + column * g_groups_per_row;

  coopmat<float, gl_ScopeSubgroup, MAT_M, MAT_N, gl_MatrixUseAccumulator>
      acc[NB];
  for (uint cb = 0u; cb < NB; ++cb) {
    acc[cb] = coopmat<float, gl_ScopeSubgroup, MAT_M, MAT_N,
        gl_MatrixUseAccumulator>(0.0);
  }

  for (uint chunk = 0u; chunk < g_k_chunks; ++chunk) {
    float scale = 0.0;
    float bias = 0.0;
    if (column_ok) {
      scale = uintBitsToFloat(uint(scales.values[scale_row + chunk]) << 16u);
      bias = uintBitsToFloat(uint(biases.values[bias_row + chunk]) << 16u);
    }
    for (uint step = 0u; step < CHUNK_K / STEP_K; ++step) {
      uint k_base = chunk * CHUNK_K + step * STEP_K;
      uint packed = column_ok
          ? input_w.values[w_row + k_base / 8u + g_wpart] : 0u;
      uint w_base = 8u * g_wpart * W_STRIDE + g_wcol;
      w_s[w_base + 0u * W_STRIDE] =
          bfloat16_t(scale * float(packed & 0xFu) + bias);
      w_s[w_base + 1u * W_STRIDE] =
          bfloat16_t(scale * float((packed >> 4u) & 0xFu) + bias);
      w_s[w_base + 2u * W_STRIDE] =
          bfloat16_t(scale * float((packed >> 8u) & 0xFu) + bias);
      w_s[w_base + 3u * W_STRIDE] =
          bfloat16_t(scale * float((packed >> 12u) & 0xFu) + bias);
      w_s[w_base + 4u * W_STRIDE] =
          bfloat16_t(scale * float((packed >> 16u) & 0xFu) + bias);
      w_s[w_base + 5u * W_STRIDE] =
          bfloat16_t(scale * float((packed >> 20u) & 0xFu) + bias);
      w_s[w_base + 6u * W_STRIDE] =
          bfloat16_t(scale * float((packed >> 24u) & 0xFu) + bias);
      w_s[w_base + 7u * W_STRIDE] =
          bfloat16_t(scale * float(packed >> 28u) + bias);
      barrier();

      // One matmad step: A 16x16 bf16 x B 16x16 bf16 -> acc 16x16 f32.
      coopmat<bfloat16_t, gl_ScopeSubgroup, MAT_M, MAT_K, gl_MatrixUseA>
          mat_a;
      uint row = row_base + g_sub_rb * MAT_M;
      row = min(row, params.matrix_m - 1u);
      coopMatLoad(
          mat_a, input_x.values,
          x_slice + row * params.matrix_k + k_base,
          params.matrix_k, gl_CooperativeMatrixLayoutRowMajor);
      coopmat<bfloat16_t, gl_ScopeSubgroup, MAT_K, MAT_N, gl_MatrixUseB>
          mat_b[NB];
      for (uint cb = 0u; cb < NB; ++cb) {
        coopMatLoad(
            mat_b[cb], w_s, cb * MAT_N,
            W_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
      }
      for (uint cb = 0u; cb < NB; ++cb) {
        acc[cb] = coopMatMulAdd(mat_a, mat_b[cb], acc[cb]);
      }
      barrier();
    }
  }

  // Each subgroup stores the one 16-row block it owns (g_sub_rb == rb);
  // lanes then scatter the f32 accumulator elements to the bf16 out.
  for (uint rb = 0u; rb < TILE_M / MAT_M; ++rb) {
    for (uint cb = 0u; cb < NB; ++cb) {
      if (g_sub_rb == rb) {
        coopMatStore(
            acc[cb], drain_s, 0u, MAT_N,
            gl_CooperativeMatrixLayoutRowMajor);
      }
      barrier();
      for (uint idx = g_lid; idx < MAT_M * MAT_N; idx += 64u) {
        uint r = idx / MAT_N;
        uint c = idx % MAT_N;
        uint out_row = row_base + rb * MAT_M + r;
        uint out_col = col_base + cb * MAT_N + c;
        if (out_row < params.matrix_m && out_col < params.matrix_n) {
          output_data.values[
              out_slice + out_row * params.matrix_n + out_col] =
              out_store(drain_s[idx]);
        }
      }
      barrier();
    }
  }
}

void main() {
  g_lid = gl_LocalInvocationID.x;
  // 64 lanes = 2 subgroups at subgroup size 32; each owns one of the
  // two 16-row blocks of the 32-row tile.
  g_sub_rb = gl_SubgroupID;
  g_wcol = g_lid % 32u;
  g_wpart = g_lid / 32u;
  g_k_chunks = params.matrix_k / CHUNK_K;
  g_words_per_row = params.matrix_k / 8u;
  g_groups_per_row = params.matrix_k / 64u;
  uint batch = params.shape[0];
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
  for (uint b = 0u; b < batch; ++b) {
    for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
         tile_row += gl_NumWorkGroups.y) {
      for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
           tile_col += gl_NumWorkGroups.x) {
        qmm_tile(tile_row, tile_col, b);
      }
    }
  }
}
