//
// Log-sum-exp phase 2 of 2: one workgroup per row merges the (m, s) pairs
// that logsumexp_chunk.comp wrote (`matrix_n` pairs per row, at most 256).
// With m the largest chunk maximum, the row result is
// m + log(sum(s_i * exp(m_i - m))). A NaN chunk maximum gives NaN and an
// infinite row maximum is returned as is, as in logsumexp_suffix.comp.
//
// Variants: float32 (default), -DUSE_FP16, -DUSE_BF16 (output storage).
#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

#define NEG_INF uintBitsToFloat(0xff800000u)

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Partials {
  vec2 values[];
} partial_data;
layout(set = 0, binding = 1, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
} params;

shared float block_values[256];

float nan_max(float a, float b) {
  return isnan(a) ? a : (isnan(b) ? b : (b > a ? b : a));
}

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint chunks = params.matrix_n;
  uint row = gl_WorkGroupID.x;
  vec2 pair = vec2(NEG_INF, 0.0);
  if (thread < chunks) {
    pair = partial_data.values[row * chunks + thread];
  }
  block_values[thread] = pair.x;
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      block_values[thread] =
          nan_max(block_values[thread], block_values[thread + stride]);
    }
    barrier();
  }
  float row_max = block_values[0];
  barrier();
  bool finite_max = !isinf(row_max) && !isnan(row_max);
  float term = 0.0;
  if (finite_max && !isinf(pair.x)) {
    term = pair.y * exp(pair.x - row_max);
  }
  block_values[thread] = term;
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (thread < stride) {
      block_values[thread] += block_values[thread + stride];
    }
    barrier();
  }
  if (thread == 0u) {
    float value = finite_max ? row_max + log(block_values[0]) : row_max;
    output_data.values[params.output_offset + row] = STORE_VALUE(value);
  }
}
