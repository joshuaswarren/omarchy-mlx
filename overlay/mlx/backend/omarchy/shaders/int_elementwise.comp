#version 460

// Integer elementwise kernel variants. The selector matches
// IntElementwiseOperation in primitives.cpp:
//   0 subtract  1 and  2 or  3 xor  4 left shift  5 right shift
//   6 invert  7 divmod quotient  8 modulo  9 power  10 sign
//   11 abs  12 add  13 multiply  14 square  15 minimum  16 maximum
//   17 floor divide (zero divisor gives 0)  18 negate
//
// The default blobs (no define) serve int32/uint32 with the full op
// set: wraparound subtraction, bitwise logic, and shifts are identical
// for both signednesses, so one SPIR-V variant serves both dtypes; `>>`
// follows the operand signedness (arithmetic for int32, logical for
// uint32), which is the upstream C++ behavior. The signed fixups
// compile for uint32 too and are constant-false there.
//
// The widened variants (USE_I8/USE_U8/USE_I16/USE_U16/USE_I64/USE_U64)
// serve the whole integer elementwise family on the narrow and 64-bit
// dtypes. Every operand widens to the full compute word on load, the
// op runs there, and the store truncates to the element width - the
// same modular result as the C++ operators on the narrow types. Byte
// lanes use the receipt-proven constant-shift BYTE_AT chain and the
// commuting atomicAnd/atomicOr lane pair from cast_int.comp
// (Honeykrisp miscompiles data-dependent shift-then-mask extraction;
// see docs/known-defects.md).

#ifdef USE_U32
#define STORAGE_TYPE uint
#else
#define STORAGE_TYPE int
#endif

#if defined(USE_I16) || defined(USE_U16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif
#if defined(USE_I64) || defined(USE_U64)
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#endif

layout(local_size_x = 256) in;

#if defined(USE_I8) || defined(USE_U8)
// Byte lanes ride uint32 words; the output lane insert needs
// read-modify-write atomics, so the output buffer is not writeonly.
#define VALUE_TYPE int
layout(set = 0, binding = 0, std430) readonly buffer InputA {
  uint values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  uint values[];
} input_b;
layout(set = 0, binding = 2, std430) buffer Output {
  uint values[];
} output_data;
#elif defined(USE_I16) || defined(USE_U16)
#define VALUE_TYPE int
layout(set = 0, binding = 0, std430) readonly buffer InputA {
  uint16_t values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  uint16_t values[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;
#elif defined(USE_I64) || defined(USE_U64)
// 64-bit elements ride little-endian uint32 word pairs; dispatch is
// gated on the device's shaderInt64 feature.
#ifdef USE_U64
#define VALUE_TYPE uint64_t
#else
#define VALUE_TYPE int64_t
#endif
layout(set = 0, binding = 0, std430) readonly buffer InputA {
  uint values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  uint values[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  uint values[];
} output_data;
#else
layout(set = 0, binding = 0, std430) readonly buffer InputA {
  STORAGE_TYPE values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  STORAGE_TYPE values[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  // dims == 0 selects the modulo fast path below. Otherwise the output
  // is unraveled over shape[] and lhs_strides/rhs_strides index the
  // operands; a stride of 0 broadcasts the axis.
  uint dims;
  uint shape[4];
  uint lhs_strides[4];
  uint rhs_strides[4];
} params;
layout(set = 0, binding = 3, std430) readonly buffer AxisMetadata {
  uint values[];
} axis_data;

// External broadcast transport: matrix_k carries the collapsed axis count
// and axis_data holds [extents | lhs strides | rhs strides], the
// reduce_general.comp binding-3 word order. matrix_k == 0 keeps the
// inline push-constant arrays; the host always binds the metadata slot
// (a placeholder while inline) because the interface is static.
uint axis_extent(uint index) {
  if (params.matrix_k == 0u) {
    return params.shape[index];
  }
  return axis_data.values[index];
}

uint lhs_stride_at(uint index) {
  if (params.matrix_k == 0u) {
    return params.lhs_strides[index];
  }
  return axis_data.values[params.matrix_k + index];
}

uint rhs_stride_at(uint index) {
  if (params.matrix_k == 0u) {
    return params.rhs_strides[index];
  }
  return axis_data.values[2u * params.matrix_k + index];
}

uint lhs_index_for(uint index) {
  if (params.dims == 0u) {
    return params.lhs_offset + (params.lhs_size == 1u
        ? 0u
        : (params.lhs_size == params.count ? index : index % params.lhs_size));
  }
  uint rem = index;
  uint result = params.lhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % axis_extent(uint(dim));
    rem /= axis_extent(uint(dim));
    result += coord * lhs_stride_at(uint(dim));
  }
  return result;
}

uint rhs_index_for(uint index) {
  if (params.dims == 0u) {
    return params.rhs_offset + (params.rhs_size == 1u
        ? 0u
        : (params.rhs_size == params.count ? index : index % params.rhs_size));
  }
  uint rem = index;
  uint result = params.rhs_offset;
  for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
    uint coord = rem % axis_extent(uint(dim));
    rem /= axis_extent(uint(dim));
    result += coord * rhs_stride_at(uint(dim));
  }
  return result;
}
// The compute word every variant calculates in: VALUE_TYPE on the
// widened builds, the storage word on the 32-bit builds.
#ifndef VALUE_TYPE
#define VALUE_TYPE STORAGE_TYPE
#endif

// Python-style floor division. The C++ quotient adjusted so the
// remainder takes the divisor's sign (upstream DivMod integral_op).
// Uses only SDiv (truncating, sign-of-dividend) plus signs of a and b:
// r = a - q*b is exact in modular arithmetic and carries the same
// sign information as a % b regardless of how the driver maps SRem.
VALUE_TYPE floor_quotient(VALUE_TYPE a, VALUE_TYPE b) {
  VALUE_TYPE q = a / b;
  VALUE_TYPE r = a - q * b;
  if (r != VALUE_TYPE(0) && (a < VALUE_TYPE(0)) != (b < VALUE_TYPE(0))) {
    q -= VALUE_TYPE(1);
  }
  return q;
}

// Upstream FloorDivide: floor_quotient with the CPU reference's zero
// divisor result. The divisor is swapped for 1 before the division so
// no SDiv/UDiv by zero executes (Vulkan leaves it undefined; the
// composed Divide path returned a stale register value for int32 / 0).
VALUE_TYPE floor_divide_int(VALUE_TYPE a, VALUE_TYPE b) {
  VALUE_TYPE q = floor_quotient(a, b == VALUE_TYPE(0) ? VALUE_TYPE(1) : b);
  return b == VALUE_TYPE(0) ? VALUE_TYPE(0) : q;
}

// Python-style modulo: truncating remainder adjusted by one divisor
// when the signs of remainder and divisor differ. Unsigned stays the
// raw remainder, which is already the upstream unsigned result.
VALUE_TYPE python_modulo(VALUE_TYPE a, VALUE_TYPE b) {
  VALUE_TYPE r = a % b;
  if (r != VALUE_TYPE(0) && (r < VALUE_TYPE(0)) != (b < VALUE_TYPE(0))) {
    r += b;
  }
  return r;
}
// Exponentiation by squaring with wraparound, mirroring the upstream
// integer pow. A signed negative exponent yields 0; the unsigned
// guard is constant-false.
VALUE_TYPE integer_power(VALUE_TYPE base, VALUE_TYPE exp) {
  VALUE_TYPE res = VALUE_TYPE(1);
  if (exp < VALUE_TYPE(0)) {
    return VALUE_TYPE(0);
  }
  while (exp != VALUE_TYPE(0)) {
    if ((exp & VALUE_TYPE(1)) != VALUE_TYPE(0)) {
      res *= base;
    }
    exp >>= 1;
    base *= base;
  }
  return res;
}

// Upstream Sign: -1, 0, or 1 by comparison with zero; unsigned is
// 0 or 1 (comparison with a negative constant is constant-false).
VALUE_TYPE integer_sign(VALUE_TYPE a) {
  if (a > VALUE_TYPE(0)) {
    return VALUE_TYPE(1);
  }
  if (a < VALUE_TYPE(0)) {
    return VALUE_TYPE(-1);
  }
  return VALUE_TYPE(0);
}

// The arithmetic family on top of the bitwise cases, shared by every
// variant: the cases run on the enclosing scope's VALUE_TYPE a/b and
// write VALUE_TYPE value. Semantics mirror the upstream C++
// operators on the element type: wraparound arithmetic, truncating
// divide (zero divisor is undefined upstream), Python floor/modulo
// fixups for the DivMod pair, exponentiation by squaring, Sign by
// comparison with zero (unsigned: 0 or 1), Abs by negation, and
// wraparound Negate (INT_MIN stays itself, as upstream's C++
// negation does on this platform).
#define INT_ARITH_CASES                                                       \
  case 0:                                                                     \
    value = a - b;                                                            \
    break;                                                                    \
  case 7:                                                                     \
    value = floor_quotient(a, b);                                             \
    break;                                                                    \
  case 8:                                                                     \
    value = python_modulo(a, b);                                              \
    break;                                                                    \
  case 9:                                                                     \
    value = integer_power(a, b);                                              \
    break;                                                                    \
  case 10:                                                                    \
    value = integer_sign(a);                                                  \
    break;                                                                    \
  case 11:                                                                    \
    value = a < VALUE_TYPE(0) ? -a : a;                                       \
    break;                                                                    \
  case 12:                                                                    \
    value = a + b;                                                            \
    break;                                                                    \
  case 13:                                                                    \
    value = a * b;                                                            \
    break;                                                                    \
  case 14:                                                                    \
    value = a * a;                                                            \
    break;                                                                    \
  case 15:                                                                    \
    value = a < b ? a : b;                                                    \
    break;                                                                    \
  case 16:                                                                    \
    value = a > b ? a : b;                                                    \
    break;                                                                    \
  case 17:                                                                    \
    value = floor_divide_int(a, b);                                           \
    break;                                                                    \
  case 18:                                                                    \
    value = -a;                                                               \
    break;

// Honeykrisp miscompiles shift-then-mask byte extraction with a
// data-dependent shift amount (receipt 2026-09-02-masked-scatter-m1-fix).
// Four constant shifts picked by a select chain are the receipt-proven
// equivalent. A macro, not a helper function: the same receipt keeps
// per-thread helper calls out of the hot path on this driver.
#define BYTE_AT(word, lane)                                                  \
  ((lane) == 0u ? ((word) & 0xFFu)                                           \
       : (lane) == 1u ? (((word) >> 8u) & 0xFFu)                             \
       : (lane) == 2u ? (((word) >> 16u) & 0xFFu)                            \
                      : (((word) >> 24u) & 0xFFu))

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
#if defined(USE_I8) || defined(USE_U8)
    uint aaddr = lhs_index_for(index);
    uint baddr = rhs_index_for(index);
    VALUE_TYPE a = VALUE_TYPE(BYTE_AT(
        input_a.values[aaddr >> 2u], aaddr & 3u));
    VALUE_TYPE b = VALUE_TYPE(BYTE_AT(
        input_b.values[baddr >> 2u], baddr & 3u));
#ifdef USE_I8
    // Sign-extend the byte into the compute word; the unsigned build
    // keeps the zero-extended byte.
    if ((a & VALUE_TYPE(0x80)) != VALUE_TYPE(0)) {
      a |= VALUE_TYPE(0xFFFFFF00u);
    }
    if ((b & VALUE_TYPE(0x80)) != VALUE_TYPE(0)) {
      b |= VALUE_TYPE(0xFFFFFF00u);
    }
#endif
    VALUE_TYPE value;
    switch (params.operation) {
      case 1:
        value = a & b;
        break;
      case 2:
        value = a | b;
        break;
      case 3:
        value = a ^ b;
        break;
      case 4:
        value = VALUE_TYPE(a << b);
        break;
      case 5:
        value = VALUE_TYPE(a >> b);
        break;
      case 6:
        value = ~a;
        break;
      INT_ARITH_CASES
      default:
        return;
    }
    uint daddr = params.output_offset + index;
    uint shift = (daddr & 3u) * 8u;
    atomicAnd(output_data.values[daddr >> 2u], ~(0xFFu << shift));
    atomicOr(output_data.values[daddr >> 2u], (uint(value) & 0xFFu) << shift);
#elif defined(USE_I16) || defined(USE_U16)
    VALUE_TYPE a = VALUE_TYPE(input_a.values[lhs_index_for(index)]);
    VALUE_TYPE b = VALUE_TYPE(input_b.values[rhs_index_for(index)]);
#ifdef USE_I16
    // uint16_t reads zero-extend, so the sign bit is bit 15, not the
    // compute word's sign - extend on the loaded pattern.
    if ((a & VALUE_TYPE(0x8000)) != VALUE_TYPE(0)) {
      a |= VALUE_TYPE(0xFFFF0000u);
    }
    if ((b & VALUE_TYPE(0x8000)) != VALUE_TYPE(0)) {
      b |= VALUE_TYPE(0xFFFF0000u);
    }
#endif
    VALUE_TYPE value;
    switch (params.operation) {
      case 1:
        value = a & b;
        break;
      case 2:
        value = a | b;
        break;
      case 3:
        value = a ^ b;
        break;
      case 4:
        value = VALUE_TYPE(a << b);
        break;
      case 5:
        value = VALUE_TYPE(a >> b);
        break;
      case 6:
        value = ~a;
        break;
      INT_ARITH_CASES
      default:
        return;
    }
    output_data.values[params.output_offset + index] = uint16_t(value);
#elif defined(USE_I64) || defined(USE_U64)
    uint aaddr = lhs_index_for(index);
    uint baddr = rhs_index_for(index);
#ifdef USE_U64
    VALUE_TYPE a = packUint2x32(uvec2(
        input_a.values[2u * aaddr], input_a.values[2u * aaddr + 1u]));
    VALUE_TYPE b = packUint2x32(uvec2(
        input_b.values[2u * baddr], input_b.values[2u * baddr + 1u]));
#else
    VALUE_TYPE a = packInt2x32(ivec2(
        int(input_a.values[2u * aaddr]),
        int(input_a.values[2u * aaddr + 1u])));
    VALUE_TYPE b = packInt2x32(ivec2(
        int(input_b.values[2u * baddr]),
        int(input_b.values[2u * baddr + 1u])));
#endif
    VALUE_TYPE value;
    switch (params.operation) {
      case 1:
        value = a & b;
        break;
      case 2:
        value = a | b;
        break;
      case 3:
        value = a ^ b;
        break;
      case 4:
        value = VALUE_TYPE(a << b);
        break;
      case 5:
        value = VALUE_TYPE(a >> b);
        break;
      case 6:
        value = ~a;
        break;
      INT_ARITH_CASES
      default:
        return;
    }
    uint daddr = params.output_offset + index;
#ifdef USE_U64
    uvec2 halves = unpackUint2x32(value);
#else
    uvec2 halves = uvec2(unpackInt2x32(value));
#endif
    output_data.values[2u * daddr] = halves.x;
    output_data.values[2u * daddr + 1u] = halves.y;
#else
    STORAGE_TYPE a = input_a.values[lhs_index_for(index)];
    STORAGE_TYPE b = input_b.values[rhs_index_for(index)];
    STORAGE_TYPE value;
    switch (params.operation) {
      case 0:
        value = a - b;
        break;
      case 1:
        value = a & b;
        break;
      case 2:
        value = a | b;
        break;
      case 3:
        value = a ^ b;
        break;
      case 4:
        value = a << b;
        break;
      case 5:
        value = a >> b;
        break;
      case 6:
        value = ~a;
        break;
      case 7:
        value = floor_quotient(a, b);
        break;
      case 8:
        value = python_modulo(a, b);
        break;
      case 9:
        value = integer_power(a, b);
        break;
      case 10:
        value = integer_sign(a);
        break;
      case 11:
        // Upstream Abs negates negatives; INT_MIN wraps to itself the
        // way upstream's C++ negation does on this platform.
        value = a < STORAGE_TYPE(0) ? -a : a;
        break;
      case 12:
        value = a + b;
        break;
      case 13:
        value = a * b;
        break;
      case 14:
        value = a * a;
        break;
      case 15:
        // Upstream Minimum/Maximum on integers: the plain min/max; NaN
        // propagation cannot arise for integers.
        value = a < b ? a : b;
        break;
      case 16:
        value = a > b ? a : b;
        break;
      case 17:
        // Upstream FloorDivide: Python floor semantics, a zero
        // divisor gives 0 (the CPU reference).
        value = floor_divide_int(a, b);
        break;
      case 18:
        // Negative: wraparound negation, matching upstream's C++
        // unary minus (INT_MIN stays itself, unsigned wraps).
        value = -a;
        break;
      default:
        return;
    }
    output_data.values[params.output_offset + index] = value;
#endif
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
