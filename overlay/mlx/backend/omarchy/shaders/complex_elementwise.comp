// Complex64 elementwise kernel. One element is a vec2 (re, im) in a
// std430 storage buffer, the same paired-float layout the FFT kernels
// use, so a complex64 item is two consecutive float32 words and every
// offset in the params is an item offset. Operation codes match the
// ComplexOperation enum in ../primitives.cpp: 0 conjugate, 1 add,
// 2 subtract, 3 multiply, 4 divide, 5 negate, 6 logaddexp, 7 power,
// 8 exp, 9 sin, 10 cos, 11 maximum, 12 sinh, 13 cosh, 14 tan,
// 15 tanh, 16 log1p, 17 sign, 18 arccos, 19 arcsin, 20 arctan,
// 21 sqrt, 22 rsqrt, 23 log, 24 log2, 25 log10, 26 round.
// Sinh/cosh/tan/tanh mirror the glibc formulas the CPU backend reaches
// through std::complex, log1p the
// upstream simd::log1p complex branch, and sign the upstream
// z/|z| rule with the zero element mapping to itself. Division uses
// Smith's scaled algorithm to avoid avoidable overflow and underflow while
// retaining upstream std::complex<float> zero-denominator semantics. Power
// mirrors glibc cpowf
// (principal branch on the negative axis, zero-base special cases).
// Broadcast indexing mirrors elementwise.comp: dims == 0 selects the
// modulo fast path, otherwise the output index unravels over shape[]
// and a stride of 0 broadcasts the axis.

#version 460

#extension GL_GOOGLE_include_directive : require
#include "omarchy_trig.h"

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  vec2 values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  vec2 values[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  vec2 values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint lhs_strides[4];
  uint rhs_strides[4];
} params;

layout(set = 0, binding = 3, std430) readonly buffer AxisMetadata {
  uint values[];
} axis_data;

// Rank>4 broadcast transport: matrix_k carries the collapsed axis count
// and axis_data holds [extents | lhs strides | rhs strides], the
// reduce_general.comp binding-3 word order. matrix_k == 0 keeps the
// inline push-constant arrays; the host always binds the metadata slot
// (a placeholder while inline) because the interface is static.
uint axis_extent(uint index) {
  if (params.matrix_k == 0u) {
    return params.shape[index];
  }
  return axis_data.values[index];
}

uint lhs_stride_at(uint index) {
  if (params.matrix_k == 0u) {
    return params.lhs_strides[index];
  }
  return axis_data.values[params.matrix_k + index];
}

uint rhs_stride_at(uint index) {
  if (params.matrix_k == 0u) {
    return params.rhs_strides[index];
  }
  return axis_data.values[2u * params.matrix_k + index];
}

// AGX (Honeykrisp) rounding contract, measured on jwm1-linux (Mesa
// 26.1.7): (1) GLSL "/" lands up to 1 ulp from the correctly rounded
// quotient - 80/25 and 10/25 one ulp low - so the complex64 divide vjp
// pin (-3.2-0.4j) missed by one bit even though every multiply and add
// in its chain is exact; llvmpipe and the pinned CPU/Metal reference
// are correctly rounded. (2) GLSL fma() lowers to plain
// OpFMul/OpFAdd and the AGX compiler contracts those pairs into a
// native fused op that does not deliver the IEEE fused result, so
// fma-based Markstein refinement cannot restore correct rounding
// here. Reproduce the reference bits with a Dekker exact-residual
// refinement using only precise (NoContraction) IEEE multiplies and
// adds: the Veltkamp split (8193 = 2^13 + 1 for binary32) makes
// r = a - q*b exact, and one correction step q + r*(1/b) rounds to the
// correctly rounded quotient. When q is already correctly rounded the
// residual is exactly zero and the value is unchanged, so llvmpipe
// stays bit-identical. Degenerate and split-range-edge inputs keep the
// native result, preserving the zero-denominator inf/NaN semantics of
// the upstream complex division.
float precise_div(float a, float b) {
  float q = a / b;
  if (b == 0.0 || isnan(q) || isinf(q) || q == 0.0 ||
      abs(b) < 1.1754944e-38 || abs(b) > 2.8e30 ||
      abs(q) > 2.8e30) {
    return q;
  }
  precise float p = q * b;
  if (isnan(p) || isinf(p)) {
    return q;
  }
  precise float bsplit = b * 8193.0;
  precise float b_hi = bsplit - (bsplit - b);
  precise float b_lo = b - b_hi;
  precise float qsplit = q * 8193.0;
  precise float q_hi = qsplit - (qsplit - q);
  precise float q_lo = q - q_hi;
  precise float err =
      ((q_hi * b_hi - p) + q_hi * b_lo + q_lo * b_hi) + q_lo * b_lo;
  precise float r = (a - p) - err;
  precise float correction = r * (1.0 / b);
  return q + correction;
}

// Kahan log1p: log(1+v) alone cancels for small v; the rescaled form
// log(u) * v/(u-1) is exact at v = 0 and keeps full precision
// elsewhere, matching std::log1p on the CPU reference.
float log1p_f(float v) {
  float u = 1.0 + v;
  if (u == 1.0) {
    return v;
  }
  return log(u) * (v / (u - 1.0));
}

bool negative_sign(float value) {
  return (floatBitsToUint(value) & 0x80000000u) != 0u;
}

float copy_sign(float magnitude, float sign_source) {
  uint bits = floatBitsToUint(magnitude) & 0x7fffffffu;
  bits |= floatBitsToUint(sign_source) & 0x80000000u;
  return uintBitsToFloat(bits);
}

vec2 complex_multiply(vec2 lhs, vec2 rhs) {
  return vec2(
      lhs.x * rhs.x - lhs.y * rhs.y,
      lhs.x * rhs.y + lhs.y * rhs.x);
}

vec2 complex_divide(vec2 lhs, vec2 rhs) {
  float rhs_real = abs(rhs.x);
  float rhs_imag = abs(rhs.y);
  if (rhs_real >= rhs_imag) {
    float ratio = rhs.y / rhs.x;
    float denominator = rhs.x + rhs.y * ratio;
    return vec2(
        precise_div(lhs.x + lhs.y * ratio, denominator),
        precise_div(lhs.y - lhs.x * ratio, denominator));
  }
  float ratio = rhs.x / rhs.y;
  float denominator = rhs.y + rhs.x * ratio;
  return vec2(
      precise_div(lhs.x * ratio + lhs.y, denominator),
      precise_div(lhs.y * ratio - lhs.x, denominator));
}

vec2 complex_reciprocal(vec2 value) {
  if (value.x == 0.0 && value.y == 0.0) {
    return vec2(
        uintBitsToFloat(0x7f800000u), uintBitsToFloat(0xffc00000u));
  }
  if (isinf(value.x)) {
    return vec2(0.0, isinf(value.y) ? copy_sign(0.0, -value.y) : 0.0);
  }
  if (isinf(value.y)) {
    return vec2(0.0, copy_sign(0.0, -value.y));
  }
  return complex_divide(vec2(1.0, 0.0), value);
}

float complex_argument(vec2 value) {
  if (isnan(value.x) || isnan(value.y)) {
    return uintBitsToFloat(0x7fc00000u);
  }
  if (value.y == 0.0) {
    if (value.x < 0.0 || (value.x == 0.0 && negative_sign(value.x))) {
      return copy_sign(3.14159265358979323846, value.y);
    }
    return value.y;
  }
  return atan(value.y, value.x);
}

// Scale by the largest component through its binary exponent instead
// of dividing by it. value / scale is a * rcp(scale) on AGX, and Vulkan
// only promises fdiv precision for divisors up to 2^126, so a scale
// near FLT_MAX reads a flushed-denormal reciprocal and the quotient is
// 0 (FLT_MAX / FLT_MAX = 0 on Honeykrisp). ldexp keeps the scaled
// components exact, with the largest in [0.5, 1) after frexp.
int scale_exponent(float scale) {
  int exponent;
  frexp(scale, exponent);
  return exponent;
}

// Evaluate log(hypot(x, y)) from the C99 complex-log identity without
// forming hypot. Scaling keeps finite float32 inputs finite.
float complex_log_magnitude(vec2 value) {
  if (isinf(value.x) || isinf(value.y)) {
    return uintBitsToFloat(0x7f800000u);
  }
  if (isnan(value.x) || isnan(value.y)) {
    return uintBitsToFloat(0x7fc00000u);
  }
  float maximum = max(abs(value.x), abs(value.y));
  float minimum = min(abs(value.x), abs(value.y));
  if (maximum == 0.0) {
    return log(maximum);
  }
  int exponent;
  float mantissa = frexp(maximum, exponent);
  float ratio = ldexp(minimum, -exponent) / mantissa;
  return log(maximum) + 0.5 * log1p_f(ratio * ratio);
}

vec2 complex_log(vec2 value) {
  return vec2(complex_log_magnitude(value), complex_argument(value));
}

vec2 complex_sqrt(vec2 value) {
  const float POS_INF = uintBitsToFloat(0x7f800000u);
  const float QNAN = uintBitsToFloat(0x7fc00000u);
  if (isinf(value.y)) {
    return vec2(POS_INF, value.y);
  }
  if (isinf(value.x)) {
    if (value.x > 0.0) {
      return vec2(POS_INF, isnan(value.y) ? value.y : copy_sign(0.0, value.y));
    }
    return vec2(
        isnan(value.y) ? QNAN : 0.0, copy_sign(POS_INF, value.y));
  }
  if (isnan(value.x) || isnan(value.y)) {
    return vec2(QNAN, QNAN);
  }
  if (value.x == 0.0 && value.y == 0.0) {
    return vec2(0.0, value.y);
  }
  // An even exponent makes sqrt(2^e) = 2^(e/2) exact.
  int exponent = scale_exponent(max(abs(value.x), abs(value.y)));
  exponent += exponent & 1;
  vec2 normalized = ldexp(value, ivec2(-exponent));
  float magnitude = length(normalized);
  float root_scale = ldexp(1.0, exponent / 2);
  if (value.x >= 0.0) {
    float real_part = sqrt(0.5 * (magnitude + normalized.x));
    return root_scale * vec2(real_part, normalized.y / (2.0 * real_part));
  }
  float imag_abs = sqrt(0.5 * (magnitude - normalized.x));
  return root_scale * vec2(
      abs(normalized.y) / (2.0 * imag_abs), copy_sign(imag_abs, value.y));
}

float real_asinh(float value) {
  float magnitude = abs(value);
  if (isinf(magnitude) || isnan(magnitude)) {
    return value;
  }
  if (magnitude < 0.125) {
    float squared = value * value;
    return value * (1.0 - squared / 6.0 + 3.0 * squared * squared / 40.0);
  }
  float root = sqrt(1.0 + magnitude * magnitude);
  float argument = magnitude + magnitude * magnitude / (1.0 + root);
  return copy_sign(log1p_f(argument), value);
}

vec2 complex_inverse_trig_factors(vec2 value) {
  vec2 lhs = complex_sqrt(vec2(1.0 + value.x, value.y));
  vec2 rhs = complex_sqrt(vec2(1.0 - value.x, -value.y));
  return vec2(
      lhs.x * rhs.x - lhs.y * rhs.y,
      lhs.y * rhs.x - lhs.x * rhs.y);
}

// The finite moderate path uses Kahan's sqrt-product formulation. It avoids
// the cancellation from taking log of a near-unit complex value.
vec2 complex_asin(vec2 value) {
  const float LN2 = 0.69314718055994530942;
  const float QNAN = uintBitsToFloat(0x7fc00000u);
  if (isinf(value.x) || isinf(value.y)) {
    float real_part = isnan(value.x) || isnan(value.y)
        ? QNAN : atan(value.x, abs(value.y));
    return vec2(real_part, copy_sign(uintBitsToFloat(0x7f800000u), value.y));
  }
  if (isnan(value.x) || isnan(value.y)) {
    return vec2(QNAN, QNAN);
  }
  float scale = max(abs(value.x), abs(value.y));
  if (scale > 1048576.0) {
    float real_part = atan(value.x, abs(value.y));
    float imag_magnitude = complex_log_magnitude(value) + LN2;
    return vec2(real_part, copy_sign(imag_magnitude, value.y));
  }
  vec2 factors = complex_inverse_trig_factors(value);
  return vec2(
      copy_sign(abs(atan(value.x, factors.x)), value.x),
      copy_sign(abs(real_asinh(factors.y)), value.y));
}

vec2 complex_acos(vec2 value) {
  if (isinf(value.x) || isinf(value.y) ||
      isnan(value.x) || isnan(value.y)) {
    vec2 inverse_sine = complex_asin(value);
    return vec2(1.57079632679489661923 - inverse_sine.x, -inverse_sine.y);
  }
  float scale = max(abs(value.x), abs(value.y));
  if (scale > 1048576.0) {
    float edge_angle = atan(abs(value.y), abs(value.x));
    float real_part = value.x >= 0.0
        ? edge_angle : 3.14159265358979323846 - edge_angle;
    float imag_magnitude = complex_log_magnitude(value) + 0.69314718055994530942;
    return vec2(real_part, copy_sign(imag_magnitude, -value.y));
  }
  vec2 factors = complex_inverse_trig_factors(value);
  return vec2(
      atan(factors.x, value.x),
      copy_sign(abs(real_asinh(factors.y)), -value.y));
}

vec2 complex_atan(vec2 value) {
  const float HALF_PI = 1.57079632679489661923;
  const float QNAN = uintBitsToFloat(0x7fc00000u);
  if (value.x == 0.0 && value.y == 0.0) {
    return value;
  }
  if (isnan(value.x) && isinf(value.y)) {
    return vec2(QNAN, copy_sign(0.0, value.y));
  }
  if (isinf(value.x) && isnan(value.y)) {
    return vec2(copy_sign(HALF_PI, value.x), 0.0);
  }
  if (isinf(value.x)) {
    return vec2(copy_sign(HALF_PI, value.x), copy_sign(0.0, value.y));
  }
  if (isinf(value.y)) {
    return vec2(copy_sign(HALF_PI, value.x), copy_sign(0.0, value.y));
  }
  if (isnan(value.x) || isnan(value.y)) {
    return vec2(QNAN, QNAN);
  }
  float scale = max(1.0, max(abs(value.x), abs(value.y)));
  float inverse_scale = 1.0 / scale;
  vec2 normalized = value / scale;
  float numerator = 2.0 * normalized.x * inverse_scale;
  float denominator =
      (inverse_scale - normalized.y) * (inverse_scale + normalized.y) -
      normalized.x * normalized.x;
  float real_part;
  if (scale > 1048576.0 || isinf(scale)) {
    real_part = copy_sign(1.57079632679489661923, value.x);
  } else {
    float angle = numerator == 0.0 && denominator < 0.0
        ? copy_sign(3.14159265358979323846, numerator)
        : (numerator == 0.0 && denominator == 0.0
              ? numerator : atan(numerator, denominator));
    real_part = 0.5 * angle;
  }

  if (value.x == 0.0 && abs(value.y) == 1.0) {
    return vec2(value.x, copy_sign(uintBitsToFloat(0x7f800000u), value.y));
  }
  float log_plus = complex_log_magnitude(vec2(value.x, value.y + 1.0));
  float log_minus = complex_log_magnitude(vec2(value.x, value.y - 1.0));
  float log_difference = log_plus - log_minus;
  if (abs(log_difference) > 0.25) {
    return vec2(real_part, 0.5 * log_difference);
  }
  vec2 shifted = vec2(value.x, value.y - 1.0);
  int exponent = scale_exponent(max(abs(shifted.x), abs(shifted.y)));
  vec2 denominator_value = ldexp(shifted, ivec2(-exponent));
  float scaled_numerator =
      ldexp(value.y, -exponent) * ldexp(4.0, -exponent);
  float delta =
      scaled_numerator / dot(denominator_value, denominator_value);
  return vec2(real_part, 0.25 * log1p_f(delta));
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    uint lhs_index;
    uint rhs_index;
    if (params.dims == 0u) {
      lhs_index = params.lhs_offset + (params.lhs_size == 1
          ? 0u
          : (params.lhs_size == params.count ? index : index % params.lhs_size));
      rhs_index = params.rhs_offset + (params.rhs_size == 1
          ? 0u
          : (params.rhs_size == params.count ? index : index % params.rhs_size));
    } else {
      uint rem = index;
      lhs_index = params.lhs_offset;
      rhs_index = params.rhs_offset;
      for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
        uint coord = rem % axis_extent(uint(dim));
        rem /= axis_extent(uint(dim));
        lhs_index += coord * lhs_stride_at(uint(dim));
        rhs_index += coord * rhs_stride_at(uint(dim));
      }
    }
    vec2 lhs = input_a.values[lhs_index];
    vec2 rhs = input_b.values[rhs_index];
    vec2 value;
    switch (params.operation) {
      case 0:
        value = vec2(lhs.x, -lhs.y);
        break;
      case 1:
        value = lhs + rhs;
        break;
      case 2:
        value = lhs - rhs;
        break;
      case 3:
        value = vec2(
            lhs.x * rhs.x - lhs.y * rhs.y,
            lhs.x * rhs.y + lhs.y * rhs.x);
        break;
      case 4: {
        float denom = rhs.x * rhs.x + rhs.y * rhs.y;
        float re = lhs.x * rhs.x + lhs.y * rhs.y;
        float im = lhs.y * rhs.x - lhs.x * rhs.y;
        value = vec2(precise_div(re, denom), precise_div(im, denom));
        break;
      }
      case 5:
        value = -lhs;
        break;
      case 7: {
        // Upstream std::pow(complex<float>, complex<float>) =
        // exp(y * clog(x)), principal branch on the negative axis,
        // with the zero-base special cases assigned to this cluster:
        // 0^0 = 1, 0^w = 0 for re(w) > 0, NaN otherwise. glibc
        // cpowf reduces to the same formula in float32.
        if (lhs.x == 0.0 && lhs.y == 0.0) {
          if (rhs.x == 0.0 && rhs.y == 0.0) {
            value = vec2(1.0, 0.0);
          } else if (rhs.x > 0.0) {
            value = vec2(0.0);
          } else {
            const float QNAN = uintBitsToFloat(0x7fc00000u);
            value = vec2(QNAN);
          }
        } else {
          float mag = log(length(lhs));
          float arg = atan(lhs.y, lhs.x);
          vec2 t = vec2(rhs.x * mag - rhs.y * arg,
                        rhs.x * arg + rhs.y * mag);
          float ex = exp(t.x);
          value = vec2(ex * omarchy_trig_cos(t.y), ex * omarchy_trig_sin(t.y));
        }
        break;
      }
      case 8: {
        // exp(a + bi) = exp(a)*(cos b, sin b), matching std::exp(complex)
        // and glibc cexpf for normal-range inputs. C99 G.6.3.2 pins the
        // infinite-argument case: cexp(-inf + i*inf) = +0 + i0, where
        // the naive form turns 0 * cos(inf) into NaN.
        if (isinf(lhs.x) && lhs.x < 0.0 && isinf(lhs.y)) {
          value = vec2(0.0);
        } else {
          float ex = exp(lhs.x);
          value = vec2(ex * omarchy_trig_cos(lhs.y), ex * omarchy_trig_sin(lhs.y));
        }
        break;
      }
      case 9: {
        // sin(a + bi) = (sin a cosh b, cos a sinh b); glibc csinf uses
        // the same formula for |b| under ~88 (exp(b) finite). The test
        // magnitudes stay well within that range.
        float sa = omarchy_trig_sin(lhs.x);
        float ca = omarchy_trig_cos(lhs.x);
        float sh = sinh(lhs.y);
        float ch = cosh(lhs.y);
        value = vec2(sa * ch, ca * sh);
        break;
      }
      case 10: {
        // cos(a + bi) = (cos a cosh b, -sin a sinh b), matching
        // std::cos(complex) and glibc ccosf.
        float sa = omarchy_trig_sin(lhs.x);
        float ca = omarchy_trig_cos(lhs.x);
        float sh = sinh(lhs.y);
        float ch = cosh(lhs.y);
        value = vec2(ca * ch, -sa * sh);
        break;
      }
      case 11: {
        // Lexicographic maximum: (re_a > re_b) || (re_a == re_b &&
        // im_a >= im_b) selects a, matching the upstream
        // compare_complex lex order; ties favor a so max(a,b)==a.
        bool ge = (lhs.x > rhs.x) ||
            (lhs.x == rhs.x && lhs.y >= rhs.y);
        value = ge ? lhs : rhs;
        break;
      }
      case 27: {
        // Lexicographic minimum matches upstream complex64 ordering.
        bool lt = (lhs.x < rhs.x) ||
            (lhs.x == rhs.x && lhs.y < rhs.y);
        value = lt ? lhs : rhs;
        break;
      }
      case 6: {
        // Upstream complex LogAddExp: maxval + log1p(exp(minval -
        // maxval)) over the lexicographic (real, then imaginary)
        // ordering, with maxval returned directly when minval is
        // -inf or maxval is +inf (the complex -inf constant has a
        // zero imaginary part upstream). exp of a real part of -inf
        // follows the C99 cexp rule and returns {+0, +0}, which raw
        // exp*cos/sin would turn into NaN through cos(-inf).
        bool ge = (lhs.x > rhs.x) || (lhs.x == rhs.x && lhs.y >= rhs.y);
        vec2 maxv = ge ? lhs : rhs;
        vec2 minv = ge ? rhs : lhs;
        // GLSL has no inf identifier; +/-inf are the IEEE bit patterns.
        const float POS_INF = uintBitsToFloat(0x7f800000u);
        const float NEG_INF = uintBitsToFloat(0xff800000u);
        bool at_inf = (minv.x == NEG_INF && minv.y == 0.0) ||
            (maxv.x == POS_INF && maxv.y == 0.0);
        vec2 value_out;
        if (at_inf) {
          value_out = maxv;
        } else {
          vec2 diff = minv - maxv;
          vec2 cexp = diff.x == NEG_INF
              ? vec2(0.0)
              : vec2(exp(diff.x) * omarchy_trig_cos(diff.y), exp(diff.x) * omarchy_trig_sin(diff.y));
          vec2 one_plus = cexp + vec2(1.0, 0.0);
          // log(1+z): magnitude log and quadrant-aware argument; the
          // (0, 0) argument is 0 by convention (SPIR-V leaves raw
          // atan(0, 0) undefined).
          float arg = (one_plus.x == 0.0 && one_plus.y == 0.0)
              ? 0.0
              : atan(one_plus.y, one_plus.x);
          value_out = maxv + vec2(log(length(one_plus)), arg);
        }
        value = value_out;
        break;
      }
      case 12:
      case 13: {
        float sx = omarchy_trig_sin(lhs.y);
        float cx = omarchy_trig_cos(lhs.y);
        if (abs(lhs.x) <= 1.0) {
          float sh = sinh(lhs.x);
          float ch = cosh(lhs.x);
          value = params.operation == 12u
              ? vec2(sh * cx, ch * sx) : vec2(ch * cx, sh * sx);
        } else {
          // The two half-exponent multiplies keep e^|x| out of the
          // pipeline for |x| up to 2 ln(FLT_MAX). precise pins that
          // order: NIR otherwise hoists the 0.5 in sh out past both h
          // multiplies and (1 - inverse) * cx * h * h overflows first
          // (sinh(89 + 0.25i) read inf on Honeykrisp).
          float h = exp(0.5 * abs(lhs.x));
          float inverse = exp(-2.0 * abs(lhs.x));
          float sh = 0.5 * (1.0 - inverse) * sign(lhs.x);
          float ch = 0.5 * (1.0 + inverse);
          vec2 factors = params.operation == 12u
              ? vec2(sh * cx, ch * sx) : vec2(ch * cx, sh * sx);
          precise vec2 scaled = (factors * h) * h;
          value = scaled;
          if (factors.x == 0.0) value.x = factors.x;
          if (factors.y == 0.0) value.y = factors.y;
        }
        break;
      }
      case 14:
      case 15: {
        bool tangent = params.operation == 14u;
        float a = tangent ? lhs.y : lhs.x;
        float b = tangent ? lhs.x : lhs.y;
        vec2 pair;
        float sb = omarchy_trig_sin(b);
        float cb = omarchy_trig_cos(b);
        if (abs(a) < 1.0) {
          float sh = sinh(a);
          float denominator = sh * sh + cb * cb;
          pair = vec2(sh * cosh(a), sb * cb) / denominator;
        } else {
          float t = exp(-2.0 * abs(a));
          float denominator = 1.0 + 2.0 * (cb * cb - sb * sb) * t + t * t;
          pair = vec2(sign(a) * (1.0 - t * t),
                      4.0 * sb * cb * t) / denominator;
        }
        value = tangent ? pair.yx : pair;
        break;
      }
      case 16: {
        // log1p(z): the upstream simd::log1p complex branch. The
        // argument is atan2(y, x + 1) with the (0, 0) argument 0 by
        // convention; the magnitude is 0.5*log1p(x(2+x) + y^2) when
        // |z| < 0.5 with r == 0 mapping to a zero real part, and
        // log(hypot(x + 1, y)) otherwise.
        bool zero_arg = lhs.y == 0.0 && lhs.x == -1.0;
        float theta = zero_arg ? 0.0 : atan(lhs.y, lhs.x + 1.0);
        if (length(lhs) < 0.5) {
          float r = lhs.x * (2.0 + lhs.x) + lhs.y * lhs.y;
          value = r == 0.0 ? vec2(0.0, theta)
                           : vec2(0.5 * log1p_f(r), theta);
        } else {
          value = vec2(complex_log_magnitude(vec2(lhs.x + 1.0, lhs.y)), theta);
        }
        break;
      }
      case 17: {
        // Upstream simd::Sign complex rule: sign(z) = z / |z| with
        // the zero element mapping to itself.
        float scale = max(abs(lhs.x), abs(lhs.y));
        if (scale == 0.0 || isinf(scale)) {
          value = scale == 0.0 ? lhs : lhs / scale;
        } else {
          vec2 normalized = ldexp(lhs, ivec2(-scale_exponent(scale)));
          value = normalized / length(normalized);
        }
        break;
      }
      case 18:
        value = complex_acos(lhs);
        break;
      case 19:
        value = complex_asin(lhs);
        break;
      case 20:
        value = complex_atan(lhs);
        break;
      case 21:
        value = complex_sqrt(lhs);
        break;
      case 22:
        value = complex_reciprocal(complex_sqrt(lhs));
        break;
      case 23:
      case 24:
      case 25: {
        value = complex_log(lhs);
        if (params.operation == 24u) {
          value /= 0.69314718055994530942;
        } else if (params.operation == 25u) {
          value /= 2.30258509299404568402;
        }
        break;
      }
      case 26:
        value = roundEven(lhs);
        break;
      default:
        value = vec2(0.0);
        break;
    }
    output_data.values[params.output_offset + index] = value;
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
