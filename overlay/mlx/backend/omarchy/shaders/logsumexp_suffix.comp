//
// Numerically stable log-sum-exp over the last axis. One workgroup handles
// one row with a shared-memory max reduction and an exp-sum reduction; the
// row then keeps one output value (the upstream LogSumExp primitive keeps
// the reduced axis at size 1). All arithmetic runs in float32 for every
// storage dtype.

#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
  // Lockstep tail of ComputeParams (mlx compute.h): a shader may
  // declare any prefix of the struct, so these appended fields keep
  // every existing SPIR-V interface byte-identical.
  uint q_rowstride;
  uint k_rowstride;
  uint v_rowstride;
  uint o_rowstride;
  uint q_headstride;
  uint k_headstride;
  uint v_headstride;
  uint q_batchstride;
  uint k_batchstride;
  uint v_batchstride;
  // Windowed-dispatch transport: out_row_stride is the full output row
  // width for windowed matmul-family dispatches (0 = use matrix_n);
  // window_lo is the global first row / element for row- or
  // index-windowed dispatches (0 = unwindowed); window_hi is Take's
  // exclusive row-window bound (0 = unwindowed).
  uint out_row_stride;
  uint window_lo;
  uint window_hi;
} params;

shared float block_values[256];

// Flag bit 31 selects the legacy walk: one load per element per memory
// round trip, identical element order and arithmetic. The prefetch walk
// (default) issues 16 consecutive steps' loads before the arithmetic
// consumes them in the same order, so both arms are bit-identical; the
// chip default (G13 parts other than G13C) and
// MLX_OMARCHY_LSE_ARGREDUCE_PREFETCH choose the arm.

// Each thread walks its strided elements (thread, thread + 256, ...) in
// ascending order in both passes. The walks below issue the loads of 16
// consecutive steps before the arithmetic consumes them in the same order:
// one element per memory round trip made a long row (a 248320-wide logits
// row) latency-bound at ~0.7 ms. The arithmetic sequence per thread is
// unchanged, so every partial, and the result, is bit-identical.
#define LSE_LOAD(b) float v##b = LOAD_VALUE(input_data.values[base + (b) * 256u]);
#define LSE_LOAD16 LSE_LOAD(0u) LSE_LOAD(1u) LSE_LOAD(2u) LSE_LOAD(3u) \
  LSE_LOAD(4u) LSE_LOAD(5u) LSE_LOAD(6u) LSE_LOAD(7u) LSE_LOAD(8u) LSE_LOAD(9u) \
  LSE_LOAD(10u) LSE_LOAD(11u) LSE_LOAD(12u) LSE_LOAD(13u) LSE_LOAD(14u) LSE_LOAD(15u)
#define LSE_MAX(v) if (isnan(v) || v > local_max) { local_max = v; }
#define LSE_SUM(v) local_sum += exp(v - row_max);
#define LSE_APPLY16(OP) OP(v0u) OP(v1u) OP(v2u) OP(v3u) OP(v4u) OP(v5u) OP(v6u) \
  OP(v7u) OP(v8u) OP(v9u) OP(v10u) OP(v11u) OP(v12u) OP(v13u) OP(v14u) OP(v15u)

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  // Row-windowed dispatches start at window_lo (0 = unwindowed).
  for (uint row = gl_WorkGroupID.x + params.window_lo;
       row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;

    float local_max = uintBitsToFloat(0xff800000u);
    if ((params.flags & 0x80000000u) != 0u) {
      for (uint index = thread; index < row_length; index += 256u) {
        float next = LOAD_VALUE(input_data.values[start + index]);
        if (isnan(next) || next > local_max) {
          local_max = next;
        }
      }
    } else {
      uint index = thread;
      for (; index + 15u * 256u < row_length; index += 16u * 256u) {
        uint base = start + index;
        LSE_LOAD16
        LSE_APPLY16(LSE_MAX)
      }
      for (; index < row_length; index += 256u) {
        float next = LOAD_VALUE(input_data.values[start + index]);
        if (isnan(next) || next > local_max) {
          local_max = next;
        }
      }
    }
    block_values[thread] = local_max;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] =
            max(block_values[thread], block_values[thread + stride]);
      }
      barrier();
    }
    float row_max = block_values[0];
    barrier();

    float local_sum = 0.0;
    if ((params.flags & 0x80000000u) != 0u) {
      for (uint index = thread; index < row_length; index += 256u) {
        local_sum +=
            exp(LOAD_VALUE(input_data.values[start + index]) - row_max);
      }
    } else {
      uint index = thread;
      for (; index + 15u * 256u < row_length; index += 16u * 256u) {
        uint base = start + index;
        LSE_LOAD16
        LSE_APPLY16(LSE_SUM)
      }
      for (; index < row_length; index += 256u) {
        local_sum +=
            exp(LOAD_VALUE(input_data.values[start + index]) - row_max);
      }
    }
    block_values[thread] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float row_sum = block_values[0];
    // An infinite row max is already the answer; exp(x - inf) would
    // poison the sum with NaN. This matches the upstream CPU rule.
    float value = isinf(row_max) ? row_max : row_max + log(row_sum);
    if (thread == 0u) {
      output_data.values[params.output_offset + row] = STORE_VALUE(value);
    }
    barrier();
  }
}
