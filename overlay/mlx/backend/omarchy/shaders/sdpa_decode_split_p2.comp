//
// Split-K pass 2 of the bf16 single-query decode SDPA, head width 128 (default) or 256 (-DHD=256; see sdpa_decode_split_p1.comp). One workgroup per query
// head, one thread per output element: folds the per-block (max, exp sum, weighted values) with the global max, divides by the
// global exp sum and stores the bf16 result (round to nearest even, NaN kept as in cast.comp).

#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Scratch {
  float values[];
} scratch_data;
layout(set = 0, binding = 1, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

#ifndef HD
#define HD 128
#endif
const uint D = uint(HD);
const uint DPT = D / 128u;
const uint BK = 128u;

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

void main() {
  uint t = gl_LocalInvocationID.x;
  uint head = gl_WorkGroupID.x;
  uint nblocks = (params.matrix_k + BK - 1u) / BK;
  uint base = head * nblocks * (D + 2u);
  float global_max = uintBitsToFloat(0xff800000u);
  for (uint b = 0u; b < nblocks; ++b) {
    float m = scratch_data.values[base + b * (D + 2u)];
    if (isnan(m) || m > global_max) {
      global_max = m;
    }
  }
#if HD == 128
  float denominator = 0.0;
  float acc = 0.0;
  for (uint b = 0u; b < nblocks; ++b) {
    uint at = base + b * (D + 2u);
    float w = exp(scratch_data.values[at] - global_max);
    denominator += scratch_data.values[at + 1u] * w;
    acc += scratch_data.values[at + 2u + t] * w;
  }
  output_data.values[params.output_offset + head * D + t] = bf16_store(acc / denominator);
#else
  float denominator = 0.0;
  float acc[DPT];
  for (uint d = 0u; d < DPT; ++d) {
    acc[d] = 0.0;
  }
  for (uint b = 0u; b < nblocks; ++b) {
    uint at = base + b * (D + 2u);
    float w = exp(scratch_data.values[at] - global_max);
    denominator += scratch_data.values[at + 1u] * w;
    for (uint d = 0u; d < DPT; ++d) {
      acc[d] += scratch_data.values[at + 2u + d * 128u + t] * w;
    }
  }
  for (uint d = 0u; d < DPT; ++d) {
    output_data.values[params.output_offset + head * D + d * 128u + t] = bf16_store(acc[d] / denominator);
  }
#endif
}
