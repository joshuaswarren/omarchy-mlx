//
// Split-K pass 2 of the bf16 single-query decode SDPA, head width 128 (default) or 256 (-DHD=256; see sdpa_decode_split_p1.comp). One workgroup per query
// head: folds the per-block (max, exp sum, weighted values) with the global max, divides by the global exp sum and stores the bf16 result (round to
// nearest even, NaN kept as in cast.comp).
//
// Block stride is D+4 floats: the D weighted-value floats sit at offset 0 so each block's value row is 16-byte aligned, then (block max, block exp
// sum, two pad floats). The workgroup splits into BLOCK_LANES lane groups of D/4 threads; a thread owns one uvec4 of four output dimensions and
// walks every BLOCK_LANES-th block, so pass 2 reads each value row with 16-byte loads. The global max and the exp-sum denominator are scalar per
// head: every thread strides the blocks once for a partial, the subgroup folds it (NaN maps to +inf, which poisons the output the same way the old
// serial walk did), and a shared broadcast hands every thread the pair.

#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Scratch {
  vec4 values4[];
} scratch_data;
layout(set = 0, binding = 1, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

#ifndef HD
#define HD 128
#endif
const uint D = uint(HD);
#ifndef BK_KEYS
#define BK_KEYS 128
#endif
const uint BK = uint(BK_KEYS);
const uint STRIDE = D + 4u;
const uint LANES = D / 4u;          // uvec4 lanes covering one block's value row
const uint BLOCK_LANES = 128u / LANES;  // lane groups, each walking a strided block subset

shared float s_part[8u];
shared float s_head[2u];

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

void main() {
  uint t = gl_LocalInvocationID.x;
  uint head = gl_WorkGroupID.x;
  uint nblocks = (params.matrix_k + BK - 1u) / BK;
  uint base = head * nblocks * STRIDE;
  uint out_head = params.out_strides[0] != 0u ? params.out_strides[0] : D;
  uint sg = gl_SubgroupID;
  // Global max over all block headers: NaN folds to +inf so a poisoned block still poisons the answer.
  float part_max = uintBitsToFloat(0xff800000u);
  for (uint b = t; b < nblocks; b += 128u) {
    float m = scratch_data.values4[(base + b * STRIDE) / 4u + D / 4u].x;
    part_max = isnan(m) ? uintBitsToFloat(0x7f800000u) : max(part_max, m);
  }
  part_max = subgroupMax(part_max);
  if (gl_SubgroupInvocationID == 0u) {
    s_part[sg] = part_max;
  }
  barrier();
  if (t == 0u) {
    s_head[0] = max(max(s_part[0u], s_part[1u]), max(s_part[2u], s_part[3u]));
  }
  barrier();
  float global_max = s_head[0];
  // Denominator = sum_b exp_sum_b * w_b, w_b = exp(max_b - global_max); same cooperative stride.
  float part_den = 0.0;
  for (uint b = t; b < nblocks; b += 128u) {
    vec4 hdr = scratch_data.values4[(base + b * STRIDE) / 4u + D / 4u];
    part_den += hdr.y * exp(hdr.x - global_max);
  }
  part_den = subgroupAdd(part_den);
  if (gl_SubgroupInvocationID == 0u) {
    s_part[4u + sg] = part_den;
  }
  barrier();
  if (t == 0u) {
    s_head[1] = s_part[4u] + s_part[5u] + s_part[6u] + s_part[7u];
  }
  barrier();
  float denominator = s_head[1];
  // Merge: this thread's vec4 of output dims, over its strided block subset.
  uint b_lane = t / LANES;
  uint dim4 = t % LANES;
  vec4 acc = vec4(0.0);
  for (uint b = b_lane; b < nblocks; b += BLOCK_LANES) {
    uint at4 = (base + b * STRIDE) / 4u;
    vec4 hdr = scratch_data.values4[at4 + D / 4u];
    acc += scratch_data.values4[at4 + dim4] * exp(hdr.x - global_max);
  }
  uint out_base = params.output_offset + head * out_head + dim4 * 4u;
  for (uint d = 0u; d < 4u; ++d) {
    output_data.values[out_base + d] = bf16_store(acc[d] / denominator);
  }
}
