#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require

// Dense bf16 matmul on the G13 hardware 8x8x8 fp32 matrix unit, in the
// qmm_coopmat form that won the four-screen bakeoff for the Q4 prefill
// tile (0dbb1d1d): a 64-lane workgroup owns a 32x32 output tile as two
// 16x32 subgroup halves; each 16-wide k step stages an A 32x16 patch
// and a B 16x32 patch into 4 KiB of shared memory with word-pair loads
// (one 32-bit word covers two bf16 elements, widened by a 16-bit left
// shift - exact, no numerics change), then issues two rounds of
// ascending 8-wide coopMatMulAdd. Per output the accumulator sequence
// is the same ascending-k 8-wide MMA chain the previous 8-wide-step
// kernel issued, so stored bits are identical for the same tile
// values; the staging instruction count drops (one word load covers
// two elements), the barrier cadence halves (one per 16 k instead of
// per 8), and each lane holds 8 accumulators instead of 16.
//
// k-adjacent word loads need the row-major lhs (flags bit 2 clear) or
// the column-major rhs (flags bit 0 set); the other two orientations
// pack each k pair from two scalar element loads. With flags bit 8
// (host-checked 8-byte alignment) those two orientations stage from
// aliased uvec2 views, one load covering two bf16 pairs - pure
// transport, the staged words are identical. The k tail (k % 16 == 8;
// the dispatch gate allows any multiple of 8) is one final 8-wide step
// with the high words masked, staged by the scalar path. Tails in m
// and n are masked at staging and at the drain. The drain packs bf16
// output pairs into 32-bit words with the same round-to-nearest-even
// bf16_store as matmul.comp (NaN quiet bit included), so the output
// contract is unchanged. K must be a multiple of 8; matrix_n and the
// output element offset must be even (word packing).
//
// Push-constant layout matches matmul.comp. Transpose flags: 1 = rhs
// column-major, 4 = lhs column-major, 8 = pair loads allowed. Batch
// unravel matches matmul.comp (workgroup z over shape[]).

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint STEP_K = 16u;
const uint MAT = 8u;

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  uint values[];
} input_a;
layout(set = 0, binding = 0, std430) readonly buffer InputA2 {
  uvec2 values2[];
} input_a2;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  uint values[];
} input_b;
layout(set = 0, binding = 1, std430) readonly buffer InputB2 {
  uvec2 values2[];
} input_b2;
layout(set = 0, binding = 2, std430) readonly buffer InputC {
  uint values[];
} input_c;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  uint values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
  // Lockstep tail of ComputeParams (mlx compute.h): a shader may
  // declare any prefix of the struct, so these appended fields keep
  // every existing SPIR-V interface byte-identical.
  uint q_rowstride;
  uint k_rowstride;
  uint v_rowstride;
  uint o_rowstride;
  uint q_headstride;
  uint k_headstride;
  uint v_headstride;
  uint q_batchstride;
  uint k_batchstride;
  uint v_batchstride;
  // Windowed-dispatch transport: out_row_stride is the full output row
  // width for windowed matmul-family dispatches (0 = use matrix_n);
  // window_lo is the global first row / element for row- or
  // index-windowed dispatches (0 = unwindowed); window_hi is Take's
  // exclusive row-window bound (0 = unwindowed).
  uint out_row_stride;
  uint window_lo;
  uint window_hi;
} params;

uint bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return (bits >> 16) | 0x40u;
  }
  return (bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16;
}

// Scalar orientations: the k pair is not word-adjacent, so fetch both
// elements and pack them low-half-first, matching the word-path layout.
uint pack_pair(uint buffer_select, uint element, uint stride) {
  uint w0 = buffer_select != 0u ? input_b.values[element >> 1u]
                                : input_a.values[element >> 1u];
  uint w1 = buffer_select != 0u
      ? input_b.values[(element + stride) >> 1u]
      : input_a.values[(element + stride) >> 1u];
  uint lo = ((element & 1u) != 0u) ? (w0 & 0xFFFF0000u) : (w0 << 16u);
  uint hi = (((element + stride) & 1u) != 0u) ? (w1 & 0xFFFF0000u)
                                              : (w1 << 16u);
  return (lo >> 16u) | (hi & 0xFFFF0000u);
}

// 4 KiB shared: one 32x16 A patch and one 16x32 B patch, both f32.
shared float a_s[TILE_M * STEP_K];
shared float b_s[STEP_K * TILE_N];

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint sub = gl_SubgroupID;
  uint sub_rb = 2u * sub;
  uint lane = lid % 32u;
  uint batch_index = gl_WorkGroupID.z;
  uint remaining = batch_index;
  uint a_batch = 0u;
  uint b_batch = 0u;
  for (uint axis = params.dims; axis > 0u; --axis) {
    uint coord = remaining % params.shape[axis - 1u];
    remaining /= params.shape[axis - 1u];
    a_batch += coord * params.in_strides[axis - 1u];
    b_batch += coord * params.out_strides[axis - 1u];
  }
  // Offsets are ELEMENT units; the word view halves them.
  uint a_slice = params.lhs_offset / 2u + a_batch / 2u;
  uint b_slice = params.rhs_offset / 2u + b_batch / 2u;
  // Windowed dispatches shrink matrix_n to their output-column
  // window and carry the full row width in out_row_stride.
  uint out_row = params.out_row_stride != 0u ? params.out_row_stride
                                             : params.matrix_n;
  uint out_matrix = params.matrix_m * out_row;
  uint out_slice = params.output_offset / 2u + batch_index * out_matrix / 2u;
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
  bool a_colmaj = (params.flags & 4u) != 0u;
  bool b_colmaj = (params.flags & 1u) != 0u;
  bool pair_ok = (params.flags & 8u) != 0u;
  uint full_steps = params.matrix_k / STEP_K;
  bool tail8 = (params.matrix_k & 8u) != 0u;
  uint total_steps = full_steps + (tail8 ? 1u : 0u);

  for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
       tile_row += gl_NumWorkGroups.y) {
    uint row_base = tile_row * TILE_M;
    for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
         tile_col += gl_NumWorkGroups.x) {
      uint col_base = tile_col * TILE_N;

      coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
          acc[2][4];
      for (uint rb = 0u; rb < 2u; ++rb) {
        for (uint cb = 0u; cb < 4u; ++cb) {
          acc[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
              gl_MatrixUseAccumulator>(0.0);
        }
      }

      for (uint step = 0u; step < total_steps; ++step) {
        uint k_base = step * STEP_K;
        uint width = (tail8 && step == full_steps) ? 8u : STEP_K;

        // Stage A (32 rows x width k): load words first, then unpack
        // and store unconditionally - the qmm_coopmat shape. flags
        // bit 8 with a row-major lhs stages two bf16 pairs per uvec2
        // load and unpacks in the same (row, du) coordinates; staged
        // values are identical to the scalar path.
        if (pair_ok && !a_colmaj && width == STEP_K) {
          for (uint j = 0u; j < 2u; ++j) {
            uint i2 = lid + 64u * j;
            uint rl = i2 / 4u;
            uint du = i2 % 4u;
            uvec2 w = row_base + rl < params.matrix_m
                ? input_a2.values2[
                      (a_slice + (row_base + rl) * (params.lhs_gap / 2u) +
                       k_base / 2u + 2u * du) / 2u]
                : uvec2(0u);
            a_s[rl * STEP_K + 4u * du + 0u] =
                uintBitsToFloat(w.x << 16u);
            a_s[rl * STEP_K + 4u * du + 1u] =
                uintBitsToFloat(w.x & 0xFFFF0000u);
            a_s[rl * STEP_K + 4u * du + 2u] =
                uintBitsToFloat(w.y << 16u);
            a_s[rl * STEP_K + 4u * du + 3u] =
                uintBitsToFloat(w.y & 0xFFFF0000u);
          }
        } else {
          uint a_words[4];
          for (uint j = 0u; j < 4u; ++j) {
            uint i = lid + 64u * j;
            uint row = row_base + i / 8u;
            uint pair = i % 8u;
            a_words[j] = row < params.matrix_m && 2u * pair < width
                ? (a_colmaj
                      ? pack_pair(
                          0u,
                          a_slice * 2u + (k_base + 2u * pair) * params.lhs_gap + row,
                          params.lhs_gap)
                      : input_a.values[a_slice +
                                       row * (params.lhs_gap / 2u) +
                                       k_base / 2u + pair])
                : 0u;
          }
          for (uint j = 0u; j < 4u; ++j) {
            uint i = lid + 64u * j;
            uint row_local = i / 8u;
            uint kk = 2u * (i % 8u);
            a_s[row_local * STEP_K + kk] =
                uintBitsToFloat(a_words[j] << 16u);
            a_s[row_local * STEP_K + kk + 1u] =
                uintBitsToFloat(a_words[j] & 0xFFFF0000u);
          }
        }
        // Stage B (width k x 32 columns), same shape.
        if (pair_ok && b_colmaj && width == STEP_K) {
          for (uint j = 0u; j < 2u; ++j) {
            uint i2 = lid + 64u * j;
            uint cl = i2 / 4u;
            uint du = i2 % 4u;
            uvec2 w = col_base + cl < params.matrix_n
                ? input_b2.values2[
                      (b_slice + (col_base + cl) * (params.rhs_gap / 2u) +
                       k_base / 2u + 2u * du) / 2u]
                : uvec2(0u);
            b_s[(4u * du + 0u) * TILE_N + cl] =
                uintBitsToFloat(w.x << 16u);
            b_s[(4u * du + 1u) * TILE_N + cl] =
                uintBitsToFloat(w.x & 0xFFFF0000u);
            b_s[(4u * du + 2u) * TILE_N + cl] =
                uintBitsToFloat(w.y << 16u);
            b_s[(4u * du + 3u) * TILE_N + cl] =
                uintBitsToFloat(w.y & 0xFFFF0000u);
          }
        } else {
          uint b_words[4];
          for (uint j = 0u; j < 4u; ++j) {
            uint i = lid + 64u * j;
            uint col = col_base + i / 8u;
            uint pair = i % 8u;
            b_words[j] = col < params.matrix_n && 2u * pair < width
                ? (b_colmaj
                      ? input_b.values[b_slice +
                                       col * (params.rhs_gap / 2u) +
                                       k_base / 2u + pair]
                      : pack_pair(
                          1u,
                          b_slice * 2u + col + (k_base + 2u * pair) * params.rhs_gap,
                          params.rhs_gap))
                : 0u;
          }
          for (uint j = 0u; j < 4u; ++j) {
            uint i = lid + 64u * j;
            uint col_local = i / 8u;
            uint kk = 2u * (i % 8u);
            b_s[kk * TILE_N + col_local] =
                uintBitsToFloat(b_words[j] << 16u);
            b_s[(kk + 1u) * TILE_N + col_local] =
                uintBitsToFloat(b_words[j] & 0xFFFF0000u);
          }
        }
        barrier();

        // DEBUGSTEP: flags==32 dumps the staged shared tiles into the
        // output buffer, 1024 words per k step (a_s first, then b_s).
        if (params.flags == 32u) {
          for (uint j = 0u; j < 8u; ++j) {
            uint idx = lid + 64u * j;
            output_data.values[step * 1024u + idx] =
                floatBitsToUint(a_s[idx]);
            output_data.values[step * 1024u + 512u + idx] =
                floatBitsToUint(b_s[idx]);
          }
        }

        for (uint ks = 0u; ks < width / MAT; ++ks) {
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> mat_a[2];
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[4];
          for (uint rb = 0u; rb < 2u; ++rb) {
            coopMatLoad(
                mat_a[rb], a_s,
                (sub_rb + rb) * MAT * STEP_K + ks * MAT, STEP_K,
                gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatLoad(
                mat_b[cb], b_s, ks * MAT * TILE_N + cb * MAT, TILE_N,
                gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint rb = 0u; rb < 2u; ++rb) {
            for (uint cb = 0u; cb < 4u; ++cb) {
              acc[rb][cb] =
                  coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
            }
          }
        }
        barrier();
      }

      // Drain one 8-row block at a time through a_s; the owning
      // subgroup stores its two accumulators, then its 32 lanes pack
      // bf16 pairs into words, tails masked.
      for (uint rb = 0u; rb < 4u; ++rb) {
        if (sub == rb / 2u) {
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatStore(
                acc[rb % 2u][cb], a_s, cb * MAT * MAT, MAT,
                gl_CooperativeMatrixLayoutRowMajor);
          }
        }
        barrier();
        if (sub == rb / 2u) {
          uint pair = lane % 16u;
          uint r0 = lane / 16u;
          for (uint rr = 0u; rr < MAT / 2u; ++rr) {
            uint r = r0 + 2u * rr;
            uint c0 = pair * 2u;
            uint cb = c0 / MAT;
            uint cc = c0 % MAT;
            uint row = row_base + rb * MAT + r;
            uint col = col_base + c0;
            if (row < params.matrix_m && col + 1u < params.matrix_n) {
              // Same scale point as the f32 sibling kernel's 16x16 tile:
              // the f32 accumulator is scaled by alpha, then the product
              // rounds once to bf16 storage. alpha==1 multiplies exactly,
              // so the projection traffic that always rode this kernel is
              // bit-identical.
              float v0 = params.alpha *
                  a_s[cb * MAT * MAT + r * MAT + cc];
              float v1 = params.alpha *
                  a_s[cb * MAT * MAT + r * MAT + cc + 1u];
              output_data.values[out_slice +
                                 (row * out_row + col) / 2u] =
                  bf16_store(v0) | (bf16_store(v1) << 16u);
            }
          }
        }
        barrier();
      }
    }
  }
}
