//
// Wave 7: Cholesky factorization. One workgroup per batch matrix; the
// workgroup factors the matrix in place with the Cholesky-Banachiewicz
// column recurrence, so cell (i, j) is read as A and later overwritten as L
// only within the column step that owns it. The opposite triangle is zeroed
// and, for the upper convention, the factor is transposed in place because
// U = L^T exactly. A pivot d <= 0 (including NaN input) pins status 1 for
// the host, which turns it into a named error; upstream LAPACK-backed CPU
// swallows that case, and a silent wrong factor is worse than a refusal.
//
// Push-constant routing: matrix_n is N, output_size the batch matrix count,
// and flags bit 0 the upper convention. Work starts as a row-major dense
// copy of the input and ends as the factor.
#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) coherent buffer Work {
  float values[];
} work;
layout(set = 0, binding = 1, std430) buffer Status {
  uint values[];
} status;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float red[256];

void main() {
  uint tid = gl_LocalInvocationID.x;
  // The host chunks the batch so no dispatch exceeds 65535 workgroups;
  // aux_offset carries this dispatch's first matrix index (the field is
  // unused by every linalg shader).
  uint matrix = params.aux_offset + gl_WorkGroupID.x;
  uint n = params.matrix_n;
  uint base = matrix * n * n;
  bool upper = (params.flags & 1u) != 0u;

  for (uint j = 0u; j < n; ++j) {
    // Column j pivot: d = A[j][j] - sum_k L[j][k]^2, reduced cooperatively.
    float part = 0.0;
    for (uint k = tid; k < j; k += 256u) {
      float l = work.values[base + j * n + k];
      part += l * l;
    }
    red[tid] = part;
      memoryBarrierBuffer();
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (tid < stride) {
        red[tid] += red[tid + stride];
      }
      memoryBarrierBuffer();
      barrier();
    }
    if (tid == 0u) {
      float d = work.values[base + j * n + j] - red[0];
      if (!(d > 0.0)) {
        status.values[matrix] = 1u;
        d = 0.0;
      }
      red[255] = sqrt(d);
      work.values[base + j * n + j] = red[255];
    }
      memoryBarrierBuffer();
    barrier();
    float ljj = red[255];
    for (uint i = j + 1u + tid; i < n; i += 256u) {
      float s = work.values[base + i * n + j];
      for (uint k = 0u; k < j; ++k) {
        s -= work.values[base + i * n + k] * work.values[base + j * n + k];
      }
      work.values[base + i * n + j] = (ljj > 0.0) ? s / ljj : 0.0;
    }
      memoryBarrierBuffer();
    barrier();
  }

  for (uint i = tid; i < n; i += 256u) {
    for (uint c = i + 1u; c < n; ++c) {
      work.values[base + i * n + c] = 0.0;
    }
  }
  memoryBarrierBuffer();
  barrier();
  if (upper) {
    for (uint idx = tid; idx < n * n; idx += 256u) {
      uint r = idx / n;
      uint c = idx % n;
      if (r < c) {
        float t = work.values[base + idx];
        work.values[base + idx] = work.values[base + c * n + r];
        work.values[base + c * n + r] = t;
      }
    }
  }
}
