//
// General nonsymmetric eigen-decomposition, float32, one workgroup per
// batch matrix. This is EISPACK hqr2 (Martin and Wilkinson), ported from
// the public-domain JAMA EigenvalueDecomposition (orthes + hqr2), which is
// the same algorithm family LAPACK sgeev implements for the upstream CPU
// backend. Householder reduction to Hessenberg form, Francis double-shift
// QR iteration to real Schur form with the transformations accumulated in
// the vectors buffer, then eigenvectors by back-substitution on the
// quasi-triangular Schur form and a back-transform through the accumulated
// orthogonal basis.
//
// Output contract (matches the upstream CPU eig.cpp convention):
// - values are complex64 in Schur order, NOT sorted; complex conjugate
//   pairs occupy adjacent slots with the positive imaginary part first.
// - vectors are complex64 with eigenvector i in column i (v[:, i]).
// - every eigenvector is normalized to Euclidean norm 1 with its largest
//   component rotated to be real and positive, matching LAPACK dgeev's
//   documented normalization.
//
// Deviations from the JAMA reference, each required for float32:
// - kEps is 2^-23 (single-precision ulp), not JAMA's 2^-52; the double
//   threshold can never be met by f32 rounding and would stall.
// - the QR iteration is capped at kMaxIter passes per eigenvalue; the
//   host raises a named error through status 3 when the cap trips, never
//   a silently unconverged answer. Exceptional shifts fire at 10 and 30.
// - the deflation threshold falls back to 1.0 when the matrix norm is
//   zero: JAMA's norm fallback is then also zero and the all-zero matrix
//   would divide 0/0 in the shift scan instead of deflating.
// - balancing (LAPACK gebal) is not implemented; badly scaled inputs lose
//   accuracy but never correctness, and the gate refuses nothing new.

#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) coherent buffer Work {
  float values[];
} work;
// Complex64 eigenvector output, written once in the final interleave.
// Values-only mode binds `work` here as a dummy; nothing writes it.
layout(set = 0, binding = 1, std430) writeonly buffer VecOut {
  float values[];
} vec_out;
layout(set = 0, binding = 2, std430) writeonly buffer Values {
  float values[];
} values;
layout(set = 0, binding = 3, std430) buffer Status {
  uint values[];
} status;
// Dense n*n float accumulation matrix V, one slot per batch matrix. The
// complex64 vectors output cannot double as the accumulator: its
// interleaved layout spans twice the floats, so writing the output while
// other invocations still read V corrupts both.
layout(set = 0, binding = 4, std430) coherent buffer Accum {
  float values[];
} accum;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float red[256];
shared float sh_norm;
shared float sh_h;
shared float sh_ortm;
shared float sh_hm1;
shared uint sh_skip;
shared float ort[1024];
shared float d_arr[1024];
shared float e_arr[1024];

// Single-precision machine epsilon, 2^-23.
const float kEps = 1.1920929e-7;
// QR passes allowed per eigenvalue before the named non-convergence
// failure; exceptional shifts fire at 10 and 30.
const int kMaxIter = 40;

uint g_base;
int g_nn;

float h_at(int r, int c) {
  return work.values[g_base + uint(r) * uint(g_nn) + uint(c)];
}
void h_set(int r, int c, float v) {
  work.values[g_base + uint(r) * uint(g_nn) + uint(c)] = v;
}
float v_at(int r, int c) {
  return accum.values[g_base + uint(r) * uint(g_nn) + uint(c)];
}
void v_set(int r, int c, float v) {
  accum.values[g_base + uint(r) * uint(g_nn) + uint(c)] = v;
}
// JAMA's complex scalar division (cdiv).
void cdiv(
    float xr,
    float xi,
    float yr,
    float yi,
    out float cdivr,
    out float cdivi) {
  float r;
  float d;
  if (abs(yr) > abs(yi)) {
    r = yi / yr;
    d = yr + r * yi;
    cdivr = (xr + r * xi) / d;
    cdivi = (xi - r * xr) / d;
  } else {
    r = yr / yi;
    d = yi + r * yr;
    cdivr = (r * xr + xi) / d;
    cdivi = (r * xi - xr) / d;
  }
}

void main() {
  uint tid = gl_LocalInvocationID.x;
  // The host chunks the batch so no dispatch exceeds 65535 workgroups;
  // aux_offset carries this dispatch's first matrix index (the field is
  // unused by every linalg shader).
  uint matrix = params.aux_offset + gl_WorkGroupID.x;
  g_nn = int(params.matrix_n);
  g_base = matrix * uint(g_nn) * uint(g_nn);
  int nn = g_nn;
  int low = 0;
  int high = nn - 1;
  bool compute_ev = params.operation == 1u;

  // The accumulation matrix starts at identity and collects the
  // orthogonal transformations. Values-only mode binds `work` as the
  // dummy for both output slots, so every write to them is gated on
  // compute_ev: writing identity into `work` would clobber the matrix
  // (the Eigh values-only lesson).
  if (compute_ev) {
    for (uint idx = tid; idx < uint(nn) * uint(nn); idx += 256u) {
      uint r = idx / uint(nn);
      uint c = idx % uint(nn);
      accum.values[g_base + idx] = (r == c) ? 1.0 : 0.0;
    }
    memoryBarrierBuffer();
  }
  barrier();

  // ---- Hessenberg reduction (JAMA orthes, EISPACK orthes/ortran) ----
  float orthes_scale = 0.0;
  float orthes_g = 0.0;
  for (int m = low + 1; m <= high - 1; ++m) {
    if (tid == 0u) {
      float scale = 0.0;
      for (int i = m; i <= high; i++) {
        scale += abs(h_at(i, m - 1));
      }
      if (scale == 0.0) {
        sh_skip = 1u;
      } else {
        // Compute the Householder transformation.
        float h = 0.0;
        for (int i = high; i >= m; i--) {
          ort[i] = h_at(i, m - 1) / scale;
          h += ort[i] * ort[i];
        }
        float g = sqrt(h);
        if (ort[m] > 0.0) {
          g = -g;
        }
        h = h - ort[m] * g;
        ort[m] = ort[m] - g;
        sh_h = h;
        sh_skip = 0u;
        orthes_scale = scale;
        orthes_g = g;
      }
    }
    memoryBarrierShared();
    barrier();
    if (sh_skip == 0u) {
      // H = (I - u u^T / h) H (I - u u^T / h): columns, then rows.
      for (int j = m + int(tid); j < nn; j += 256) {
        float f = 0.0;
        for (int i = high; i >= m; i--) {
          f += ort[i] * h_at(i, j);
        }
        f = f / sh_h;
        for (int i = m; i <= high; i++) {
          h_set(i, j, h_at(i, j) - f * ort[i]);
        }
      }
      memoryBarrierBuffer();
      barrier();
      for (int i = int(tid); i <= high; i += 256) {
        float f = 0.0;
        for (int j = high; j >= m; j--) {
          f += ort[j] * h_at(i, j);
        }
        f = f / sh_h;
        for (int j = m; j <= high; j++) {
          h_set(i, j, h_at(i, j) - f * ort[j]);
        }
      }
      memoryBarrierBuffer();
      barrier();
      if (tid == 0u) {
        ort[m] = ort[m] * orthes_scale;
        h_set(m, m - 1, orthes_scale * orthes_g);
      }
      memoryBarrierBuffer();
      barrier();
    }
  }

  // Accumulate the Hessenberg transformations (EISPACK ortran).
  if (compute_ev) {
    for (int m = high - 1; m >= low + 1; --m) {
      if (tid == 0u) {
        if (h_at(m, m - 1) != 0.0) {
          for (int i = m + 1; i <= high; i++) {
            ort[i] = h_at(i, m - 1);
          }
          sh_ortm = ort[m];
          sh_hm1 = h_at(m, m - 1);
          sh_skip = 0u;
        } else {
          sh_skip = 1u;
        }
      }
      memoryBarrierShared();
      barrier();
      if (sh_skip == 0u) {
        for (int j = m + int(tid); j <= high; j += 256) {
          float g = 0.0;
          for (int i = m; i <= high; i++) {
            g += ort[i] * v_at(i, j);
          }
          // Double division avoids possible underflow.
          g = (g / sh_ortm) / sh_hm1;
          for (int i = m; i <= high; i++) {
            v_set(i, j, v_at(i, j) + g * ort[i]);
          }
        }
        memoryBarrierBuffer();
        barrier();
      }
    }
  }

  // ---- Real Schur form (JAMA hqr2, Francis double-shift QR) ----
  // Matrix norm: sum of |H[i][j]| over j >= max(i - 1, 0).
  float partial = 0.0;
  for (int i = int(tid); i < nn; i += 256) {
    for (int j = max(i - 1, 0); j < nn; j++) {
      partial += abs(h_at(i, j));
    }
  }
  red[tid] = partial;
  memoryBarrierShared();
  barrier();
  if (tid == 0u) {
    float total = 0.0;
    for (uint k = 0u; k < 256u; k++) {
      total += red[k];
    }
    sh_norm = total;
  }
  memoryBarrierShared();
  barrier();

  float exshift = 0.0;
  int iter = 0;
  bool failed = false;
  float p = 0.0;
  float q = 0.0;
  float r = 0.0;
  float s = 0.0;
  float z = 0.0;
  float t = 0.0;
  float w = 0.0;
  float x = 0.0;
  float y = 0.0;
  int en = nn - 1;

  while (en >= low) {
    // Look for a single small sub-diagonal element.
    int l = en;
    while (l > low) {
      s = abs(h_at(l - 1, l - 1)) + abs(h_at(l, l));
      if (s == 0.0) {
        s = sh_norm;
      }
      if (s == 0.0) {
        // All-zero matrix: JAMA's norm fallback is 0 here and the
        // deflation test would never fire, dividing 0/0 in the shift
        // scan below. Every sub-diagonal is exactly zero, so deflate.
        s = 1.0;
      }
      if (abs(h_at(l, l - 1)) < kEps * s) {
        break;
      }
      l--;
    }

    if (l == en) {
      // One root found.
      if (tid == 0u) {
        float v = h_at(en, en) + exshift;
        h_set(en, en, v);
        d_arr[en] = v;
        e_arr[en] = 0.0;
      }
      en = en - 1;
      iter = 0;
    } else if (l == en - 1) {
      // Two roots found: solve the trailing 2x2 block.
      w = h_at(en, en - 1) * h_at(en - 1, en);
      p = (h_at(en - 1, en - 1) - h_at(en, en)) / 2.0;
      q = p * p + w;
      z = sqrt(abs(q));
      if (tid == 0u) {
        h_set(en, en, h_at(en, en) + exshift);
        h_set(en - 1, en - 1, h_at(en - 1, en - 1) + exshift);
      }
      memoryBarrierBuffer();
      barrier();
      x = h_at(en, en);
      if (q >= 0.0) {
        // Real pair: standardize the block to upper triangular with a
        // plane rotation.
        if (p >= 0.0) {
          z = p + z;
        } else {
          z = p - z;
        }
        if (tid == 0u) {
          d_arr[en - 1] = x + z;
          d_arr[en] = x + z;
          if (z != 0.0) {
            d_arr[en] = x - w / z;
          }
          e_arr[en - 1] = 0.0;
          e_arr[en] = 0.0;
        }
        x = h_at(en, en - 1);
        s = abs(x) + abs(z);
        p = x / s;
        q = z / s;
        r = sqrt(p * p + q * q);
        p = p / r;
        q = q / r;
        // Row modification.
        for (int j = en - 1 + int(tid); j < nn; j += 256) {
          float zj = h_at(en - 1, j);
          h_set(en - 1, j, q * zj + p * h_at(en, j));
          h_set(en, j, q * h_at(en, j) - p * zj);
        }
        memoryBarrierBuffer();
        barrier();
        // Column modification.
        for (int i = int(tid); i <= en; i += 256) {
          float zi = h_at(i, en - 1);
          h_set(i, en - 1, q * zi + p * h_at(i, en));
          h_set(i, en, q * h_at(i, en) - p * zi);
        }
        memoryBarrierBuffer();
        barrier();
        if (compute_ev) {
          for (int i = int(tid); i <= high; i += 256) {
            float zi = v_at(i, en - 1);
            v_set(i, en - 1, q * zi + p * v_at(i, en));
            v_set(i, en, q * v_at(i, en) - p * zi);
          }
          memoryBarrierBuffer();
          barrier();
        }
      } else {
        // Complex conjugate pair: the 2x2 block stays in H for the
        // back-substitution; the eigenvalues are recorded here.
        if (tid == 0u) {
          d_arr[en - 1] = x + p;
          d_arr[en] = x + p;
          e_arr[en - 1] = z;
          e_arr[en] = -z;
        }
      }
      en = en - 2;
      iter = 0;
    } else {
      // No convergence yet: form the Francis double shift.
      x = h_at(en, en);
      y = 0.0;
      w = 0.0;
      if (l < en) {
        y = h_at(en - 1, en - 1);
        w = h_at(en, en - 1) * h_at(en - 1, en);
      }
      // Wilkinson's original ad hoc shift.
      if (iter == 10) {
        exshift += x;
        if (tid == 0u) {
          for (int i = low; i <= en; i++) {
            h_set(i, i, h_at(i, i) - x);
          }
        }
        s = abs(h_at(en, en - 1)) + abs(h_at(en - 1, en - 2));
        x = 0.75 * s;
        y = x;
        w = -0.4375 * s * s;
      }
      // MATLAB's ad hoc shift.
      if (iter == 30) {
        s = (y - x) / 2.0;
        s = s * s + w;
        if (s > 0.0) {
          s = sqrt(s);
          if (y < x) {
            s = -s;
          }
          s = x - w / ((y - x) / 2.0 + s);
          if (tid == 0u) {
            for (int i = low; i <= en; i++) {
              h_set(i, i, h_at(i, i) - s);
            }
          }
          exshift += s;
          x = 0.964;
          y = 0.964;
          w = 0.964;
        }
      }
      iter = iter + 1;
      if (iter > kMaxIter) {
        failed = true;
        break;
      }
      memoryBarrierBuffer();
      barrier();

      // Look for two consecutive small sub-diagonal elements.
      int m = en - 2;
      while (m >= l) {
        z = h_at(m, m);
        r = x - z;
        s = y - z;
        p = (r * s - w) / h_at(m + 1, m) + h_at(m, m + 1);
        q = h_at(m + 1, m + 1) - z - r - s;
        r = h_at(m + 2, m + 1);
        s = abs(p) + abs(q) + abs(r);
        p = p / s;
        q = q / s;
        r = r / s;
        if (m == l) {
          break;
        }
        if (abs(h_at(m, m - 1)) * (abs(q) + abs(r)) <
            kEps *
                (abs(p) *
                 (abs(h_at(m - 1, m - 1)) + abs(z) + abs(h_at(m + 1, m + 1))))) {
          break;
        }
        m--;
      }

      // Zero the bulge tail.
      for (int i = m + 2 + int(tid); i <= en; i += 256) {
        h_set(i, i - 2, 0.0);
        if (i > m + 2) {
          h_set(i, i - 3, 0.0);
        }
      }
      memoryBarrierBuffer();
      barrier();

      // Double QR step over rows l..en, columns m..en.
      for (int k = m; k <= en - 1; k++) {
        bool notlast = (k != en - 1);
        if (k != m) {
          p = h_at(k, k - 1);
          q = h_at(k + 1, k - 1);
          r = notlast ? h_at(k + 2, k - 1) : 0.0;
          x = abs(p) + abs(q) + abs(r);
          if (x == 0.0) {
            continue;
          }
          p = p / x;
          q = q / x;
          r = r / x;
        }
        s = sqrt(p * p + q * q + r * r);
        if (p < 0.0) {
          s = -s;
        }
        if (s != 0.0) {
          if (tid == 0u) {
            if (k != m) {
              h_set(k, k - 1, -s * x);
            } else if (l != m) {
              h_set(k, k - 1, -h_at(k, k - 1));
            }
          }
          p = p + s;
          x = p / s;
          y = q / s;
          z = r / s;
          q = q / p;
          r = r / p;
          // Row modification.
          for (int j = k + int(tid); j < nn; j += 256) {
            float pj = h_at(k, j) + q * h_at(k + 1, j);
            if (notlast) {
              pj = pj + r * h_at(k + 2, j);
              h_set(k + 2, j, h_at(k + 2, j) - pj * z);
            }
            h_set(k, j, h_at(k, j) - pj * x);
            h_set(k + 1, j, h_at(k + 1, j) - pj * y);
          }
          memoryBarrierBuffer();
          barrier();
          // Column modification.
          int imax = min(en, k + 3);
          for (int i = int(tid); i <= imax; i += 256) {
            float pi2 = x * h_at(i, k) + y * h_at(i, k + 1);
            if (notlast) {
              pi2 = pi2 + z * h_at(i, k + 2);
              h_set(i, k + 2, h_at(i, k + 2) - pi2 * r);
            }
            h_set(i, k, h_at(i, k) - pi2);
            h_set(i, k + 1, h_at(i, k + 1) - pi2 * q);
          }
          memoryBarrierBuffer();
          barrier();
          if (compute_ev) {
            // Accumulate the transformation.
            for (int i = int(tid); i <= high; i += 256) {
              float pi3 = x * v_at(i, k) + y * v_at(i, k + 1);
              if (notlast) {
                pi3 = pi3 + z * v_at(i, k + 2);
                v_set(i, k + 2, v_at(i, k + 2) - pi3 * r);
              }
              v_set(i, k, v_at(i, k) - pi3);
              v_set(i, k + 1, v_at(i, k + 1) - pi3 * q);
            }
            memoryBarrierBuffer();
            barrier();
          }
        }
      }
    }
    memoryBarrierBuffer();
    barrier();
  }

  if (failed) {
    if (tid == 0u) {
      status.values[matrix] = 3u;
    }
    return;
  }

  // ---- Back-substitution on the quasi-triangular Schur form ----
  // Serial on one thread: every component reads the components already
  // computed in this pass, exactly like the JAMA reference. Column en2 of
  // H is consumed and overwritten with the eigenvector; for a complex
  // pair, columns en2-1 (real part) and en2 (imaginary part) together.
  if (compute_ev && sh_norm > 0.0) {
    if (tid == 0u) {
      float bp;
      float bq;
      float br;
      float bs;
      float bz;
      float bt;
      float bw;
      float bx;
      float by;
      float cdivr;
      float cdivi;
      for (int en2 = nn - 1; en2 >= 0; en2--) {
        bp = d_arr[en2];
        bq = e_arr[en2];
        if (bq == 0.0) {
          // Real vector.
          int l = en2;
          h_set(en2, en2, 1.0);
          for (int i = en2 - 1; i >= 0; i--) {
            bw = h_at(i, i) - bp;
            br = 0.0;
            for (int j = l; j <= en2; j++) {
              br = br + h_at(i, j) * h_at(j, en2);
            }
            if (e_arr[i] < 0.0) {
              bz = bw;
              bs = br;
            } else {
              l = i;
              if (e_arr[i] == 0.0) {
                if (bw != 0.0) {
                  h_set(i, en2, -br / bw);
                } else {
                  h_set(i, en2, -br / (kEps * sh_norm));
                }
              } else {
                // Solve the 2x2 real block.
                bx = h_at(i, i + 1);
                by = h_at(i + 1, i);
                bq = (d_arr[i] - bp) * (d_arr[i] - bp) + e_arr[i] * e_arr[i];
                bt = (bx * bs - bz * br) / bq;
                h_set(i, en2, bt);
                if (abs(bx) > abs(bz)) {
                  h_set(i + 1, en2, (-br - bw * bt) / bx);
                } else {
                  h_set(i + 1, en2, (-bs - by * bt) / bz);
                }
              }
              // Overflow control.
              bt = abs(h_at(i, en2));
              if ((kEps * bt) * bt > 1.0) {
                for (int j = i; j <= en2; j++) {
                  h_set(j, en2, h_at(j, en2) / bt);
                }
              }
            }
          }
        } else if (bq < 0.0) {
          // Complex vector for the pair (en2-1, en2); the pass over the
          // first of the pair was a no-op, this one writes both columns.
          int l = en2 - 1;
          // Last vector component imaginary so the matrix is triangular.
          if (abs(h_at(en2, en2 - 1)) > abs(h_at(en2 - 1, en2))) {
            h_set(en2 - 1, en2 - 1, bq / h_at(en2, en2 - 1));
            h_set(en2 - 1, en2, -(h_at(en2, en2) - bp) / h_at(en2, en2 - 1));
          } else {
            cdiv(
                0.0,
                -h_at(en2 - 1, en2),
                h_at(en2 - 1, en2 - 1) - bp,
                bq,
                cdivr,
                cdivi);
            h_set(en2 - 1, en2 - 1, cdivr);
            h_set(en2 - 1, en2, cdivi);
          }
          h_set(en2, en2 - 1, 0.0);
          h_set(en2, en2, 1.0);
          for (int i = en2 - 2; i >= 0; i--) {
            float ra = 0.0;
            float sa = 0.0;
            for (int j = l; j <= en2; j++) {
              ra = ra + h_at(i, j) * h_at(j, en2 - 1);
              sa = sa + h_at(i, j) * h_at(j, en2);
            }
            bw = h_at(i, i) - bp;
            if (e_arr[i] < 0.0) {
              bz = bw;
              br = ra;
              bs = sa;
            } else {
              l = i;
              if (e_arr[i] == 0.0) {
                cdiv(-ra, -sa, bw, bq, cdivr, cdivi);
                h_set(i, en2 - 1, cdivr);
                h_set(i, en2, cdivi);
              } else {
                // Solve the 2x2 complex equations.
                bx = h_at(i, i + 1);
                by = h_at(i + 1, i);
                float vr =
                    (d_arr[i] - bp) * (d_arr[i] - bp) + e_arr[i] * e_arr[i] -
                    bq * bq;
                float vi = (d_arr[i] - bp) * 2.0 * bq;
                if (vr == 0.0 && vi == 0.0) {
                  vr = kEps * sh_norm *
                      (abs(bw) + abs(bq) + abs(bx) + abs(by) + abs(bz));
                }
                cdiv(
                    bx * br - bz * ra + bq * sa,
                    bx * bs - bz * sa - bq * ra,
                    vr,
                    vi,
                    cdivr,
                    cdivi);
                h_set(i, en2 - 1, cdivr);
                h_set(i, en2, cdivi);
                if (abs(bx) > (abs(bz) + abs(bq))) {
                  h_set(
                      i + 1,
                      en2 - 1,
                      (-ra - bw * h_at(i, en2 - 1) + bq * h_at(i, en2)) / bx);
                  h_set(
                      i + 1,
                      en2,
                      (-sa - bw * h_at(i, en2) - bq * h_at(i, en2 - 1)) / bx);
                } else {
                  cdiv(
                      -br - by * h_at(i, en2 - 1),
                      -bs - by * h_at(i, en2),
                      bz,
                      bq,
                      cdivr,
                      cdivi);
                  h_set(i + 1, en2 - 1, cdivr);
                  h_set(i + 1, en2, cdivi);
                }
              }
              // Overflow control.
              bt = max(abs(h_at(i, en2 - 1)), abs(h_at(i, en2)));
              if ((kEps * bt) * bt > 1.0) {
                for (int j = i; j <= en2; j++) {
                  h_set(j, en2 - 1, h_at(j, en2 - 1) / bt);
                  h_set(j, en2, h_at(j, en2) / bt);
                }
              }
            }
          }
        }
      }
    }
    memoryBarrierBuffer();
    barrier();

    // Back transformation: eigenvectors of A from those of the Schur
    // form, column by column. Each column j only reads columns <= j,
    // which are untouched, so one barrier per column is enough.
    for (int j = nn - 1; j >= 0; j--) {
      for (int i = int(tid); i < nn; i += 256) {
        float acc = 0.0;
        for (int k = 0; k <= j; k++) {
          acc += v_at(i, k) * h_at(k, j);
        }
        v_set(i, j, acc);
      }
      memoryBarrierBuffer();
      barrier();
    }
  }

  // ---- Outputs ----
  // Eigenvalues: complex64 pairs in Schur order, positive imaginary part
  // of a conjugate pair first.
  memoryBarrierShared();
  barrier();
  for (int i = int(tid); i < nn; i += 256) {
    uint oi = (matrix * uint(nn) + uint(i)) * 2u;
    values.values[oi] = d_arr[i];
    values.values[oi + 1u] = e_arr[i];
  }

  if (!compute_ev) {
    return;
  }

  // Eigenvectors: normalize to Euclidean norm 1, rotate the largest
  // component to be real and positive (LAPACK dgeev normalization), and
  // interleave the pair columns into complex64 output. Column j of the
  // output is eigenvector j (v[:, i] convention).
  for (int j = int(tid); j < nn; j += 256) {
    float ej = e_arr[j];
    if (ej == 0.0) {
      float nrm = 0.0;
      float amax = -1.0;
      int rmax = 0;
      for (int r = 0; r < nn; r++) {
        float val = v_at(r, j);
        nrm += val * val;
        float aval = abs(val);
        if (aval > amax) {
          amax = aval;
          rmax = r;
        }
      }
      nrm = sqrt(nrm);
      float sgn = (v_at(rmax, j) >= 0.0) ? 1.0 : -1.0;
      for (int r = 0; r < nn; r++) {
        float outv = v_at(r, j);
        if (nrm > 0.0) {
          outv = sgn * outv / nrm;
        }
        uint oi = (matrix * uint(nn) * uint(nn) + uint(r) * uint(nn) + uint(j)) *
            2u;
        vec_out.values[oi] = outv;
        vec_out.values[oi + 1u] = 0.0;
      }
    } else if (ej > 0.0) {
      // Pair start: vectors column j holds the real part, column j+1 the
      // imaginary part. Eigenvector j is col_j + i * col_{j+1}; its
      // conjugate is eigenvector j+1.
      float nrm = 0.0;
      float amax = -1.0;
      int rmax = 0;
      for (int r = 0; r < nn; r++) {
        float ar = v_at(r, j);
        float ai = v_at(r, j + 1);
        nrm += ar * ar + ai * ai;
        float aval = ar * ar + ai * ai;
        if (aval > amax) {
          amax = aval;
          rmax = r;
        }
      }
      nrm = sqrt(nrm);
      float pr = v_at(rmax, j);
      float pi = v_at(rmax, j + 1);
      float pd = sqrt(pr * pr + pi * pi);
      for (int r = 0; r < nn; r++) {
        float ar = v_at(r, j);
        float ai = v_at(r, j + 1);
        float wr = ar;
        float wi = ai;
        if (pd > 0.0) {
          // Multiply by conj(phase of the largest component).
          wr = (ar * pr + ai * pi) / pd;
          wi = (ai * pr - ar * pi) / pd;
        }
        if (nrm > 0.0) {
          wr = wr / nrm;
          wi = wi / nrm;
        }
        uint oi = (matrix * uint(nn) * uint(nn) + uint(r) * uint(nn) + uint(j)) *
            2u;
        uint oj =
            (matrix * uint(nn) * uint(nn) + uint(r) * uint(nn) + uint(j + 1)) *
            2u;
        vec_out.values[oi] = wr;
        vec_out.values[oi + 1u] = wi;
        vec_out.values[oj] = wr;
        vec_out.values[oj + 1u] = -wi;
      }
    }
  }
}
