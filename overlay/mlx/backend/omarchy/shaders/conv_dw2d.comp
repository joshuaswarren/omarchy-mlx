#version 460

// Depthwise 2-D convolution over channels-last input [N, H_in, W_in, C]
// with weight [C, K_h, K_w, 1] and output [N, H_out, W_out, C]
// (groups == C, one channel per group, no kernel flip): the Conformer
// frontend depthwise convs in Parakeet-class encoders. conv.comp is the
// fully general kernel and walks its index guards per tap; this kernel
// keeps the same arithmetic with straight-line indexing.
//
// Bit-exact to conv.comp on this shape: one thread per output element,
// the K_h * K_w taps accumulate in ascending (kh, kw) order from 0.0
// with the same `accumulator += x * w` expression on widened operands,
// out-of-range taps skipped exactly where the general kernel's guards
// contribute zero, one RNE store.
//
// Push constants (the fixed omarchy::ComputeParams layout):
//   count        N * H_out * W_out * C output elements
//   operation    K_w taps
//   lhs_size     H_in
//   rhs_size     W_in
//   reduce_size  C channels
//   output_size  H_out
//   lhs_offset   input element offset
//   rhs_offset   weight element offset
//   output_offset output element offset
//   matrix_m     W_out
//   lhs_gap      N (batch)
//   aux_offset   K_h
//   in_strides   {stride_h, stride_w}
//   out_strides  {pad_lo_h, pad_lo_w, dil_h, dil_w}

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  STORAGE_TYPE values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer Weight {
  STORAGE_TYPE values[];
} weight;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
} params;

void main() {
  const uint channels = params.reduce_size;
  const uint k_w = params.operation;
  const uint k_h = params.aux_offset;
  const uint h_in = params.lhs_size;
  const uint w_in = params.rhs_size;
  const uint h_out = params.output_size;
  const uint w_out = params.matrix_m;
  const uint stride_h = params.in_strides[0];
  const uint stride_w = params.in_strides[1];
  const int pad_h = int(params.out_strides[0]);
  const int pad_w = int(params.out_strides[1]);
  const uint dil_h = params.out_strides[2];
  const uint dil_w = params.out_strides[3];
  uint stride_threads = gl_NumWorkGroups.x * 256u;
  for (uint index = gl_GlobalInvocationID.x; index < params.count;
       index += stride_threads) {
    uint channel = index % channels;
    uint row = index / channels;
    uint w_idx = row % w_out;
    uint hb = row / w_out;
    uint h_idx = hb % h_out;
    uint b = hb / h_out;
    const int y0 = int(h_idx * stride_h) - pad_h;
    const int x0 = int(w_idx * stride_w) - pad_w;
    const uint in_batch =
        params.lhs_offset + b * h_in * w_in * channels + channel;
    const uint w_base = params.rhs_offset + channel * k_h * k_w;
    float accumulator = 0.0;
    for (uint kh = 0u; kh < k_h; ++kh) {
      const int y = y0 + int(kh * dil_h);
      if (y < 0 || uint(y) >= h_in) {
        continue;
      }
      const uint in_row = in_batch + uint(y) * w_in * channels;
      const uint w_row = w_base + kh * k_w;
      for (uint kw = 0u; kw < k_w; ++kw) {
        const int x = x0 + int(kw * dil_w);
        if (x < 0 || uint(x) >= w_in) {
          continue;
        }
        accumulator += LOAD_VALUE(input_x.values[in_row + uint(x) * channels]) *
            LOAD_VALUE(weight.values[w_row + kw]);
      }
    }
    output_data.values[params.output_offset + index] = STORE_VALUE(accumulator);
  }
}
