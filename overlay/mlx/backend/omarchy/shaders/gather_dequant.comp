#version 460

// Gather + affine dequantize fold (prologue / quantized embedding):
// out[r, ...] = q(ids[r]) * scale + bias, where one thread owns one
// packed uint32 unit of a gathered row. The unit load reads the word at
// the row the index buffer names instead of the thread's own row; the
// group-parameter loads reuse one address for every lane in the unit.
// Same pack math as dequant.comp (bits 2/4/8 uint32 words, LSB first);
// bits 3/5/6 and the fp modes stay on the ordinary gather + dequant
// path and this shader is never dispatched for them.
//
// Push-constant routing: count carries gathered packed units, operation
// bits, reduce_size group size, matrix_n packed words per source row,
// matrix_k groups per source row, matrix_m source table rows (for the
// negative-index wraparound take semantics require), dims the ids
// element offset, lhs/rhs/aux/output offsets the buffer element starts.

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Ids {
  int values[];
} ids_data;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  STORAGE_TYPE values[];
} scales_data;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  STORAGE_TYPE values[];
} biases_data;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

void main() {
  uint bits = params.operation;
  uint group_size = params.reduce_size;
  uint stride = gl_NumWorkGroups.x * 256u;
  uint pack_factor = 32u / bits;
  uint value_mask = (1u << bits) - 1u;
  uint units_per_group = group_size / pack_factor;

  for (uint unit = gl_GlobalInvocationID.x; unit < params.count;
       unit += stride) {
    uint row = unit / params.matrix_n;
    uint unit_column = unit % params.matrix_n;
    int src_row = ids_data.values[params.dims + row];
    uint src;
    if ((params.flags & 1u) != 0u) {
      src = uint(src_row);
    } else {
      if (src_row < 0) {
        src_row += int(params.matrix_m);
      }
      src = uint(src_row);
    }
    uint group = unit_column / units_per_group;
    float scale = LOAD_VALUE(
        scales_data.values[params.rhs_offset + src * params.matrix_k +
            group]);
    float bias = LOAD_VALUE(
        biases_data.values[params.aux_offset + src * params.matrix_k +
            group]);
    uint value_base = params.output_offset + unit * pack_factor;
    uint word =
        input_w.values[params.lhs_offset + src * params.matrix_n +
            unit_column];
    for (uint lane = 0u; lane < pack_factor; ++lane) {
      uint q = (word >> (lane * bits)) & value_mask;
      output_data.values[value_base + lane] =
          STORE_VALUE(scale * float(q) + bias);
    }
  }
}
