//
// Fused RMSNorm (-DRMS default) or LayerNorm (-DLAYER_NORM=1) forward over the
// last axis, matching mlx::core::fast fallback math in mlx/fast.cpp. One
// workgroup handles one row with shared-memory reductions and a grid-stride
// row loop; every arithmetic step runs in float32 for all storage dtypes.
//
//   RMS:   n = rsqrt(mean(x^2) + eps);            y = x * n * w
//   Layer: mu = mean(x); var = mean(x^2) - mu^2;
//          n = rsqrt(var + eps);                  y = (x - mu) * n * w + b
//
// A scalar weight or bias (element count 1, the weightless upstream form)
// broadcasts to every column. eps arrives in params.alpha.

#version 460

#ifdef SGTAIL
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#endif

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 1, std430) readonly buffer Weight {
  STORAGE_TYPE values[];
} weight_data;
#ifdef LAYER_NORM
layout(set = 0, binding = 2, std430) readonly buffer Bias {
  STORAGE_TYPE values[];
} bias_data;
#endif
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
} params;

shared float block_values[256];

#ifdef SGTAIL
// Levels 16, 8, 4, 2 and 1 of the 256-wide halving tree, on lane values, with every lane of the subgroup active.
// The caller has already run levels 128, 64 and 32 through shared memory, so block_values[0..31] hold the 32
// partials that the in-place tree would hold at the start of level 16. Lane t then forms the same sums:
// own + the value of lane t + stride. Lanes whose source lane is out of range only ever feed lanes that are not
// read afterwards (lane 0's value is the result). `precise` keeps each add an add of exactly those two operands.
// The function is separate so `precise` does not reach the per-thread accumulation in main().
float sgtail_reduce() {
  precise float level0 = block_values[gl_SubgroupInvocationID];
  precise float level16 = level0 + subgroupShuffleDown(level0, 16u);
  precise float level8 = level16 + subgroupShuffleDown(level16, 8u);
  precise float level4 = level8 + subgroupShuffleDown(level8, 4u);
  precise float level2 = level4 + subgroupShuffleDown(level4, 2u);
  precise float level1 = level2 + subgroupShuffleDown(level2, 1u);
  return subgroupBroadcastFirst(level1);
}
#endif

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  float eps = params.alpha;
  uint threads = 256u;

  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;

#ifdef LAYER_NORM
    float local_sum = 0.0;
    for (uint index = thread; index < row_length; index += threads) {
      local_sum += LOAD_VALUE(input_data.values[start + index]);
    }
    block_values[thread] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float mu = block_values[0] / float(row_length);
    barrier();
#endif

    float local_sq = 0.0;
    for (uint index = thread; index < row_length; index += threads) {
      float value = LOAD_VALUE(input_data.values[start + index]);
      local_sq += value * value;
    }
#ifdef SGTAIL
    block_values[thread] = local_sq;
    barrier();
    for (uint stride = 128u; stride > 16u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float mean_square = sgtail_reduce() / float(row_length);
    barrier();
#else
    block_values[thread] = local_sq;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float mean_square = block_values[0] / float(row_length);
    barrier();
#endif
#ifdef LAYER_NORM
    float variance = mean_square - mu * mu;
#else
    float variance = mean_square;
#endif
    float norm = inversesqrt(variance + eps);

    for (uint index = thread; index < row_length; index += threads) {
      float value = LOAD_VALUE(input_data.values[start + index]);
      float weight =
          (params.lhs_size == 1u)
              ? LOAD_VALUE(weight_data.values[params.rhs_offset])
              : LOAD_VALUE(weight_data.values[params.rhs_offset + index]);
#ifdef LAYER_NORM
      float bias =
          (params.aux_size == 1u)
              ? LOAD_VALUE(bias_data.values[params.aux_offset])
              : LOAD_VALUE(bias_data.values[params.aux_offset + index]);
      float result = (value - mu) * norm * weight + bias;
#else
      float result = value * norm * weight;
#endif
      output_data.values[params.output_offset + row * row_length + index] =
          STORE_VALUE(result);
    }
    barrier();
  }
}
