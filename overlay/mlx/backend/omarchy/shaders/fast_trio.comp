#version 460

#extension GL_GOOGLE_include_directive : require
#include "omarchy_trig.h"

// Copyright © 2026 Joshua Warren / mlx-omarchy contributors.
// SPDX-License-Identifier: MIT
//
// Decode trio: ONE shader source carrying near-copies of the three
// standalone bit-exact decode kernels, compiled three times so every
// pipeline is exactly one straight-line body (a single mode-switched
// megashader measurably regressed decode tok/s on Honeykrisp - the mode
// branch cost more than the dispatch it saved):
//
//   -DTRIO_NORM       RMSNorm row   - near-copy of shaders/fast_norm.comp
//                                     (RMS forward, float32 math, per-row
//                                     shared-memory reduction).
//   -DTRIO_ROPE_PAIR  RoPE pair     - near-copy of the shaders/fast_rope.comp
//                                     forward, scalar-offset, no-freqs, no-
//                                     passthrough branch, rotating TWO
//                                     tensors (query and key) in one
//                                     dispatch. Both sides share the offset
//                                     buffer, dims, base, scale, and flags;
//                                     they differ in head count, offsets,
//                                     and output strides (the key side may
//                                     write a producer-direct KV window).
//   -DTRIO_SWIGLU     SwiGLU        - near-copy of shaders/swiglu.comp with
//                                     the same ComputeParams field mapping
//                                     dispatch_chain uses for
//                                     shaders/swiglu.comp: params.operation
//                                     is the gate offset, params.lhs_size
//                                     the up offset, params.rhs_size the
//                                     materialize flag.
//
// Every arithmetic step, rounding site, barrier, and workgroup size is
// copied from the three proven kernels so the stored bits match the
// standalone paths. The single near-copied source is the point: the
// decode epilogue ops stay one file without touching qmm_vec.comp.
//
// Honeykrisp contract notes carried over unchanged: float16 rides the
// typed 16-bit storage block (the proven form for this dtype); every
// output element is written exactly once by exactly one invocation, with
// per-element stores only (no read-modify-write of a shared 32-bit word
// anywhere, which is why the swiglu mode stores four scalars instead of
// one vec4); no data-dependent shift-and-mask appears anywhere; inputs
// and outputs never alias within a dispatch.

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#else
#error "fast_trio.comp is built for the float16 decode path only"
#endif

#if !defined(TRIO_NORM) && !defined(TRIO_ROPE_PAIR) && !defined(TRIO_SWIGLU)
#error "define exactly one of TRIO_NORM, TRIO_ROPE_PAIR, TRIO_SWIGLU"
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InQGate {
  float16_t values[];
} in_q_gate;
#ifdef TRIO_NORM
layout(set = 0, binding = 1, std430) readonly buffer WeightUp {
  float16_t values[];
} weight_up;
layout(set = 0, binding = 3, std430) writeonly buffer OutQ {
  float16_t values[];
} out_q;
#endif
#ifdef TRIO_ROPE_PAIR
layout(set = 0, binding = 2, std430) readonly buffer InK {
  float16_t values[];
} in_k;
layout(set = 0, binding = 3, std430) writeonly buffer OutQ {
  float16_t values[];
} out_q;
layout(set = 0, binding = 4, std430) writeonly buffer OutK {
  float16_t values[];
} out_k;
layout(set = 0, binding = 7, std430) readonly buffer Offsets {
  int values[];
} offset_data;
#endif
#ifdef TRIO_SWIGLU
layout(set = 0, binding = 1, std430) readonly buffer WeightUp {
  float16_t values[];
} weight_up;
layout(set = 0, binding = 4, std430) writeonly buffer SwigluOut {
  float16_t values[];
} swiglu_out;
layout(set = 0, binding = 5, std430) writeonly buffer SigmoidOut {
  float16_t values[];
} sigmoid_out;
layout(set = 0, binding = 6, std430) writeonly buffer SiluOut {
  float16_t values[];
} silu_out;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
} params;

#ifdef TRIO_NORM
shared float block_values[256];
#endif

#ifdef TRIO_ROPE_PAIR
float rope_round(float value) {
  // The eager RoPE composition stores every intermediate at storage
  // precision; reproduce that rounding exactly like fast_rope.comp.
  return float(float16_t(value));
}

float rope_load(uint abs_index, bool q_side) {
  return q_side ? float(in_q_gate.values[abs_index])
                : float(in_k.values[abs_index]);
}

void rope_store(uint abs_index, float value, bool q_side) {
  if (q_side) {
    out_q.values[abs_index] = float16_t(value);
  } else {
    out_k.values[abs_index] = float16_t(value);
  }
}

// One side of the RoPE pair: near-copy of the fast_rope.comp forward,
// scalar-offset, no-freqs, non-passthrough branch (traditional and
// half-split layouts ride params.flags bit 1; forward only, per the
// RoPE fusion fence). The input strides are the row-contiguous natural
// (matrix = T*D, time = D, feature = 1); the output strides are natural
// for the query side and arrive in out_matrix_stride/out_time_stride for
// the key side (a fresh row-contiguous output, or a producer-direct KV
// window whose feature stride the window geometry guarantees to be 1).
void rope_side(
    uint index,
    uint heads,
    bool traditional,
    bool q_side,
    bool head_seq_transpose,
    uint in_base,
    uint out_base,
    uint in_matrix_stride,
    uint in_time_stride,
    uint out_matrix_stride,
    uint out_time_stride) {
  uint half_dims = params.dims;
  uint time = params.shape[2];
  uint i = index % half_dims;
  uint t = (index / half_dims) % time;
  uint mat = index / (half_dims * time);
  uint b = mat / heads;
  uint head = mat - b * heads;
  float offset =
      float(offset_data.values[params.aux_offset + b * params.matrix_m]);
  float position = params.alpha * (float(t) + offset);
  float inv_freq = exp(-float(i) * params.beta);
  float theta = position * inv_freq;
  float cos_t = rope_round(omarchy_trig_cos(theta));
  float sin_t = rope_round(omarchy_trig_sin(theta));
  // Row-contiguous inputs fold the batch into the matrix axis
  // (matrix = T*D per mat, time = D); the head/seq transposed 4D view
  // keeps a per-head matrix stride and a per-time stride of N*D, with
  // the batch stride T*time_stride handled separately - the same two
  // layouts the single RoPE kernel serves without a copy.
  uint in_row = head_seq_transpose
      ? (in_base + b * (time * in_time_stride) + t * in_time_stride +
         head * in_matrix_stride)
      : (in_base + t * in_time_stride + mat * in_matrix_stride);
  uint out_row = out_base + t * out_time_stride + mat * out_matrix_stride;
  uint in_index_1;
  uint in_index_2;
  uint out_index_1;
  uint out_index_2;
  if (traditional) {
    in_index_1 = in_row + (2u * i);
    in_index_2 = in_index_1 + 1u;
    out_index_1 = out_row + (2u * i);
    out_index_2 = out_index_1 + 1u;
  } else {
    in_index_1 = in_row + i;
    in_index_2 = in_index_1 + half_dims;
    out_index_1 = out_row + i;
    out_index_2 = out_index_1 + half_dims;
  }
  float x1 = rope_load(in_index_1, q_side);
  float x2 = rope_load(in_index_2, q_side);
  float xa = rope_round(x1 * cos_t);
  float xb = rope_round(x2 * sin_t);
  float xc = rope_round(x1 * sin_t);
  float xd = rope_round(x2 * cos_t);
  float r1 = xa - xb;
  float r2 = xc + xd;
  rope_store(out_index_1, r1, q_side);
  rope_store(out_index_2, r2, q_side);
}
#endif // TRIO_ROPE_PAIR

#ifdef TRIO_SWIGLU
vec4 round4(vec4 v) {
  // swiglu.comp rounding: packHalf2x16 round trip, identical bits.
  return vec4(
      unpackHalf2x16(packHalf2x16(vec2(v.x, 0.0))).x,
      unpackHalf2x16(packHalf2x16(vec2(v.y, 0.0))).x,
      unpackHalf2x16(packHalf2x16(vec2(v.z, 0.0))).x,
      unpackHalf2x16(packHalf2x16(vec2(v.w, 0.0))).x);
}
#endif

#ifdef TRIO_NORM
// Near-copy of the fast_norm.comp RMS forward body (USE_FP16, LAYER_NORM
// undefined): float32 math, tree reduction, grid-stride row loop.
void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  float eps = params.alpha;
  uint threads = 256u;

  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;

    float local_sq = 0.0;
    for (uint index = thread; index < row_length; index += threads) {
      float value = float(in_q_gate.values[start + index]);
      local_sq += value * value;
    }
    block_values[thread] = local_sq;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        block_values[thread] += block_values[thread + stride];
      }
      barrier();
    }
    float mean_square = block_values[0] / float(row_length);
    barrier();
    float norm = inversesqrt(mean_square + eps);

    for (uint index = thread; index < row_length; index += threads) {
      float value = float(in_q_gate.values[start + index]);
      float weight =
          (params.lhs_size == 1u)
              ? float(weight_up.values[params.rhs_offset])
              : float(weight_up.values[params.rhs_offset + index]);
      float result = value * norm * weight;
      out_q.values[params.output_offset + row * row_length + index] =
          float16_t(result);
    }
    barrier();
  }
}
#endif

#ifdef TRIO_ROPE_PAIR
// Near-copy of the fast_rope.comp main loop for the pair case.
void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  bool traditional = (params.flags & 2u) != 0u;
  bool q_transposed = (params.flags & 4u) != 0u;
  bool k_transposed = (params.flags & 8u) != 0u;
  uint q_count = params.lhs_size;
  while (index < params.count) {
    if (index < q_count) {
      rope_side(
          index,
          params.shape[0],
          traditional,
          true,
          q_transposed,
          params.lhs_offset,
          0u,
          params.in_strides[0],
          params.in_strides[1],
          params.out_strides[2],
          params.out_strides[3]);
    } else {
      rope_side(
          index - q_count,
          params.shape[1],
          traditional,
          false,
          k_transposed,
          params.rhs_offset,
          params.output_offset,
          params.in_strides[2],
          params.in_strides[3],
          params.out_strides[0],
          params.out_strides[1]);
    }
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
#endif

#ifdef TRIO_SWIGLU
// Near-copy of swiglu.comp: four-wide sigmoid, gate mul, output mul with
// the interpreter's exact rounding. Loads and stores are four per-element
// accesses instead of one vec4 access; the stored bits are identical and
// no shared word is ever read-modify-written.
void main() {
  uint vec_count = params.count / 4u;
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < vec_count) {
    uint g = params.operation + index * 4u;
    uint u = params.lhs_size + index * 4u;
    uint o = index * 4u;
    vec4 gate = vec4(
        float(in_q_gate.values[g]),
        float(in_q_gate.values[g + 1u]),
        float(in_q_gate.values[g + 2u]),
        float(in_q_gate.values[g + 3u]));
    vec4 up = vec4(
        float(weight_up.values[u]),
        float(weight_up.values[u + 1u]),
        float(weight_up.values[u + 2u]),
        float(weight_up.values[u + 3u]));
    vec4 sig = round4(1.0 / (1.0 + exp(-gate)));
    vec4 silu = round4(gate * sig);
    vec4 value = round4(silu * up);
    if (params.rhs_size != 0u) {
      sigmoid_out.values[o] = float16_t(sig.x);
      sigmoid_out.values[o + 1u] = float16_t(sig.y);
      sigmoid_out.values[o + 2u] = float16_t(sig.z);
      sigmoid_out.values[o + 3u] = float16_t(sig.w);
      silu_out.values[o] = float16_t(silu.x);
      silu_out.values[o + 1u] = float16_t(silu.y);
      silu_out.values[o + 2u] = float16_t(silu.z);
      silu_out.values[o + 3u] = float16_t(silu.w);
    }
    swiglu_out.values[o] = float16_t(value.x);
    swiglu_out.values[o + 1u] = float16_t(value.y);
    swiglu_out.values[o + 2u] = float16_t(value.z);
    swiglu_out.values[o + 3u] = float16_t(value.w);
    if (vec_count - index <= stride) {
      break;
    }
    index += stride;
  }
}
#endif
