#version 460

// Dense NT GEMM: A[M,K] and B[N,K] are row-major, two BF16s per word.
// Each workgroup owns a full 32x64 output tile; each lane owns a 4x4 block.
layout(local_size_x = 16, local_size_y = 8) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  uint words[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  uint words[];
} input_b;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  uint words[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
} params;

shared float tile_a[16][32];
shared float tile_b[16][64];

vec2 unpack_bf16(uint word) {
  return uintBitsToFloat(uvec2(word << 16u, word & 0xffff0000u));
}

uint round_bf16(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return (bits >> 16u) | 0x40u;
  }
  return (bits + 0x7fffu + ((bits >> 16u) & 1u)) >> 16u;
}

void main() {
  uint row0 = gl_WorkGroupID.y * 32u;
  uint col0 = gl_WorkGroupID.x * 64u;
  uint row = gl_LocalInvocationID.y * 4u;
  uint col = gl_LocalInvocationID.x * 4u;
  uint lane_k = gl_LocalInvocationIndex % 8u;
  uint lane_row = gl_LocalInvocationIndex / 8u;
  uint stride = params.matrix_k / 2u;
  uint a_base = params.lhs_offset / 2u + row0 * stride + lane_k;
  uint b_base = params.rhs_offset / 2u + col0 * stride + lane_k;
  vec4 acc[4] = vec4[4](vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0));

  for (uint k = 0u; k < stride; k += 8u) {
    for (uint r = lane_row; r < 32u; r += 16u) {
      vec2 a = unpack_bf16(input_a.words[a_base + r * stride + k]);
      tile_a[2u * lane_k][r] = a.x;
      tile_a[2u * lane_k + 1u][r] = a.y;
    }
    for (uint c = lane_row; c < 64u; c += 16u) {
      vec2 b = unpack_bf16(input_b.words[b_base + c * stride + k]);
      tile_b[2u * lane_k][c] = b.x;
      tile_b[2u * lane_k + 1u][c] = b.y;
    }
    barrier();
    for (uint t = 0u; t < 16u; ++t) {
      vec4 b = vec4(tile_b[t][col], tile_b[t][col + 1u],
                    tile_b[t][col + 2u], tile_b[t][col + 3u]);
      for (uint r = 0u; r < 4u; ++r) {
        acc[r] = fma(vec4(tile_a[t][row + r]), b, acc[r]);
      }
    }
    barrier();
  }

  uint out_stride = params.matrix_n / 2u;
  uint word = params.output_offset / 2u + (row0 + row) * out_stride +
      (col0 + col) / 2u;
  for (uint r = 0u; r < 4u; ++r) {
    vec4 a = acc[r];
    output_data.words[word] = round_bf16(a.x) | (round_bf16(a.y) << 16u);
    output_data.words[word + 1u] = round_bf16(a.z) | (round_bf16(a.w) << 16u);
    word += out_stride;
  }
}
