#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#ifdef USE_BF16
// bf16 build: the same kernel with bfloat16 activations, scales and
// biases. Widening bf16 to f32 is exact, so the k chain matches the f16
// build's f32 arithmetic; the drain rounds to nearest even like the bf16
// tile kernel.
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define AFFINE_TYPE uint16_t
#define AFFINE_LOAD(v) uintBitsToFloat(uint(v) << 16u)
#define X_LO(word) uintBitsToFloat((word) << 16u)
#define X_HI(word) uintBitsToFloat((word) & 0xffff0000u)
uint bf16_bits(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return (bits >> 16) | 0x40u;
  }
  return (bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16;
}
#define PACK_OUT(a, b) (bf16_bits(a) | (bf16_bits(b) << 16u))
#else
#define AFFINE_TYPE float16_t
#define AFFINE_LOAD(v) float(v)
#define X_LO(word) unpackHalf2x16(word).x
#define X_HI(word) unpackHalf2x16(word).y
#define PACK_OUT(a, b) packHalf2x16(vec2((a), (b)))
#endif

// Scalar-FMA prefill Q4/group-64 f16 (and, built with USE_BF16, bf16)
// quantized matmul. Replaces the
// cooperative-matrix kernel on the shared dispatch gate: the G13
// 8x8x8 fp32 matrix path tops out at ~1.46 TFLOP/s in this dispatch
// geometry with zero operand traffic (receipts/2026-09-11-coopmat-ilp-chains),
// while the scalar FMA chains sustain 2.3 TFLOP/s
// (receipts/2026-09-11-fma-ceiling), so the matmul leaves the matrix
// unit entirely. Each lane owns ROWS rows x COLS columns of the output
// and keeps ROWS x COLS independent f32 accumulators; per output the
// sum is one ascending-k fused chain, the same arithmetic qmm_tile and
// qmm_coopmat produce, with weights dequantized in registers
// (scale*float(nibble)+bias, f32) and x widened exactly from f16 or bf16 - no
// shared memory, no barriers, no coopMatLoad round trip.
// Requires matrix_k % 8 == 0 (implied by group_size 64), even
// matrix_n and output offset (word-pair f16 stores), and an x row
// base 16-byte aligned (uvec4 loads; the host materializes rarer
// views). Tails in m and n are masked at load and drain.

#ifndef ROWS
#define ROWS 16
#endif
#ifndef COLS
#define COLS 2
#endif

const uint ROWS_U = uint(ROWS);
const uint COLS_U = uint(COLS);
const uint WARPS = 4u;
const uint ROWS_PER_WG = WARPS * ROWS_U;
const uint COLS_PER_WARP = 32u * COLS_U;

layout(local_size_x = 128) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX4 {
  uvec4 values4[];
} input_x4;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  AFFINE_TYPE values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  AFFINE_TYPE values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint values[];
} output_words;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint warp = lid / 32u;
  uint lane = lid % 32u;
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint m = params.matrix_m;
  uint n = params.matrix_n;
  uint k = params.matrix_k;
  uint words_per_row = k / 8u;
  uint groups_per_row = k / 64u;
  uint x_vec_per_row = k / 8u;
  uint m_bands = (m + ROWS_PER_WG - 1u) / ROWS_PER_WG;
  uint n_blocks = (n + COLS_PER_WARP - 1u) / COLS_PER_WARP;

  for (uint b = 0u; b < batch; ++b) {
    uint w_slice = params.rhs_offset + b * w_batch_words;
    uint scale_slice = params.aux_offset + b * param_batch;
    uint bias_slice = params.aux_size + b * param_batch;
    uint x_slice4 = (params.lhs_offset + b * m * k) / 8u;
    uint out_slice = params.output_offset + b * m * n;
    for (uint band = gl_WorkGroupID.y; band < m_bands;
         band += gl_NumWorkGroups.y) {
      uint row0 = band * ROWS_PER_WG + warp * ROWS_U;
      for (uint block = gl_WorkGroupID.x; block < n_blocks;
           block += gl_NumWorkGroups.x) {
        uint col0 = block * COLS_PER_WARP + lane * COLS_U;
        float acc[ROWS][COLS];
        for (uint r = 0u; r < ROWS_U; ++r) {
          for (uint c = 0u; c < COLS_U; ++c) {
            acc[r][c] = 0.0;
          }
        }
        for (uint g = 0u; g < groups_per_row; ++g) {
          float scale[COLS];
          float bias[COLS];
          for (uint c = 0u; c < COLS_U; ++c) {
            uint col = col0 + c;
            scale[c] = col < n
                ? AFFINE_LOAD(scales.values[scale_slice + col * groups_per_row + g])
                : 0.0;
            bias[c] = col < n
                ? AFFINE_LOAD(biases.values[bias_slice + col * groups_per_row + g])
                : 0.0;
          }
          for (uint s = 0u; s < 8u; ++s) {
            uint kw = g * 8u + s;
            uint xk = g * 8u + s;
            float wv[COLS][8];
            for (uint c = 0u; c < COLS_U; ++c) {
              uint col = col0 + c;
              uint packed = col < n
                  ? input_w.values[w_slice + col * words_per_row + kw]
                  : 0u;
              wv[c][0] = scale[c] * float(packed & 0xFu) + bias[c];
              wv[c][1] = scale[c] * float((packed >> 4u) & 0xFu) + bias[c];
              wv[c][2] = scale[c] * float((packed >> 8u) & 0xFu) + bias[c];
              wv[c][3] = scale[c] * float((packed >> 12u) & 0xFu) + bias[c];
              wv[c][4] = scale[c] * float((packed >> 16u) & 0xFu) + bias[c];
              wv[c][5] = scale[c] * float((packed >> 20u) & 0xFu) + bias[c];
              wv[c][6] = scale[c] * float((packed >> 24u) & 0xFu) + bias[c];
              wv[c][7] = scale[c] * float(packed >> 28u) + bias[c];
            }
            for (uint r = 0u; r < ROWS_U; ++r) {
              uint row = row0 + r;
              uvec4 xw = row < m
                  ? input_x4.values4[x_slice4 + row * x_vec_per_row + xk]
                  : uvec4(0u);
              float x0 = X_LO(xw.x);
              float x1 = X_HI(xw.x);
              float x2 = X_LO(xw.y);
              float x3 = X_HI(xw.y);
              float x4 = X_LO(xw.z);
              float x5 = X_HI(xw.z);
              float x6 = X_LO(xw.w);
              float x7 = X_HI(xw.w);
              for (uint c = 0u; c < COLS_U; ++c) {
#ifdef PRECISE_ACCUM
                precise float p0 = x0 * wv[c][0];
                acc[r][c] += p0;
                precise float p1 = x1 * wv[c][1];
                acc[r][c] += p1;
                precise float p2 = x2 * wv[c][2];
                acc[r][c] += p2;
                precise float p3 = x3 * wv[c][3];
                acc[r][c] += p3;
                precise float p4 = x4 * wv[c][4];
                acc[r][c] += p4;
                precise float p5 = x5 * wv[c][5];
                acc[r][c] += p5;
                precise float p6 = x6 * wv[c][6];
                acc[r][c] += p6;
                precise float p7 = x7 * wv[c][7];
                acc[r][c] += p7;
#else
                acc[r][c] += x0 * wv[c][0];
                acc[r][c] += x1 * wv[c][1];
                acc[r][c] += x2 * wv[c][2];
                acc[r][c] += x3 * wv[c][3];
                acc[r][c] += x4 * wv[c][4];
                acc[r][c] += x5 * wv[c][5];
                acc[r][c] += x6 * wv[c][6];
                acc[r][c] += x7 * wv[c][7];
#endif
              }
            }
          }
        }
        for (uint r = 0u; r < ROWS_U; ++r) {
          uint row = row0 + r;
          if (row < m) {
            for (uint p = 0u; p < COLS_U / 2u; ++p) {
              uint col = col0 + 2u * p;
              if (col < n) {
                uint index = (out_slice + row * n + col) / 2u;
                output_words.values[index] =
                    PACK_OUT(acc[r][2u * p], acc[r][2u * p + 1u]);
              }
            }
          }
        }
      }
    }
  }
}
