// Instruction: op[7:0] | a[15:8] | b[23:16] | dst[31:24].
// Operands: 0x00-0x07 are registers; 0x10+slot selects a leaf buffer.
// Op codes match chain_op_for in fused_chain.cpp, not ElementwiseOperation.
// Each instruction rounds to the storage dtype, matching per-node dispatch.

#version 460
#extension GL_GOOGLE_include_directive : require
#include "omarchy_half.h"

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
// The float16_t round trip failed M1 equality; an integer round-to-nearest-even
// conversion preserves the required intermediate rounding on every driver
// (packHalf2x16 rounding is implementation-defined). Compiler-pass
// attribution of the float16_t failure is unproved.
#define ROUND_INTERMEDIATE(f) omarchy_round_f16(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#define ROUND_INTERMEDIATE(f) LOAD_VALUE(bf16_store(f))
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#define ROUND_INTERMEDIATE(f) (f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer LeafA {
  STORAGE_TYPE values[];
} leaf_a;
layout(set = 0, binding = 1, std430) readonly buffer LeafB {
  STORAGE_TYPE values[];
} leaf_b;
layout(set = 0, binding = 2, std430) buffer LeafCOrFirstIntermediate {
  STORAGE_TYPE values[];
} leaf_c;
layout(set = 0, binding = 3, std430) readonly buffer Program {
  uint words[];
} program_buf;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
layout(set = 0, binding = 5, std430) writeonly buffer SecondIntermediate {
  STORAGE_TYPE values[];
} second_intermediate;

// The first eleven ComputeParams scalars carry this compact ABI. aux_offset
// selects eager materialization of the first two instructions; compiled
// chains leave it zero.
layout(push_constant) uniform Params {
  uint count;
  uint instr_count;
  uint last_dim;
  uint dst_final;
  uint leaf_offset[3];
  // Per leaf: 0 = direct, 1 = index % last_dim, 2 = index / last_dim,
  // 3 = scalar (index 0).
  uint leaf_mode[3];
  uint materialize_intermediates;
} params;

STORAGE_TYPE load_leaf(uint slot, uint index) {
  uint offset = params.leaf_offset[slot];
  uint address;
  if (params.leaf_mode[slot] == 1u) {
    address = index % params.last_dim;
  } else if (params.leaf_mode[slot] == 2u) {
    address = index / params.last_dim;
  } else if (params.leaf_mode[slot] == 3u) {
    address = 0u;
  } else {
    address = index;
  }
  if (slot == 0u) {
    return leaf_a.values[offset + address];
  }
  if (slot == 1u) {
    return leaf_b.values[offset + address];
  }
  return leaf_c.values[offset + address];
}

float eval_operand(uint operand, uint index, float regs[8]) {
  if (operand <= 7u) {
    return regs[operand];
  }
  return LOAD_VALUE(load_leaf(operand - 0x10u, index));
}

void main() {
  // Grid stride, mirroring elementwise.comp: the dispatcher caps the
  // group count at the device limit, so one invocation covers several
  // chain elements when count exceeds one full grid.
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    float regs[8];
    for (uint i = 0; i < params.instr_count; ++i) {
      uint word = program_buf.words[i];
      uint op = word & 0xffu;
      uint a = (word >> 8) & 0xffu;
      uint b = (word >> 16) & 0xffu;
      uint dst = (word >> 24) & 0xffu;
      float lhs = eval_operand(a, index, regs);
      float rhs = eval_operand(b, index, regs);
      float value;
      switch (op) {
        case 0u: // Add
          value = lhs + rhs;
          break;
        case 1u: // Multiply
          value = lhs * rhs;
          break;
        case 2u: // Divide
          value = lhs / rhs;
          break;
        case 3u: // Maximum: NaN propagates, mirroring elementwise.comp.
          value = (isnan(lhs) || isnan(rhs))
              ? uintBitsToFloat(0x7fc00000u)
              : max(lhs, rhs);
          break;
        case 4u: // Exp
          value = exp(lhs);
          break;
        case 5u: // Sigmoid: same unguarded form as elementwise.comp
          // case 5. exp underflows to 0 for large positive x and
          // overflows to inf for large negative x, both of which the
          // division folds to the correct 1.0 / 0.0 without producing
          // the inf/inf NaN a sign-guarded form would.
          value = 1.0 / (1.0 + exp(-lhs));
          break;
        case 6u: // Square
          value = lhs * lhs;
          break;
        case 7u: // Sqrt
          value = sqrt(lhs);
          break;
        case 8u: // Rsqrt
          value = inversesqrt(lhs);
          break;
        case 9u: // Subtract
          value = lhs - rhs;
          break;
        case 10u: // Negative
          value = -lhs;
          break;
        case 11u: // Minimum: NaN propagates, mirroring elementwise.comp.
          value = (isnan(lhs) || isnan(rhs))
              ? uintBitsToFloat(0x7fc00000u)
              : min(lhs, rhs);
          break;
        case 12u: // Tanh
          value = tanh(lhs);
          break;
        default:
          return;
      }
      regs[dst] = ROUND_INTERMEDIATE(value);
      if (params.materialize_intermediates != 0u) {
        if (i == 0u) {
          leaf_c.values[index] = STORE_VALUE(regs[dst]);
        } else if (i == 1u) {
          second_intermediate.values[index] = STORE_VALUE(regs[dst]);
        }
      }
    }
    output_data.values[index] = STORE_VALUE(regs[params.dst_final]);
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
