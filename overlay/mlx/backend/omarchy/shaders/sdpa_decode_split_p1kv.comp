//
// Split-K pass 1 with coalesced K and V loads and reduced threadgroup memory
// (MLX_OMARCHY_SDPA_SPLIT_P1KV=32|64|128; same scratch layout and pass 2 as
// sdpa_decode_split_p1v.comp / sdpa_decode_split_p2.comp).
//
// Why this exists:
// - sdpa_decode_split_p1v.comp / _bk64 assign one thread per key in the K
//   score phase, so adjacent lanes stride by one full K row (256 B for HD=128,
//   512 B for HD=256) on every uvec4 load — zero coalescing across a 32-lane
//   subgroup — and hold s_o[4 * SPLIT_R * D] (8 KB at HD=128, 16 KB at HD=256)
//   plus s_q and s_part (13.3 KB / 22.5 KB total threadgroup memory).
// - This shader maps lanes across the head dimension for BOTH K and V:
//     * HD=128 K: 16 lanes x uvec4 (8 bf16) = 256 B coalesced per key row,
//       2 keys per 32-lane subgroup (512 B contiguous burst per load),
//       reduced in 4 subgroupShuffleXor steps with Q resident in registers.
//     * HD=256 K: 32 lanes x uvec4 (8 bf16) = 512 B coalesced per key row,
//       1 key per 32-lane subgroup, reduced by one subgroupAdd with Q in
//       registers.
//     * V phase: 32 lanes x uvec2 (HD=128) or uvec4 (HD=256), 4 subgroups
//       splitting BK keys, reduced one head at a time through s_o[4 * D]
//       (2 KB at HD=128, 4 KB at HD=256 — 4x smaller threadgroup footprint).
//
// Arithmetic is float32 throughout; only pass 2 rounds to bf16. Gated against
// float64 reference in test_sdpa_split.cpp.

#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#ifndef SPLIT_R
#define SPLIT_R 4
#endif

#ifndef HD
#define HD 128
#endif

#ifndef BK_KEYS
#define BK_KEYS 64
#endif

#if HD != 128 && HD != 256
#error "sdpa_decode_split_p1kv.comp supports HD=128 or HD=256 only"
#endif

#if BK_KEYS != 32 && BK_KEYS != 64 && BK_KEYS != 128
#error "sdpa_decode_split_p1kv.comp supports BK_KEYS in {32, 64, 128} only"
#endif

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Query {
  uint16_t values[];
} query_data;
layout(set = 0, binding = 1, std430) readonly buffer Key {
  uvec4 values[];
} key_data;
#if HD == 128
layout(set = 0, binding = 2, std430) readonly buffer Value {
  uvec2 values[];
} value_data;
#else
layout(set = 0, binding = 2, std430) readonly buffer Value {
  uvec4 values[];
} value_data;
#endif
layout(set = 0, binding = 3, std430) writeonly buffer Scratch {
  float values[];
} scratch_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

const uint D = uint(HD);
const uint BK = uint(BK_KEYS);
const uint K_PER_SG = BK / 4u;

shared float s_p[SPLIT_R * BK];
shared float s_max[SPLIT_R * 4u];
shared float s_sum[SPLIT_R * 4u];
shared float s_o[4u * D];

float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}

void main() {
  uint t = gl_LocalInvocationID.x;
  uint kv_head = gl_WorkGroupID.x;
  uint block = gl_WorkGroupID.y;
  uint k_len = params.matrix_k;
  uint nblocks = (k_len + BK - 1u) / BK;
  uint sg = gl_SubgroupID;
  uint lane = gl_SubgroupInvocationID;

  uint k_stride = params.shape[2];
  uint k_block_base =
      params.rhs_offset + kv_head * params.shape[1] + block * BK * k_stride;
  uint kstart = sg * K_PER_SG;
  uint kend = kstart + K_PER_SG;

  // Phase 1: Coalesced K loads with Q resident in registers (8 bf16/lane).
#if HD == 128
  uint lane_k = lane >> 4u;
  uint lane_d = lane & 15u;
  float q[SPLIT_R * 8u];
  for (uint r = 0u; r < SPLIT_R; ++r) {
    uint head = kv_head * SPLIT_R + r;
    uint q_base = params.lhs_offset + head * params.shape[0] + lane_d * 8u;
    for (uint i = 0u; i < 8u; ++i) {
      q[r * 8u + i] = params.alpha * bf16_load(query_data.values[q_base + i]);
    }
  }
  for (uint k0 = kstart; k0 < kend; k0 += 4u) {
    uint lk0 = k0 + lane_k;
    uint lk1 = k0 + 2u + lane_k;
    bool v0 = (block * BK + lk0) < k_len;
    bool v1 = (block * BK + lk1) < k_len;
    uvec4 w0 = v0
        ? key_data.values[(k_block_base + lk0 * k_stride + lane_d * 8u) >> 3u]
        : uvec4(0u);
    uvec4 w1 = v1
        ? key_data.values[(k_block_base + lk1 * k_stride + lane_d * 8u) >> 3u]
        : uvec4(0u);

    float kf0[8];
    kf0[0] = uintBitsToFloat(w0.x << 16u);
    kf0[1] = uintBitsToFloat(w0.x & 0xffff0000u);
    kf0[2] = uintBitsToFloat(w0.y << 16u);
    kf0[3] = uintBitsToFloat(w0.y & 0xffff0000u);
    kf0[4] = uintBitsToFloat(w0.z << 16u);
    kf0[5] = uintBitsToFloat(w0.z & 0xffff0000u);
    kf0[6] = uintBitsToFloat(w0.w << 16u);
    kf0[7] = uintBitsToFloat(w0.w & 0xffff0000u);
    for (uint r = 0u; r < SPLIT_R; ++r) {
      float acc = q[r * 8u + 0u] * kf0[0] + q[r * 8u + 1u] * kf0[1] +
                  q[r * 8u + 2u] * kf0[2] + q[r * 8u + 3u] * kf0[3] +
                  q[r * 8u + 4u] * kf0[4] + q[r * 8u + 5u] * kf0[5] +
                  q[r * 8u + 6u] * kf0[6] + q[r * 8u + 7u] * kf0[7];
      acc += subgroupShuffleXor(acc, 8u);
      acc += subgroupShuffleXor(acc, 4u);
      acc += subgroupShuffleXor(acc, 2u);
      acc += subgroupShuffleXor(acc, 1u);
      if (lane_d == 0u) {
        s_p[r * BK + lk0] = v0 ? acc : uintBitsToFloat(0xff800000u);
      }
    }

    float kf1[8];
    kf1[0] = uintBitsToFloat(w1.x << 16u);
    kf1[1] = uintBitsToFloat(w1.x & 0xffff0000u);
    kf1[2] = uintBitsToFloat(w1.y << 16u);
    kf1[3] = uintBitsToFloat(w1.y & 0xffff0000u);
    kf1[4] = uintBitsToFloat(w1.z << 16u);
    kf1[5] = uintBitsToFloat(w1.z & 0xffff0000u);
    kf1[6] = uintBitsToFloat(w1.w << 16u);
    kf1[7] = uintBitsToFloat(w1.w & 0xffff0000u);
    for (uint r = 0u; r < SPLIT_R; ++r) {
      float acc = q[r * 8u + 0u] * kf1[0] + q[r * 8u + 1u] * kf1[1] +
                  q[r * 8u + 2u] * kf1[2] + q[r * 8u + 3u] * kf1[3] +
                  q[r * 8u + 4u] * kf1[4] + q[r * 8u + 5u] * kf1[5] +
                  q[r * 8u + 6u] * kf1[6] + q[r * 8u + 7u] * kf1[7];
      acc += subgroupShuffleXor(acc, 8u);
      acc += subgroupShuffleXor(acc, 4u);
      acc += subgroupShuffleXor(acc, 2u);
      acc += subgroupShuffleXor(acc, 1u);
      if (lane_d == 0u) {
        s_p[r * BK + lk1] = v1 ? acc : uintBitsToFloat(0xff800000u);
      }
    }
  }
#else
  float q[SPLIT_R * 8u];
  for (uint r = 0u; r < SPLIT_R; ++r) {
    uint head = kv_head * SPLIT_R + r;
    uint q_base = params.lhs_offset + head * params.shape[0] + lane * 8u;
    for (uint i = 0u; i < 8u; ++i) {
      q[r * 8u + i] = params.alpha * bf16_load(query_data.values[q_base + i]);
    }
  }
  for (uint k0 = kstart; k0 < kend; k0 += 4u) {
    bool kv[4];
    uvec4 kw[4];
    for (uint i = 0u; i < 4u; ++i) {
      uint lk = k0 + i;
      kv[i] = (block * BK + lk) < k_len;
      kw[i] = kv[i]
          ? key_data.values[(k_block_base + lk * k_stride + lane * 8u) >> 3u]
          : uvec4(0u);
    }
    for (uint i = 0u; i < 4u; ++i) {
      float kf[8];
      kf[0] = uintBitsToFloat(kw[i].x << 16u);
      kf[1] = uintBitsToFloat(kw[i].x & 0xffff0000u);
      kf[2] = uintBitsToFloat(kw[i].y << 16u);
      kf[3] = uintBitsToFloat(kw[i].y & 0xffff0000u);
      kf[4] = uintBitsToFloat(kw[i].z << 16u);
      kf[5] = uintBitsToFloat(kw[i].z & 0xffff0000u);
      kf[6] = uintBitsToFloat(kw[i].w << 16u);
      kf[7] = uintBitsToFloat(kw[i].w & 0xffff0000u);
      for (uint r = 0u; r < SPLIT_R; ++r) {
        float acc = q[r * 8u + 0u] * kf[0] + q[r * 8u + 1u] * kf[1] +
                    q[r * 8u + 2u] * kf[2] + q[r * 8u + 3u] * kf[3] +
                    q[r * 8u + 4u] * kf[4] + q[r * 8u + 5u] * kf[5] +
                    q[r * 8u + 6u] * kf[6] + q[r * 8u + 7u] * kf[7];
        float sc = subgroupAdd(acc);
        if (lane == 0u) {
          s_p[r * BK + k0 + i] = kv[i] ? sc : uintBitsToFloat(0xff800000u);
        }
      }
    }
  }
#endif
  barrier();

  // Phase 2: Block softmax over BK scores in s_p.
#if BK_KEYS == 32
  if (sg == 0u) {
    bool valid = (block * BK + lane) < k_len;
    for (uint r = 0u; r < SPLIT_R; ++r) {
      float sc = s_p[r * BK + lane];
      float m = subgroupMax(sc);
      float p = valid ? exp(sc - m) : 0.0;
      s_p[r * BK + lane] = p;
      float ps = subgroupAdd(p);
      if (lane == 0u) {
        s_max[r] = m;
        s_sum[r] = ps;
      }
    }
  }
  barrier();
#elif BK_KEYS == 64
  float sc[SPLIT_R];
  if (sg < 2u) {
    for (uint r = 0u; r < SPLIT_R; ++r) {
      sc[r] = s_p[r * BK + t];
      float m = subgroupMax(sc[r]);
      if (lane == 0u) {
        s_max[r * 2u + sg] = m;
      }
    }
  }
  barrier();
  if (sg < 2u) {
    bool valid = (block * BK + t) < k_len;
    for (uint r = 0u; r < SPLIT_R; ++r) {
      float m = max(s_max[r * 2u], s_max[r * 2u + 1u]);
      float p = valid ? exp(sc[r] - m) : 0.0;
      s_p[r * BK + t] = p;
      float ps = subgroupAdd(p);
      if (lane == 0u) {
        s_sum[r * 2u + sg] = ps;
        if (sg == 0u) {
          s_max[r * 2u] = m;
        }
      }
    }
  }
  barrier();
#else
  float sc[SPLIT_R];
  for (uint r = 0u; r < SPLIT_R; ++r) {
    sc[r] = s_p[r * BK + t];
    float m = subgroupMax(sc[r]);
    if (lane == 0u) {
      s_max[r * 4u + sg] = m;
    }
  }
  barrier();
  bool valid = (block * BK + t) < k_len;
  for (uint r = 0u; r < SPLIT_R; ++r) {
    float m = max(max(s_max[r * 4u], s_max[r * 4u + 1u]),
                  max(s_max[r * 4u + 2u], s_max[r * 4u + 3u]));
    float p = valid ? exp(sc[r] - m) : 0.0;
    s_p[r * BK + t] = p;
    float ps = subgroupAdd(p);
    if (lane == 0u) {
      s_sum[r * 4u + sg] = ps;
      if (sg == 0u) {
        s_max[r * 4u] = m;
      }
    }
  }
  barrier();
#endif

  // Phase 3: Coalesced V accumulation + per-head s_o[4 * D] reduction.
  uint nk = min(BK, k_len - block * BK);
  uint v_stride = params.in_strides[2];
  uint v_kstart = sg * K_PER_SG;
  uint v_kend = min(nk, v_kstart + K_PER_SG);
#if HD == 128
  uint v_row0 =
      params.aux_offset + kv_head * params.in_strides[1] + block * BK * v_stride + lane * 4u;
  float o[SPLIT_R * 4u];
  for (uint i = 0u; i < SPLIT_R * 4u; ++i) {
    o[i] = 0.0;
  }
  uint key0 = v_kstart;
  for (; key0 + 4u <= v_kend; key0 += 4u) {
    uvec2 w[4];
    for (uint i = 0u; i < 4u; ++i) {
      w[i] = value_data.values[(v_row0 + (key0 + i) * v_stride) >> 2u];
    }
    for (uint i = 0u; i < 4u; ++i) {
      float v0 = uintBitsToFloat(w[i].x << 16u);
      float v1 = uintBitsToFloat(w[i].x & 0xffff0000u);
      float v2 = uintBitsToFloat(w[i].y << 16u);
      float v3 = uintBitsToFloat(w[i].y & 0xffff0000u);
      for (uint r = 0u; r < SPLIT_R; ++r) {
        float p = s_p[r * BK + key0 + i];
        o[r * 4u + 0u] += p * v0;
        o[r * 4u + 1u] += p * v1;
        o[r * 4u + 2u] += p * v2;
        o[r * 4u + 3u] += p * v3;
      }
    }
  }
  for (; key0 < v_kend; ++key0) {
    uvec2 w = value_data.values[(v_row0 + key0 * v_stride) >> 2u];
    float v0 = uintBitsToFloat(w.x << 16u);
    float v1 = uintBitsToFloat(w.x & 0xffff0000u);
    float v2 = uintBitsToFloat(w.y << 16u);
    float v3 = uintBitsToFloat(w.y & 0xffff0000u);
    for (uint r = 0u; r < SPLIT_R; ++r) {
      float p = s_p[r * BK + key0];
      o[r * 4u + 0u] += p * v0;
      o[r * 4u + 1u] += p * v1;
      o[r * 4u + 2u] += p * v2;
      o[r * 4u + 3u] += p * v3;
    }
  }
  for (uint r = 0u; r < SPLIT_R; ++r) {
    for (uint i = 0u; i < 4u; ++i) {
      s_o[sg * D + lane * 4u + i] = o[r * 4u + i];
    }
    barrier();
    uint head = kv_head * SPLIT_R + r;
    uint base = (head * nblocks + block) * (D + 2u);
    if (t == 0u) {
#if BK_KEYS == 32
      scratch_data.values[base] = s_max[r];
      scratch_data.values[base + 1u] = s_sum[r];
#elif BK_KEYS == 64
      scratch_data.values[base] = s_max[r * 2u];
      scratch_data.values[base + 1u] = s_sum[r * 2u] + s_sum[r * 2u + 1u];
#else
      scratch_data.values[base] = s_max[r * 4u];
      scratch_data.values[base + 1u] = s_sum[r * 4u] + s_sum[r * 4u + 1u] +
          s_sum[r * 4u + 2u] + s_sum[r * 4u + 3u];
#endif
    }
    float total = s_o[t] + s_o[D + t] + s_o[2u * D + t] + s_o[3u * D + t];
    scratch_data.values[base + 2u + t] = total;
    if (r + 1u < SPLIT_R) {
      barrier();
    }
  }
#else
  uint v_row0 =
      params.aux_offset + kv_head * params.in_strides[1] + block * BK * v_stride + lane * 8u;
  float o[SPLIT_R * 8u];
  for (uint i = 0u; i < SPLIT_R * 8u; ++i) {
    o[i] = 0.0;
  }
  uint key0 = v_kstart;
  for (; key0 + 4u <= v_kend; key0 += 4u) {
    uvec4 w[4];
    for (uint i = 0u; i < 4u; ++i) {
      w[i] = value_data.values[(v_row0 + (key0 + i) * v_stride) >> 3u];
    }
    for (uint i = 0u; i < 4u; ++i) {
      float v[8];
      v[0] = uintBitsToFloat(w[i].x << 16u);
      v[1] = uintBitsToFloat(w[i].x & 0xffff0000u);
      v[2] = uintBitsToFloat(w[i].y << 16u);
      v[3] = uintBitsToFloat(w[i].y & 0xffff0000u);
      v[4] = uintBitsToFloat(w[i].z << 16u);
      v[5] = uintBitsToFloat(w[i].z & 0xffff0000u);
      v[6] = uintBitsToFloat(w[i].w << 16u);
      v[7] = uintBitsToFloat(w[i].w & 0xffff0000u);
      for (uint r = 0u; r < SPLIT_R; ++r) {
        float p = s_p[r * BK + key0 + i];
        for (uint j = 0u; j < 8u; ++j) {
          o[r * 8u + j] += p * v[j];
        }
      }
    }
  }
  for (; key0 < v_kend; ++key0) {
    uvec4 w = value_data.values[(v_row0 + key0 * v_stride) >> 3u];
    float v[8];
    v[0] = uintBitsToFloat(w.x << 16u);
    v[1] = uintBitsToFloat(w.x & 0xffff0000u);
    v[2] = uintBitsToFloat(w.y << 16u);
    v[3] = uintBitsToFloat(w.y & 0xffff0000u);
    v[4] = uintBitsToFloat(w.z << 16u);
    v[5] = uintBitsToFloat(w.z & 0xffff0000u);
    v[6] = uintBitsToFloat(w.w << 16u);
    v[7] = uintBitsToFloat(w.w & 0xffff0000u);
    for (uint r = 0u; r < SPLIT_R; ++r) {
      float p = s_p[r * BK + key0];
      for (uint j = 0u; j < 8u; ++j) {
        o[r * 8u + j] += p * v[j];
      }
    }
  }
  for (uint r = 0u; r < SPLIT_R; ++r) {
    for (uint i = 0u; i < 8u; ++i) {
      s_o[sg * D + lane * 8u + i] = o[r * 8u + i];
    }
    barrier();
    uint head = kv_head * SPLIT_R + r;
    uint base = (head * nblocks + block) * (D + 2u);
    if (t == 0u) {
#if BK_KEYS == 32
      scratch_data.values[base] = s_max[r];
      scratch_data.values[base + 1u] = s_sum[r];
#elif BK_KEYS == 64
      scratch_data.values[base] = s_max[r * 2u];
      scratch_data.values[base + 1u] = s_sum[r * 2u] + s_sum[r * 2u + 1u];
#else
      scratch_data.values[base] = s_max[r * 4u];
      scratch_data.values[base + 1u] = s_sum[r * 4u] + s_sum[r * 4u + 1u] +
          s_sum[r * 4u + 2u] + s_sum[r * 4u + 3u];
#endif
    }
    for (uint d = 0u; d < 2u; ++d) {
      uint dim = d * 128u + t;
      float total = s_o[dim] + s_o[D + dim] + s_o[2u * D + dim] + s_o[3u * D + dim];
      scratch_data.values[base + 2u + dim] = total;
    }
    if (r + 1u < SPLIT_R) {
      barrier();
    }
  }
#endif
}
