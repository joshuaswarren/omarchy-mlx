//
// Wave 7, SVD phase 2: finalize the factors after the one-sided Jacobi
// sweeps (LAPACK gesdd semantics). The work columns are orthogonal now;
// their norms are the singular values. This pass sorts descending,
// canonicalizes each singular direction so the largest-|entry| component
// is positive, stores S, and stores both factors full and square:
// tall convention u = U' (R x R completed) and vt = V^T (C x C); wide
// convention u = V' (C x C) and vt = U'^T (R x R, transposed through the
// finished work buffer). Any zero singular value would leave a dead U
// column, so Gram-Schmidt fill with two reorthogonalization passes
// completes the basis, keeping rank-deficient inputs orthonormal instead
// of silently wrong.
//
// Push-constant routing: matrix_m is R (kernel rows: M tall, N wide),
// matrix_n is C (kernel columns, min(M, N)), output_size the batch matrix
// count, and flags bit 0 the wide convention (the work copy holds A^T and
// u/vt swap contents).
#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) coherent buffer Work {
  float values[];
} work;
layout(set = 0, binding = 1, std430) coherent buffer UOut {
  float values[];
} u_out;
layout(set = 0, binding = 2, std430) coherent buffer VtOut {
  float values[];
} vt_out;
layout(set = 0, binding = 3, std430) writeonly buffer SOut {
  float values[];
} s_out;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float red[256];
shared float signs[1024];
shared float norms[1024];
shared uint perm[1024];

void main() {
  uint tid = gl_LocalInvocationID.x;
  uint r = params.matrix_m;
  uint c = params.matrix_n;
  // The host chunks the batch so no dispatch exceeds 65535 workgroups;
  // aux_offset carries this dispatch's first matrix index (the field is
  // unused by every linalg shader).
  uint matrix = params.aux_offset + gl_WorkGroupID.x;
  uint base = matrix * r * c;
  uint ubase = matrix * r * r;
  uint vbase = matrix * c * c;
  bool wide = (params.flags & 1u) != 0u;

  for (uint j = tid; j < c; j += 256u) {
    float part = 0.0;
    for (uint t = 0u; t < r; ++t) {
      float x = work.values[base + t * c + j];
      part += x * x;
    }
    norms[j] = sqrt(part);
  }
  memoryBarrierBuffer();
  barrier();
  if (tid == 0u) {
    for (uint j = 0u; j < c; ++j) {
      perm[j] = j;
    }
    for (uint i = 1u; i < c; ++i) {
      uint pi = perm[i];
      float di = norms[pi];
      uint j = i;
      while (j > 0u && norms[perm[j - 1u]] < di) {
        perm[j] = perm[j - 1u];
        j--;
      }
      perm[j] = pi;
    }
    // Sign of each sorted direction: largest-|entry| of the U column.
    for (uint jj = 0u; jj < c; ++jj) {
      uint j = perm[jj];
      if (norms[j] == 0.0) {
        continue;
      }
      float best = 0.0;
      uint best_t = 0u;
      for (uint t = 0u; t < r; ++t) {
        float x = abs(work.values[base + t * c + j]);
        if (t == 0u || x > best) {
          best = x;
          best_t = t;
        }
      }
      signs[jj] = (work.values[base + best_t * c + j] >= 0.0) ? 1.0 : -1.0;
    }
  }
  memoryBarrierBuffer();
  barrier();

  for (uint jj = tid; jj < c; jj += 256u) {
    uint j = perm[jj];
    float sg = signs[jj];
    s_out.values[matrix * c + jj] = norms[j];
    if (wide) {
      // vt = U'^T (R x R); V' lives in u_out's first C x C cells.
      for (uint t = 0u; t < r; ++t) {
        float u = (norms[j] > 0.0)
            ? work.values[base + t * c + j] / norms[j]
            : 0.0;
        vt_out.values[ubase + jj * r + t] = u * sg;
      }
    } else {
      // vt = V^T (C x C) read out of u_out before U overwrites it.
      for (uint t = 0u; t < c; ++t) {
        float v = u_out.values[vbase + t * c + j];
        vt_out.values[vbase + jj * c + t] = v * sg;
      }
    }
  }
  memoryBarrierBuffer();
  barrier();
  if (wide) {
    // u = V' (C x C): stage V through the finished work buffer so the
    // in-place transpose cannot race itself.
    for (uint idx = tid; idx < c * c; idx += 256u) {
      work.values[base + idx] = u_out.values[vbase + idx];
    }
      memoryBarrierBuffer();
    barrier();
    for (uint jj = tid; jj < c; jj += 256u) {
      uint j = perm[jj];
      float sg = signs[jj];
      for (uint t = 0u; t < c; ++t) {
        float v = work.values[base + t * c + j];
        u_out.values[matrix * c * c + t * c + jj] = v * sg;
      }
    }
  } else {
    for (uint jj = tid; jj < c; jj += 256u) {
      uint j = perm[jj];
      float sg = signs[jj];
      for (uint t = 0u; t < r; ++t) {
        float u = (norms[j] > 0.0)
            ? work.values[base + t * c + j] / norms[j]
            : 0.0;
        u_out.values[ubase + t * r + jj] = u * sg;
      }
    }
  }
  memoryBarrierBuffer();
  barrier();

  // Gram-Schmidt completion to the full square factor. Sorted positions
  // whose source norm is zero and the trailing vectors join the basis;
  // two passes keep the fill stable. The completed factor holds one
  // vector per COLUMN in the tall convention (u) and one per ROW in the
  // wide convention (vt): index cell (vec, t) as vec*stride+t for wide
  // and t*stride+vec for tall, or the projections read cells the
  // sorted-direction loops never wrote (allocator garbage that varies
  // run to run and lands exactly at the k boundary).
  for (uint col = 0u; col < r; ++col) {
    if (col < c && norms[perm[col]] > 0.0) {
      continue;
    }
    uint out_base = ubase;
    uint stride = r;
    for (uint t = tid; t < r; t += 256u) {
      float e = (t == col) ? 1.0 : 0.0;
      if (wide) {
        vt_out.values[out_base + col * stride + t] = e;
      } else {
        u_out.values[out_base + t * stride + col] = e;
      }
    }
      memoryBarrierBuffer();
    barrier();
    for (uint pass = 0u; pass < 2u; ++pass) {
      for (uint done = 0u; done < col; ++done) {
        float part = 0.0;
        for (uint t = tid; t < r; t += 256u) {
          float existing = wide
              ? vt_out.values[out_base + done * stride + t]
              : u_out.values[out_base + t * stride + done];
          float candidate = wide
              ? vt_out.values[out_base + col * stride + t]
              : u_out.values[out_base + t * stride + col];
          part += existing * candidate;
        }
        red[tid] = part;
          memoryBarrierBuffer();
        barrier();
        for (uint stride2 = 128u; stride2 > 0u; stride2 >>= 1u) {
          if (tid < stride2) {
            red[tid] += red[tid + stride2];
          }
          memoryBarrierBuffer();
          barrier();
        }
        float proj = red[0];
        for (uint t = tid; t < r; t += 256u) {
          float existing = wide
              ? vt_out.values[out_base + done * stride + t]
              : u_out.values[out_base + t * stride + done];
          if (wide) {
            vt_out.values[out_base + col * stride + t] -= proj * existing;
          } else {
            u_out.values[out_base + t * stride + col] -= proj * existing;
          }
        }
          memoryBarrierBuffer();
        barrier();
      }
      float part = 0.0;
      for (uint t = tid; t < r; t += 256u) {
        float candidate = wide
            ? vt_out.values[out_base + col * stride + t]
            : u_out.values[out_base + t * stride + col];
        part += candidate * candidate;
      }
      red[tid] = part;
      memoryBarrierBuffer();
      barrier();
      for (uint stride2 = 128u; stride2 > 0u; stride2 >>= 1u) {
        if (tid < stride2) {
          red[tid] += red[tid + stride2];
        }
          memoryBarrierBuffer();
        barrier();
      }
      if (tid == 0u) {
        red[255] = sqrt(max(red[0], 0.0));
      }
      memoryBarrierBuffer();
      barrier();
      float nrm = red[255];
      for (uint t = tid; t < r; t += 256u) {
        float scaled = (nrm > 0.0)
            ? (wide
                  ? vt_out.values[out_base + col * stride + t]
                  : u_out.values[out_base + t * stride + col]) / nrm
            : 0.0;
        if (wide) {
          vt_out.values[out_base + col * stride + t] = scaled;
        } else {
          u_out.values[out_base + t * stride + col] = scaled;
        }
      }
      memoryBarrierBuffer();
      barrier();
    }
  }
}
