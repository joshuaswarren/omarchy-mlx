#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_bfloat16 : require

// Causal flash prefill on the 16x16x16 cooperative matrix (bf16 operands, f32
// accumulators), head_dim 128, for parts whose driver advertises only the
// WMMA-shaped bf16 x bf16 -> f32 subgroup shape (RADV RDNA3+). 16x16x16 twin of
// shaders/sdpa_prefill_flash_causal_coopmat.comp (MatmulGap H35); scores never
// reach memory.
//
// A 64-lane workgroup is ONE subgroup (RADV pins pipelines to wave64); the
// subgroup owns 16 query rows of one head for the whole key walk. Operands come
// straight from the storage buffers: Q panels stay in registers as A operands,
// K tiles load column-major as B operands (K^T), V tiles row-major as B
// operands. Per key tile of 32 keys (two 16-key matrix blocks):
//   1. S = Q K^T on the matrix unit, f32 accumulators, scaled by alpha, stored
//      to the shared tile.
//   2. Lanes (4 per row, 8 keys each): causal mask (masked score = NEGINF, so
//      exp underflows to exact 0), tile max, online max update, p = exp(s - m)
//      in f32 split into two bf16 values p_hi = bf16(p) and
//      p_lo = bf16(p - p_hi), running sum over p_hi + p_lo, both written to
//      shared, the row correction exp(m_old - m_new) written as a 16x16 f32
//      tile (corr[r] along row r).
//   3. O *= correction tile (elementwise multiply of f32 matrices).
//   4. O += P_hi V + P_lo V on the matrix unit (the V operand is loaded once
//      and used twice).
// The epilogue divides O by the row sum the same way (a 1/l tile) and stores
// bf16.
//
// Causal skip: the subgroup walks key tiles up to the last key its last row
// sees (row + k_len - q_len), 16-key blocks past it are skipped. Query rows
// past q_len shift the subgroup back to q_len - 16: the overlap recomputes the
// same rows from the same inputs in the same tile order and stores the same
// bits (host guarantees q_len >= 64).
// Host contract: causal, bf16, hd 128, k_len % 16 == 0, k_len >= q_len,
// q_len >= 64, row strides and offsets multiples of 8 elements, last dim
// contiguous, output (B, H, L, 128) contiguous.
//
// Numerics: the online softmax reassociates the composed softmax, so outputs
// are not bit-identical to the composed route; the gate is the fp64 error no
// worse than the composed causal route, plus run-to-run identity (fixed order,
// no atomics).

const uint MAT = 16u;
const uint HD = 128u;
const uint DT = HD / MAT;               // 8 column tiles of the output
const uint KT = 32u;                    // keys per tile
const uint KB = KT / MAT;               // 2 key blocks per tile
const uint SG_ROWS = MAT;               // 16 query rows per workgroup
const float NEGINF = -3.4028234663852886e38;

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer Query { bfloat16_t q[]; };
layout(set = 0, binding = 1, std430) readonly buffer Key { bfloat16_t k[]; };
layout(set = 0, binding = 2, std430) readonly buffer Value { bfloat16_t v[]; };
layout(set = 0, binding = 3, std430) writeonly buffer OutBuf { bfloat16_t o[]; };

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
  uint q_rowstride;
  uint k_rowstride;
  uint v_rowstride;
  uint o_rowstride;
  uint q_headstride;
  uint k_headstride;
  uint v_headstride;
  uint q_batchstride;
  uint k_batchstride;
  uint v_batchstride;
} params;

shared float s_s[MAT * KT];
shared bfloat16_t s_p[MAT * KT];
shared bfloat16_t s_pl[MAT * KT];
shared float s_c[MAT * MAT];

#define ACCT coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>

// Round to bf16 (nearest even); returns the bits.
uint bf16_bits(float value) {
  uint bits = floatBitsToUint(value);
  return (bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16;
}

void sync_subgroup() {
  subgroupMemoryBarrierShared();
  subgroupBarrier();
}

void main() {
  const uint lane = gl_SubgroupInvocationID;
  const uint batch = gl_WorkGroupID.z;
  const uint repeats = max(params.rhs_gap, 1u);
  const uint lq = params.matrix_m;
  const uint lk = params.matrix_n;
  const uint koff = lk - lq;
  const uint head_id = gl_WorkGroupID.y;
  const uint kv_head = head_id / repeats;

  // Heaviest causal tiles first (MatmulGap H40): the same tiles, launched in
  // descending order.
  uint row0 = (gl_NumWorkGroups.x - 1u - gl_WorkGroupID.x) * SG_ROWS;
  if (row0 >= lq) {
    return;
  }
  row0 = min(row0, lq - SG_ROWS);

  const uint q_base = params.lhs_offset + batch * params.q_batchstride + head_id * params.q_headstride;
  const uint k_base = params.rhs_offset + batch * params.k_batchstride + kv_head * params.k_headstride;
  const uint v_base = params.aux_offset + batch * params.v_batchstride + kv_head * params.v_headstride;
  const uint o_base = params.output_offset + (batch * gl_NumWorkGroups.y + head_id) * lq * HD;
  const uint qs = params.q_rowstride;
  const uint ks = params.k_rowstride;
  const uint vs = params.v_rowstride;
  const uint os = params.o_rowstride;

  coopmat<bfloat16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> qa[DT];
  for (uint s = 0u; s < DT; ++s) {
    coopMatLoad(qa[s], q, q_base + row0 * qs + s * MAT, qs, gl_CooperativeMatrixLayoutRowMajor);
  }
  ACCT acc[DT];
  for (uint d = 0u; d < DT; ++d) {
    acc[d] = ACCT(0.0);
  }

  const uint r = lane >> 2u;            // this lane's row inside the 16-row tile
  const uint jb = (lane & 3u) * 8u;     // this lane's first key inside the 32-key tile
  float m_run = NEGINF;
  float l_run = 0.0;
  const uint last_key = row0 + SG_ROWS - 1u + koff;
  const uint tiles = last_key / KT + 1u;

  for (uint t = 0u; t < tiles; ++t) {
    const uint k0 = t * KT;

    ACCT sc[KB];
    for (uint c = 0u; c < KB; ++c) {
      sc[c] = ACCT(0.0);
    }
    for (uint c = 0u; c < KB; ++c) {
      if (k0 + c * MAT <= last_key) {
        for (uint s = 0u; s < DT; ++s) {
          coopmat<bfloat16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> kb;
          coopMatLoad(kb, k, k_base + (k0 + c * MAT) * ks + s * MAT, ks, gl_CooperativeMatrixLayoutColumnMajor);
          sc[c] = coopMatMulAdd(qa[s], kb, sc[c]);
        }
      }
    }
    for (uint c = 0u; c < KB; ++c) {
      ACCT scaled = sc[c] * params.alpha;
      coopMatStore(scaled, s_s, c * MAT, KT, gl_CooperativeMatrixLayoutRowMajor);
    }
    sync_subgroup();

    {
      const uint tile_base = r * KT + jb;
      const uint visible = row0 + r + koff;
      float s[8];
      float mt = NEGINF;
      for (uint e = 0u; e < 8u; ++e) {
        s[e] = (k0 + jb + e <= visible) ? s_s[tile_base + e] : NEGINF;
        mt = max(mt, s[e]);
      }
      mt = max(mt, subgroupShuffleXor(mt, 1u));
      mt = max(mt, subgroupShuffleXor(mt, 2u));
      const float m_new = max(m_run, mt);
      const float corr = (m_new == m_run) ? 1.0 : exp(m_run - m_new);
      float sum = 0.0;
      for (uint e = 0u; e < 8u; ++e) {
        const float pe = exp(s[e] - m_new);
        const uint hi = bf16_bits(pe);
        const float p_hi = uintBitsToFloat(hi << 16u);
        const uint lo = bf16_bits(pe - p_hi);
        s_p[tile_base + e] = uintBitsToBFloat16EXT(uint16_t(hi));
        s_pl[tile_base + e] = uintBitsToBFloat16EXT(uint16_t(lo));
        sum += p_hi + uintBitsToFloat(lo << 16u);
      }
      sum += subgroupShuffleXor(sum, 1u);
      sum += subgroupShuffleXor(sum, 2u);
      l_run = l_run * corr + sum;
      m_run = m_new;
      const uint cbase = r * MAT + (lane & 3u) * 4u;
      s_c[cbase] = corr;
      s_c[cbase + 1u] = corr;
      s_c[cbase + 2u] = corr;
      s_c[cbase + 3u] = corr;
    }
    sync_subgroup();

    {
      ACCT cm;
      coopMatLoad(cm, s_c, 0u, MAT, gl_CooperativeMatrixLayoutRowMajor);
      for (uint d = 0u; d < DT; ++d) {
        acc[d] = acc[d] * cm;
      }
    }
    for (uint c = 0u; c < KB; ++c) {
      if (k0 + c * MAT <= last_key) {
        coopmat<bfloat16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> pa;
        coopmat<bfloat16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> pb;
        coopMatLoad(pa, s_p, c * MAT, KT, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(pb, s_pl, c * MAT, KT, gl_CooperativeMatrixLayoutRowMajor);
        for (uint d = 0u; d < DT; ++d) {
          coopmat<bfloat16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> vb;
          coopMatLoad(vb, v, v_base + (k0 + c * MAT) * vs + d * MAT, vs, gl_CooperativeMatrixLayoutRowMajor);
          acc[d] = coopMatMulAdd(pa, vb, acc[d]);
          acc[d] = coopMatMulAdd(pb, vb, acc[d]);
        }
      }
    }
    sync_subgroup();
  }

  {
    const float inv_l = 1.0 / l_run;
    const uint cbase = r * MAT + (lane & 3u) * 4u;
    s_c[cbase] = inv_l;
    s_c[cbase + 1u] = inv_l;
    s_c[cbase + 2u] = inv_l;
    s_c[cbase + 3u] = inv_l;
  }
  sync_subgroup();
  {
    ACCT cm;
    coopMatLoad(cm, s_c, 0u, MAT, gl_CooperativeMatrixLayoutRowMajor);
    for (uint d = 0u; d < DT; ++d) {
      ACCT scaled = acc[d] * cm;
      coopmat<bfloat16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> h =
          coopmat<bfloat16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(scaled);
      coopMatStore(h, o, o_base + row0 * os + d * MAT, os, gl_CooperativeMatrixLayoutRowMajor);
    }
  }
}
