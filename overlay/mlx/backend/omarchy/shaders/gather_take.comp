//
// General gather (the Gather primitive behind take and take_along
// slicing). Output element t splits into a broadcast index position and
// a slice-window position: idx_lin = t / slice_total and s = t % slice
// _total. Every table dim contributes s_d * table_stride[d] to the
// source offset (window sizes come from slice_sizes, gathered dims
// included), and each gathered axis adds its decoded index value times
// that axis's table stride. Index arrays arrive pre-broadcast by the
// op layer, share one dtype and shape, and are materialized dense by
// the host, so one extent table decodes every array's position.
//
// params.operation selects the index interpretation, the rule the
// gather_rows kernel used before the general kernel replaced it:
// 0 = signed 32-bit, 1 = unsigned 32-bit, 2 = signed 64-bit as two
// little-endian words, 3 = unsigned 8-bit, 4 = signed 8-bit,
// 5 = unsigned 16-bit, 6 = signed 16-bit (byte and half lanes ride
// the word transport with the receipt-proven BYTE_AT decode).
// Negative signed indices wrap like upstream offset_neg_idx: -1 reads
// the last position along that axis. An index outside [-dim, dim)
// writes zero, the documented deviation the axis gather and the row
// gather make; upstream leaves such reads undefined. An int64 index
// whose high word is neither 0 nor 0xFFFFFFFF is out of range and
// takes the zero path.
//
// USE_U32 selects raw uint32 storage: words copy with no float
// conversion, so int32/uint32 tables and packed words above 2^31 stay
// bit-exact. USE_U16 copies raw halfwords the same way; USE_I64 copies
// raw 8-byte elements. USE_MULTI_INDEX packs every broadcast index
// array into binding 1, stores [axis extents | table strides | packed
// word offsets] at binding 2, and moves output to binding 3. The push-
// constant tables cap table and broadcast-index ranks at four; gathered
// axes use the external metadata table.
#version 460

#ifdef USE_COMPLEX
#define STORAGE_TYPE vec2
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#elif defined(USE_FP16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#elif defined(USE_U32)
#define STORAGE_TYPE uint
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#elif defined(USE_U16)
// Raw 16-bit table storage: halfwords copy bitwise, so int16/uint16
// tables keep packed bits exact. Reads need the 16-bit storage
// feature; the host gates dispatch on it.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#elif defined(USE_I64)
#define STORAGE_TYPE uvec2
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(x) (x)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Table {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 1, std430) readonly buffer Indices {
  int values[];
} indices_data;
#ifdef USE_MULTI_INDEX
layout(set = 0, binding = 2, std430) readonly buffer AxisMetadata {
  uint values[];
} axis_metadata;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
#else
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
  // Lockstep tail of ComputeParams (mlx compute.h): a shader may
  // declare any prefix of the struct, so these appended fields keep
  // every existing SPIR-V interface byte-identical.
  uint q_rowstride;
  uint k_rowstride;
  uint v_rowstride;
  uint o_rowstride;
  uint q_headstride;
  uint k_headstride;
  uint v_headstride;
  uint q_batchstride;
  uint k_batchstride;
  uint v_batchstride;
  // Windowed-dispatch transport: out_row_stride is the full output row
  // width for windowed matmul-family dispatches (0 = use matrix_n);
  // window_lo is the global first row / element for row- or
  // index-windowed dispatches (0 = unwindowed); window_hi is Take's
  // exclusive row-window bound (0 = unwindowed).
  uint out_row_stride;
  uint window_lo;
  uint window_hi;
} params;

// Honeykrisp miscompiles data-dependent shift-then-mask byte
// extraction; four constant shifts picked by a select chain are the
// receipt-proven equivalent (scatter.comp BYTE_AT).
#define BYTE_AT(word, lane)                                                   \
  ((lane) == 0u ? ((word) & 0xFFu)                                            \
       : (lane) == 1u ? (((word) >> 8u) & 0xFFu)                              \
       : (lane) == 2u ? (((word) >> 16u) & 0xFFu)                             \
                      : (((word) >> 24u) & 0xFFu))

// Decode one index element of any supported dtype into out_index.
// slot is the element position inside the index array; the macro does
// its own width scaling against the word transport the buffer rides.
// Narrow lanes decode through BYTE_AT, sign-extended for the signed
// modes, then the same signed wrap the 32-bit modes apply. Out-of-range
// leaves out_index == dim, the zero-write marker. Expands as a plain
// braced block: GLSL conditions are bool-typed, so a do/while(0)
// wrapper does not compile.
#define DECODE_INDEX(buf, base, slot, op, dim, out_index)                     \
  {                                                                           \
    uint decoded_index = (dim);                                               \
    if ((op) == 3u || (op) == 4u) {                                           \
      uint bword = uint(buf.values[(base) + ((slot) >> 2u)]);                 \
      uint b = BYTE_AT(bword, (slot) & 3u);                                   \
      if ((op) == 4u && (b & 0x80u) != 0u) {                                  \
        b |= 0xFFFFFF00u;                                                     \
      }                                                                       \
      decoded_index = b < 0x80000000u ? b : (dim) + b;                        \
    } else if ((op) == 5u || (op) == 6u) {                                    \
      uint hword = uint(buf.values[(base) + ((slot) >> 1u)]);                 \
      uint h = ((slot) & 1u) == 0u ? (hword & 0xFFFFu) : (hword >> 16u);      \
      if ((op) == 6u && (h & 0x8000u) != 0u) {                                \
        h |= 0xFFFF0000u;                                                     \
      }                                                                       \
      decoded_index = h < 0x80000000u ? h : (dim) + h;                        \
    } else {                                                                  \
      uint word = uint(buf.values[(base) + (slot)]);                          \
      if ((op) == 0u) {                                                       \
        decoded_index = word < 0x80000000u ? word : (dim) + word;             \
      } else if ((op) == 1u) {                                                \
        decoded_index = word;                                                 \
      } else {                                                                \
        uint high = uint(buf.values[(base) + (slot) + 1u]);                   \
        if (high == 0u) {                                                     \
          decoded_index = word;                                               \
        } else if (high == 0xFFFFFFFFu) {                                     \
          decoded_index = (dim) + word;                                       \
        }                                                                     \
      }                                                                       \
    }                                                                         \
    (out_index) = decoded_index;                                              \
  }                                                                           \

void main() {
  uint t = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (t < params.count) {
    // Split the output element into index position and window position.
    uint idx_count = 1u;
    for (uint i = 0u; i < params.dims; ++i) {
      idx_count *= params.out_strides[i];
    }
    uint slice_total = params.count / idx_count;
    uint idx_lin = t / slice_total;
    uint s = t - idx_lin * slice_total;

    // Decode the window position across the table dims.
    uint win = 0u;
    uint scale = 1u;
    for (uint i = params.flags; i > 0u; --i) {
      uint dim = params.shape[i - 1u];
      win += ((s / scale) % dim) * params.in_strides[i - 1u];
      scale *= dim;
    }

    uint word_slot =
        params.operation == 2u ? idx_lin + idx_lin : idx_lin;
    bool valid = true;
    bool row_in_window = true;
    uint src = 0u;
#ifdef USE_MULTI_INDEX
    for (uint axis = 0u; axis < params.aux_size; ++axis) {
      uint dim = axis_metadata.values[axis];
      uint index;
      DECODE_INDEX(indices_data,
                   axis_metadata.values[2u * params.aux_size + axis],
                   word_slot,
                   params.operation,
                   dim,
                   index);
      valid = valid && index < dim;
      src += index * axis_metadata.values[params.aux_size + axis];
    }
#else
    {
      uint dim = params.reduce_size;
      uint index;
      DECODE_INDEX(indices_data,
                   params.rhs_offset,
                   word_slot,
                   params.operation,
                   dim,
                   index);
      valid = index < dim;
      src = index * params.matrix_m;
      // Row-windowed dispatch (window_hi != 0): a row outside the
      // window belongs to another dispatch in the split and must not
      // store; an out-of-extent index keeps its zero write so every
      // window's dispatch writes the same value there.
      if (params.window_hi != 0u && valid &&
          (index < params.window_lo || index >= params.window_hi)) {
        row_in_window = false;
      }
    }
#endif
#if defined(USE_COMPLEX) || defined(USE_U32) || defined(USE_U16) || defined(USE_I64)
    STORAGE_TYPE value = STORAGE_TYPE(0);
#else
    float value = 0.0;
#endif
    // A row outside this dispatch's window must not load either: its
    // address lands past the window's byte binding.
    if (valid && row_in_window) {
      value = LOAD_VALUE(
          input_data.values[params.lhs_offset + src + win]);
    }
    if (row_in_window) {
      output_data.values[params.output_offset + t] = STORE_VALUE(value);
    }
    if (params.count - t <= stride) {
      break;
    }
    t += stride;
  }
}
