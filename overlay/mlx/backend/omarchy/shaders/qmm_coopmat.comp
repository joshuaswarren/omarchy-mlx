#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Direct-global-load qmm prefill coopmat: whenever x can feed the
// matrix unit exactly, the A (x) tiles are coopMatLoad'ed straight
// from the x buffer and the x_s shared tile, its per-lane staging
// stores/unpack and address arithmetic are deleted. The B (weight)
// side keeps its shared staging in every build: the data is packed
// 4-bit nibbles and cannot feed coopMatLoad, so w_s, the dequant
// stores remain. The output drain
// reuses the staging scratch (idle past the k loop and large enough
// for the four 8x8 blocks).
//
// X modes:
// - default (f16 activations): coopMatLoad f16 from the x buffer, then
//   convert to an f32 A matrix; the matmad is fp32xfp32, the shape the
//   bf16 build already used (f16*f16 products are exact in f32, so the
//   conversion adds no error over the staged path's widened values).
// - X_F32 (bf16 activations, widened by a cast pass into a fresh f32
//   buffer): coopMatLoad f32 straight from that buffer; identical
//   values to the staged path by construction (bf16 -> f32 widening
//   is exact), identical f32 x f32 accumulation.
// - X_BF16: bf16 x read as words cannot feed coopMatLoad (no bf16
//   matrix operand, and bf16 -> f16 is lossy in exponent range), so
//   this build keeps the shipped x_s staging bit for bit.
//
// Matrix shapes: the shipped builds emit an fp32xfp32 8x8x8 matmad,
// the shape Apple drivers list. CMAT16 (X_BF16 + OUT_BF16 only)
// emits the 16x16x16 fp16-operand shape NVIDIA's coopmat list
// carries: bf16 x converts to fp16 on stage (exact for normal-range
// values), the dequantized B stores fp16 in w_s, and the fp32
// accumulator drains through a dedicated f32 scratch tile. B values
// round to fp16 once per tile, so the k chain is NOT bit-identical
// to the fp32 routes - selected only where the fp32 shape is absent.
//
// Prefill-axes variants (receipts/2026-10-03-prefill-axes). The tile
// body lives in qmm_tile()/qmm_tile_two() and every build runs the
// same per-output ascending-k f32 chain; the variants only change
// which tiles a workgroup runs or how many column tiles share one
// A-tile load, so all are bit-identical to the shipped mapping:
// - RASTER_SWAP: dispatch (x = m tiles, y = n tiles). Concurrently
//   resident workgroups share a 32-column weight slab and stream the
//   A tiles instead (the shipped order streams weights m_tiles times).
// - RASTER_GM=n: one-dimensional dispatch over n_tiles * n row-block
//   slots; n consecutive workgroups share one weight slab across n
//   adjacent row tiles (n in {2, 4, 8}).
// - TWO_N (requires FULL_N and matrix_n % 64 == 0): one workgroup
//   computes two adjacent 32-column tiles per row tile, so one mat_a
//   coopMatLoad per (row block, k step) feeds both B tiles - the
//   A-side global loads and their dependency chain halve per output
//   pair. Needs a second w_s tile (shared budget 4 KiB -> 8 KiB).

// QmmPeak variants (receipts/2026-10-04-qmm-roofline), X_F32 FullN
// builds only, env-selected in primitives.cpp:
// - LDS_PAD (landed default; MLX_OMARCHY_QMM_LDSPAD=0 is the kill
//   switch): the shared B-tile row stride becomes TILE_N + 4 f32. At
//   stride 32 every row of a coopMatLoad'd 8x8 B block lands on the
//   same LDS banks (8-way conflict per block under the row-major lane
//   mapping); +4 shifts each row by 4 banks. Values, addresses'
//   contents and MAC order are unchanged - bit-exact by construction.
// - CHUNK_DEQ: the whole 64-wide group is dequantized into a 64-row
//   shared tile with ONE fence, then the 8 (step, ks) MAC iterations
//   run without further barriers (the shipped body fences twice per
//   16-wide step). Same dequant values, same per-output ascending-k
//   chain - bit-exact by construction.
#if defined(CHUNK_DEQ) && (!defined(FULL_N) || !defined(X_F32))
#error "CHUNK_DEQ twins the X_F32 FullN route only"
#endif
#if defined(LDS_PAD) && defined(X_BF16)
#error "LDS_PAD is an X_F32-route experiment; X_BF16 staging is out of scope"
#endif
#if (defined(CHUNK_DEQ) || defined(LDS_PAD)) && defined(TWO_N)
#error "TWO_N keeps its own second tile; chunk/pad combos are out of scope"
#endif

// Affine weight format (compile time). The shipped builds are 4-bit,
// group 64 and keep their exact source below; the 8-bit and group-32
// builds change only how a lane unpacks its eight k values and which
// scale/bias pair it reads. The coopmat k chain, tiles and drain are the
// same in every build, so each format keeps one per-output ascending-k
// f32 accumulation.
#ifndef QBITS
#define QBITS 4
#endif
#ifndef QGROUP
#define QGROUP 64
#endif
#if QBITS != 4 && QBITS != 8
#error "QBITS must be 4 or 8"
#endif
#if QGROUP != 64 && QGROUP != 32
#error "QGROUP must be 64 or 32"
#endif
#if (QBITS != 4 || QGROUP != 64) && (defined(CHUNK_DEQ) || defined(TWO_N))
#error "CHUNK_DEQ and TWO_N are 4-bit group-64 experiments"
#endif

#ifdef LDS_PAD
#define QMM_W_STRIDE (TILE_N + 4u)
#else
#define QMM_W_STRIDE (TILE_N)
#endif
#ifdef CHUNK_DEQ
#define QMM_W_ROWS (CHUNK_K)
#else
#define QMM_W_ROWS (STEP_K)
#endif

#ifndef TILE_ROWS
#define TILE_ROWS 32
#endif

#if TILE_ROWS == 32
#ifdef CMAT16
#define SUBGROUP_ROW_BLOCKS 1u
#else
#define SUBGROUP_ROW_BLOCKS 2u
#endif
#elif TILE_ROWS == 16
#ifdef CMAT16
#error "CMAT16 ships the 32-row tile only"
#endif
#define SUBGROUP_ROW_BLOCKS 1u
#elif TILE_ROWS == 64
// Two subgroups each own 32 rows (4 blocks), or SG4: four subgroups
// (128 threads) each own 16 rows (2 blocks) so the 64-row tile keeps
// the shipped 32-row per-thread accumulator footprint. W is dequantized
// once and reused across twice the rows; every output keeps its
// ascending-k chain.
#ifdef SG4
#define SUBGROUP_ROW_BLOCKS 2u
#else
#define SUBGROUP_ROW_BLOCKS 4u
#endif
#elif TILE_ROWS == 128
// SG8: eight subgroups (256 threads) each own 16 rows (2 blocks),
// reusing one 64x32 weight tile across 128 output rows (1 packed word
// per lane per 64-K group, 2 barriers per group) while keeping the
// shipped 32-row per-thread accumulator footprint.
#ifndef SG8
#error "TILE_ROWS == 128 requires SG8"
#endif
#define SUBGROUP_ROW_BLOCKS 2u
#else
#error "TILE_ROWS must be 128, 64, 32 or 16"
#endif

// CMAT16: the 16x16x16 fp16-operand build for devices whose coopmat list
// has no fp32 8x8x8 shape (NVIDIA lists only 16-wide f16/bf16 entries).
// A and B are coopmat<float16_t> with the fp32 accumulator; x_s and w_s
// therefore store fp16. bf16 x converts to fp16 on stage (exact for
// normal-range values) and the dequantized B stores fp16 - the one value
// change against the f32 route, which is what the screen measures. The
// plain 32-row X_BF16 build only.
#ifdef CMAT16
#if !defined(X_BF16) || !defined(OUT_BF16)
#error "CMAT16 is the bf16-in bf16-out build only"
#endif
#if defined(FULL_N) || defined(LDS_PAD) || defined(CHUNK_DEQ) || \
    defined(TWO_N) || defined(SG4) || defined(RASTER_SWAP) || \
    defined(RASTER_GM) || defined(STEP_K_VAL) || defined(FULL_M) || \
    defined(SUBGROUP_DRAIN)
#error "CMAT16 is the plain 32-row route only"
#endif
#if QBITS != 4 || QGROUP != 64
#error "CMAT16 is a 4-bit group-64 build"
#endif
#endif

#define ROW_BLOCKS (TILE_ROWS / MAT)
#define COL_BLOCKS (TILE_N / MAT)

const uint TILE_M = TILE_ROWS;
const uint TILE_N = 32u;
const uint CHUNK_K = 64u;
// STEP_K_VAL widens the k step (32 or 64) so one dequant + barrier
// feeds more 8-wide matmads. The per-output k chain is unchanged
// (same 8-wide mma order). Direct-load q4g64 FullN twins only.
#ifdef STEP_K_VAL
#if defined(X_BF16) || defined(CHUNK_DEQ) || defined(TWO_N)
#error "STEP_K_VAL applies to the direct-load q4g64 FullN route only"
#endif
#if QBITS != 4 || QGROUP != 64
#error "STEP_K_VAL is a 4-bit group-64 experiment"
#endif
#if STEP_K_VAL != 32 && STEP_K_VAL != 64
#error "STEP_K_VAL must be 32 or 64"
#endif
#define STEP_K STEP_K_VAL
#else
#define STEP_K 16
#endif
#ifdef CMAT16
const uint MAT = 16u;
#else
const uint MAT = 8u;
#endif

#ifdef SG8
#if TILE_ROWS != 128
#error "SG8 is the 128-row 256-lane workgroup"
#endif
layout(local_size_x = 256) in;
#elif defined(SG4)
#if TILE_ROWS != 64
#error "SG4 is the 64-row 128-lane workgroup"
#endif
layout(local_size_x = 128) in;
#else
layout(local_size_x = 64) in;
#endif

// When STEP_K == 64 (w_s holds 64 * QMM_W_STRIDE >= 2048 floats), each
// subgroup in SG4 (4 * 256 = 1024) or SG8 (8 * 256 = 2048) owns a
// disjoint 256-float slice of w_s for output drain without per-block
// workgroup barriers, and tail A tiles use a single 64-float (256-byte)
// straddling-block scratch so total shared memory stays at 9.25 KiB
// (preserving 3-WG/core occupancy on 32 KiB LDS parts).
#if (defined(SG8) || (defined(SG4) && STEP_K == 64)) && !defined(X_BF16)
#define SUBGROUP_DRAIN 1
#endif

#ifdef X_BF16
layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint values[];
} input_x;
#elif defined(X_F32)
layout(set = 0, binding = 0, std430) readonly buffer InputX {
  float values[];
} input_x;
#else
layout(set = 0, binding = 0, std430) readonly buffer InputX {
  float16_t values[];
} input_x;
#endif
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
#if defined(X_BF16) || defined(X_F32)
// bf16 models store scales and biases in bfloat16 (16-bit word layout,
// widened exactly); the f16 models use float16_t storage. The X_F32
// build serves the same bf16-hybrid route (x pre-widened by the host
// cast pass), so it reads the bf16 scale layout too.
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  uint16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  uint16_t values[];
} biases;
#else
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  float16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  float16_t values[];
} biases;
#endif
#ifdef OUT_BF16
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;
#else
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  float16_t values[];
} output_data;
#endif

#ifdef X_BF16
#ifdef CMAT16
// x_s stores fp16 in the CMAT16 build: widen bf16 to f32 then convert
// to fp16 (exact for normal-range values, the only x rounding point).
#define X_UNPACK(word)                                        \
  f16vec2(                                                    \
      float16_t(uintBitsToFloat(((word) & 0xffffu) << 16u)),   \
      float16_t(uintBitsToFloat((word) & 0xffff0000u)))
#else
#define X_UNPACK(word)                                     \
  vec2(                                                    \
      uintBitsToFloat(((word) & 0xffffu) << 16u),          \
      uintBitsToFloat((word) & 0xffff0000u))
#endif
#else
#define X_UNPACK(word) unpackHalf2x16(word)
#endif
// Element type of the x_s and w_s stage tiles and the store applied to
// each dequantized weight row.
#ifdef CMAT16
#define X_T float16_t
#define W_T float16_t
#define W_STORE(v) float16_t(v)
#else
#define X_T float
#define W_T float
#define W_STORE(v) (v)
#endif
#if defined(X_BF16) || defined(X_F32)
#define SCALE_LOAD(x) uintBitsToFloat(uint(x) << 16u)
#else
#define SCALE_LOAD(x) float(x)
#endif
#ifdef OUT_BF16
uint16_t out_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define OUT_STORE(value) out_store(value)
#else
#define OUT_STORE(value) float16_t(value)
#endif
// Integer 0-15 (and 0-255) is exact in f32. 0x4B000000 is 2^23; OR-ing
// the nibble and subtracting 2^23 is bit-identical to float(nibble).
#ifdef CHEAP_DEQ
#define NIB_F32(n) (uintBitsToFloat(0x4B000000u | (n)) - 8388608.0)
#else
#define NIB_F32(n) float(n)
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

// One (16- or 64-)x(32- or 36-) f32 weight tile. The output drain
// uses the staging scratch (w_s here; x_s in the X_BF16 build) as
// scratch; the drain's flat indices stay far below QMM_W_ROWS *
// QMM_W_STRIDE in every build.
#ifdef X_BF16
shared X_T x_s[TILE_M * STEP_K];
#elif defined(FULL_M)
// FULL_M guarantees matrix_m % TILE_M == 0 on the host: no tail A scratch.
#elif defined(SUBGROUP_DRAIN)
// Compact straddling-block tail scratch: for any M, at most one 8-row
// block in the tile straddles matrix_m (r0 < M && r0 + 8 > M). Only that
// subgroup stages its 8x8 A block here via subgroupBarrier() - 256 bytes
// instead of ROW_BLOCKS*256 bytes, keeping total LDS at 9.25 KiB.
shared float a_tail[MAT * MAT];
#else
// Tail-tile A staging (r m tail): a coopMatLoad covers 8 whole rows, so
// an edge tile cannot load straight from input_x without reading past
// the buffer. The tail workgroup stages every 8x8 A block of its
// (step, ks) tile here through guarded per-element stores - zeros past
// matrix_m, whose accumulators are never stored. ROW_BLOCKS*64 f32:
// 1 KiB at TILE_M=32, at most 2 KiB at TILE_M=64.
shared float a_s[ROW_BLOCKS * MAT * MAT];
#endif
shared W_T w_s[QMM_W_ROWS * QMM_W_STRIDE];
#ifdef CMAT16
// fp32 drain scratch: the f16 stage tiles above cannot take the fp32
// accumulator store, so the CMAT16 build keeps a dedicated drain tile.
// COL_BLOCKS*MAT*MAT f32 = 2 KiB.
shared float drain_s[COL_BLOCKS * MAT * MAT];
#endif

// Workgroup-lane scalars the tile body reads; set once in main().
uint g_lid;
uint g_sub_rb;
uint g_wcol;
uint g_wpart;
uint g_k_chunks;
uint g_words_per_row;
uint g_groups_per_row;

#if !defined(X_BF16) && !defined(SUBGROUP_DRAIN) && !defined(FULL_M)
// Stage this tile's 8-row A blocks for one 8-column k slice into a_s,
// zero-filling rows past matrix_m. Called only on a tail tile, where
// the direct coopMatLoad of a block could pass the buffer end; the
// caller barriers before the staged loads and before the next stage.
// Element type follows the build (f16 widened or pre-widened f32);
// either reads exactly the value the direct load would produce.
void a_stage_tail(uint row_base, uint x_slice, uint k_col) {
  for (uint idx = g_lid; idx < ROW_BLOCKS * MAT * MAT;
       idx += gl_WorkGroupSize.x) {
    const uint grow =
        row_base + (idx / (MAT * MAT)) * MAT + (idx / MAT) % MAT;
    a_s[idx] = grow < params.matrix_m
        ? float(input_x.values[x_slice + grow * params.matrix_k +
                               k_col + idx % MAT])
        : 0.0f;
  }
}
#endif

// One (row tile, column tile) output block: the shipped kernel's body
// unchanged. Raster and persistent mappings only choose which tiles a
// workgroup runs, so every output keeps the shipped ascending-k f32
// accumulation chain (bit-exact by construction; pinned by the
// matmul-family doctest on device).
void qmm_tile(uint tile_row, uint tile_col, uint b) {
  uint row_base = tile_row * TILE_M;
  uint w_slice = params.rhs_offset + b * params.shape[1];
  uint scale_slice = params.aux_offset + b * params.shape[2];
  uint bias_slice = params.aux_size + b * params.shape[2];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
#ifdef X_BF16
  uint x_slice = (params.lhs_offset + b * x_batch_rows) / 2u;
  uint x_words_per_row = params.matrix_k / 2u;
#elif defined(X_F32)
  // The cast pass writes a fresh f32 buffer and the host forces
  // lhs_offset to 0, so the offset term is 0 in practice - only
  // lhs_offset would count 2-byte input elements (the f32 view is
  // 4-byte). x_batch_rows is already in f32 elements: halving the
  // batch term shifts batch b by matrix_m / 2 rows (odd b wrong, even
  // b reading batch b/2, masked by identical batch rows).
  uint x_slice = params.lhs_offset / 2u + b * x_batch_rows;
#else
  // x elements are f16 here, so the slice/row strides are elements.
  uint x_slice = params.lhs_offset + b * x_batch_rows;
#endif
  uint out_slice = params.output_offset +
      b * params.matrix_m * params.matrix_n;
#if !defined(X_BF16) && !defined(FULL_M)
  // Edge tile: any 8-row A block of this tile can reach past input_x,
  // so the whole tile stages A through a_s (uniform across the
  // workgroup - the barriers below stay legal). Interior tiles keep
  // the direct coopMatLoad and never touch a_s.
  const bool tile_tail = row_base + TILE_M > params.matrix_m;
#endif
  uint column = tile_col * TILE_N + g_wcol;
#ifdef FULL_N
  // Every column tile is full (matrix_n % 32 == 0, checked on the host):
  // the predicated scale/bias/weight loads and their exec-mask regions
  // drop out of the K loop. Arithmetic is unchanged.
  const bool column_ok = true;
#else
  bool column_ok = column < params.matrix_n;
#endif
  uint w_row = w_slice + column * g_words_per_row;
  uint scale_row = scale_slice + column * g_groups_per_row;
  uint bias_row = bias_slice + column * g_groups_per_row;

#ifndef X_BF16
  // Hoist per-subgroup X row pointers outside the K loop.
  uint x_row_ptr[SUBGROUP_ROW_BLOCKS];
  for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
    uint r0 = row_base + (g_sub_rb + rb) * MAT;
    x_row_ptr[rb] = x_slice + r0 * params.matrix_k;
  }
#endif

  coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
      acc[SUBGROUP_ROW_BLOCKS][COL_BLOCKS];
  for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
    for (uint cb = 0u; cb < COL_BLOCKS; ++cb) {
      acc[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
          gl_MatrixUseAccumulator>(0.0);
    }
  }

  for (uint chunk = 0u; chunk < g_k_chunks; ++chunk) {
    float scale = 0.0;
    float bias = 0.0;
#if QGROUP == 64
    if (column_ok) {
      scale = SCALE_LOAD(scales.values[scale_row + chunk]);
      bias = SCALE_LOAD(biases.values[bias_row + chunk]);
    }
#endif
#ifdef CHUNK_DEQ
    // Whole-chunk dequant into the shared tile (rows 0..63), one
    // fence, then every (step, ks) MAC iteration of the chunk runs
    // without further barriers. FULL_N is compile-time guaranteed, so
    // the column_ok predication drops out (same as the FullN builds).
    for (uint step = 0u; step < CHUNK_K / STEP_K; ++step) {
      uint k_base = chunk * CHUNK_K + step * STEP_K;
      uint packed = input_w.values[w_row + k_base / 8u + g_wpart];
      uint w_base = step * STEP_K * QMM_W_STRIDE +
          8u * g_wpart * QMM_W_STRIDE + g_wcol;
      w_s[w_base + 0u * QMM_W_STRIDE] = W_STORE(scale * NIB_F32(packed & 0xFu) + bias);
      w_s[w_base + 1u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32((packed >> 4u) & 0xFu) + bias);
      w_s[w_base + 2u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32((packed >> 8u) & 0xFu) + bias);
      w_s[w_base + 3u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32((packed >> 12u) & 0xFu) + bias);
      w_s[w_base + 4u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32((packed >> 16u) & 0xFu) + bias);
      w_s[w_base + 5u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32((packed >> 20u) & 0xFu) + bias);
      w_s[w_base + 6u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32((packed >> 24u) & 0xFu) + bias);
      w_s[w_base + 7u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32(packed >> 28u) + bias);
    }
    barrier();
    if (!tile_tail) {
      for (uint step = 0u; step < CHUNK_K / STEP_K; ++step) {
        uint k_base = chunk * CHUNK_K + step * STEP_K;
        for (uint ks = 0u; ks < STEP_K / MAT; ++ks) {
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
              mat_a[SUBGROUP_ROW_BLOCKS];
          for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
            coopMatLoad(
                mat_a[rb], input_x.values,
                x_row_ptr[rb] + k_base + ks * MAT,
                params.matrix_k,
                gl_CooperativeMatrixLayoutRowMajor);
          }
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[4];
          uint k_row = step * STEP_K + ks * MAT;
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatLoad(
                mat_b[cb], w_s, k_row * QMM_W_STRIDE + cb * MAT,
                QMM_W_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
            for (uint cb = 0u; cb < 4u; ++cb) {
              acc[rb][cb] =
                  coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
            }
          }
        }
      }
    } else {
      for (uint step = 0u; step < CHUNK_K / STEP_K; ++step) {
        uint k_base = chunk * CHUNK_K + step * STEP_K;
        for (uint ks = 0u; ks < STEP_K / MAT; ++ks) {
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
              mat_a[SUBGROUP_ROW_BLOCKS];
          a_stage_tail(row_base, x_slice, k_base + ks * MAT);
          barrier();
          for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
            coopMatLoad(
                mat_a[rb], a_s, (g_sub_rb + rb) * MAT * MAT, MAT,
                gl_CooperativeMatrixLayoutRowMajor);
          }
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[4];
          uint k_row = step * STEP_K + ks * MAT;
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatLoad(
                mat_b[cb], w_s, k_row * QMM_W_STRIDE + cb * MAT,
                QMM_W_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
            for (uint cb = 0u; cb < 4u; ++cb) {
              acc[rb][cb] =
                  coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
            }
          }
          barrier();
        }
      }
    }
    barrier();
#else
    for (uint step = 0u; step < CHUNK_K / STEP_K; ++step) {
      uint k_base = chunk * CHUNK_K + step * STEP_K;
#if QGROUP == 32
      // A 16-row step never straddles a 32-wide group.
      if (column_ok) {
        scale = SCALE_LOAD(scales.values[scale_row + k_base / 32u]);
        bias = SCALE_LOAD(biases.values[bias_row + k_base / 32u]);
      }
#endif
#if QBITS == 8
      // Two packed words per lane (four bytes each, low byte first)
      // cover the lane's eight k values of the 16x32 weight tile.
      uint packed = column_ok
          ? input_w.values[w_row + k_base / 4u + 2u * g_wpart] : 0u;
      uint packed_hi = column_ok
          ? input_w.values[w_row + k_base / 4u + 2u * g_wpart + 1u] : 0u;
      uint w_base = 8u * g_wpart * QMM_W_STRIDE + g_wcol;
      w_s[w_base + 0u * QMM_W_STRIDE] = W_STORE(scale * NIB_F32(packed & 0xFFu) + bias);
      w_s[w_base + 1u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32((packed >> 8u) & 0xFFu) + bias);
      w_s[w_base + 2u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32((packed >> 16u) & 0xFFu) + bias);
      w_s[w_base + 3u * QMM_W_STRIDE] = W_STORE(scale * NIB_F32(packed >> 24u) + bias);
      w_s[w_base + 4u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32(packed_hi & 0xFFu) + bias);
      w_s[w_base + 5u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32((packed_hi >> 8u) & 0xFFu) + bias);
      w_s[w_base + 6u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32((packed_hi >> 16u) & 0xFFu) + bias);
      w_s[w_base + 7u * QMM_W_STRIDE] =
          W_STORE(scale * NIB_F32(packed_hi >> 24u) + bias);
#else
      // STEP_K/16 packed words per lane cover the STEP_K x 32 weight
      // tile (one word at the shipped STEP_K=16: word == g_wpart).
#ifdef SG8
      // 256 lanes, 8 parts per column: one packed word per lane covers
      // the full 64-K group (STEP_K == 64).
      {
        uint word = g_wpart;
        uint packed = column_ok
            ? input_w.values[w_row + k_base / 8u + word] : 0u;
        uint w_base = 8u * word * QMM_W_STRIDE + g_wcol;
        w_s[w_base + 0u * QMM_W_STRIDE] = scale * NIB_F32(packed & 0xFu) + bias;
        w_s[w_base + 1u * QMM_W_STRIDE] =
            scale * NIB_F32((packed >> 4u) & 0xFu) + bias;
        w_s[w_base + 2u * QMM_W_STRIDE] =
            scale * NIB_F32((packed >> 8u) & 0xFu) + bias;
        w_s[w_base + 3u * QMM_W_STRIDE] =
            scale * NIB_F32((packed >> 12u) & 0xFu) + bias;
        w_s[w_base + 4u * QMM_W_STRIDE] =
            scale * NIB_F32((packed >> 16u) & 0xFu) + bias;
        w_s[w_base + 5u * QMM_W_STRIDE] =
            scale * NIB_F32((packed >> 20u) & 0xFu) + bias;
        w_s[w_base + 6u * QMM_W_STRIDE] =
            scale * NIB_F32((packed >> 24u) & 0xFu) + bias;
        w_s[w_base + 7u * QMM_W_STRIDE] =
            scale * NIB_F32(packed >> 28u) + bias;
      }
#elif defined(SG4)
#if STEP_K == 16
      {
        // 128 lanes: each lane dequantizes four nibbles of one word.
        uint word = g_wpart >> 1u;
        uint nib_base = 4u * (g_wpart & 1u);
        uint packed = column_ok
            ? input_w.values[w_row + k_base / 8u + word] : 0u;
        for (uint n = 0u; n < 4u; ++n) {
          uint nib = nib_base + n;
          w_s[(8u * word + nib) * QMM_W_STRIDE + g_wcol] =
              W_STORE(scale * NIB_F32((packed >> (4u * nib)) & 0xFu) + bias);
        }
      }
#else
      // 128 lanes, four 32-lane parts: one packed word per part covers
      // 32 K; a second iteration covers 64 K.
      for (uint wi = 0u; wi < STEP_K / 32u; ++wi) {
        uint word = g_wpart + 4u * wi;
        uint packed = column_ok
            ? input_w.values[w_row + k_base / 8u + word] : 0u;
        uint w_base = 8u * word * QMM_W_STRIDE + g_wcol;
        w_s[w_base + 0u * QMM_W_STRIDE] = W_STORE(scale * NIB_F32(packed & 0xFu) + bias);
        w_s[w_base + 1u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32((packed >> 4u) & 0xFu) + bias);
        w_s[w_base + 2u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32((packed >> 8u) & 0xFu) + bias);
        w_s[w_base + 3u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32((packed >> 12u) & 0xFu) + bias);
        w_s[w_base + 4u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32((packed >> 16u) & 0xFu) + bias);
        w_s[w_base + 5u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32((packed >> 20u) & 0xFu) + bias);
        w_s[w_base + 6u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32((packed >> 24u) & 0xFu) + bias);
        w_s[w_base + 7u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32(packed >> 28u) + bias);
      }
#endif
#else
      for (uint wi = 0u; wi < STEP_K / 16u; ++wi) {
        uint word = g_wpart + 2u * wi;
        uint packed = column_ok
            ? input_w.values[w_row + k_base / 8u + word] : 0u;
        uint w_base = 8u * word * QMM_W_STRIDE + g_wcol;
        w_s[w_base + 0u * QMM_W_STRIDE] = W_STORE(scale * NIB_F32(packed & 0xFu) + bias);
        w_s[w_base + 1u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32((packed >> 4u) & 0xFu) + bias);
        w_s[w_base + 2u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32((packed >> 8u) & 0xFu) + bias);
        w_s[w_base + 3u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32((packed >> 12u) & 0xFu) + bias);
        w_s[w_base + 4u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32((packed >> 16u) & 0xFu) + bias);
        w_s[w_base + 5u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32((packed >> 20u) & 0xFu) + bias);
        w_s[w_base + 6u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32((packed >> 24u) & 0xFu) + bias);
        w_s[w_base + 7u * QMM_W_STRIDE] =
            W_STORE(scale * NIB_F32(packed >> 28u) + bias);
      }
#endif
#endif
#ifdef X_BF16
      // X_WORDS half-word loads per lane cover the TILE_ROWS x 16 x tile.
      uint x_words[TILE_M / 8u];
      for (uint j = 0u; j < TILE_M / 8u; ++j) {
        uint i = g_lid + 64u * j;
        uint local_row = i / 8u;
        uint row = row_base + local_row;
        x_words[j] = row < params.matrix_m
            ? input_x.values[
                  x_slice + row * x_words_per_row + k_base / 2u +
                  (i % 8u)]
            : 0u;
      }
      for (uint j = 0u; j < TILE_M / 8u; ++j) {
        uint i = g_lid + 64u * j;
        uint local_row = i / 8u;
#ifdef CMAT16
        f16vec2 pair = X_UNPACK(x_words[j]);
#else
        vec2 pair = X_UNPACK(x_words[j]);
#endif
        x_s[local_row * STEP_K + 2u * (i % 8u)] = pair.x;
        x_s[local_row * STEP_K + 2u * (i % 8u) + 1u] = pair.y;
      }
#endif
      barrier();

#ifdef X_BF16
      for (uint ks = 0u; ks < STEP_K / MAT; ++ks) {
#ifdef CMAT16
        coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
            mat_a[SUBGROUP_ROW_BLOCKS];
        coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB>
            mat_b[COL_BLOCKS];
#else
        // f16 x is widened to an f32 A matrix: B is f32, and a device that
        // lists only same-operand shapes (f16 x f16, f32 x f32) has no
        // fp32xfp32 configuration (omarchy::qmm_prefill_coopmat_shape).
        coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
            mat_a[SUBGROUP_ROW_BLOCKS];
        coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[4];
#endif
        for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
          coopMatLoad(
              mat_a[rb], x_s,
              (g_sub_rb + rb) * MAT * STEP_K + ks * MAT, STEP_K,
              gl_CooperativeMatrixLayoutRowMajor);
        }
#ifdef CMAT16
        for (uint cb = 0u; cb < COL_BLOCKS; ++cb) {
#else
        for (uint cb = 0u; cb < 4u; ++cb) {
#endif
          coopMatLoad(
              mat_b[cb], w_s, ks * MAT * QMM_W_STRIDE + cb * MAT,
              QMM_W_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
        }
        for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
          for (uint cb = 0u; cb < COL_BLOCKS; ++cb) {
            acc[rb][cb] =
                coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
          }
        }
      }
#else
#ifdef FULL_M
      for (uint ks = 0u; ks < STEP_K / MAT; ++ks) {
        coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
            mat_a[SUBGROUP_ROW_BLOCKS];
        coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[4];
        for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
#ifdef X_F32
          coopMatLoad(
              mat_a[rb], input_x.values,
              x_row_ptr[rb] + k_base + ks * MAT,
              params.matrix_k,
              gl_CooperativeMatrixLayoutRowMajor);
#else
          coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT,
              gl_MatrixUseA> a16;
          coopMatLoad(
              a16, input_x.values,
              x_row_ptr[rb] + k_base + ks * MAT,
              params.matrix_k,
              gl_CooperativeMatrixLayoutRowMajor);
          mat_a[rb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
                              gl_MatrixUseA>(a16);
#endif
        }
        for (uint cb = 0u; cb < 4u; ++cb) {
          coopMatLoad(
              mat_b[cb], w_s, ks * MAT * QMM_W_STRIDE + cb * MAT,
              QMM_W_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
        }
        for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
          for (uint cb = 0u; cb < 4u; ++cb) {
            acc[rb][cb] =
                coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
          }
        }
      }
#else
      // Hoist tile_tail outside the ks loop so interior tiles execute a
      // branchless, barrier-free inner MMA loop that fully unrolls.
      if (!tile_tail) {
        for (uint ks = 0u; ks < STEP_K / MAT; ++ks) {
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
              mat_a[SUBGROUP_ROW_BLOCKS];
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[4];
          for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
#ifdef X_F32
            coopMatLoad(
                mat_a[rb], input_x.values,
                x_row_ptr[rb] + k_base + ks * MAT,
                params.matrix_k,
                gl_CooperativeMatrixLayoutRowMajor);
#else
            coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT,
                gl_MatrixUseA> a16;
            coopMatLoad(
                a16, input_x.values,
                x_row_ptr[rb] + k_base + ks * MAT,
                params.matrix_k,
                gl_CooperativeMatrixLayoutRowMajor);
            mat_a[rb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
                                gl_MatrixUseA>(a16);
#endif
          }
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatLoad(
                mat_b[cb], w_s, ks * MAT * QMM_W_STRIDE + cb * MAT,
                QMM_W_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
            for (uint cb = 0u; cb < 4u; ++cb) {
              acc[rb][cb] =
                  coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
            }
          }
        }
      } else {
        for (uint ks = 0u; ks < STEP_K / MAT; ++ks) {
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
              mat_a[SUBGROUP_ROW_BLOCKS];
          coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[4];
#ifdef SUBGROUP_DRAIN
          uint sg_lane = gl_SubgroupInvocationID;
          for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
            uint r0 = row_base + (g_sub_rb + rb) * MAT;
            if (r0 + MAT <= params.matrix_m) {
              coopMatLoad(
                  mat_a[rb], input_x.values,
                  x_row_ptr[rb] + k_base + ks * MAT,
                  params.matrix_k,
                  gl_CooperativeMatrixLayoutRowMajor);
            } else if (r0 < params.matrix_m) {
              for (uint p = 0u; p < 2u; ++p) {
                uint idx = sg_lane + 32u * p;
                uint grow = r0 + (idx >> 3u);
                a_tail[idx] = grow < params.matrix_m
                    ? float(input_x.values[
                          x_slice + grow * params.matrix_k +
                          k_base + ks * MAT + (idx & 7u)])
                    : 0.0f;
              }
              subgroupMemoryBarrierShared();
              subgroupBarrier();
              coopMatLoad(
                  mat_a[rb], a_tail, 0u, MAT,
                  gl_CooperativeMatrixLayoutRowMajor);
              subgroupMemoryBarrierShared();
              subgroupBarrier();
            } else {
              mat_a[rb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
                  gl_MatrixUseA>(0.0);
            }
          }
#else
          a_stage_tail(row_base, x_slice, k_base + ks * MAT);
          barrier();
          for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
            coopMatLoad(
                mat_a[rb], a_s, (g_sub_rb + rb) * MAT * MAT, MAT,
                gl_CooperativeMatrixLayoutRowMajor);
          }
#endif
          for (uint cb = 0u; cb < 4u; ++cb) {
            coopMatLoad(
                mat_b[cb], w_s, ks * MAT * QMM_W_STRIDE + cb * MAT,
                QMM_W_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
          }
          for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
            for (uint cb = 0u; cb < 4u; ++cb) {
              acc[rb][cb] =
                  coopMatMulAdd(mat_a[rb], mat_b[cb], acc[rb][cb]);
            }
          }
#ifndef SUBGROUP_DRAIN
          barrier();
#endif
        }
      }
#endif
#endif
      barrier();
    }
#endif
  }

#ifdef SUBGROUP_DRAIN
  // Zero-workgroup-barrier subgroup-private drain: each subgroup owns a
  // disjoint 256-float slice w_s[gl_SubgroupID * 256] (SG4: 1024 floats,
  // SG8: 2048 floats <= 64 * QMM_W_STRIDE = 2304 floats). The K-loop's
  // final barrier() guarantees w_s is idle on entry; one trailing barrier()
  // keeps batch > 1 and grid-stride persistent loops race-free.
  {
    uint sg_base = gl_SubgroupID * (4u * MAT * MAT);
    uint lane = gl_SubgroupInvocationID;
    uint col = tile_col * TILE_N + lane;
    uint blk_off = sg_base + (lane >> 3u) * (MAT * MAT) + (lane & 7u);
    for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
      for (uint cb = 0u; cb < 4u; ++cb) {
        coopMatStore(
            acc[rb][cb], w_s, sg_base + cb * (MAT * MAT), MAT,
            gl_CooperativeMatrixLayoutRowMajor);
      }
      subgroupMemoryBarrierShared();
      subgroupBarrier();
      uint r_base = row_base + (g_sub_rb + rb) * MAT;
      for (uint r = 0u; r < MAT; ++r) {
        uint row = r_base + r;
        if (row < params.matrix_m) {
          output_data.values[out_slice + row * params.matrix_n + col] =
              OUT_STORE(w_s[blk_off + r * MAT]);
        }
      }
      if (rb + 1u < SUBGROUP_ROW_BLOCKS) {
        subgroupMemoryBarrierShared();
        subgroupBarrier();
      }
    }
    barrier();
  }
#else
  // One subgroup stores each 8-row block it owns; duplicated column
  // lanes each drain their four distinct rows of that block.
  for (uint rb = 0u; rb < ROW_BLOCKS; ++rb) {
    if (g_sub_rb == (rb & ~(SUBGROUP_ROW_BLOCKS - 1u))) {
      for (uint cb = 0u; cb < COL_BLOCKS; ++cb) {
#ifdef CMAT16
        coopMatStore(
            acc[rb & (SUBGROUP_ROW_BLOCKS - 1u)][cb], drain_s,
            cb * MAT * MAT, MAT,
            gl_CooperativeMatrixLayoutRowMajor);
#elif defined(X_BF16)
        coopMatStore(
            acc[rb & (SUBGROUP_ROW_BLOCKS - 1u)][cb], x_s,
            cb * MAT * MAT, MAT,
            gl_CooperativeMatrixLayoutRowMajor);
#else
        coopMatStore(
            acc[rb & (SUBGROUP_ROW_BLOCKS - 1u)][cb], w_s,
            cb * MAT * MAT, MAT,
            gl_CooperativeMatrixLayoutRowMajor);
#endif
      }
    }
    barrier();
    if (column_ok) {
#ifdef SG4
      for (uint pass = 0u; pass < 2u; ++pass) {
        uint r = 2u * g_wpart + pass;
#elif defined(CMAT16)
      // 32 lanes cover 32 columns; each subgroup's two half-lanes drain
      // the 16 rows of its owned block.
      for (uint pass = 0u; pass < MAT / 2u; ++pass) {
        uint r = (MAT / 2u) * g_wpart + pass;
#else
      for (uint pass = 0u; pass < 4u; ++pass) {
        uint r = 4u * g_wpart + pass;
#endif
        uint row = row_base + rb * MAT + r;
        if (row < params.matrix_m) {
#ifdef CMAT16
          output_data.values[out_slice + row * params.matrix_n + column] =
              OUT_STORE(drain_s[(g_wcol / MAT) * MAT * MAT +
                                r * MAT + (g_wcol % MAT)]);
#elif defined(X_BF16)
          output_data.values[out_slice + row * params.matrix_n + column] =
              OUT_STORE(x_s[(g_wcol / 8u) * MAT * MAT +
                            r * MAT + (g_wcol % 8u)]);
#else
          output_data.values[out_slice + row * params.matrix_n + column] =
              OUT_STORE(w_s[(g_wcol / 8u) * MAT * MAT +
                            r * MAT + (g_wcol % 8u)]);
#endif
        }
      }
    }
    barrier();
  }
#endif
}

#if defined(TWO_N) && !defined(FULL_N)
#error "TWO_N requires FULL_N (matrix_n % 64 == 0 makes column tiles full)"
#endif
#if defined(TWO_N) && TILE_ROWS != 32
#error "TWO_N is a 32-row-route experiment; the M16 twins are out of scope"
#endif

#ifdef TWO_N
shared float w_s2[STEP_K * TILE_N];

// Two adjacent 32-column tiles per (row tile, A-tile load): one mat_a
// coopMatLoad per (row block, k step) feeds both B tiles, halving the
// A-side global loads on the critical path. Each output keeps its own
// ascending-k chain - acc0/acc1 only ever see their own w_s/w_s2
// content in the shipped per-step order - so the drain is
// byte-identical to qmm_tile.
void qmm_tile_two(uint tile_row, uint tile_col, uint b) {
  uint row_base = tile_row * TILE_M;
  uint w_slice = params.rhs_offset + b * params.shape[1];
  uint scale_slice = params.aux_offset + b * params.shape[2];
  uint bias_slice = params.aux_size + b * params.shape[2];
  uint x_batch_rows = params.matrix_m * params.matrix_k;
  // X_F32 only (see the host gate): the cast pass writes a fresh f32
  // buffer and the host forces lhs_offset to 0 - only lhs_offset would
  // count 2-byte input elements. The batch stride x_batch_rows is
  // already in f32 elements and must not be halved (same defect class
  // qmm_tile's X_F32 branch had).
  uint x_slice = params.lhs_offset / 2u + b * x_batch_rows;
  uint out_slice = params.output_offset +
      b * params.matrix_m * params.matrix_n;
  // Same tail-tile staging contract as qmm_tile.
  const bool tile_tail = row_base + TILE_M > params.matrix_m;
  uint column0 = tile_col * TILE_N + g_wcol;
  uint column1 = column0 + TILE_N;
  uint w_row0 = w_slice + column0 * g_words_per_row;
  uint w_row1 = w_slice + column1 * g_words_per_row;
  uint scale_row0 = scale_slice + column0 * g_groups_per_row;
  uint scale_row1 = scale_slice + column1 * g_groups_per_row;
  uint bias_row0 = bias_slice + column0 * g_groups_per_row;
  uint bias_row1 = bias_slice + column1 * g_groups_per_row;

  coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
      acc0[SUBGROUP_ROW_BLOCKS][4];
  coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>
      acc1[SUBGROUP_ROW_BLOCKS][4];
  for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
    for (uint cb = 0u; cb < COL_BLOCKS; ++cb) {
      acc0[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
          gl_MatrixUseAccumulator>(0.0);
      acc1[rb][cb] = coopmat<float, gl_ScopeSubgroup, MAT, MAT,
          gl_MatrixUseAccumulator>(0.0);
    }
  }

  for (uint chunk = 0u; chunk < g_k_chunks; ++chunk) {
    float scale0 = SCALE_LOAD(scales.values[scale_row0 + chunk]);
    float bias0 = SCALE_LOAD(biases.values[bias_row0 + chunk]);
    float scale1 = SCALE_LOAD(scales.values[scale_row1 + chunk]);
    float bias1 = SCALE_LOAD(biases.values[bias_row1 + chunk]);
    for (uint step = 0u; step < CHUNK_K / STEP_K; ++step) {
      uint k_base = chunk * CHUNK_K + step * STEP_K;
      uint w_base = 8u * g_wpart * TILE_N + g_wcol;
      {
        uint packed = input_w.values[w_row0 + k_base / 8u + g_wpart];
        w_s[w_base + 0u * TILE_N] = W_STORE(scale0 * NIB_F32(packed & 0xFu) + bias0);
        w_s[w_base + 1u * TILE_N] =
            W_STORE(scale0 * NIB_F32((packed >> 4u) & 0xFu) + bias0);
        w_s[w_base + 2u * TILE_N] =
            W_STORE(scale0 * NIB_F32((packed >> 8u) & 0xFu) + bias0);
        w_s[w_base + 3u * TILE_N] =
            W_STORE(scale0 * NIB_F32((packed >> 12u) & 0xFu) + bias0);
        w_s[w_base + 4u * TILE_N] =
            W_STORE(scale0 * NIB_F32((packed >> 16u) & 0xFu) + bias0);
        w_s[w_base + 5u * TILE_N] =
            W_STORE(scale0 * NIB_F32((packed >> 20u) & 0xFu) + bias0);
        w_s[w_base + 6u * TILE_N] =
            W_STORE(scale0 * NIB_F32((packed >> 24u) & 0xFu) + bias0);
        w_s[w_base + 7u * TILE_N] = W_STORE(scale0 * NIB_F32(packed >> 28u) + bias0);
      }
      {
        uint packed = input_w.values[w_row1 + k_base / 8u + g_wpart];
        w_s2[w_base + 0u * TILE_N] = scale1 * NIB_F32(packed & 0xFu) + bias1;
        w_s2[w_base + 1u * TILE_N] =
            scale1 * NIB_F32((packed >> 4u) & 0xFu) + bias1;
        w_s2[w_base + 2u * TILE_N] =
            scale1 * NIB_F32((packed >> 8u) & 0xFu) + bias1;
        w_s2[w_base + 3u * TILE_N] =
            scale1 * NIB_F32((packed >> 12u) & 0xFu) + bias1;
        w_s2[w_base + 4u * TILE_N] =
            scale1 * NIB_F32((packed >> 16u) & 0xFu) + bias1;
        w_s2[w_base + 5u * TILE_N] =
            scale1 * NIB_F32((packed >> 20u) & 0xFu) + bias1;
        w_s2[w_base + 6u * TILE_N] =
            scale1 * NIB_F32((packed >> 24u) & 0xFu) + bias1;
        w_s2[w_base + 7u * TILE_N] =
            scale1 * NIB_F32(packed >> 28u) + bias1;
      }
      barrier();

      for (uint ks = 0u; ks < STEP_K / MAT; ++ks) {
        coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA>
            mat_a[SUBGROUP_ROW_BLOCKS];
        if (tile_tail) {
          a_stage_tail(row_base, x_slice, k_base + ks * MAT);
          barrier();
        }
        for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
          if (tile_tail) {
            coopMatLoad(
                mat_a[rb], a_s, (g_sub_rb + rb) * MAT * MAT, MAT,
                gl_CooperativeMatrixLayoutRowMajor);
          } else {
            coopMatLoad(
                mat_a[rb], input_x.values,
                x_slice + (row_base + (g_sub_rb + rb) * MAT) *
                    params.matrix_k + k_base + ks * MAT,
                params.matrix_k,
                gl_CooperativeMatrixLayoutRowMajor);
          }
        }
        if (tile_tail) {
          barrier();
        }
        coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> mat_b[COL_BLOCKS];
        for (uint cb = 0u; cb < COL_BLOCKS; ++cb) {
          coopMatLoad(
              mat_b[cb], w_s, ks * MAT * TILE_N + cb * MAT, TILE_N,
              gl_CooperativeMatrixLayoutRowMajor);
        }
        for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
          for (uint cb = 0u; cb < COL_BLOCKS; ++cb) {
            acc0[rb][cb] =
                coopMatMulAdd(mat_a[rb], mat_b[cb], acc0[rb][cb]);
          }
        }
        for (uint cb = 0u; cb < COL_BLOCKS; ++cb) {
          coopMatLoad(
              mat_b[cb], w_s2, ks * MAT * TILE_N + cb * MAT, TILE_N,
              gl_CooperativeMatrixLayoutRowMajor);
        }
        for (uint rb = 0u; rb < SUBGROUP_ROW_BLOCKS; ++rb) {
          for (uint cb = 0u; cb < COL_BLOCKS; ++cb) {
            acc1[rb][cb] =
                coopMatMulAdd(mat_a[rb], mat_b[cb], acc1[rb][cb]);
          }
        }
      }
      barrier();
    }
  }

  // Drain both tiles: one store phase per row block (acc0 -> w_s,
  // acc1 -> w_s2), then both output strips. The per-row arithmetic and
  // the store indices match qmm_tile exactly.
  for (uint rb = 0u; rb < ROW_BLOCKS; ++rb) {
    if (g_sub_rb == (rb & ~(SUBGROUP_ROW_BLOCKS - 1u))) {
      for (uint cb = 0u; cb < COL_BLOCKS; ++cb) {
        coopMatStore(
            acc0[rb & (SUBGROUP_ROW_BLOCKS - 1u)][cb], w_s,
            cb * MAT * MAT, MAT,
            gl_CooperativeMatrixLayoutRowMajor);
        coopMatStore(
            acc1[rb & (SUBGROUP_ROW_BLOCKS - 1u)][cb], w_s2,
            cb * MAT * MAT, MAT,
            gl_CooperativeMatrixLayoutRowMajor);
      }
    }
    barrier();
    for (uint pass = 0u; pass < 4u; ++pass) {
      uint r = 4u * g_wpart + pass;
      uint row = row_base + rb * MAT + r;
      if (row < params.matrix_m) {
        output_data.values[out_slice + row * params.matrix_n + column0] =
            OUT_STORE(w_s[(g_wcol / 8u) * MAT * MAT +
                          r * MAT + (g_wcol % 8u)]);
        output_data.values[out_slice + row * params.matrix_n + column1] =
            OUT_STORE(w_s2[(g_wcol / 8u) * MAT * MAT +
                           r * MAT + (g_wcol % 8u)]);
      }
    }
    barrier();
  }
}
#endif // TWO_N

void main() {
  g_lid = gl_LocalInvocationID.x;
  g_sub_rb = SUBGROUP_ROW_BLOCKS * gl_SubgroupID;
#ifdef COALESCED_W
  // Map adjacent lanes along K-words of the same column so each subgroup
  // issues coalesced global reads on input_w and L1-broadcast reads on
  // scales/biases.
  const uint w_parts_per_col = gl_WorkGroupSize.x / TILE_N;
  g_wcol = g_lid / w_parts_per_col;
  g_wpart = g_lid - g_wcol * w_parts_per_col;
#else
  g_wcol = g_lid % 32u;
  g_wpart = g_lid / 32u;
#endif
  g_k_chunks = params.matrix_k / CHUNK_K;
  g_words_per_row = params.matrix_k / (32u / QBITS);
  g_groups_per_row = params.matrix_k / QGROUP;
  uint batch = params.shape[0];
  uint m_tiles = (params.matrix_m + TILE_M - 1u) / TILE_M;
  uint n_tiles = (params.matrix_n + TILE_N - 1u) / TILE_N;
#ifdef TWO_N
  // Dispatch (x = n_tiles / 2, y = m tiles); the host gates
  // matrix_n % 64 == 0, so n_tiles is even and both column tiles of a
  // pair are in bounds.
  for (uint b = 0u; b < batch; ++b) {
    for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
         tile_row += gl_NumWorkGroups.y) {
      for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles / 2u;
           tile_col += gl_NumWorkGroups.x) {
        qmm_tile_two(tile_row, 2u * tile_col, b);
      }
    }
  }
#elif defined(RASTER_SWAP)
  // Dispatch (x = m tiles, y = n tiles): concurrently resident
  // workgroups share a 32-column weight slab and stream the A tiles.
  for (uint b = 0u; b < batch; ++b) {
    for (uint tile_row = gl_WorkGroupID.x; tile_row < m_tiles;
         tile_row += gl_NumWorkGroups.x) {
      for (uint tile_col = gl_WorkGroupID.y; tile_col < n_tiles;
           tile_col += gl_NumWorkGroups.y) {
        qmm_tile(tile_row, tile_col, b);
      }
    }
  }
#elif defined(RASTER_GM)
  // Group-of-GM rasterization: one-dimensional dispatch over
  // n_tiles * GM * ceil(m_tiles / GM) slots; GM consecutive workgroups
  // share one 32-column weight slab across GM adjacent row tiles.
  const uint gm = uint(RASTER_GM);
  const uint rb_count = (m_tiles + gm - 1u) / gm;
  const uint span = n_tiles * gm;
  const uint total = span * rb_count;
  for (uint b = 0u; b < batch; ++b) {
    for (uint g = gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.y;
         g < total; g += gl_NumWorkGroups.x * gl_NumWorkGroups.y) {
      uint tile_row = (g / span) * gm + g % gm;
      if (tile_row < m_tiles) {
        qmm_tile(tile_row, (g / gm) % n_tiles, b);
      }
    }
  }
#else
  // Shipped mapping: dispatch (x = n tiles, y = m tiles), row-major
  // raster (consecutive workgroups share a 32-row A tile).
  for (uint b = 0u; b < batch; ++b) {
    for (uint tile_row = gl_WorkGroupID.y; tile_row < m_tiles;
         tile_row += gl_NumWorkGroups.y) {
      for (uint tile_col = gl_WorkGroupID.x; tile_col < n_tiles;
           tile_col += gl_NumWorkGroups.x) {
        qmm_tile(tile_row, tile_col, b);
      }
    }
  }
#endif
}
