#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

layout(local_size_x = 32) in;

#ifdef USE_BF16
layout(set = 0, binding = 0, std430) readonly buffer InputA {
  uvec2 values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  uvec2 values[];
} input_b;
#else
layout(set = 0, binding = 0, std430) readonly buffer InputA {
  STORAGE_TYPE values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  STORAGE_TYPE values[];
} input_b;
#endif
layout(set = 0, binding = 2, std430) readonly buffer InputC {
  STORAGE_TYPE values[];
} input_c;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
  // Lockstep tail of ComputeParams (mlx compute.h): a shader may
  // declare any prefix of the struct, so these appended fields keep
  // every existing SPIR-V interface byte-identical.
  uint q_rowstride;
  uint k_rowstride;
  uint v_rowstride;
  uint o_rowstride;
  uint q_headstride;
  uint k_headstride;
  uint v_headstride;
  uint q_batchstride;
  uint k_batchstride;
  uint v_batchstride;
  // Windowed-dispatch transport: out_row_stride is the full output row
  // width for windowed matmul-family dispatches (0 = use matrix_n);
  // window_lo is the global first row / element for row- or
  // index-windowed dispatches (0 = unwindowed); window_hi is Take's
  // exclusive row-window bound (0 = unwindowed).
  uint out_row_stride;
  uint window_lo;
  uint window_hi;
} params;

#ifdef USE_BF16

vec4 unpack_bf16x4(uvec2 packed) {
  return vec4(
      uintBitsToFloat((packed.x & 0xffffu) << 16u),
      uintBitsToFloat(packed.x & 0xffff0000u),
      uintBitsToFloat((packed.y & 0xffffu) << 16u),
      uintBitsToFloat(packed.y & 0xffff0000u));
}

void main() {
  uint batch_index = gl_WorkGroupID.z;
  uint remaining = batch_index;
  uint a_batch = 0u;
  uint b_batch = 0u;
  for (uint axis = params.dims; axis > 0u; --axis) {
    uint coord = remaining % params.shape[axis - 1u];
    remaining /= params.shape[axis - 1u];
    a_batch += coord * params.in_strides[axis - 1u];
    b_batch += coord * params.out_strides[axis - 1u];
  }

  uint a_base = params.lhs_offset + a_batch;
  uint b_base = params.rhs_offset + b_batch;
  uint row_groups = params.matrix_n / 4u;
  uint lane_k = gl_SubgroupInvocationID * 4u;
  for (uint row_group = gl_WorkGroupID.x; row_group < row_groups;
       row_group += gl_NumWorkGroups.x) {
    uint row = row_group * 4u;
    precise float accumulator0 = 0.0;
    precise float accumulator1 = 0.0;
    precise float accumulator2 = 0.0;
    precise float accumulator3 = 0.0;
    for (uint k = lane_k; k < params.matrix_k; k += 128u) {
      vec4 x = unpack_bf16x4(input_a.values[(a_base + k) / 4u]);
      vec4 weight0 = unpack_bf16x4(
          input_b.values[(b_base + row * params.rhs_gap + k) / 4u]);
      vec4 weight1 = unpack_bf16x4(
          input_b.values[(b_base + (row + 1u) * params.rhs_gap + k) / 4u]);
      vec4 weight2 = unpack_bf16x4(
          input_b.values[(b_base + (row + 2u) * params.rhs_gap + k) / 4u]);
      vec4 weight3 = unpack_bf16x4(
          input_b.values[(b_base + (row + 3u) * params.rhs_gap + k) / 4u]);
      accumulator0 = fma(weight0.x, x.x, accumulator0);
      accumulator0 = fma(weight0.y, x.y, accumulator0);
      accumulator0 = fma(weight0.z, x.z, accumulator0);
      accumulator0 = fma(weight0.w, x.w, accumulator0);
      accumulator1 = fma(weight1.x, x.x, accumulator1);
      accumulator1 = fma(weight1.y, x.y, accumulator1);
      accumulator1 = fma(weight1.z, x.z, accumulator1);
      accumulator1 = fma(weight1.w, x.w, accumulator1);
      accumulator2 = fma(weight2.x, x.x, accumulator2);
      accumulator2 = fma(weight2.y, x.y, accumulator2);
      accumulator2 = fma(weight2.z, x.z, accumulator2);
      accumulator2 = fma(weight2.w, x.w, accumulator2);
      accumulator3 = fma(weight3.x, x.x, accumulator3);
      accumulator3 = fma(weight3.y, x.y, accumulator3);
      accumulator3 = fma(weight3.z, x.z, accumulator3);
      accumulator3 = fma(weight3.w, x.w, accumulator3);
    }

#define REDUCE_ROWS(OFFSET) \
    accumulator0 += subgroupShuffleDown(accumulator0, OFFSET); \
    accumulator1 += subgroupShuffleDown(accumulator1, OFFSET); \
    accumulator2 += subgroupShuffleDown(accumulator2, OFFSET); \
    accumulator3 += subgroupShuffleDown(accumulator3, OFFSET)
    REDUCE_ROWS(16u);
    REDUCE_ROWS(8u);
    REDUCE_ROWS(4u);
    REDUCE_ROWS(2u);
    REDUCE_ROWS(1u);
#undef REDUCE_ROWS

    if (gl_SubgroupInvocationID == 0u) {
      uint output_index = batch_index * params.matrix_n + row;
      output_data.values[params.output_offset + output_index] =
          bf16_store(accumulator0);
      output_data.values[params.output_offset + output_index + 1u] =
          bf16_store(accumulator1);
      output_data.values[params.output_offset + output_index + 2u] =
          bf16_store(accumulator2);
      output_data.values[params.output_offset + output_index + 3u] =
          bf16_store(accumulator3);
    }
  }
}

#else

const uint COLUMNS_PER_GROUP = 32u;

void main() {
  uint batch_index = gl_WorkGroupID.z;
  uint remaining = batch_index;
  uint a_batch = 0u;
  uint b_batch = 0u;
  for (uint axis = params.dims; axis > 0u; --axis) {
    uint coord = remaining % params.shape[axis - 1u];
    remaining /= params.shape[axis - 1u];
    a_batch += coord * params.in_strides[axis - 1u];
    b_batch += coord * params.out_strides[axis - 1u];
  }
  bool b_transposed = (params.flags & 1u) != 0u;
  bool a_transposed = (params.flags & 4u) != 0u;
  uint a_base = params.lhs_offset + a_batch;
  uint b_base = params.rhs_offset + b_batch;
  uint tiles = params.matrix_n / COLUMNS_PER_GROUP +
      uint(params.matrix_n % COLUMNS_PER_GROUP != 0u);
  for (uint tile = gl_WorkGroupID.x; tile < tiles; tile += gl_NumWorkGroups.x) {
    uint column = tile * COLUMNS_PER_GROUP + gl_LocalInvocationID.x;
    if (column >= params.matrix_n) {
      continue;
    }
    float accumulator = 0.0;
    for (uint k = 0u; k < params.matrix_k; ++k) {
      uint a_index = a_base + (a_transposed ? k * params.lhs_gap : k);
      uint b_index = b_transposed
          ? b_base + column * params.rhs_gap + k
          : b_base + k * params.rhs_gap + column;
      accumulator += LOAD_VALUE(input_a.values[a_index]) *
          LOAD_VALUE(input_b.values[b_index]);
    }
    uint output_index = batch_index * params.matrix_n + column;
    float value = params.alpha * accumulator;
    if ((params.flags & 2u) != 0u) {
      uint c_index = params.aux_size == 1u ? 0u : output_index % params.aux_size;
      value += params.beta * LOAD_VALUE(input_c.values[params.aux_offset + c_index]);
    }
    output_data.values[params.output_offset + output_index] = STORE_VALUE(value);
  }
}

#endif
