//
// Split-K pass 2, head-fold variant for the M2D-5 dispatch-count cut: ONE workgroup
// per key-value head covers its SPLIT_R = 4 query heads, so the p2 dispatch count
// drops from heads (36/tok on the 4B shape) to key-value heads (8/tok). Each of the
// 128 threads folds one dimension of one of the four heads against the same float64-
// gated accumulation the plain pass 2 runs. Pairs with any pass 1: the scratch rows
// are exactly the (head * nblocks) layout pass 1 leaves. Compile: -DBK_KEYS=64 (or
// 32 for the BK=32 screen pair).

#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Scratch {
  float values[];
} scratch_data;
layout(set = 0, binding = 1, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

#ifndef BK_KEYS
#define BK_KEYS 64
#endif
const uint BK = uint(BK_KEYS);
const uint D = 128u;
const uint SPLIT_R = 4u;

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

void main() {
  uint t = gl_LocalInvocationID.x;
  uint kv_head = gl_WorkGroupID.x;
  uint sub = t & (SPLIT_R - 1u);   // one of the four query heads
  uint dim = t >> 2u;              // one of the 128 dimensions
  uint head = kv_head * SPLIT_R + sub;
  uint nblocks = (params.matrix_k + BK - 1u) / BK;
  uint base = head * nblocks * (D + 2u);
  uint out_head = params.out_strides[0] != 0u ? params.out_strides[0] : D;

  float global_max = uintBitsToFloat(0xff800000u);
  for (uint b = 0u; b < nblocks; ++b) {
    float m = scratch_data.values[base + b * (D + 2u)];
    if (isnan(m) || m > global_max) {
      global_max = m;
    }
  }
  float denominator = 0.0;
  float acc = 0.0;
  for (uint b = 0u; b < nblocks; ++b) {
    uint at = base + b * (D + 2u);
    float w = exp(scratch_data.values[at] - global_max);
    denominator += scratch_data.values[at + 1u] * w;
    acc += scratch_data.values[at + 2u + dim] * w;
  }
  output_data.values[params.output_offset + head * out_head + dim] = bf16_store(acc / denominator);
}
