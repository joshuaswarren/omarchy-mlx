//
// Split-K pass 1, value-phase variant (selected by MLX_OMARCHY_SDPA_SPLIT_PV; same scratch layout and pass 2 as sdpa_decode_split_p1.comp). Phases 1 and 2 are the same; the weighted value sum uses 8-byte value loads:
// 32 lanes cover the 128 dimensions in groups of four and the four subgroups each walk 32 of the 128 keys, so the serial chain of dependent loads is 32 keys long instead of 128;
// the four partial sums of a dimension are added in a fixed order through shared memory. Needs V element offset, head stride and key stride multiples of 4.
//
// Split-K pass 1 of the bf16 single-query decode SDPA, head width 128 (default) or 256 (-DHD=256). One workgroup per (key-value head, block of 128 keys)
// computes, for the SPLIT_R query heads that share the key-value head, the block's scores, the block softmax numerators and the
// block-weighted value sum, and stores (block max, block exp sum, D weighted-value floats) per (query head, block) for pass 2
// (sdpa_decode_split_p2.comp). The fused kernel (sdpa_decode_native.comp, BF16_IO arm) keeps one 1024-thread workgroup per query
// head, so a 500-key decode step is a 32-workgroup serial chain: one thread per key with 2-byte loads along its row, then 128
// threads each walking every key. This pair spreads the keys over blocks, loads each key row with sixteen 16-byte loads and
// reads every K and V row once for all SPLIT_R query heads of its group.
//
// Arithmetic is float32 throughout (scores, exp, sums, accumulation); only the final store rounds to bf16. The order differs from
// the fused kernel's composition order, so the result is not bit-equal to it; test_sdpa_split.cpp gates the error against a float64
// reference. Host guards (primitives.cpp): batch 1, q_len 1, bf16, head width 128 or 256, heads / kv heads == SPLIT_R, subgroup size 32,
// K element offset, head stride and key stride multiples of 8 (16-byte loads), V element offset and strides even.

#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#ifdef SDPA_QROPE
// FUSE-3 fold 1: this build computes fast_rope_norm's RMS norm and
// rotation of the query inside the Q load (the host skips the
// rope_rms_norm dispatch). The rope arithmetic is reproduced statement
// for statement; see the Q load below.
#extension GL_GOOGLE_include_directive : require
#include "omarchy_trig.h"
#endif

#ifndef SPLIT_R
#define SPLIT_R 4
#endif

// Head width: 128 (default) or 256 (-DHD=256, the Qwen3.5/3.8 full-attention layers; SPLIT_R 4 at most so the partial-sum tile fits shared memory).
#ifndef HD
#define HD 128
#endif

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Query {
  uint16_t values[];
} query_data;
layout(set = 0, binding = 1, std430) readonly buffer Key {
  uvec4 values[];
} key_data;
#if HD == 128
layout(set = 0, binding = 2, std430) readonly buffer Value {
  uvec2 values[];
} value_data;
#else
layout(set = 0, binding = 2, std430) readonly buffer Value {
  uvec4 values[];
} value_data;
#endif
layout(set = 0, binding = 3, std430) writeonly buffer Scratch {
  float values[];
} scratch_data;

#ifdef SDPA_QROPE
// The raw query rides binding 0 in place of the rope_rms_norm output;
// the norm weight and the position offsets ride two extra bindings.
layout(set = 0, binding = 4, std430) readonly buffer NormWeight {
  uint values[];
} norm_weight_data;
layout(set = 0, binding = 5, std430) readonly buffer Offsets {
  int values[];
} offset_data;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

#if HD == 128
const uint D = 128u;
#else
const uint D = 256u;
#endif
const uint BK = 128u;
const uint SUBGROUPS = 4u;

shared float s_q[SPLIT_R * D];
#ifdef SDPA_QROPE
// The rope reduction: the non-Apple tree walks 128 values (one per
// thread); the Apple path hands the eight 32-lane subgroup partials
// through shared memory before the final subgroupAdd.
shared float s_red[128];
#ifdef APPLE_REDUCTION
shared float s_part[8];
#endif
float rope_bf16(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}
float weight_bf16(uint index) {
  uint word = norm_weight_data.values[index >> 1u];
  uint bits = ((index & 1u) == 0u) ? (word & 0xFFFFu) : (word >> 16u);
  return uintBitsToFloat(bits << 16u);
}
uint bf16_round_bits(float value) {
  uint bits = floatBitsToUint(value);
  return isnan(value)
      ? ((bits >> 16u) | 0x40u)
      : ((bits + 0x7fffu + ((bits >> 16u) & 1u)) >> 16u);
}
float rope_round(float value) {
  return uintBitsToFloat(bf16_round_bits(value) << 16u);
}
#endif
shared float s_p[SPLIT_R * BK];
shared float s_max[SPLIT_R * SUBGROUPS];
shared float s_sum[SPLIT_R * SUBGROUPS];
shared float s_o[4u * SPLIT_R * D];

float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}

void main() {
  uint t = gl_LocalInvocationID.x;
  uint kv_head = gl_WorkGroupID.x;
  uint block = gl_WorkGroupID.y;
  uint k_len = params.matrix_k;
  uint nblocks = (k_len + BK - 1u) / BK;
  uint sg = gl_SubgroupID;

#ifdef SDPA_QROPE
#if HD != 256
#error "SDPA_QROPE is built for the 256-wide full-attention layers only"
#endif
  // fast_rope_norm.comp reproduced in this kernel's layout. Thread t owns
  // dims {t, t + half_dims}, which is the rope kernel's own pairing (its
  // reduction tree adds lane t to lane t + 128 first), so both the f32
  // reduction and the per-element chain land on the same values and the
  // same bf16 roundings as the unfused rope_rms_norm dispatch. Push
  // fields (all free in the split kernels): eps bits in operation, the
  // rope scale bits in lhs_size, the freq exponent in beta, the rotation
  // half dims in dims, the query row's time index in matrix_m, the
  // offsets buffer offset in output_offset and the weight element offset
  // in aux_size. Forward, non-traditional, non-passthrough only: the
  // host refuses every other rope shape to the unfused route.
  const float rope_eps = uintBitsToFloat(params.operation);
  const float rope_scale = uintBitsToFloat(params.lhs_size);
  const float position =
      rope_scale * (float(params.matrix_m) + float(offset_data.values[params.output_offset]));
  const uint half_dims = params.dims;
  const uint w_off = params.aux_size;
  for (uint r = 0u; r < SPLIT_R; ++r) {
    uint head = kv_head * SPLIT_R + r;
    uint row_base = params.lhs_offset + head * params.shape[0];
    uint idx0 = row_base + t * params.shape[3];
    uint idx1 = row_base + (t + half_dims) * params.shape[3];
#ifdef APPLE_REDUCTION
    // The rope kernel's subgroup reduction: each of its 256 threads holds
    // one dim, its 8 subgroups each add 32 squares, and subgroup 0 adds
    // the 8 partials. Here thread t holds dims {t, t + 128} = rope lanes
    // {t, t + 128} of subgroups {sg, sg + 4}: two subgroupAdds over this
    // subgroup's 32 lanes reproduce two of the rope kernel's partials
    // bit for bit, and the shared handoff plus the final subgroupAdd in
    // subgroup 0 is the rope kernel's second level.
    precise float value0 = rope_bf16(query_data.values[idx0]);
    precise float value1 = rope_bf16(query_data.values[idx1]);
    precise float sq0 = value0 * value0;
    precise float sq1 = value1 * value1;
    float p0 = subgroupAdd(sq0);
    float p1 = subgroupAdd(sq1);
    if (gl_SubgroupInvocationID == 0u) {
      s_part[sg] = p0;
      s_part[sg + 4u] = p1;
    }
    barrier();
    float partial = (sg == 0u && gl_SubgroupInvocationID < 8u)
        ? s_part[gl_SubgroupInvocationID]
        : 0.0;
    float row_sum = subgroupAdd(partial);
    if (t == 0u) {
      s_red[0] = row_sum;
    }
    barrier();
#else
    // The rope kernel's shared tree, verbatim from its first step: lane t
    // adds lane t + 128, then strides 64..1 over the remaining 128 sums.
    float value0 = rope_bf16(query_data.values[idx0]);
    float value1 = rope_bf16(query_data.values[idx1]);
    precise float sq0 = value0 * value0;
    precise float sq1 = value1 * value1;
    precise float pair = sq0 + sq1;
    s_red[t] = pair;
    barrier();
    for (uint stride = 64u; stride > 0u; stride >>= 1u) {
      if (t < stride) {
        s_red[t] += s_red[t + stride];
      }
      barrier();
    }
#endif
    float mean_square = s_red[0] / float(D);
    barrier();
    precise float norm = inversesqrt(mean_square + rope_eps);
    // Re-load the values instead of carrying the squared register: the
    // rope kernel documents that the carried register lets NIR fold the
    // multiplies into an ffma that drifts one bf16 ULP at the rounding
    // tie line.
    precise float re0 = rope_bf16(query_data.values[idx0]);
    precise float re1 = rope_bf16(query_data.values[idx1]);
    precise float weight0 = weight_bf16(w_off + t);
    precise float weight1 = weight_bf16(w_off + t + half_dims);
    precise float wn0 = weight0 * norm;
    precise float wn1 = weight1 * norm;
    float x1 = rope_round(re0 * wn0);
    float x2 = rope_round(re1 * wn1);
    // Half-split rotation, forward: this thread's pair (x1 at dim t,
    // x2 at dim t + half_dims) produces both rotated outputs.
    float inv_freq = exp(-float(t) * params.beta);
    float theta = position * inv_freq;
    float cos_t = rope_round(omarchy_trig_cos(theta));
    float sin_t = rope_round(omarchy_trig_sin(theta));
    float xa = rope_round(x1 * cos_t);
    float xb = rope_round(x2 * sin_t);
    float xc = rope_round(x1 * sin_t);
    float xd = rope_round(x2 * cos_t);
    float rotated0 = xa - xb;
    float rotated1 = xc + xd;
    // The unfused route stores the rotation as bf16 and this kernel
    // reloads it, so round through the same bf16 bits before the scale.
    s_q[r * D + t] = params.alpha *
        uintBitsToFloat(bf16_round_bits(rotated0) << 16u);
    s_q[r * D + t + half_dims] = params.alpha *
        uintBitsToFloat(bf16_round_bits(rotated1) << 16u);
    // Release the shared reduction state before the next head rewrites it:
    // without this trailing barrier a fast thread could start the next
    // head's reduction while a slow thread still reads s_red[0]. The
    // rope kernel ends its row loop with the same barrier.
    barrier();
  }
#else
#if HD == 128
  for (uint r = 0u; r < SPLIT_R; ++r) {
    uint head = kv_head * SPLIT_R + r;
    s_q[r * D + t] = params.alpha * bf16_load(
        query_data.values[params.lhs_offset + head * params.shape[0] + t * params.shape[3]]);
  }
#else
  for (uint r = 0u; r < SPLIT_R; ++r) {
    uint head = kv_head * SPLIT_R + r;
    for (uint d = 0u; d < 2u; ++d) {
      uint dim = d * 128u + t;
      s_q[r * D + dim] = params.alpha * bf16_load(
          query_data.values[params.lhs_offset + head * params.shape[0] + dim * params.shape[3]]);
    }
  }
#endif
#endif
  barrier();

  uint key = block * BK + t;
  bool valid = key < k_len;
  float score[SPLIT_R];
  for (uint r = 0u; r < SPLIT_R; ++r) {
    score[r] = 0.0;
  }
  if (valid) {
    uint k_base = (params.rhs_offset + kv_head * params.shape[1] + key * params.shape[2]) >> 3u;
    for (uint c = 0u; c < D / 8u; ++c) {
      uvec4 w = key_data.values[k_base + c];
      float kf[8];
      kf[0] = uintBitsToFloat(w.x << 16u);
      kf[1] = uintBitsToFloat(w.x & 0xffff0000u);
      kf[2] = uintBitsToFloat(w.y << 16u);
      kf[3] = uintBitsToFloat(w.y & 0xffff0000u);
      kf[4] = uintBitsToFloat(w.z << 16u);
      kf[5] = uintBitsToFloat(w.z & 0xffff0000u);
      kf[6] = uintBitsToFloat(w.w << 16u);
      kf[7] = uintBitsToFloat(w.w & 0xffff0000u);
      for (uint r = 0u; r < SPLIT_R; ++r) {
        for (uint i = 0u; i < 8u; ++i) {
          score[r] += s_q[r * D + c * 8u + i] * kf[i];
        }
      }
    }
  } else {
    for (uint r = 0u; r < SPLIT_R; ++r) {
      score[r] = uintBitsToFloat(0xff800000u);
    }
  }

  for (uint r = 0u; r < SPLIT_R; ++r) {
    float m = subgroupMax(score[r]);
    if (gl_SubgroupInvocationID == 0u) {
      s_max[r * SUBGROUPS + sg] = m;
    }
  }
  barrier();
  float block_max[SPLIT_R];
  for (uint r = 0u; r < SPLIT_R; ++r) {
    float m = max(max(s_max[r * SUBGROUPS], s_max[r * SUBGROUPS + 1u]),
        max(s_max[r * SUBGROUPS + 2u], s_max[r * SUBGROUPS + 3u]));
    block_max[r] = m;
    float p = valid ? exp(score[r] - m) : 0.0;
    s_p[r * BK + t] = p;
    float ps = subgroupAdd(p);
    if (gl_SubgroupInvocationID == 0u) {
      s_sum[r * SUBGROUPS + sg] = ps;
    }
  }
  barrier();

  uint nk = min(BK, k_len - block * BK);
  uint v_stride = params.in_strides[2];
  uint dg = t & 31u;
  uint part = t >> 5u;
  uint kstart = part * 32u;
  uint kend = min(nk, kstart + 32u);
#if HD == 128
  uint v_row0 = params.aux_offset + kv_head * params.in_strides[1] + block * BK * v_stride + dg * 4u;
  float o[SPLIT_R * 4];
  for (uint i = 0u; i < SPLIT_R * 4u; ++i) {
    o[i] = 0.0;
  }
  uint key0 = kstart;
  for (; key0 + 8u <= kend; key0 += 8u) {
    uvec2 w[8];
    for (uint i = 0u; i < 8u; ++i) {
      w[i] = value_data.values[(v_row0 + (key0 + i) * v_stride) >> 2u];
    }
    for (uint i = 0u; i < 8u; ++i) {
      float v0 = uintBitsToFloat(w[i].x << 16u);
      float v1 = uintBitsToFloat(w[i].x & 0xffff0000u);
      float v2 = uintBitsToFloat(w[i].y << 16u);
      float v3 = uintBitsToFloat(w[i].y & 0xffff0000u);
      for (uint r = 0u; r < SPLIT_R; ++r) {
        float p = s_p[r * BK + key0 + i];
        o[r * 4u + 0u] += p * v0;
        o[r * 4u + 1u] += p * v1;
        o[r * 4u + 2u] += p * v2;
        o[r * 4u + 3u] += p * v3;
      }
    }
  }
  for (; key0 < kend; ++key0) {
    uvec2 w = value_data.values[(v_row0 + key0 * v_stride) >> 2u];
    float v0 = uintBitsToFloat(w.x << 16u);
    float v1 = uintBitsToFloat(w.x & 0xffff0000u);
    float v2 = uintBitsToFloat(w.y << 16u);
    float v3 = uintBitsToFloat(w.y & 0xffff0000u);
    for (uint r = 0u; r < SPLIT_R; ++r) {
      float p = s_p[r * BK + key0];
      o[r * 4u + 0u] += p * v0;
      o[r * 4u + 1u] += p * v1;
      o[r * 4u + 2u] += p * v2;
      o[r * 4u + 3u] += p * v3;
    }
  }
  for (uint r = 0u; r < SPLIT_R; ++r) {
    for (uint i = 0u; i < 4u; ++i) {
      s_o[(part * SPLIT_R + r) * D + dg * 4u + i] = o[r * 4u + i];
    }
  }
  barrier();

  for (uint r = 0u; r < SPLIT_R; ++r) {
    uint head = kv_head * SPLIT_R + r;
    uint base = (head * nblocks + block) * (D + 2u);
    if (t == 0u) {
      scratch_data.values[base] = block_max[r];
      scratch_data.values[base + 1u] = s_sum[r * SUBGROUPS] + s_sum[r * SUBGROUPS + 1u] +
          s_sum[r * SUBGROUPS + 2u] + s_sum[r * SUBGROUPS + 3u];
    }
    float total = s_o[r * D + t] + s_o[(SPLIT_R + r) * D + t] + s_o[(2u * SPLIT_R + r) * D + t] + s_o[(3u * SPLIT_R + r) * D + t];
    scratch_data.values[base + 2u + t] = total;
  }
#else
  // Width 256: each lane covers 8 dimensions with one 16-byte value load per key; the four subgroups each walk 32 of the 128 keys, four keys per batch
  // (the same 64 bytes in flight per lane as the width-128 batch of eight 8-byte loads). The four partial sums of a dimension are added in the same fixed order.
  uint v_row0 = params.aux_offset + kv_head * params.in_strides[1] + block * BK * v_stride + dg * 8u;
  float o[SPLIT_R * 8];
  for (uint i = 0u; i < SPLIT_R * 8u; ++i) {
    o[i] = 0.0;
  }
  uint key0 = kstart;
  for (; key0 + 4u <= kend; key0 += 4u) {
    uvec4 w[4];
    for (uint i = 0u; i < 4u; ++i) {
      w[i] = value_data.values[(v_row0 + (key0 + i) * v_stride) >> 3u];
    }
    for (uint i = 0u; i < 4u; ++i) {
      float v[8];
      v[0] = uintBitsToFloat(w[i].x << 16u);
      v[1] = uintBitsToFloat(w[i].x & 0xffff0000u);
      v[2] = uintBitsToFloat(w[i].y << 16u);
      v[3] = uintBitsToFloat(w[i].y & 0xffff0000u);
      v[4] = uintBitsToFloat(w[i].z << 16u);
      v[5] = uintBitsToFloat(w[i].z & 0xffff0000u);
      v[6] = uintBitsToFloat(w[i].w << 16u);
      v[7] = uintBitsToFloat(w[i].w & 0xffff0000u);
      for (uint r = 0u; r < SPLIT_R; ++r) {
        float p = s_p[r * BK + key0 + i];
        for (uint j = 0u; j < 8u; ++j) {
          o[r * 8u + j] += p * v[j];
        }
      }
    }
  }
  for (; key0 < kend; ++key0) {
    uvec4 w = value_data.values[(v_row0 + key0 * v_stride) >> 3u];
    float v[8];
    v[0] = uintBitsToFloat(w.x << 16u);
    v[1] = uintBitsToFloat(w.x & 0xffff0000u);
    v[2] = uintBitsToFloat(w.y << 16u);
    v[3] = uintBitsToFloat(w.y & 0xffff0000u);
    v[4] = uintBitsToFloat(w.z << 16u);
    v[5] = uintBitsToFloat(w.z & 0xffff0000u);
    v[6] = uintBitsToFloat(w.w << 16u);
    v[7] = uintBitsToFloat(w.w & 0xffff0000u);
    for (uint r = 0u; r < SPLIT_R; ++r) {
      float p = s_p[r * BK + key0];
      for (uint j = 0u; j < 8u; ++j) {
        o[r * 8u + j] += p * v[j];
      }
    }
  }
  for (uint r = 0u; r < SPLIT_R; ++r) {
    for (uint i = 0u; i < 8u; ++i) {
      s_o[(part * SPLIT_R + r) * D + dg * 8u + i] = o[r * 8u + i];
    }
  }
  barrier();

  for (uint r = 0u; r < SPLIT_R; ++r) {
    uint head = kv_head * SPLIT_R + r;
    uint base = (head * nblocks + block) * (D + 2u);
    if (t == 0u) {
      scratch_data.values[base] = block_max[r];
      scratch_data.values[base + 1u] = s_sum[r * SUBGROUPS] + s_sum[r * SUBGROUPS + 1u] +
          s_sum[r * SUBGROUPS + 2u] + s_sum[r * SUBGROUPS + 3u];
    }
    for (uint d = 0u; d < 2u; ++d) {
      uint dim = d * 128u + t;
      float total = s_o[r * D + dim] + s_o[(SPLIT_R + r) * D + dim] + s_o[(2u * SPLIT_R + r) * D + dim] + s_o[(3u * SPLIT_R + r) * D + dim];
      scratch_data.values[base + 2u + dim] = total;
    }
  }
#endif
}
