//
// Wave 7: LU factorization with partial pivoting, LAPACK getrf semantics.
// One workgroup per batch matrix. The work buffer starts as a dense
// row-major copy of A and ends as the packed LU (unit-diagonal L implicit
// in the strict lower triangle, U in the upper). Pivots are recorded
// 0-based exactly like upstream (LAPACK ipiv minus one), and row_indices
// is the row permutation built by applying those swaps in reverse, so the
// documented reconstruction A[row_indices] = L @ U holds. A zero pivot
// pins status 1 for the host: upstream silently returns the partial
// factorization, and a silent wrong factor is worse than a refusal.
//
// Push-constant routing: matrix_m is M, matrix_n is N, matrix_k is
// min(M, N), and output_size the batch matrix count.
#version 460

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) coherent buffer Work {
  float values[];
} work;
layout(set = 0, binding = 1, std430) buffer Pivots {
  uint values[];
} pivots;
layout(set = 0, binding = 2, std430) buffer RowIndices {
  uint values[];
} row_indices;
layout(set = 0, binding = 3, std430) buffer Status {
  uint values[];
} status;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float red[256];
shared uint redi[256];

void main() {
  uint tid = gl_LocalInvocationID.x;
  // The host chunks the batch so no dispatch exceeds 65535 workgroups;
  // aux_offset carries this dispatch's first matrix index (the field is
  // unused by every linalg shader).
  uint matrix = params.aux_offset + gl_WorkGroupID.x;
  uint m = params.matrix_m;
  uint n = params.matrix_n;
  uint k_count = params.matrix_k;
  uint base = matrix * m * n;

  for (uint i = tid; i < m; i += 256u) {
    row_indices.values[matrix * m + i] = i;
  }

  for (uint k = 0u; k < k_count; ++k) {
    // Partial pivot over column k, rows [k, m), reduced as (value, index)
    // pairs with a strictly-greater compare so ties keep the smaller row.
    // The sentinel -1.0 must be distinct from every real |value| >= 0: a
    // 0.0 sentinel let the thread that owns row k overwrite its candidate
    // on every later stride step (its best_i legitimately stays k), so
    // m > 256 silently lost the true maximum.
    float best = -1.0;
    uint best_i = k;
    for (uint i = k + tid; i < m; i += 256u) {
      float v = abs(work.values[base + i * n + k]);
      if (best < 0.0 || v > best) {
        best = v;
        best_i = i;
      }
    }
    red[tid] = best;
    redi[tid] = best_i;
      memoryBarrierBuffer();
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (tid < stride && red[tid + stride] > red[tid]) {
        red[tid] = red[tid + stride];
        redi[tid] = redi[tid + stride];
      }
      memoryBarrierBuffer();
      barrier();
    }
    if (tid == 0u) {
      red[255] = red[0];
      redi[255] = redi[0];
      pivots.values[matrix * k_count + k] = redi[0];
      if (red[0] == 0.0) {
        status.values[matrix] = 1u;
      }
    }
      memoryBarrierBuffer();
    barrier();
    uint pivot_row = redi[255];
    for (uint c = tid; c < n; c += 256u) {
      float t = work.values[base + k * n + c];
      work.values[base + k * n + c] = work.values[base + pivot_row * n + c];
      work.values[base + pivot_row * n + c] = t;
    }
      memoryBarrierBuffer();
    barrier();
    if (tid == 0u) {
      red[254] = 1.0 / work.values[base + k * n + k];
    }
      memoryBarrierBuffer();
    barrier();
    float pinv = red[254];
    for (uint i = k + 1u + tid; i < m; i += 256u) {
      float f = work.values[base + i * n + k] * pinv;
      work.values[base + i * n + k] = f;
      for (uint c = k + 1u; c < n; ++c) {
        work.values[base + i * n + c] -= f * work.values[base + k * n + c];
      }
    }
      memoryBarrierBuffer();
    barrier();
  }

  // Upstream applies the recorded swaps to row_indices in reverse order
  // after factoring; a forward in-loop application yields a different
  // permutation and breaks the documented A[row_indices] = L @ U.
  if (tid == 0u) {
    for (uint j = k_count; j-- > 0u;) {
      uint piv = pivots.values[matrix * k_count + j];
      uint t = row_indices.values[matrix * m + piv];
      row_indices.values[matrix * m + piv] =
          row_indices.values[matrix * m + j];
      row_indices.values[matrix * m + j] = t;
    }
  }
}
