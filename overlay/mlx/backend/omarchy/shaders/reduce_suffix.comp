// Suffix-axis reduction: the reduced axis is the last axis of a
// row-contiguous input. Per-invocation serial loops are bounded by the
// driver (the lavapipe runtime stops after roughly 2^16 trips for this
// kernel shape), so reduce_size is split across chunks when it exceeds
// the chunk-trip threshold. One kernel runs in two phases:
//
//   flags bit 0 clear: one (output element, chunk) pair per invocation,
//     writes its partial accumulator to the scratch buffer at binding 1.
//   flags bit 0 set:   one output element per invocation, combines its
//     chunks from scratch and writes the final typed output.
//
// flags bit 1 marks the single-pass layout: reduce_size fits in one
// chunk, so the accumulator is stored straight to the output and the
// scratch buffer goes untouched.
//
// The selector matches ReduceOperation in primitives.cpp: 0 Sum, 1 Prod,
// 2 Min, 3 Max. Any/All always route to the bool general kernel and are
// not served by this file.
//
// Scratch holds one accumulator per (output element, chunk). Float
// variants accumulate in float32, the rule the suffix scan and general
// reduce kernels follow; 16-bit storage never narrows a partial.
#version 460

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_OUTPUT(v) float16_t(v)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_OUTPUT(v) bf16_store(v)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_OUTPUT(v) STORAGE_TYPE(v)
#endif

#if defined(USE_I32)
#define ACC_TYPE int
#define MAX_SENTINEL 2147483647
#define MIN_SENTINEL (-2147483647 - 1)
#define SCRATCH_TYPE int
#elif defined(USE_U32)
#define ACC_TYPE uint
#define MAX_SENTINEL 0xffffffffu
#define MIN_SENTINEL 0u
#define SCRATCH_TYPE uint
#else
#define ACC_TYPE float
#define MAX_SENTINEL uintBitsToFloat(0x7f800000u)
#define MIN_SENTINEL uintBitsToFloat(0xff800000u)
#define SCRATCH_TYPE float
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 1, std430) buffer Scratch {
  SCRATCH_TYPE values[];
} scratch_data;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  uint lhs_gap;
  uint rhs_gap;
  // Lockstep tail of ComputeParams (mlx compute.h): a shader may
  // declare any prefix of the struct, so these appended fields keep
  // every existing SPIR-V interface byte-identical.
  uint q_rowstride;
  uint k_rowstride;
  uint v_rowstride;
  uint o_rowstride;
  uint q_headstride;
  uint k_headstride;
  uint v_headstride;
  uint q_batchstride;
  uint k_batchstride;
  uint v_batchstride;
  // Windowed-dispatch transport: out_row_stride is the full output row
  // width for windowed matmul-family dispatches (0 = use matrix_n);
  // window_lo is the global first row / element for row- or
  // index-windowed dispatches (0 = unwindowed); window_hi is Take's
  // exclusive row-window bound (0 = unwindowed).
  uint out_row_stride;
  uint window_lo;
  uint window_hi;
} params;

// The accumulator seed for each operation: the empty-reduction identity.
ACC_TYPE init_value(uint operation) {
  if (operation == 0u) {
    return ACC_TYPE(0);
  }
  if (operation == 1u) {
    return ACC_TYPE(1);
  }
  if (operation == 2u) {
    return ACC_TYPE(MAX_SENTINEL);
  }
  return ACC_TYPE(MIN_SENTINEL);
}

// Min and Max follow the upstream NaN convention: any NaN in the reduced
// set poisons the result. A plain ordered compare silently drops a NaN
// carried in the accumulator, so the poison is held once it enters.
ACC_TYPE combine(ACC_TYPE acc, ACC_TYPE next, uint operation) {
  if (operation == 0u) {
    return acc + next;
  }
  if (operation == 1u) {
    return acc * next;
  }
#if !defined(USE_I32) && !defined(USE_U32)
  if (isnan(acc)) {
    return acc;
  }
  if (isnan(next)) {
    return next;
  }
#endif
  if (operation == 2u) {
    return acc < next ? acc : next;
  }
  return acc > next ? acc : next;
}

void main() {
  uint grid = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  // Row-windowed dispatches start at window_lo (0 = unwindowed).
  uint id = gl_GlobalInvocationID.x + params.window_lo;
  uint chunks = max(params.matrix_n, 1u);
  if ((params.flags & 1u) != 0u) {
    // Combine phase: one output element per invocation.
    while (id < params.output_size) {
      ACC_TYPE value = init_value(params.operation);
      uint base = id * chunks;
      for (uint c = 0u; c < chunks; ++c) {
        value =
            combine(value, ACC_TYPE(scratch_data.values[base + c]),
                    params.operation);
      }
      output_data.values[params.output_offset + id] = STORE_OUTPUT(value);
      if (params.output_size - id <= grid) {
        break;
      }
      id += grid;
    }
    return;
  }
  // Partial phase: one (output element, chunk) pair per invocation.
  while (id < params.output_size * chunks) {
    uint output_index = id / chunks;
    uint chunk = id - output_index * chunks;
    uint trips = (params.reduce_size + chunks - 1u) / chunks;
    uint lo = chunk * trips;
    uint hi = min(lo + trips, params.reduce_size);
    uint start = params.lhs_offset + output_index * params.reduce_size;
    ACC_TYPE value = init_value(params.operation);
    for (uint index = lo; index < hi; ++index) {
      value = combine(
          value,
          ACC_TYPE(LOAD_VALUE(input_data.values[start + index])),
          params.operation);
    }
    if ((params.flags & 2u) != 0u) {
      output_data.values[params.output_offset + output_index] =
          STORE_OUTPUT(value);
    } else {
      scratch_data.values[id] = SCRATCH_TYPE(value);
    }
    if (params.output_size * chunks - id <= grid) {
      break;
    }
    id += grid;
  }
}
