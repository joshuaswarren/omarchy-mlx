//
// Numeric dtype conversion. One blob per source/destination storage width;
// runtime dtype codes preserve signedness and distinguish integer, float,
// bfloat16, and complex semantics. Complex sources project their real part;
// real sources promote to complex with a zero imaginary part. Byte stores use
// commuting atomic lane insertion so adjacent invocations cannot lose writes.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "omarchy_half.h"

#if SRC_W == 2 || DST_W == 2
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif
#if SRC_W == 8 || DST_W == 8
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#endif

#define CODE_BOOL 0u
#define CODE_U8 1u
#define CODE_I8 2u
#define CODE_U16 3u
#define CODE_I16 4u
#define CODE_U32 5u
#define CODE_I32 6u
#define CODE_U64 7u
#define CODE_I64 8u
#define CODE_F32 9u
#define CODE_F16 10u
#define CODE_BF16 11u
#define CODE_C64 12u

#define SRC_CODE (params.operation & 0xFFFFu)
#define DST_CODE ((params.operation >> 16u) & 0x7FFFu)
#define FLAG_SCALAR 1u
#define FLAG_GENERAL 2u

layout(local_size_x = 256) in;

#if SRC_W == 2
layout(set = 0, binding = 0, std430) readonly buffer InputH {
  uint16_t values[];
} in_h;
#else
layout(set = 0, binding = 0, std430) readonly buffer InputW {
  uint values[];
} in_w;
#endif

#if DST_W == 2
layout(set = 0, binding = 2, std430) buffer OutputH {
  uint16_t values[];
} out_h;
#elif DST_W == 1
layout(set = 0, binding = 2, std430) buffer OutputW {
  uint values[];
} out_w;
#else
layout(set = 0, binding = 2, std430) writeonly buffer OutputW {
  uint values[];
} out_w;
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

layout(set = 0, binding = 3, std430) readonly buffer AxisMetadata {
  uint values[];
} axis_data;

uint axis_extent(uint index) {
  return params.matrix_k == 0u ? params.shape[index] : axis_data.values[index];
}

uint in_stride_at(uint index) {
  return params.matrix_k == 0u
      ? params.in_strides[index]
      : axis_data.values[params.matrix_k + index];
}

uint out_stride_at(uint index) {
  return params.matrix_k == 0u
      ? params.out_strides[index]
      : axis_data.values[2u * params.matrix_k + index];
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  while (index < params.count) {
    int in_index = int(params.lhs_offset);
    int out_index = int(params.output_offset);
    if ((params.flags & FLAG_GENERAL) != 0u) {
      uint rem = index;
      for (int dim = int(params.dims) - 1; dim >= 0; --dim) {
        uint coord = rem % axis_extent(uint(dim));
        rem /= axis_extent(uint(dim));
        in_index += int(coord) * int(in_stride_at(uint(dim)));
        out_index += int(coord) * int(out_stride_at(uint(dim)));
      }
    } else {
      if ((params.flags & FLAG_SCALAR) == 0u) {
        in_index += int(index);
      }
      out_index += int(index);
    }
    uint addr = uint(in_index);
    uint daddr = uint(out_index);
    uint lo = 0u;
    uint hi = 0u;
    float real_value = 0.0;
    bool floating_source = SRC_CODE >= CODE_F32;
#if SRC_W == 1
    uint word = in_w.values[addr >> 2u];
    uint lane = addr & 3u;
    uint b = (lane == 0u)
        ? (word & 0xFFu)
        : (lane == 1u)
        ? ((word >> 8u) & 0xFFu)
        : (lane == 2u)
        ? ((word >> 16u) & 0xFFu)
        : ((word >> 24u) & 0xFFu);
    lo = b;
    if (SRC_CODE == CODE_I8 && (b & 0x80u) != 0u) {
      lo |= 0xFFFFFF00u;
      hi = 0xFFFFFFFFu;
    } else if (SRC_CODE == CODE_BOOL) {
      lo = b != 0u ? 1u : 0u;
    }
    real_value = SRC_CODE == CODE_I8 ? float(int(lo)) : float(lo);
#elif SRC_W == 2
    uint16_t h = in_h.values[addr];
    lo = uint(h);
    if (SRC_CODE == CODE_F16) {
      real_value = unpackHalf2x16(uint(h)).x;
    } else if (SRC_CODE == CODE_BF16) {
      real_value = uintBitsToFloat(uint(h) << 16u);
    } else {
      if (SRC_CODE == CODE_I16 && (lo & 0x8000u) != 0u) {
        lo |= 0xFFFF0000u;
        hi = 0xFFFFFFFFu;
      }
      real_value = SRC_CODE == CODE_I16 ? float(int(lo)) : float(lo);
    }
#elif SRC_W == 4
    lo = in_w.values[addr];
    if (SRC_CODE == CODE_F32) {
      real_value = uintBitsToFloat(lo);
    } else {
      if (SRC_CODE == CODE_I32 && (lo & 0x80000000u) != 0u) {
        hi = 0xFFFFFFFFu;
      }
      real_value = SRC_CODE == CODE_I32 ? float(int(lo)) : float(lo);
    }
#else
    lo = in_w.values[2u * addr];
    hi = in_w.values[2u * addr + 1u];
    if (SRC_CODE == CODE_C64) {
      real_value = uintBitsToFloat(lo);
    } else {
      uint64_t wide = (uint64_t(hi) << 32ul) | uint64_t(lo);
      real_value = SRC_CODE == CODE_I64
          ? float(int64_t(wide))
          : float(wide);
    }
#endif
    // static_cast<bool>(x) is (x != 0). Deciding it from the float value
    // relies on DenormPreserve, which Vulkan only grants opt-in: the
    // Honeykrisp fork flushes subnormal operands to zero, so a float32
    // subnormal (and a bfloat16 subnormal, which rides the same f32
    // subnormal encoding) compared != 0.0 reads as false where every CPU
    // and the float16 path (whose subnormals decode to normal f32 values)
    // say true. Decide from the encoded bits instead: every nonzero
    // encoding except the sign bit means nonzero - this covers
    // subnormals of any width and keeps NaN true and both zeros false.
    uint truth;
#if SRC_W == 2
    truth = floating_source ? ((lo & 0x7FFFu) != 0u ? 1u : 0u)
                            : ((lo | hi) != 0u ? 1u : 0u);
#else
    truth = floating_source ? ((lo & 0x7FFFFFFFu) != 0u ? 1u : 0u)
                            : ((lo | hi) != 0u ? 1u : 0u);
#endif
    bool floating_destination = DST_CODE >= CODE_F32;
    if (floating_destination) {
#if DST_W == 2
      uint bits = floatBitsToUint(real_value);
      uint encoded = DST_CODE == CODE_F16
          ? omarchy_f16_bits_rne(real_value)
          : (isnan(real_value)
                ? ((bits >> 16u) | 0x40u)
                : ((bits + 0x7FFFu + ((bits >> 16u) & 1u)) >> 16u));
      out_h.values[daddr] = uint16_t(encoded);
#elif DST_W == 4
      out_w.values[daddr] = floatBitsToUint(real_value);
#else
      out_w.values[2u * daddr] = floatBitsToUint(real_value);
      out_w.values[2u * daddr + 1u] = 0u;
#endif
    } else {
      if (floating_source && DST_CODE != CODE_BOOL) {
#if DST_W == 8
        if (DST_CODE == CODE_U64) {
          uint64_t converted;
          if (isnan(real_value) || real_value <= 0.0) {
            converted = 0ul;
          } else if (real_value >= 18446744073709551616.0) {
            converted = 0xFFFFFFFFFFFFFFFFul;
          } else {
            converted = uint64_t(real_value);
          }
          lo = uint(converted & 0xFFFFFFFFul);
          hi = uint(converted >> 32ul);
        } else {
          int64_t converted;
          if (isnan(real_value)) {
            converted = 0l;
          } else if (real_value >= 9223372036854775808.0) {
            converted = 9223372036854775807l;
          } else if (real_value <= -9223372036854775808.0) {
            converted = -9223372036854775807l - 1l;
          } else {
            converted = int64_t(real_value);
          }
          lo = uint(uint64_t(converted) & 0xFFFFFFFFul);
          hi = uint(uint64_t(converted) >> 32ul);
        }
#else
        if (DST_CODE == CODE_U8 || DST_CODE == CODE_U16 ||
            DST_CODE == CODE_U32) {
          if (isnan(real_value) || real_value <= 0.0) {
            lo = 0u;
          } else if (real_value >= 4294967296.0) {
            lo = 0xFFFFFFFFu;
          } else {
            lo = uint(real_value);
          }
          hi = 0u;
        } else {
          int converted;
          if (isnan(real_value)) {
            converted = 0;
          } else if (real_value >= 2147483648.0) {
            converted = 2147483647;
          } else if (real_value <= -2147483648.0) {
            converted = -2147483647 - 1;
          } else {
            converted = int(real_value);
          }
          lo = uint(converted);
          hi = converted < 0 ? 0xFFFFFFFFu : 0u;
        }
#endif
      }
#if DST_W == 1
      uint value = DST_CODE == CODE_BOOL ? truth : (lo & 0xFFu);
      uint shift = (daddr & 3u) * 8u;
      atomicAnd(out_w.values[daddr >> 2u], ~(0xFFu << shift));
      atomicOr(out_w.values[daddr >> 2u], value << shift);
#elif DST_W == 2
      out_h.values[daddr] = uint16_t(lo & 0xFFFFu);
#elif DST_W == 4
      out_w.values[daddr] = lo;
#else
      out_w.values[2u * daddr] = lo;
      out_w.values[2u * daddr + 1u] = hi;
#endif
    }
    if (params.count - index <= stride) {
      break;
    }
    index += stride;
  }
}
