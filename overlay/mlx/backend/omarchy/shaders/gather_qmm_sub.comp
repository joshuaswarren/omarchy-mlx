//
// Subgroup gathered affine quantized matmul (decode shape m == 1).
//
// The scalar gather_qmm.comp assigns one thread per output element;
// at B=1 decode the routed-expert shapes (6 experts x 1408/2048
// columns) launch only 33-48 workgroups whose threads run serial
// K = 2048 loops, and the GPU sits latency-bound: measured 4.2 ms per
// dispatch on the M2 (80% of a DeepSeek-Coder-V2-Lite MoE decode
// step; the QmmVecQ4WordSubgroup class runs the same weight format in
// 35-49 us).
//
// This kernel assigns one WORKGROUP (256 lanes, 8 subgroups) per
// output element and splits the K loop across lanes: lane l contracts
// k in {l, l + 256, ...}. Every 32-lane subgroup spans 32 consecutive
// k values, so the group_size (>= 32) scale/bias index is
// subgroup-uniform per step. The per-lane partial reduces with
// subgroupAdd, the eight subgroup sums combine through shared memory,
// and lane 0 stores. Products are identical to the scalar kernel
// (same decode helpers, same packed layout); the fp32 accumulation
// order changes from a serial K loop to a lane-tree, which the
// numerics gate covers (per-op fp64 error and token agreement).
//
// Binding 1 is the same packed uint32 staging buffer as the scalar
// kernel: [all scale bytes | (all bias bytes) | lhs words | rhs words].
// Push-constant routing is unchanged.

#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#if defined(USE_FP16) || defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#endif
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

#if defined(USE_FP16) || defined(USE_BF16)
#define PARAM_BYTES 2u
#else
#define PARAM_BYTES 4u
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  STORAGE_TYPE values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer PackedParams {
  uint values[];
} packed_params;
layout(set = 0, binding = 2, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float subgroup_totals[8];

// Decode one group parameter stored at byte_offset in the packed word
// buffer, in the output dtype (identical to the scalar kernel).
float decode_param(uint byte_offset) {
  uint word = packed_params.values[params.aux_offset + byte_offset / 4u];
#if defined(USE_FP16)
  uint half_index = byte_offset / 2u;
  uint shifted = (half_index & 1u) == 0u ? word : word >> 16u;
  return unpackHalf2x16(shifted).x;
#elif defined(USE_BF16)
  uint half_index = byte_offset / 2u;
  uint bits = (half_index & 1u) == 0u ? word << 16u : word & 0xffff0000u;
  return uintBitsToFloat(bits);
#else
  return uintBitsToFloat(word);
#endif
}

void main() {
  uint bits = params.operation;
  uint group_size = params.reduce_size;
  bool non_transposed = (params.flags & 1u) != 0u;
  uint pack_factor = 32u / bits;
  uint value_mask = (1u << bits) - 1u;
  uint words_per_row = params.matrix_k / pack_factor;
  uint groups_per_row = params.matrix_k / group_size;
  uint matrix = params.matrix_m * params.matrix_n;
  uint param_bytes = PARAM_BYTES;
  uint w_row_words = params.matrix_n * words_per_row;
  uint scale_row_words = non_transposed
      ? params.matrix_k * (params.matrix_n / group_size)
      : params.matrix_n * groups_per_row;
  uint index_count = params.shape[0];
  uint lhs_word_base = params.in_strides[0];
  uint rhs_word_base = params.out_strides[0];

  uint index = gl_WorkGroupID.x;
  uint batch = index / matrix;
  uint within = index - batch * matrix;
  uint row = within / params.matrix_n;
  uint column = within - row * params.matrix_n;
  uint lhs = packed_params.values[params.aux_offset + lhs_word_base +
      batch];
  uint rhs = packed_params.values[params.aux_offset + rhs_word_base +
      batch];
  uint x_base = params.lhs_offset +
      lhs * (params.matrix_m * params.matrix_k) +
      row * params.matrix_k;

  uint lane = gl_LocalInvocationID.x;
  uint k_steps = (params.matrix_k + 255u) / 256u;
  float accumulator = 0.0;
  if (non_transposed) {
    // w batch slice [Kp, N]: the column nibble is fixed per workgroup.
    uint w_base = params.rhs_offset + rhs * w_row_words +
        column / pack_factor;
    uint scale_base = rhs * scale_row_words + column / group_size;
    uint lane_shift = (column % pack_factor) * bits;
    uint param_step = params.matrix_n / group_size;
    for (uint j = 0u; j < k_steps; ++j) {
      uint k = lane + j * 256u;
      if (k < params.matrix_k) {
        uint word = input_w.values[
            w_base + k * (params.matrix_n / pack_factor)];
        uint q = (word >> lane_shift) & value_mask;
        uint group = k / group_size;
        float scale = decode_param((scale_base + group * param_step) *
            param_bytes);
        float bias = 0.0;
#ifndef NO_BIAS
        bias = decode_param(params.shape[1] +
            (scale_base + group * param_step) * param_bytes);
#endif
        accumulator += LOAD_VALUE(input_x.values[x_base + k]) *
            (scale * float(q) + bias);
      }
    }
  } else {
    // w batch slice [N, Kp]: groups along K.
    uint w_base = params.rhs_offset + rhs * w_row_words +
        column * words_per_row;
    uint scale_base = rhs * scale_row_words + column * groups_per_row;
    for (uint j = 0u; j < k_steps; ++j) {
      uint k = lane + j * 256u;
      if (k < params.matrix_k) {
        uint group = k / group_size;
        uint word = input_w.values[w_base + k / pack_factor];
        uint lane_shift = (k - (k / pack_factor) * pack_factor) * bits;
        uint q = (word >> lane_shift) & value_mask;
        float scale = decode_param((scale_base + group) * param_bytes);
        float bias = 0.0;
#ifndef NO_BIAS
        bias = decode_param(params.shape[1] +
            (scale_base + group) * param_bytes);
#endif
        accumulator += LOAD_VALUE(input_x.values[x_base + k]) *
            (scale * float(q) + bias);
      }
    }
  }

  float total = subgroupAdd(accumulator);
  if (gl_SubgroupInvocationID == 0u) {
    subgroup_totals[gl_SubgroupID] = total;
  }
  barrier();
  if (lane == 0u) {
    float sum = 0.0;
    for (uint s = 0u; s < 8u; ++s) {
      sum += subgroup_totals[s];
    }
    output_data.values[params.output_offset + index] = STORE_VALUE(sum);
  }
}
