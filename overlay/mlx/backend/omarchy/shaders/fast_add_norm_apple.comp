//
// Fused residual Add + RMSNorm kernel (bf16 storage), Apple-tree
// reduction. One dispatch replaces the composed
// BinaryVecBF16(Add) -> FastRmsNormAppleBF16 sequence:
//   h          = bf16_store(f32(x) + f32(r))     (exactly binary_vec.comp)
//   res_out    = h
//   norm_out   = bf16(widen(h) * rsqrt(mean(widen(h)^2) + eps) * w)
// Bit-exact to the composed path because every intermediate the composed
// sequence rounds to bf16 is rounded identically here: the add stores the
// RNE-rounded h and the sum of squares accumulates the WIDENED stored
// values, which is exactly what the norm kernel re-reads from memory.
// The float32 reduction order, weight handling, and store rounding are
// copied verbatim from fast_norm_apple.comp (256 threads, per-thread
// contiguous register loads for row_length in {2048, 2560, 4096}, other
// widths stride by 256; 32-lane subgroupAdd + 8 shared partials).
//
// Bindings: 0 = x (add lhs), 1 = w (norm weight), 2 = r (addend), 3 =
// res_out (h), 4 = norm_out. Offsets: lhs_offset = x, rhs_offset = w,
// output_offset = norm_out, aux_offset = r, matrix_m = res_out, eps in
// params.alpha, row count in params.output_size.

#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
// Exact bf16 -> float32 widening of a stored value.
#define WIDEN(x) (uintBitsToFloat(uint(x) << 16u))
#define STORE_VALUE(f) bf16_store(f)

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
  STORAGE_TYPE values[];
} input_data;
layout(set = 0, binding = 1, std430) readonly buffer Weight {
  STORAGE_TYPE values[];
} weight_data;
layout(set = 0, binding = 2, std430) readonly buffer Residual {
  STORAGE_TYPE values[];
} residual_data;
layout(set = 0, binding = 3, std430) writeonly buffer ResOut {
  STORAGE_TYPE values[];
} res_out_data;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
} params;

const uint SIMD = 32u;
const uint MAX_READS = 16u;      // 256 * 8 = 2048, 256 * 10 = 2560 and 256 * 16 = 4096 take the register path
shared float s_partial[8u];        // 8 subgroups -> 8 partial sums

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint sub_id = thread / SIMD;     // 0..7
  uint lane = thread % SIMD;       // 0..31
  uint row_length = params.reduce_size;
  float eps = params.alpha;

  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint x_start = params.lhs_offset + row * row_length;
    uint r_start = params.aux_offset + row * row_length;
    uint res_start = params.matrix_m + row * row_length;

    float reg_h[MAX_READS];
    precise float reg_sq = 0.0;
    uint n_reads = row_length / 256u;
    bool reg_path = (row_length == 2048u || row_length == 2560u || row_length == 4096u);
    if (reg_path) {
      uint base = thread * n_reads;
      for (uint i = 0u; i < 8u; ++i) {
        uint index = base + i;
        precise float sum = LOAD_VALUE(input_data.values[x_start + index]) +
                            LOAD_VALUE(residual_data.values[r_start + index]);
        float h = WIDEN(STORE_VALUE(sum));
        reg_h[i] = h;
        reg_sq += h * h;
        res_out_data.values[res_start + index] = STORE_VALUE(sum);
      }
      if (n_reads == 10u) {
        for (uint i = 8u; i < 10u; ++i) {
          uint index = base + i;
          precise float sum = LOAD_VALUE(input_data.values[x_start + index]) +
                              LOAD_VALUE(residual_data.values[r_start + index]);
          float h = WIDEN(STORE_VALUE(sum));
          reg_h[i] = h;
          reg_sq += h * h;
          res_out_data.values[res_start + index] = STORE_VALUE(sum);
        }
      } else if (n_reads == 16u) {
        for (uint i = 8u; i < 16u; ++i) {
          uint index = base + i;
          precise float sum = LOAD_VALUE(input_data.values[x_start + index]) +
                              LOAD_VALUE(residual_data.values[r_start + index]);
          float h = WIDEN(STORE_VALUE(sum));
          reg_h[i] = h;
          reg_sq += h * h;
          res_out_data.values[res_start + index] = STORE_VALUE(sum);
        }
      }
    } else {
      for (uint index = thread; index < row_length; index += 256u) {
        precise float sum = LOAD_VALUE(input_data.values[x_start + index]) +
                            LOAD_VALUE(residual_data.values[r_start + index]);
        float h = WIDEN(STORE_VALUE(sum));
        reg_sq += h * h;
        res_out_data.values[res_start + index] = STORE_VALUE(sum);
      }
    }

    float sub_partial = subgroupAdd(reg_sq);
    if (lane == 0u) {
      s_partial[sub_id] = sub_partial;
    }
    barrier();
    float total;
    if (sub_id == 0u) {
      float v = (lane < 8u) ? s_partial[lane] : 0.0;
      total = subgroupAdd(v);
      if (lane == 0u) {
        s_partial[0] = total;
      }
    }
    barrier();
    float mean_square = s_partial[0] / float(row_length);
    float norm = inversesqrt(mean_square + eps);

    if (reg_path) {
      uint base = thread * n_reads;
      for (uint i = 0u; i < 8u; ++i) {
        uint index = base + i;
        float weight =
            (params.lhs_size == 1u)
                ? LOAD_VALUE(weight_data.values[params.rhs_offset])
                : LOAD_VALUE(weight_data.values[params.rhs_offset + index]);
        precise float norm_weight = norm * weight;
        precise float result = reg_h[i] * norm_weight;
        output_data.values[params.output_offset + row * row_length + index] =
            STORE_VALUE(result);
      }
      if (n_reads == 10u) {
        for (uint i = 8u; i < 10u; ++i) {
          uint index = base + i;
          float weight =
              (params.lhs_size == 1u)
                  ? LOAD_VALUE(weight_data.values[params.rhs_offset])
                  : LOAD_VALUE(weight_data.values[params.rhs_offset + index]);
          precise float norm_weight = norm * weight;
          precise float result = reg_h[i] * norm_weight;
          output_data.values[params.output_offset + row * row_length + index] =
              STORE_VALUE(result);
        }
      } else if (n_reads == 16u) {
        for (uint i = 8u; i < 16u; ++i) {
          uint index = base + i;
          float weight =
              (params.lhs_size == 1u)
                  ? LOAD_VALUE(weight_data.values[params.rhs_offset])
                  : LOAD_VALUE(weight_data.values[params.rhs_offset + index]);
          precise float norm_weight = norm * weight;
          precise float result = reg_h[i] * norm_weight;
          output_data.values[params.output_offset + row * row_length + index] =
              STORE_VALUE(result);
        }
      }
    } else {
      for (uint index = thread; index < row_length; index += 256u) {
        float value = WIDEN(STORE_VALUE(
            LOAD_VALUE(input_data.values[x_start + index]) +
            LOAD_VALUE(residual_data.values[r_start + index])));
        float weight =
            (params.lhs_size == 1u)
                ? LOAD_VALUE(weight_data.values[params.rhs_offset])
                : LOAD_VALUE(weight_data.values[params.rhs_offset + index]);
        precise float norm_weight = norm * weight;
        precise float result = value * norm_weight;
        output_data.values[params.output_offset + row * row_length + index] =
            STORE_VALUE(result);
      }
    }
    barrier();
  }
}
