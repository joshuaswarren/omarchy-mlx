#version 460

#ifdef USE_COMPLEX64
#define STORAGE_TYPE vec2
#define LOAD_VALUE(x) (x)
#define STORE_VALUE(f) (f)
#elif defined(USE_FP16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif

#ifdef USE_COMPLEX64
#define ACCUM_TYPE vec2
#define ZERO_VALUE vec2(0.0)
#define ACCUMULATE(acc, a, b) \
  acc += vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x)
#else
#define ACCUM_TYPE float
#define ZERO_VALUE 0.0
#define ACCUMULATE(acc, a, b) acc += a * b
#endif

const uint TILE_SIZE = 16u;

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
  STORAGE_TYPE values[];
} input_a;
layout(set = 0, binding = 1, std430) readonly buffer InputB {
  STORAGE_TYPE values[];
} input_b;
layout(set = 0, binding = 2, std430) readonly buffer InputC {
  STORAGE_TYPE values[];
} input_c;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  // Matmul batch routing: dims is the batch axis count, shape[] the
  // batch extents, and in_strides/out_strides[] the per-operand batch
  // strides in elements (0 = broadcast axis).
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
  // Inner-matrix gaps in elements: for the transposed flag the stored
  // column stride, else the stored row stride. Dense operands carry the
  // natural gap (matrix_m / matrix_k / matrix_n by role); a cache slice
  // carries its row gap and consumes no materialization.
  uint lhs_gap;
  uint rhs_gap;
  // Lockstep tail of ComputeParams (mlx compute.h): a shader may
  // declare any prefix of the struct, so these appended fields keep
  // every existing SPIR-V interface byte-identical.
  uint q_rowstride;
  uint k_rowstride;
  uint v_rowstride;
  uint o_rowstride;
  uint q_headstride;
  uint k_headstride;
  uint v_headstride;
  uint q_batchstride;
  uint k_batchstride;
  uint v_batchstride;
  // Windowed-dispatch transport: out_row_stride is the full output row
  // width for windowed matmul-family dispatches (0 = use matrix_n);
  // window_lo is the global first row / element for row- or
  // index-windowed dispatches (0 = unwindowed); window_hi is Take's
  // exclusive row-window bound (0 = unwindowed).
  uint out_row_stride;
  uint window_lo;
  uint window_hi;
} params;

shared ACCUM_TYPE tile_a[16][16];
shared ACCUM_TYPE tile_b[16][16];

void main() {
  uint local_x = gl_LocalInvocationID.x;
  uint local_y = gl_LocalInvocationID.y;
  // Workgroup z is the collapsed batch index. It unravels over shape[]
  // and each operand advances by its own batch strides, so a stride of
  // 0 broadcasts the axis. A dense stack keeps the contiguous strides,
  // which reduces to the plain batch * matrix_size indexing, and dims
  // == 0 (rank 2) leaves both offsets at zero.
  uint batch_index = gl_WorkGroupID.z;
  uint remaining = batch_index;
  uint a_batch = 0u;
  uint b_batch = 0u;
  // Unravel from the last axis so the flat z stays row-major, the same
  // order the output uses.
  for (uint axis = params.dims; axis > 0u; --axis) {
    uint coord = remaining % params.shape[axis - 1u];
    remaining /= params.shape[axis - 1u];
    a_batch += coord * params.in_strides[axis - 1u];
    b_batch += coord * params.out_strides[axis - 1u];
  }
  uint lhs_matrix = params.matrix_m * params.matrix_k;
  uint rhs_matrix = params.matrix_k * params.matrix_n;
  // Windowed dispatches shrink matrix_n to their output-column window
  // and carry the full row width in out_row_stride.
  uint out_row = params.out_row_stride != 0u ? params.out_row_stride
                                             : params.matrix_n;
  uint out_matrix = params.matrix_m * out_row;
  uint tile_rows = params.matrix_m / TILE_SIZE +
      uint(params.matrix_m % TILE_SIZE != 0u);
  uint tile_columns = params.matrix_n / TILE_SIZE +
      uint(params.matrix_n % TILE_SIZE != 0u);
  uint k_tiles = params.matrix_k / TILE_SIZE +
      uint(params.matrix_k % TILE_SIZE != 0u);

  for (uint tile_row = gl_WorkGroupID.y; tile_row < tile_rows;
       tile_row += gl_NumWorkGroups.y) {
    uint row = tile_row * TILE_SIZE + local_y;
    for (uint tile_column = gl_WorkGroupID.x; tile_column < tile_columns;
         tile_column += gl_NumWorkGroups.x) {
      uint column = tile_column * TILE_SIZE + local_x;
      ACCUM_TYPE accumulator = ZERO_VALUE;

      for (uint tile = 0; tile < k_tiles; ++tile) {
        uint a_column = tile * TILE_SIZE + local_x;
        uint b_row = tile * TILE_SIZE + local_y;
        uint a_index = params.lhs_offset + a_batch +
            ((params.flags & 4u) != 0u
                ? a_column * params.lhs_gap + row
                : row * params.lhs_gap + a_column);
        tile_a[local_y][local_x] = row < params.matrix_m &&
                a_column < params.matrix_k
            ? LOAD_VALUE(input_a.values[a_index])
            : ZERO_VALUE;
        uint b_index = params.rhs_offset + b_batch +
            ((params.flags & 1u) != 0u
                ? column * params.rhs_gap + b_row
                : b_row * params.rhs_gap + column);
        tile_b[local_y][local_x] = b_row < params.matrix_k &&
                column < params.matrix_n
            ? LOAD_VALUE(input_b.values[b_index])
            : ZERO_VALUE;
        barrier();

        for (uint index = 0; index < TILE_SIZE; ++index) {
          ACCUMULATE(
              accumulator, tile_a[local_y][index], tile_b[index][local_x]);
        }
        barrier();
      }

      if (row < params.matrix_m && column < params.matrix_n) {
        uint output_index =
            batch_index * out_matrix + row * out_row + column;
        ACCUM_TYPE value = params.alpha * accumulator;
        if ((params.flags & 2u) != 0u) {
          uint c_index = params.aux_size == 1u
              ? 0u
              : output_index % params.aux_size;
          value += params.beta * LOAD_VALUE(
              input_c.values[params.aux_offset + c_index]);
        }
        output_data.values[params.output_offset + output_index] =
            STORE_VALUE(value);
      }
    }
  }
}
