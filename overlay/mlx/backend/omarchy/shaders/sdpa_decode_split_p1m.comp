//
// Single-dispatch split-K bf16 single-query decode SDPA, head width 128 (sdpa_decode_split_p1v.comp + sdpa_decode_split_p2.comp folded together;
// MLX_OMARCHY_SDPA_SPLIT_MERGE). The pass-1 phases are the value-phase variant's: one workgroup per (key-value head, block of 128 keys) scores the
// SPLIT_R query heads that share the key-value head, then stores (D weighted-value floats, block max, block exp sum, two pad floats) per
// (query head, block) — value row first, header last, so the row stays 16-byte aligned.
//
// Instead of a second dispatch, each workgroup then bumps a per-query-head arrival counter in the encoder's persistent
// counter pool (binding 5). The workgroup whose bump makes nblocks merges that head inline: it re-reads the block
// partials through the same coherent buffer, stores the bf16 result, and resets the head's slot to 0 — the pool is
// self-cleaning, so the route is one dispatch per call after the pool's one-time zeroing. No workgroup ever waits on
// another — the merge work just lands on whichever block finishes last — so there is no resident-spin deadlock.
//
// Arithmetic is float32 throughout and the merge folds blocks in the serial order the pre-vectorized
// sdpa_decode_split_p2.comp used; test_sdpa_split.cpp gates the error against a float64 reference and counts
// dispatches.

#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#ifndef SPLIT_R
#define SPLIT_R 4
#endif

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Query {
  uint16_t values[];
} query_data;
layout(set = 0, binding = 1, std430) readonly buffer Key {
  uvec4 values[];
} key_data;
layout(set = 0, binding = 2, std430) readonly buffer Value {
  uvec2 values[];
} value_data;
layout(set = 0, binding = 3, std430) coherent buffer Scratch {
  uint values[];
} scratch_data;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;
layout(set = 0, binding = 5, std430) coherent buffer Done {
  uint values[];
} done_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

const uint D = 128u;
const uint BK = 128u;
const uint SUBGROUPS = 4u;
const uint STRIDE = D + 4u;

shared float s_q[SPLIT_R * D];
shared float s_p[SPLIT_R * BK];
shared float s_max[SPLIT_R * SUBGROUPS];
shared float s_sum[SPLIT_R * SUBGROUPS];
shared float s_o[4u * SPLIT_R * D];
shared uint s_done[SPLIT_R];

float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

void main() {
  uint t = gl_LocalInvocationID.x;
  uint kv_head = gl_WorkGroupID.x;
  uint block = gl_WorkGroupID.y;
  uint k_len = params.matrix_k;
  uint nblocks = (k_len + BK - 1u) / BK;
  uint sg = gl_SubgroupID;

  for (uint r = 0u; r < SPLIT_R; ++r) {
    uint head = kv_head * SPLIT_R + r;
    s_q[r * D + t] = params.alpha * bf16_load(
        query_data.values[params.lhs_offset + head * params.shape[0] + t * params.shape[3]]);
  }
  barrier();

  uint key = block * BK + t;
  bool valid = key < k_len;
  float score[SPLIT_R];
  for (uint r = 0u; r < SPLIT_R; ++r) {
    score[r] = 0.0;
  }
  if (valid) {
    uint k_base = (params.rhs_offset + kv_head * params.shape[1] + key * params.shape[2]) >> 3u;
    for (uint c = 0u; c < D / 8u; ++c) {
      uvec4 w = key_data.values[k_base + c];
      float kf[8];
      kf[0] = uintBitsToFloat(w.x << 16u);
      kf[1] = uintBitsToFloat(w.x & 0xffff0000u);
      kf[2] = uintBitsToFloat(w.y << 16u);
      kf[3] = uintBitsToFloat(w.y & 0xffff0000u);
      kf[4] = uintBitsToFloat(w.z << 16u);
      kf[5] = uintBitsToFloat(w.z & 0xffff0000u);
      kf[6] = uintBitsToFloat(w.w << 16u);
      kf[7] = uintBitsToFloat(w.w & 0xffff0000u);
      for (uint r = 0u; r < SPLIT_R; ++r) {
        for (uint i = 0u; i < 8u; ++i) {
          score[r] += s_q[r * D + c * 8u + i] * kf[i];
        }
      }
    }
  } else {
    for (uint r = 0u; r < SPLIT_R; ++r) {
      score[r] = uintBitsToFloat(0xff800000u);
    }
  }

  for (uint r = 0u; r < SPLIT_R; ++r) {
    float m = subgroupMax(score[r]);
    if (gl_SubgroupInvocationID == 0u) {
      s_max[r * SUBGROUPS + sg] = m;
    }
  }
  barrier();
  float block_max[SPLIT_R];
  for (uint r = 0u; r < SPLIT_R; ++r) {
    float m = max(max(s_max[r * SUBGROUPS], s_max[r * SUBGROUPS + 1u]),
        max(s_max[r * SUBGROUPS + 2u], s_max[r * SUBGROUPS + 3u]));
    block_max[r] = m;
    float p = valid ? exp(score[r] - m) : 0.0;
    s_p[r * BK + t] = p;
    float ps = subgroupAdd(p);
    if (gl_SubgroupInvocationID == 0u) {
      s_sum[r * SUBGROUPS + sg] = ps;
    }
  }
  barrier();

  uint nk = min(BK, k_len - block * BK);
  uint v_stride = params.in_strides[2];
  uint dg = t & 31u;
  uint part = t >> 5u;
  uint kstart = part * 32u;
  uint kend = min(nk, kstart + 32u);
  uint v_row0 = params.aux_offset + kv_head * params.in_strides[1] + block * BK * v_stride + dg * 4u;
  float o[SPLIT_R * 4];
  for (uint i = 0u; i < SPLIT_R * 4u; ++i) {
    o[i] = 0.0;
  }
  uint key0 = kstart;
  for (; key0 + 8u <= kend; key0 += 8u) {
    uvec2 w[8];
    for (uint i = 0u; i < 8u; ++i) {
      w[i] = value_data.values[(v_row0 + (key0 + i) * v_stride) >> 2u];
    }
    for (uint i = 0u; i < 8u; ++i) {
      float v0 = uintBitsToFloat(w[i].x << 16u);
      float v1 = uintBitsToFloat(w[i].x & 0xffff0000u);
      float v2 = uintBitsToFloat(w[i].y << 16u);
      float v3 = uintBitsToFloat(w[i].y & 0xffff0000u);
      for (uint r = 0u; r < SPLIT_R; ++r) {
        float p = s_p[r * BK + key0 + i];
        o[r * 4u + 0u] += p * v0;
        o[r * 4u + 1u] += p * v1;
        o[r * 4u + 2u] += p * v2;
        o[r * 4u + 3u] += p * v3;
      }
    }
  }
  for (; key0 < kend; ++key0) {
    uvec2 w = value_data.values[(v_row0 + key0 * v_stride) >> 2u];
    float v0 = uintBitsToFloat(w.x << 16u);
    float v1 = uintBitsToFloat(w.x & 0xffff0000u);
    float v2 = uintBitsToFloat(w.y << 16u);
    float v3 = uintBitsToFloat(w.y & 0xffff0000u);
    for (uint r = 0u; r < SPLIT_R; ++r) {
      float p = s_p[r * BK + key0];
      o[r * 4u + 0u] += p * v0;
      o[r * 4u + 1u] += p * v1;
      o[r * 4u + 2u] += p * v2;
      o[r * 4u + 3u] += p * v3;
    }
  }
  for (uint r = 0u; r < SPLIT_R; ++r) {
    for (uint i = 0u; i < 4u; ++i) {
      s_o[(part * SPLIT_R + r) * D + dg * 4u + i] = o[r * 4u + i];
    }
  }
  barrier();

  for (uint r = 0u; r < SPLIT_R; ++r) {
    uint head = kv_head * SPLIT_R + r;
    uint base = (head * nblocks + block) * STRIDE;
    if (t == 0u) {
      // Atomic stores: the finisher workgroup reads these words, and a plain
      // coherent store can sit posted until this workgroup drains — an
      // atomic exchange lands at the memory point immediately.
      atomicExchange(scratch_data.values[base + D], floatBitsToUint(block_max[r]));
      atomicExchange(scratch_data.values[base + D + 1u], floatBitsToUint(
          s_sum[r * SUBGROUPS] + s_sum[r * SUBGROUPS + 1u] +
          s_sum[r * SUBGROUPS + 2u] + s_sum[r * SUBGROUPS + 3u]));
    }
    float total = s_o[r * D + t] + s_o[(SPLIT_R + r) * D + t] +
        s_o[(2u * SPLIT_R + r) * D + t] + s_o[(3u * SPLIT_R + r) * D + t];
    atomicExchange(scratch_data.values[base + t], floatBitsToUint(total));
  }
  // Arrival count, then the last block's workgroup merges the head inline. Each head owns two pool words: a publish
  // count (word 1) bumped after the workgroup's scratch stores clear the release barrier, and an arrival count (word 0)
  // that names the finisher. The finisher spins on the publish count before reading: the arrival atomic only orders
  // the bump, so without the second handshake the merge can reach scratch before a sibling workgroup's posted stores
  // land in shared memory — the failure this handshake removes.
  barrier();
  memoryBarrierBuffer();
  for (uint r = 0u; r < SPLIT_R; ++r) {
    if (t == 0u) {
      uint head = kv_head * SPLIT_R + r;
      atomicAdd(done_data.values[head * 2u + 1u], 1u);
      s_done[r] = atomicAdd(done_data.values[head * 2u], 1u) + 1u;
    }
  }
  barrier();
  uint out_head = params.out_strides[0] != 0u ? params.out_strides[0] : D;
  for (uint r = 0u; r < SPLIT_R; ++r) {
    if (s_done[r] != nblocks) {
      continue;
    }
    uint head = kv_head * SPLIT_R + r;
    if (t == 0u) {
      // Bounded spin: every earlier workgroup's publish bump follows its scratch stores' release barrier, so reaching
      // nblocks publishes their stores to the merge reads below. A missed bound means the device cannot order
      // intra-dispatch traffic at all; merging anyway is no worse than the pre-handshake form.
      for (uint spins = 0u;
           atomicOr(done_data.values[head * 2u + 1u], 0u) < nblocks && spins < 0x400000u;
           ++spins) {}
      // All nblocks arrivals landed (the atomic read says so) and no other workgroup ever writes this slot again this
      // dispatch, so the finisher alone puts both words back to zero; the next dispatch's pipeline barrier publishes it.
      done_data.values[head * 2u] = 0u;
      done_data.values[head * 2u + 1u] = 0u;
    }
    memoryBarrierBuffer();
    barrier();
    uint hbase = head * nblocks * STRIDE;
    float global_max = uintBitsToFloat(0xff800000u);
    for (uint b = 0u; b < nblocks; ++b) {
      float m = uintBitsToFloat(atomicOr(scratch_data.values[hbase + b * STRIDE + D], 0u));
      if (isnan(m) || m > global_max) {
        global_max = m;
      }
    }
    float denominator = 0.0;
    float acc = 0.0;
    for (uint b = 0u; b < nblocks; ++b) {
      uint at = hbase + b * STRIDE;
      float w = exp(uintBitsToFloat(atomicOr(scratch_data.values[at + D], 0u)) - global_max);
      denominator += uintBitsToFloat(atomicOr(scratch_data.values[at + D + 1u], 0u)) * w;
      acc += uintBitsToFloat(atomicOr(scratch_data.values[at + t], 0u)) * w;
    }
    output_data.values[params.output_offset + head * out_head + t] =
        bf16_store(acc / denominator);
  }
}
