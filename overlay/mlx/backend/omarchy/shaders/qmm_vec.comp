// bf16 round-to-nearest-even on the f32 register value, the same
// constant-shift form fast_rope_norm.comp calls rope_round.
float epi_rope_round(float value) {
  uint bits = floatBitsToUint(value);
  uint rounded = isnan(value)
      ? ((bits >> 16u) | 0x40u)
      : ((bits + 0x7fffu + ((bits >> 16u) & 1u)) >> 16u);
  return uintBitsToFloat(rounded << 16u);
