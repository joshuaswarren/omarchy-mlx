#version 460
#extension GL_GOOGLE_include_directive : require

// Fused matrix-vector path for QuantizedMatmul when x is a single row:
// out[1, n] = x[1, k] @ dequant(w) with w packed uint32 words holding
// 32/bits affine values along the packed axis in the low bits first
// (bits 2/4/8) or lane-atomic little-endian byte packs of 8/3, 8/5,
// or 4/3 bytes (bits 3/5/6), one affine scale and bias per group_size
// elements; with -DFP_MODE the fp modes instead (fp4 e2m1 / fp8 e4m3
// element bytes, one scale byte per group, no bias). Decode is this
// shape on every layer, and the general kernel serializes it: one
// thread per output column walks the whole row serially, so its
// 32-lane reads sit words-per-row*4 bytes apart - every lane a
// separate cache line. Here each of the workgroup's 32-lane subgroups
// owns one weight row (ROWS_PER_SLOT consecutive rows in the packed-x
// subgroup builds) and lanes stride single k steps, so consecutive lanes
// read consecutive x elements, consecutive weight-row words, and one
// shared cache line of row bytes per step.
// Dequantization happens in registers inside the dot product - no
// dequantized intermediate tensor, no extra pass over memory, one
// dispatch.
//
// Two reduction flavors compile from this same source via -DUSE_SUBGROUP:
//   * default: five-round workgroup-shared tree (correct on any
//     subgroup size; lane split is plain workgroup arithmetic). The
//     five barrier rounds are the cost.
//   * USE_SUBGROUP=1: one subgroupAdd(accumulator) per 32-lane slot
//     (Honeykrisp's actual subgroupSize). Trades the barriers for the
//     hardware reduction; the bench (tools/subgroup-bench) decides
//     whether the trade pays on this device. Dispatch is gated on
//     caps.subgroup_size == 32 and the ARITHMETIC subgroup-feature bit,
//     so a device that lacks either falls back to the tree path
//     unchanged.
// Both flavors pair lanes stride 1 first, then 2, 4, 8, 16. That is the
// order native Metal simd_sum reduces in, and Honeykrisp's 32-bit float
// subgroupAdd is the same hardware reduction (agx_nir_lower_subgroups
// leaves it unlowered) and measured that pairing bit for bit, so the Q4
// word path below is bit-identical to native qmv
// (receipts/2026-09-09-q4-gemv-order). subgroupShuffleXor is not used:
// Honeykrisp emulates arbitrary shuffles with four read_invocation
// selects per step.
//
// QMM_VEC_Q4_WORD compiles the transposed affine 4-bit/group-64 decode
// path in native qmv arithmetic: one lane owns one packed word per
// block, loads scale and bias once, and applies all eight nibbles with
// constant shifts.

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif
#ifdef USE_SUBGROUP
// The subgroup reduction variant assumes subgroupSize == 32, gated in
// dispatch (see QuantizedMatmul::eval_gpu). The kernel does not check
// this itself because Vulkan does not let compute shaders query
// subgroupSize at runtime. Compiling this on a device with a different
// subgroup size produces a wrong sum, so the dispatch gate is the
// load-bearing part of this codepath.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif
#include "omarchy_half.h"
#if defined(QMM_VEC_ROPE_EPI)
#include "omarchy_trig.h"
#endif
#if defined(FP_MODE) && defined(QMM_VEC_Q4_WORD)
#error "QMM_VEC_Q4_WORD applies to affine quantization only"
#endif
#if defined(QMM_VEC_GREEDY) && (!defined(USE_BF16) || \
    !defined(USE_SUBGROUP) || !defined(QMM_VEC_Q4_WORD) || \
    defined(QMM_VEC_MULTI))
#error "QMM_VEC_GREEDY builds on the bf16 subgroup Q4 word column"
#endif
#if defined(QMM_VEC_OUTGATE) && \
    (!defined(USE_BF16) || !defined(USE_SUBGROUP) || \
     (!defined(QMM_VEC_MULTI) && !defined(QMM_VEC_RESNORM)))
#error "QMM_VEC_OUTGATE builds on the bf16 subgroup multi or resnorm column"
#endif
#if defined(QMM_VEC_RESNORM) && !defined(QMM_VEC_TOKENS) && \
    (!defined(USE_BF16) || !defined(USE_SUBGROUP) || \
     !defined(QMM_VEC_Q4_WORD) || defined(QMM_VEC_MULTI) || \
     defined(QMM_VEC_SWIGLU) || \
     defined(QMM_VEC_BATCH) || defined(QMM_VEC_ROWS) || \
     defined(QMM_VEC_GREEDY) || \
     ROWS_PER_SLOT != 2 || SLOTS_PER_GROUP < 8)
#error "QMM_VEC_RESNORM builds on bf16 subgroup Q4 word 2-row >=8-slot single weight"
#endif
#if defined(QMM_VEC_SWIGLU) && \
    (!defined(USE_BF16) || !defined(USE_SUBGROUP) || \
     !defined(QMM_VEC_Q4_WORD) || defined(QMM_VEC_MULTI) || \
     defined(QMM_VEC_RESNORM) || defined(QMM_VEC_OUTGATE) || \
     defined(QMM_VEC_BATCH) || defined(QMM_VEC_ROWS) || \
     defined(QMM_VEC_TOKENS) || defined(QMM_VEC_GREEDY))
#error "QMM_VEC_SWIGLU builds on bf16 subgroup Q4 word"
#endif
#if defined(QMM_VEC_RESNORM) && defined(QMM_VEC_TOKENS) && \
    (!defined(USE_BF16) || !defined(USE_SUBGROUP) || \
     !defined(QMM_VEC_Q4_WORD) || !defined(QMM_VEC_MULTI) || \
     !defined(M_TOKENS))
#error "QMM_VEC_RESNORM on the token column builds on the bf16 subgroup multi-token variant"
#endif
#if defined(QMM_VEC_ROPE_EPI)
#if !defined(USE_BF16) || !defined(USE_SUBGROUP) || \
    !defined(QMM_VEC_Q4_WORD) || defined(QMM_VEC_RESNORM)
#error "QMM_VEC_ROPE_EPI builds on the bf16 subgroup Q4 word column without resnorm"
#endif
#if defined(QMM_VEC_MULTI) && \
    (!defined(QMM_VEC_TOKENS) || !defined(M_TOKENS))
#error "QMM_VEC_ROPE_EPI multi builds on the token variant"
#endif
#if !defined(QMM_VEC_MULTI) && !defined(QMM_VEC_ROWS)
#error "QMM_VEC_ROPE_EPI needs the multi-token or single-weight rows base"
#endif

#endif

// Decode geometry: SLOTS_PER_GROUP 32-lane slots per workgroup, each slot
// owning ROWS_PER_SLOT consecutive output rows (native qmv_fast keeps four
// rows per simdgroup: the x quads load once per block and feed every row,
// and the row loads sit independent in flight). ROWS_PER_SLOT > 1 needs the
// packed x view (f16/bf16) and the subgroup reduction; the per-row
// arithmetic order is the single-row chain, so results stay bit-identical.
#ifndef ROWS_PER_SLOT
#define ROWS_PER_SLOT 1
#endif
#ifndef SLOTS_PER_GROUP
#define SLOTS_PER_GROUP 8
#endif
#if ROWS_PER_SLOT != 1 && !defined(QMM_VEC_TOKENS) && \
    (!defined(USE_SUBGROUP) || !(defined(USE_FP16) || defined(USE_BF16)))
#error "ROWS_PER_SLOT > 1 needs USE_SUBGROUP and a packed x view"
#endif
#if defined(QMM_VEC_TOKENS) && \
    (ROWS_PER_SLOT != 2 || !defined(USE_BF16) || !defined(QMM_VEC_Q4_WORD))
#error "QMM_VEC_TOKENS builds on the bf16 packed-x multi column"
#endif
#if defined(QMM_VEC_BATCH) && \
    (ROWS_PER_SLOT != 2 || !defined(USE_BF16) || !defined(QMM_VEC_Q4_WORD) || \
     defined(QMM_VEC_MULTI))
#error "QMM_VEC_BATCH builds on the bf16 packed-x single-weight column"
#endif
#if defined(QMM_VEC_ROWS) && \
    (ROWS_PER_SLOT != 2 || !defined(USE_BF16) || !defined(QMM_VEC_Q4_WORD) || \
     defined(QMM_VEC_MULTI))
#error "QMM_VEC_ROWS builds on the bf16 packed-x single-weight column"
#endif
#if !defined(USE_SUBGROUP) && SLOTS_PER_GROUP != 8
#error "the tree reduction assumes 8 slots"
#endif
// The x fetch inside Q4_WORD / Q4_ROWS: the out-gate prologue variant
// (QMM_VEC_OUTGATE, multi-only) transforms the two prologue vectors
// instead of reading the product; every other variant reads input_x.
#if defined(QMM_VEC_OUTGATE)
#define OUTGATE_XWORDS(x_base) outgate_quad((x_base) / 8u)
#define OUTGATE_XQUAD(q_idx) outgate_quad(q_idx)
#else
#define OUTGATE_XWORDS(x_base) input_x.values[(x_base) / 8u]
#define OUTGATE_XQUAD(q_idx) input_x.values[q_idx]
#endif
#ifdef QMM_W2
// uvec2 weight words: the fast tile's adjacent w/w+1 pair rides one load.
#define WVEC_T uvec2
#define WLOAD(W, I) (W.values[(I) >> 1u][(I) & 1u])
#define WLOAD_PAIR(W, I, A, B) { \
  uvec2 wv_ = W.values[(I) / 2u]; (A) = wv_.x; (B) = wv_.y; }
#else
#define WVEC_T uint
#define WLOAD(W, I) W.values[I]
#define WLOAD_PAIR(W, I, A, B) { (A) = WLOAD(W, I); (B) = WLOAD(W, (I) + 1u); }
#endif

// K-contiguous (experimental only, NOT bit-identical to the strided path at
// K >= 1024 and excluded from every default selection): each lane owns one
// contiguous chunk of words instead of strided pairs, which changes the FP32
// per-lane accumulation order before subgroupAdd (+/-1 bf16 ULP at
// Q4_FAST_ITERS >= 2). Preserving strided summation order from a contiguous
// per-lane walk would require buffering/transposing terms across lanes (offset
// 64 words = 512 elements between strided terms), erasing the memory gain.
#ifdef QMM_KCONT
#define Q4_FAST_ITERS(wpr) ((wpr) / (LANES * 2u))
#define Q4_FAST_W(it, wpr) (lane_in_slot * ((wpr) / LANES) + (it) * 2u)
#define Q4_KCONT_OK(wpr) ((wpr) % (LANES * 2u) == 0u)
#else
#define Q4_FAST_ITERS(wpr) (((wpr) + LANES * 2u - 1u) / (LANES * 2u))
#define Q4_FAST_W(it, wpr) (lane_in_slot * 2u + (it) * LANES * 2u)
#define Q4_KCONT_OK(wpr) true
#endif
const uint COLUMNS_PER_GROUP = uint(SLOTS_PER_GROUP * ROWS_PER_SLOT);
// Slot width. The device default is 32; QMM_LANES=16 builds pair with a
// requiredSubgroupSize=16 pipeline (parts whose size-control range
// admits 16, e.g. ANV/Xe2). Every slot walk and reduction is written in
// LANES, so only this constant and the workgroup size change.
#ifndef QMM_LANES
#define QMM_LANES 32
#endif
#if QMM_LANES != 16 && QMM_LANES != 32
#error "QMM_LANES must be 16 or 32"
#endif
const uint LANES = uint(QMM_LANES);

layout(local_size_x = SLOTS_PER_GROUP * QMM_LANES) in;

#if (defined(USE_FP16) || defined(USE_BF16)) && defined(QMM_VEC_Q4_WORD)
// Decode x rows are 16-byte aligned by dispatch. Reading eight packed halves
// at once keeps native's half arithmetic while avoiding eight scalar loads.
layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uvec4 values[];
} input_x;
#else
layout(set = 0, binding = 0, std430) readonly buffer InputX {
  STORAGE_TYPE values[];
} input_x;
#endif
#ifdef QMM_VEC_MULTI
#ifndef QMM_VEC_Q4_WORD
#error "QMM_VEC_MULTI builds on QMM_VEC_Q4_WORD"
#endif
// Multi-weight decode dispatch: up to four transposed 4-bit/group-64
// weights against one x row in one dispatch, each with its own
// scale/bias/output triple and an optional fused Add epilogue
// (sum = out + addend, the elementwise Add's float add and storage
// rounding). Workgroups are laid out weight after weight; shape[i]
// carries weight i's N, dims the weight count, flags bit 8+i the
// epilogue for weight i. Every weight, scale, bias, output, and addend
// starts at element 0 of its buffer (the host refuses otherwise), so no
// per-weight offsets ride in the push constants — except a weight's sum
// store under the direct-KV flag (bit 12+i), which the host may aim at
// one token row of a KV cache copy: out_strides[i] base element,
// in_strides[i] the row gap, matrix_m the head dim. Dual-write strided
// outputs (bits 20+i, host refuses them together with the KV window):
// the member's output store lands at out_strides[i] + column inside a
// whole parent buffer the member's binding aliases; unflagged members
// store at column exactly as before.
// The token-route residual+norm epilogue reads Sum0 back inside the same
// dispatch (the last finishing workgroup norms the materialized sum), so
// that variant upgrades every Sum slot to coherent; all other multi
// builds keep the writeonly store contract.
#if defined(QMM_VEC_TOKENS) && \
    (defined(QMM_VEC_RESNORM) || defined(QMM_VEC_ROPE_EPI))
#define QMM_VEC_SUM_ACCESS coherent
#else
#define QMM_VEC_SUM_ACCESS writeonly
#endif
#if defined(QMM_VEC_TOKENS) && defined(QMM_VEC_ROPE_EPI)
// The fused-norm rope epilogue reads the Q/K members' materialized
// outputs back inside the same dispatch, so their stores upgrade to
// coherent like the resnorm variant's Sum slot. Measured on the M1 Max:
// an unqualified decl produces stale reads (wrong ids) — coherent is
// load-bearing for cross-workgroup visibility on this stack.
#define QMM_VEC_OUTPUT_ACCESS coherent
#else
#define QMM_VEC_OUTPUT_ACCESS writeonly
#endif
#define QMM_VEC_MULTI_WEIGHT(I, B) \
layout(set = 0, binding = B, std430) readonly buffer InputW##I { \
  WVEC_T values[]; \
} input_w##I; \
layout(set = 0, binding = B + 1, std430) readonly buffer Scales##I { \
  STORAGE_TYPE values[]; \
} scales##I; \
layout(set = 0, binding = B + 2, std430) readonly buffer Biases##I { \
  STORAGE_TYPE values[]; \
} biases##I; \
layout(set = 0, binding = B + 3, std430) QMM_VEC_OUTPUT_ACCESS buffer Output##I { \
  STORAGE_TYPE values[]; \
} output##I; \
layout(set = 0, binding = B + 4, std430) readonly buffer Addend##I { \
  STORAGE_TYPE values[]; \
} addend##I; \
layout(set = 0, binding = B + 5, std430) QMM_VEC_SUM_ACCESS buffer Sum##I { \
  STORAGE_TYPE values[]; \
} sum##I;
QMM_VEC_MULTI_WEIGHT(0, 1)
QMM_VEC_MULTI_WEIGHT(1, 7)
QMM_VEC_MULTI_WEIGHT(2, 13)
QMM_VEC_MULTI_WEIGHT(3, 19)
#if defined(QMM_VEC_TOKENS) && defined(QMM_VEC_RESNORM)
// Token residual+norm epilogue: single-member groups only (weights 1..3
// stay filler-bound), so the norm weight/output and the last-workgroup
// ticket ride the free slots above binding 24.
layout(set = 0, binding = 25, std430) readonly buffer NormWeight {
  STORAGE_TYPE values[];
} norm_weight;
layout(set = 0, binding = 26, std430) writeonly buffer NormOutput {
  STORAGE_TYPE values[];
} norm_output;
layout(set = 0, binding = 27, std430) coherent buffer Ticket {
  uint done;
} ticket;
shared uint s_resnorm_is_last;
shared float s_resnorm_partial[8u];
#endif
#if defined(QMM_VEC_TOKENS) && defined(QMM_VEC_ROPE_EPI)
// Fused RMSNorm+RoPE epilogue on a <=3-member token group: member 3's
// weight slots are repurposed (the host refuses 4-member rope-epi
// groups) — input_w3 carries the scalar position offset, scales3 and
// biases3 the per-side norm weights, output3 the query rope output,
// and sum3 the producer-direct keys window. The ticket rides binding
// 25 the same way the resnorm variant's does.
layout(set = 0, binding = 25, std430) coherent buffer Ticket {
  uint values[];
} ticket;
shared uint s_rope_is_last;
// epi_rounded is epi_block: the reduce tree's row sum is consumed
// into |norm| before the rounded pass overwrites the same range, so
// one 2KB scratch serves both (occupancy cost measured on the M1 Max:
// +4KB static shared slowed the member-dot ~2ms/30-step).
shared float epi_block[512u];
float epi_member_load(uint member, uint index) {
  if (member == 0u) {
    return LOAD_VALUE(output0.values[index]);
  }
  if (member == 1u) {
    return LOAD_VALUE(output1.values[index]);
  }
  return LOAD_VALUE(output2.values[index]);
}
float epi_weight_load(uint side, uint index) {
  return side == 0u ? LOAD_VALUE(scales3.values[index])
                    : LOAD_VALUE(biases3.values[index]);
}
// bf16 round-to-nearest-even on the f32 register value, the same
// constant-shift form fast_rope_norm.comp calls rope_round.
float epi_rope_round(float value) {
  uint bits = floatBitsToUint(value);
  uint rounded = isnan(value)
      ? ((bits >> 16u) | 0x40u)
      : ((bits + 0x7fffu + ((bits >> 16u) & 1u)) >> 16u);
  return uintBitsToFloat(rounded << 16u);
}
#endif
#if defined(QMM_VEC_OUTGATE)
// Out-gate prologue (flags bit 17): x = out * bf16(sigmoid(gate)), the
// exact arithmetic and rounding of the two elementwise kernels the
// prologue deletes (unary_vec.comp / elementwise.comp: float math on
// the widened operand, one round to storage per kernel boundary —
// sig_b = bf16(1/(1+exp(-g))), m = bf16(o * sig_b), both bf16_store
// RNE). Every workgroup recomputes the full product from the same two
// read-only vectors and gets identical bits; workgroup 0 stores the
// materialized product so retained references to the deleted
// Multiply's output stay valid (bindings 25-27; the vectors start at
// element 0 — the host refuses otherwise).
layout(set = 0, binding = 25, std430) readonly buffer OutgateOut {
  uvec4 values[];
} outgate_out;
layout(set = 0, binding = 26, std430) readonly buffer OutgateGate {
  uvec4 values[];
} outgate_gate;
layout(set = 0, binding = 27, std430) writeonly buffer OutgateMul {
  uvec4 values[];
} outgate_mul;
#endif
#elif defined(QMM_VEC_RESNORM)
// Single-weight Q4 word GEMV + Add epilogue + last-workgroup Apple
// RMSNorm: bindings 0..9 (and 10..12 under QMM_VEC_OUTGATE). Sum0 carries
// the residual sum so other consumers still read a materialized buffer,
// and coherent atomic Ticket selects the last finishing workgroup to run
// the 256-thread row norm once without an inter-dispatch barrier.
layout(set = 0, binding = 1, std430) readonly buffer InputW0 {
  WVEC_T values[];
} input_w0;
layout(set = 0, binding = 2, std430) readonly buffer Scales0 {
  STORAGE_TYPE values[];
} scales0;
layout(set = 0, binding = 3, std430) readonly buffer Biases0 {
  STORAGE_TYPE values[];
} biases0;
#if defined(QMM_RESNORM_PACK32)
layout(set = 0, binding = 4, std430) writeonly buffer Output0U32 {
  uint values[];
} output0_u32;
layout(set = 0, binding = 5, std430) readonly buffer Addend0U32 {
  uint values[];
} addend0_u32;
layout(set = 0, binding = 6, std430) coherent buffer Sum0U32 {
  uint values[];
} sum0_u32;
#else
layout(set = 0, binding = 4, std430) writeonly buffer Output0 {
  STORAGE_TYPE values[];
} output0;
layout(set = 0, binding = 5, std430) readonly buffer Addend0 {
  STORAGE_TYPE values[];
} addend0;
layout(set = 0, binding = 6, std430) coherent buffer Sum0 {
  STORAGE_TYPE values[];
} sum0;
#endif
layout(set = 0, binding = 7, std430) readonly buffer NormWeight {
  STORAGE_TYPE values[];
} norm_weight;
layout(set = 0, binding = 8, std430) writeonly buffer NormOutput {
  STORAGE_TYPE values[];
} norm_output;
layout(set = 0, binding = 9, std430) coherent buffer Ticket {
  uint done;
} ticket;
#if defined(QMM_RESNORM_VEC4) && !defined(QMM_VEC_OUTGATE)
// 128-bit uvec4 aliases (8 bf16 elements/lane) for coalesced RMSNorm epilogue
// on row_length == 2048 or 4096. Host binds the exact same backing buffers as
// bindings 6, 7, 8 (sum0, norm_weight, norm_output).
layout(set = 0, binding = 10, std430) readonly coherent buffer Sum0V4 {
  uvec4 values[];
} sum0_v4;
layout(set = 0, binding = 11, std430) readonly buffer NormWeightV4 {
  uvec4 values[];
} norm_weight_v4;
layout(set = 0, binding = 12, std430) writeonly buffer NormOutputV4 {
  uvec4 values[];
} norm_output_v4;
#endif
#if defined(QMM_RESNORM_VEC)
layout(set = 0, binding = 10, std430) readonly coherent buffer Sum0Vec4 {
  uvec4 values[];
} sum0_v4;
layout(set = 0, binding = 11, std430) writeonly buffer NormOutputU32 {
  uint values[];
} norm_output_u32;
shared uint s_resnorm_sum[2048u];
#endif
#if defined(QMM_VEC_OUTGATE)
layout(set = 0, binding = 10, std430) readonly buffer OutgateOut {
  uvec4 values[];
} outgate_out;
layout(set = 0, binding = 11, std430) readonly buffer OutgateGate {
  uvec4 values[];
} outgate_gate;
layout(set = 0, binding = 12, std430) writeonly buffer OutgateMul {
  uvec4 values[];
} outgate_mul;
#endif
shared uint s_resnorm_is_last;
shared float s_resnorm_partial[8u];
#elif defined(QMM_VEC_SWIGLU)
// Dedicated 1-pass interleaved SwiGLU decode kernel (gate + up sharing one X
// stream per K step, 8 bindings total). Bit-identical to QMM_VEC_MULTI's
// SwiGLU fold: same Q4_ROWS quad chain, subgroupAdd order, and bf16 rounding.
layout(set = 0, binding = 1, std430) readonly buffer InputW0 {
  WVEC_T values[];
} input_w0;
layout(set = 0, binding = 2, std430) readonly buffer Scales0 {
  STORAGE_TYPE values[];
} scales0;
layout(set = 0, binding = 3, std430) readonly buffer Biases0 {
  STORAGE_TYPE values[];
} biases0;
layout(set = 0, binding = 4, std430) readonly buffer InputW1 {
  WVEC_T values[];
} input_w1;
layout(set = 0, binding = 5, std430) readonly buffer Scales1 {
  STORAGE_TYPE values[];
} scales1;
layout(set = 0, binding = 6, std430) readonly buffer Biases1 {
  STORAGE_TYPE values[];
} biases1;
layout(set = 0, binding = 7, std430) writeonly buffer Output0 {
  STORAGE_TYPE values[];
} output0;
#else
layout(set = 0, binding = 1, std430) readonly buffer InputW {
#if defined(QMM_VEC_Q4_WORD) && \
    (!defined(QMM_VEC_GREEDY) || defined(QMM_VEC_GREEDY_WORD))
  WVEC_T values[];
#else
  uint values[];
#endif
} input_w;
#ifdef FP_MODE
// Scale bytes addressed through the word view; no bias term.
layout(set = 0, binding = 2, std430) readonly buffer ScaleBias {
  uint values[];
} scale_bias;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
#else
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  STORAGE_TYPE values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  STORAGE_TYPE values[];
} biases;
#ifdef QMM_VEC_GREEDY
// Greedy-argmax head (see the QMM_VEC_GREEDY main): top-bit plane, the
// token, scratch (state words, per-row bounds, survivor rows, row
// values), and the two stats words.
layout(set = 0, binding = 4, std430) readonly buffer Plane {
  uint values[];
} plane;
layout(set = 0, binding = 5, std430) writeonly buffer Token {
  uint values[];
} token;
// coherent on the fused-path traffic: stages 8-10 let one workgroup
// consume another workgroup's atomic counters and survivor rows inside
