// rt over the rows of one [R, K] activation (x_row strided by matrix_k, the
// same layout as the batch slices above) instead of bt over batch slices.
// Per row the chain is Q4_ROWS_BATCH_ROW exactly, so each row matches the
// single-row main bit for bit.
#define Q4_ROWS_ROW(w, X_WORDS) { \
  uint x_row = params.lhs_offset + rt * params.matrix_k; \
  precise float dot[ROWS_PER_SLOT]; \
  precise float input_sum = 0.0; \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    dot[r] = 0.0; \
  } \
  X_WORDS \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    precise float bias_term = input_sum * bias_r[r]; \
    acc[rt][r] += fma(scale_r[r], dot[r], bias_term); \
  } \
}
#define Q4_ROWS_ROWS(W, S, B) { \
  uint row_base[ROWS_PER_SLOT]; \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    row_base[r] = min(column + r, n - 1u); \
  } \
  if (params.matrix_k % 512u == 0u && n % 8u == 0u) { \
    for (uint w = lane_in_slot * 2u; w < words_per_row; \
         w += LANES * 2u) { \
      uint wa[ROWS_PER_SLOT]; \
      uint wb[ROWS_PER_SLOT]; \
      for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
        WLOAD_PAIR( \
            W, w_base + row_base[r] * words_per_row + w, wa[r], wb[r]) \
      } \
      Q4_ROWS_BATCH_PARAMS(w, S, B) \
      for (uint rt = 0u; rt < uint(QMM_VEC_ROWS); ++rt) { \
        if (rt < rows) { \
          Q4_ROWS_ROW(w, \
            uvec4 xa = OUTGATE_XWORDS(x_row + w * 8u); \
            uvec4 xb = OUTGATE_XWORDS(x_row + w * 8u + 8u); \
            Q4_QUAD_ROWS(wa[r], xa.x, xa.y) \
            Q4_QUAD_ROWS(wa[r] >> 16u, xa.z, xa.w) \
            Q4_QUAD_ROWS(wb[r], xb.x, xb.y) \
            Q4_QUAD_ROWS(wb[r] >> 16u, xb.z, xb.w)) \
        } \
      } \
    } \
  } else { \
    for (uint w = lane_in_slot; w < words_per_row; w += LANES) { \
      uint wa[ROWS_PER_SLOT]; \
      for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
        wa[r] = WLOAD(W, w_base + row_base[r] * words_per_row + w); \
      } \
      Q4_ROWS_BATCH_PARAMS(w, S, B) \
      for (uint rt = 0u; rt < uint(QMM_VEC_ROWS); ++rt) { \
        if (rt < rows) { \
          Q4_ROWS_ROW(w, \
            uvec4 xa = OUTGATE_XWORDS(x_row + w * 8u); \
            Q4_QUAD_ROWS(wa[r], xa.x, xa.y) \
            Q4_QUAD_ROWS(wa[r] >> 16u, xa.z, xa.w)) \
        } \
      } \
    } \
  } \
}
// Small-row form (MLX_OMARCHY_QMM_ROWS, default on): params.matrix_m = R <=
// QMM_VEC_ROWS rows of ONE [R, K] activation against ONE 2D weight (batch =
// 1, no per-row weight or param stride). Each block loads its weight words,
// scales and biases once and runs every row's chain on them. Per row that
// chain is Q4_ROWS_BATCH_ROW exactly: the same quads in the same order into
// dot, the same input_sum, the same block epilogue and the same subgroup
// reduction, so each row matches the single-row main bit for bit while the
// weight bytes are read once instead of R times. Rows past matrix_m do no
// work (guarded, not clamped). The host gates R to 2..4; wider rows keep
// the tile path (the scalar-FMA row chain loses to the coopmat tile at
// R >= 8, measured 2026-11-15).
void main() {
  uint lane = gl_LocalInvocationID.x;
  uint column_slot = lane / LANES;
  uint lane_in_slot = lane % LANES;
  uint rows = min(params.matrix_m, uint(QMM_VEC_ROWS));
  uint column = gl_WorkGroupID.x * COLUMNS_PER_GROUP +
      column_slot * uint(ROWS_PER_SLOT);
  uint n = params.matrix_n;
  bool column_active = column < n;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  precise float acc[QMM_VEC_ROWS][ROWS_PER_SLOT];
  for (uint rt = 0u; rt < uint(QMM_VEC_ROWS); ++rt) {
    for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) {
      acc[rt][r] = 0.0;
    }
  }
  if (column_active) {
    uint w_base = params.rhs_offset;
    uint s_base = params.aux_offset;
    uint b_base = params.aux_size;
    Q4_ROWS_ROWS(input_w, scales, biases)
  }
  for (uint rt = 0u; rt < rows; ++rt) {
    for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) {
      float total = subgroupAdd(acc[rt][r]);
      if (lane_in_slot == 0u && column + r < n) {
        output_data.values[params.output_offset + rt * params.matrix_n +
            column + r] = STORE_VALUE(total);
#if defined(QMM_VEC_ROPE_EPI)
        // Producer-direct KV window on flag bit 4 (window member only):
        // the same scatter the token kernel runs — window offset +
        // m*head_dim + (c/head_dim)*row_gap + c%head_dim — but the
        // storing lane already holds the rounded value, so the window
        // write is one extra store on epi_out instead of a read-back.
        if ((params.flags & 16u) != 0u) {
          epi_out.values[params.out_strides[0] + rt * params.dims +
              ((column + r) / params.dims) * params.out_strides[1] +
              ((column + r) % params.dims)] = STORE_VALUE(total);
        }
#endif
      }
    }
  }
#if defined(QMM_VEC_ROPE_EPI)
  // Per-member RMSNorm+RoPE epilogue: this dispatch's workgroups cover
  // COLUMNS_PER_GROUP contiguous columns of ONE member's output, all
  // inside a single rope head (whose per-head element span is the mat
  // stride is0), so is0/COLUMNS_PER_GROUP workgroups finish each head.
  // The LAST finisher of each head norms and rotates all rope_t token
  // rows, exactly like the standalone FastRopeNormBF16 dispatch pair
  // it replaces — the same math the multi-token epilogue carries, with
  // the member fixed (this dispatch's Output) and side in flag bit 0.
  // Flag bit 2 skips the tail and bit 3 stops after the election
  // (debug timing; results are wrong when set).
  if ((params.flags & 4u) == 0u) {
    const uint row_length = params.reduce_size;
    const uint half_dims = params.dims;
    const float eps = uintBitsToFloat(params.operation);
    const bool passthrough = 2u * half_dims < row_length;
    const uint rope_t = rows;
    const uint side = params.flags & 1u;
    const uint heads = params.shape[3];
    const uint in_off = params.lhs_size;
    const bool epi_transpose = (params.flags & 2u) != 0u;
    const uint is0 =
        epi_transpose ? row_length : rope_t * row_length;
    const uint is1 =
        epi_transpose ? heads * row_length : row_length;
    const float epi_off =
        float(int(offset_buf.values[params.count]));
    barrier();
    memoryBarrierBuffer();
    const uint wgs_per_head = is0 / COLUMNS_PER_GROUP;
    const uint head = gl_WorkGroupID.x / wgs_per_head;
    const uint tix = head;
    // Only the LAST finisher of this head reads its tiles: the head
    // row spans every producer's column slice, so an earlier elected
    // workgroup could read tiles that are still unwritten. The same
    // last-arrival protocol the multi-token epilogue runs.
    if (lane == 0u) {
      const uint prev = atomicAdd(ticket.values[tix], 1u);
      s_epi_is_last = (prev == wgs_per_head - 1u) ? 1u : 0u;
    }
    barrier();
    if (s_epi_is_last == 0u) {
      return;
    }
    if (lane == 0u) {
      ticket.values[tix] = 0u;
    }
    memoryBarrierBuffer();
    barrier();
    if ((params.flags & 8u) != 0u) {
      return;
    }
    // The norm keeps the serial path's exact pairing: each of the 128
    // lanes folds v[i]^2 (+v[i+128]^2) into one scratch slot, then the
    // 64..1 shared tree runs the same order — bit-for-bit with the
    // standalone path; only the row-to-workgroup assignment changed.
    const uint mat = head;
    for (uint t = 0u; t < rope_t; ++t) {
      const uint in_base = in_off + t * is1 + mat * is0;
      // v_reg keeps this lane's pass-1 load for the weighted pass:
      // the two walks hit the same indices below row_length.
      float v_reg = 0.0;
      {
        const uint i = lane;
        float sq = 0.0;
        if (i < row_length) {
          v_reg = epi_member_load(in_base + i);
          sq = v_reg * v_reg;
        }
        if (i + 128u < row_length) {
          float v2 = epi_member_load(in_base + i + 128u);
          sq += v2 * v2;
        }
        epi_block[i] = sq;
      }
      barrier();
      for (uint stride = 64u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
          epi_block[lane] += epi_block[lane + stride];
        }
        barrier();
      }
      const float mean_square = epi_block[0] / float(row_length);
      barrier();
      precise float norm = inversesqrt(mean_square + eps);
      for (uint vl = lane; vl < row_length; vl += 128u) {
        float v = (vl < 128u) ? v_reg : epi_member_load(in_base + vl);
        float w = epi_weight_load(vl);
        precise float weight_norm = w * norm;
        epi_block[vl] = epi_rope_round(v * weight_norm);
      }
      barrier();
      for (uint k = lane; k < row_length / 2u; k += 128u) {
        const float position =
            params.alpha * (float(t) + epi_off);
        float v0;
        float v1;
        if (passthrough) {
          const uint d0 = 2u * k;
          const uint d1 = d0 + 1u;
          if (d0 >= 2u * half_dims) {
            v0 = epi_block[d0];
            v1 = epi_block[d1];
          } else {
            float vals[2];
            for (uint s = 0u; s < 2u; ++s) {
              uint d = d0 + s;
              uint i = d % half_dims;
              float inv_freq = exp(-float(i) * params.beta);
              float theta = position * inv_freq;
              float cos_t = epi_rope_round(omarchy_trig_cos(theta));
              float sin_t = epi_rope_round(omarchy_trig_sin(theta));
              float x1 = epi_block[i];
              float x2 = epi_block[i + half_dims];
              float xa = epi_rope_round(x1 * cos_t);
              float xb = epi_rope_round(x2 * sin_t);
              float xc = epi_rope_round(x1 * sin_t);
              float xd = epi_rope_round(x2 * cos_t);
              vals[s] = (d < half_dims) ? (xa - xb) : (xc + xd);
            }
            v0 = vals[0];
            v1 = vals[1];
          }
        } else {
          bool r1_side = k < (half_dims >> 1u);
          uint j0 = r1_side
              ? (2u * k)
              : (half_dims + 2u * (k - (half_dims >> 1u)));
          uint j1 = j0 + 1u;
          uint i0 = r1_side ? j0 : (j0 - half_dims);
          uint i1 = i0 + 1u;
          float inv0 = exp(-float(i0) * params.beta);
          float inv1 = exp(-float(i1) * params.beta);
          float cos0 =
              epi_rope_round(omarchy_trig_cos(position * inv0));
          float sin0 =
              epi_rope_round(omarchy_trig_sin(position * inv0));
          float cos1 =
              epi_rope_round(omarchy_trig_cos(position * inv1));
          float sin1 =
              epi_rope_round(omarchy_trig_sin(position * inv1));
          float xa = epi_block[i0];
          float xb = epi_block[i0 + half_dims];
          float xc = epi_block[i1];
          float xd = epi_block[i1 + half_dims];
          if (r1_side) {
            v0 = epi_rope_round(xa * cos0) - epi_rope_round(xb * sin0);
            v1 = epi_rope_round(xc * cos1) - epi_rope_round(xd * sin1);
          } else {
            v0 = epi_rope_round(xa * sin0) + epi_rope_round(xb * cos0);
            v1 = epi_rope_round(xc * sin1) + epi_rope_round(xd * cos1);
          }
        }
        if (side == 0u) {
          uint ob = params.output_size +
              (mat * rope_t + t) * row_length + 2u * k;
          epi_out.values[ob] = STORE_VALUE(v0);
          epi_out.values[ob + 1u] = STORE_VALUE(v1);
        } else {
          uint ob = params.out_strides[0] +
              mat * params.out_strides[1] +
              t * params.out_strides[2] + 2u * k;
          epi_out.values[ob] = STORE_VALUE(v0);
          epi_out.values[ob + 1u] = STORE_VALUE(v1);
        }
      }
      barrier();
    }
  }
#endif
}
