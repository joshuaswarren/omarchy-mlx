#version 460

// Fused matrix-vector path for QuantizedMatmul when x is a single row:
// out[1, n] = x[1, k] @ dequant(w) with w packed uint32 words holding
// 32/bits affine values along the packed axis in the low bits first
// (bits 2/4/8) or lane-atomic little-endian byte packs of 8/3, 8/5,
// or 4/3 bytes (bits 3/5/6), one affine scale and bias per group_size
// elements; with -DFP_MODE the fp modes instead (fp4 e2m1 / fp8 e4m3
// element bytes, one scale byte per group, no bias). Decode is this
// shape on every layer, and the general kernel serializes it: one
// thread per output column walks the whole row serially, so its
// 32-lane reads sit words-per-row*4 bytes apart - every lane a
// separate cache line. Here each of the workgroup's 32-lane subgroups
// owns one weight row (ROWS_PER_SLOT consecutive rows in the packed-x
// subgroup builds) and lanes stride single k steps, so consecutive lanes
// read consecutive x elements, consecutive weight-row words, and one
// shared cache line of row bytes per step.
// Dequantization happens in registers inside the dot product - no
// dequantized intermediate tensor, no extra pass over memory, one
// dispatch.
//
// Two reduction flavors compile from this same source via -DUSE_SUBGROUP:
//   * default: five-round workgroup-shared tree (correct on any
//     subgroup size; lane split is plain workgroup arithmetic). The
//     five barrier rounds are the cost.
//   * USE_SUBGROUP=1: one subgroupAdd(accumulator) per 32-lane slot
//     (Honeykrisp's actual subgroupSize). Trades the barriers for the
//     hardware reduction; the bench (tools/subgroup-bench) decides
//     whether the trade pays on this device. Dispatch is gated on
//     caps.subgroup_size == 32 and the ARITHMETIC subgroup-feature bit,
//     so a device that lacks either falls back to the tree path
//     unchanged.
// Both flavors pair lanes stride 1 first, then 2, 4, 8, 16. That is the
// order native Metal simd_sum reduces in, and Honeykrisp's 32-bit float
// subgroupAdd is the same hardware reduction (agx_nir_lower_subgroups
// leaves it unlowered) and measured that pairing bit for bit, so the Q4
// word path below is bit-identical to native qmv
// (receipts/2026-09-09-q4-gemv-order). subgroupShuffleXor is not used:
// Honeykrisp emulates arbitrary shuffles with four read_invocation
// selects per step.
//
// QMM_VEC_Q4_WORD compiles the transposed affine 4-bit/group-64 decode
// path in native qmv arithmetic: one lane owns one packed word per
// block, loads scale and bias once, and applies all eight nibbles with
// constant shifts.

#ifdef USE_FP16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#elif defined(USE_BF16)
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define LOAD_VALUE(x) uintBitsToFloat(uint(x) << 16u)
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}
#define STORE_VALUE(f) bf16_store(f)
#else
#define STORAGE_TYPE float
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)
#endif
#ifdef USE_SUBGROUP
// The subgroup reduction variant assumes subgroupSize == 32, gated in
// dispatch (see QuantizedMatmul::eval_gpu). The kernel does not check
// this itself because Vulkan does not let compute shaders query
// subgroupSize at runtime. Compiling this on a device with a different
// subgroup size produces a wrong sum, so the dispatch gate is the
// load-bearing part of this codepath.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif
#if defined(FP_MODE) && defined(QMM_VEC_Q4_WORD)
#error "QMM_VEC_Q4_WORD applies to affine quantization only"
#endif
#if defined(QMM_VEC_GREEDY) && (!defined(USE_BF16) || \
    !defined(USE_SUBGROUP) || !defined(QMM_VEC_Q4_WORD) || \
    defined(QMM_VEC_MULTI))
#error "QMM_VEC_GREEDY builds on the bf16 subgroup Q4 word column"
#endif
#if defined(QMM_VEC_OUTGATE) && \
    (!defined(USE_BF16) || !defined(USE_SUBGROUP) || !defined(QMM_VEC_MULTI))
#error "QMM_VEC_OUTGATE builds on the bf16 subgroup multi column"
#endif

// Decode geometry: SLOTS_PER_GROUP 32-lane slots per workgroup, each slot
// owning ROWS_PER_SLOT consecutive output rows (native qmv_fast keeps four
// rows per simdgroup: the x quads load once per block and feed every row,
// and the row loads sit independent in flight). ROWS_PER_SLOT > 1 needs the
// packed x view (f16/bf16) and the subgroup reduction; the per-row
// arithmetic order is the single-row chain, so results stay bit-identical.
#ifndef ROWS_PER_SLOT
#define ROWS_PER_SLOT 1
#endif
#ifndef SLOTS_PER_GROUP
#define SLOTS_PER_GROUP 8
#endif
#if ROWS_PER_SLOT != 1 && !defined(QMM_VEC_TOKENS) && \
    (!defined(USE_SUBGROUP) || !(defined(USE_FP16) || defined(USE_BF16)))
#error "ROWS_PER_SLOT > 1 needs USE_SUBGROUP and a packed x view"
#endif
#if defined(QMM_VEC_TOKENS) && \
    (ROWS_PER_SLOT != 2 || !defined(USE_BF16) || !defined(QMM_VEC_Q4_WORD))
#error "QMM_VEC_TOKENS builds on the bf16 packed-x multi column"
#endif
#if defined(QMM_VEC_BATCH) && \
    (ROWS_PER_SLOT != 2 || !defined(USE_BF16) || !defined(QMM_VEC_Q4_WORD) || \
     defined(QMM_VEC_MULTI))
#error "QMM_VEC_BATCH builds on the bf16 packed-x single-weight column"
#endif
#if !defined(USE_SUBGROUP) && SLOTS_PER_GROUP != 8
#error "the tree reduction assumes 8 slots"
#endif
// The x fetch inside Q4_WORD / Q4_ROWS: the out-gate prologue variant
// (QMM_VEC_OUTGATE, multi-only) transforms the two prologue vectors
// instead of reading the product; every other variant reads input_x.
#if defined(QMM_VEC_OUTGATE)
#define OUTGATE_XWORDS(x_base) outgate_quad((x_base) / 8u)
#else
#define OUTGATE_XWORDS(x_base) input_x.values[(x_base) / 8u]
#endif
const uint COLUMNS_PER_GROUP = uint(SLOTS_PER_GROUP * ROWS_PER_SLOT);
const uint LANES = 32u;

layout(local_size_x = SLOTS_PER_GROUP * 32) in;

#if (defined(USE_FP16) || defined(USE_BF16)) && defined(QMM_VEC_Q4_WORD)
// Decode x rows are 16-byte aligned by dispatch. Reading eight packed halves
// at once keeps native's half arithmetic while avoiding eight scalar loads.
layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uvec4 values[];
} input_x;
#else
layout(set = 0, binding = 0, std430) readonly buffer InputX {
  STORAGE_TYPE values[];
} input_x;
#endif
#ifdef QMM_VEC_MULTI
#ifndef QMM_VEC_Q4_WORD
#error "QMM_VEC_MULTI builds on QMM_VEC_Q4_WORD"
#endif
// Multi-weight decode dispatch: up to four transposed 4-bit/group-64
// weights against one x row in one dispatch, each with its own
// scale/bias/output triple and an optional fused Add epilogue
// (sum = out + addend, the elementwise Add's float add and storage
// rounding). Workgroups are laid out weight after weight; shape[i]
// carries weight i's N, dims the weight count, flags bit 8+i the
// epilogue for weight i. Every weight, scale, bias, output, and addend
// starts at element 0 of its buffer (the host refuses otherwise), so no
// per-weight offsets ride in the push constants — except a weight's sum
// store under the direct-KV flag (bit 12+i), which the host may aim at
// one token row of a KV cache copy: out_strides[i] base element,
// in_strides[i] the row gap, matrix_m the head dim.
#define QMM_VEC_MULTI_WEIGHT(I, B) \
layout(set = 0, binding = B, std430) readonly buffer InputW##I { \
  uint values[]; \
} input_w##I; \
layout(set = 0, binding = B + 1, std430) readonly buffer Scales##I { \
  STORAGE_TYPE values[]; \
} scales##I; \
layout(set = 0, binding = B + 2, std430) readonly buffer Biases##I { \
  STORAGE_TYPE values[]; \
} biases##I; \
layout(set = 0, binding = B + 3, std430) writeonly buffer Output##I { \
  STORAGE_TYPE values[]; \
} output##I; \
layout(set = 0, binding = B + 4, std430) readonly buffer Addend##I { \
  STORAGE_TYPE values[]; \
} addend##I; \
layout(set = 0, binding = B + 5, std430) writeonly buffer Sum##I { \
  STORAGE_TYPE values[]; \
} sum##I;
QMM_VEC_MULTI_WEIGHT(0, 1)
QMM_VEC_MULTI_WEIGHT(1, 7)
QMM_VEC_MULTI_WEIGHT(2, 13)
QMM_VEC_MULTI_WEIGHT(3, 19)
#if defined(QMM_VEC_OUTGATE)
// Out-gate prologue (flags bit 17): x = out * bf16(sigmoid(gate)), the
// exact arithmetic and rounding of the two elementwise kernels the
// prologue deletes (unary_vec.comp / elementwise.comp: float math on
// the widened operand, one round to storage per kernel boundary —
// sig_b = bf16(1/(1+exp(-g))), m = bf16(o * sig_b), both bf16_store
// RNE). Every workgroup recomputes the full product from the same two
// read-only vectors and gets identical bits; workgroup 0 stores the
// materialized product so retained references to the deleted
// Multiply's output stay valid (bindings 25-27; the vectors start at
// element 0 — the host refuses otherwise).
layout(set = 0, binding = 25, std430) readonly buffer OutgateOut {
  uvec4 values[];
} outgate_out;
layout(set = 0, binding = 26, std430) readonly buffer OutgateGate {
  uvec4 values[];
} outgate_gate;
layout(set = 0, binding = 27, std430) writeonly buffer OutgateMul {
  uvec4 values[];
} outgate_mul;
uint16_t outgate_sig_lane(uint g_bits) {
  float g = uintBitsToFloat(g_bits << 16u);
  return bf16_store(1.0 / (1.0 + exp(-g)));
}
uint outgate_word(uint o, uint g) {
  float sig_lo = uintBitsToFloat(
      uint(outgate_sig_lane(g & 0xFFFFu)) << 16u);
  float sig_hi = uintBitsToFloat(
      uint(outgate_sig_lane(g >> 16u)) << 16u);
  float lo = uintBitsToFloat((o & 0xFFFFu) << 16u) * sig_lo;
  float hi = uintBitsToFloat((o & 0xFFFF0000u)) * sig_hi;
  return uint(bf16_store(lo)) | (uint(bf16_store(hi)) << 16u);
}
uvec4 outgate_quad(uint quad_index) {
  uvec4 o = outgate_out.values[quad_index];
  uvec4 g = outgate_gate.values[quad_index];
  uvec4 m = {outgate_word(o.x, g.x), outgate_word(o.y, g.y),
             outgate_word(o.z, g.z), outgate_word(o.w, g.w)};
  if (gl_WorkGroupID.x == 0u) {
    outgate_mul.values[quad_index] = m;
  }
  return m;
}
#define OUTGATE_XWORDS(x_base) outgate_quad((x_base) / 8u)
#endif
#else
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
#ifdef FP_MODE
// Scale bytes addressed through the word view; no bias term.
layout(set = 0, binding = 2, std430) readonly buffer ScaleBias {
  uint values[];
} scale_bias;
layout(set = 0, binding = 3, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
#else
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  STORAGE_TYPE values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  STORAGE_TYPE values[];
} biases;
#ifdef QMM_VEC_GREEDY
// Greedy-argmax head (see the QMM_VEC_GREEDY main): top-bit plane, the
// token, scratch (state words, per-row bounds, survivor rows, row
// values), and the two stats words.
layout(set = 0, binding = 4, std430) readonly buffer Plane {
  uint values[];
} plane;
layout(set = 0, binding = 5, std430) writeonly buffer Token {
  uint values[];
} token;
layout(set = 0, binding = 6, std430) buffer State {
  uint values[];
} state;
layout(set = 0, binding = 7, std430) buffer Bounds {
  float values[];
} bounds;
layout(set = 0, binding = 8, std430) buffer Survivors {
  uint values[];
} survivors;
layout(set = 0, binding = 9, std430) buffer RowValues {
  float values[];
} row_values;
layout(set = 0, binding = 10, std430) writeonly buffer Stats {
  uint values[];
} stats;
#else
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;
#endif
#endif
#endif

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

#ifndef USE_SUBGROUP
shared float reduce_scratch[256];
#endif

// Push-constant routing: operation carries bits (2, 3, 4, 5, 6, or 8),
// reduce_size the group size, flags bit 0 the non-transposed layout.
// Affine bindings 2/3 are the separate scale/bias streams; aux_offset
// is the scale base item and aux_size the bias base item (storage
// offsets in elements), shape[2] the per-batch param stride. FP_MODE
// binding 2 is the scale-byte stream (one byte per group, aux_offset =
// byte offset into it).

// Constant-shift select chain from scatter.comp: runtime word and lane,
// constant shift per lane.
uint byte_at(uint word, uint lane) {
  return (lane == 0u)
      ? (word & 0xFFu)
      : (lane == 1u)
      ? ((word >> 8u) & 0xFFu)
      : (lane == 2u)
      ? ((word >> 16u) & 0xFFu)
      : ((word >> 24u) & 0xFFu);
}

#ifdef FP_MODE
float fp8_decode(uint bits) {
  float magnitude = unpackHalf2x16((bits & 127u) << 7u).x * 256.0;
  return ((bits & 128u) != 0u) ? -magnitude : magnitude;
}

float e8m0_decode(uint bits) {
  return uintBitsToFloat(bits == 0u ? 0x400000u : bits << 23u);
}

// FP4 E2M1 decode via the fp16 bit trick from the Metal fp4_e2m1
// constructor: (bits & 7) << 9 reinterprets the exponent and mantissa
// as fp16 subnormals, the missing 2^14 lands in the scale factor.
float fp4_decode(uint code) {
  float magnitude = unpackHalf2x16((code & 7u) << 9u).x * 16384.0;
  return ((code & 8u) != 0u) ? -magnitude : magnitude;
}
#else
// Affine byte-pack decode: element e of a pack, upstream extract table
// (all constant shifts; e routes between constant expressions).
uint q3_at(uint e, uint c0, uint c1, uint c2) {
  if (e == 0u) return c0 & 0x7u;
  if (e == 1u) return (c0 >> 3) & 0x7u;
  if (e == 2u) return ((c0 >> 6) & 0x3u) + ((c1 & 0x1u) << 2);
  if (e == 3u) return (c1 >> 1) & 0x7u;
  if (e == 4u) return (c1 >> 4) & 0x7u;
  if (e == 5u) return ((c1 >> 7) & 0x1u) + ((c2 & 0x3u) << 1);
  if (e == 6u) return (c2 >> 2) & 0x7u;
  return (c2 >> 5) & 0x7u;
}

uint q5_at(uint e, uint c0, uint c1, uint c2, uint c3, uint c4) {
  if (e == 0u) return c0 & 0x1fu;
  if (e == 1u) return ((c0 >> 5) & 0x7u) + ((c1 & 0x3u) << 3);
  if (e == 2u) return (c1 >> 2) & 0x1fu;
  if (e == 3u) return ((c1 >> 7) & 0x1u) + ((c2 & 0xfu) << 1);
  if (e == 4u) return ((c2 >> 4) & 0xfu) + ((c3 & 0x1u) << 4);
  if (e == 5u) return (c3 >> 1) & 0x1fu;
  if (e == 6u) return ((c3 >> 6) & 0x3u) + ((c4 & 0x7u) << 2);
  return (c4 >> 3) & 0x1fu;
}

uint q6_at(uint e, uint c0, uint c1, uint c2) {
  if (e == 0u) return c0 & 0x3fu;
  if (e == 1u) return ((c0 >> 6) & 0x3u) + ((c1 & 0xfu) << 2);
  if (e == 2u) return ((c1 >> 4) & 0xfu) + ((c2 & 0x3u) << 4);
  return (c2 >> 2) & 0x3fu;
}
#endif

#ifdef QMM_VEC_Q4_WORD
// One x quad against the low 16 bits of `packed` (nibbles low first).
// The quad's half chain sum joins input_sum; ((p0 + p1) + p2) + p3 joins
// dot as an fma chain: every product is exact (11-bit x times a 4-bit
// nibble), so each fma rounds exactly the sum native qdot rounds, and
// nibble i times x equals native's (x / 16^i) * (word & mask_i).
#ifdef USE_FP16
// Native load_vector adds the four T=half values in half. unpackFloat2x16 is
// an f16vec2 bitcast, not a widening conversion. Q4_WORD supplies one uvec4
// load for all eight x values.
#define Q4_QUAD_LOAD(lo, hi) \
  f16vec2 h01 = unpackFloat2x16(lo); \
  f16vec2 h23 = unpackFloat2x16(hi); \
  float16_t h0 = h01.x; \
  float16_t h1 = h01.y; \
  float16_t h2 = h23.x; \
  float16_t h3 = h23.y; \
  input_sum += float(((h0 + h1) + h2) + h3); \
  float x0 = float(h0); \
  float x1 = float(h1); \
  float x2 = float(h2); \
  float x3 = float(h3);
#elif defined(USE_BF16)
// Packed-x bf16 quad: two uint words of the uvec4 carry four bf16 halves
// (low half first, as stored). bf16 -> f32 is an exact left shift by 16,
// so every x value equals the scalar LOAD_VALUE, the sum chain keeps the
// float order, and one uvec4 load replaces eight 2-byte scalar loads per
// weight word.
#define Q4_QUAD_LOAD(lo, hi) \
  float x0 = uintBitsToFloat(((lo) & 0xFFFFu) << 16u); \
  float x1 = uintBitsToFloat((lo) & 0xFFFF0000u); \
  float x2 = uintBitsToFloat(((hi) & 0xFFFFu) << 16u); \
  float x3 = uintBitsToFloat((hi) & 0xFFFF0000u); \
  input_sum += ((x0 + x1) + x2) + x3;
#else
// f32 x has nothing to round; the f32 quad sum is uncaptured,
// so f32 keeps the float chain.
#define Q4_QUAD_LOAD(base, unused) \
  float x0 = LOAD_VALUE(input_x.values[base]); \
  float x1 = LOAD_VALUE(input_x.values[(base) + 1u]); \
  float x2 = LOAD_VALUE(input_x.values[(base) + 2u]); \
  float x3 = LOAD_VALUE(input_x.values[(base) + 3u]); \
  input_sum += ((x0 + x1) + x2) + x3;
#endif
// Exact float(n) for a nibble n in [0, 15] without u32_to_f (an expensive
// conversion op on AGX; the in-chain GEMV runs +3% without it): 2^23 + n is
// exact in f32, so inserting the nibble into the exponent word of 2^23 and
// subtracting 2^23 returns n exactly.
#define Q4_NIB(p, shift) \
  (uintBitsToFloat((((p) >> (shift)) & 0xfu) | 0x4B000000u) - 8388608.0)
#define Q4_QUAD(packed, a, b) { \
  Q4_QUAD_LOAD(a, b) \
  uint p = (packed); \
  dot += fma(x3, Q4_NIB(p, 12u), \
      fma(x2, Q4_NIB(p, 8u), \
          fma(x1, Q4_NIB(p, 4u), \
              x0 * Q4_NIB(p, 0u)))); \
}
// One packed weight word and its eight x values.
#if defined(USE_FP16) || defined(USE_BF16)
#define Q4_WORD(word, x_base) { \
  uint word_value = (word); \
  uvec4 x_words = OUTGATE_XWORDS(x_base); \
  Q4_QUAD(word_value, x_words.x, x_words.y) \
  Q4_QUAD(word_value >> 16u, x_words.z, x_words.w) \
}
#else
#define Q4_WORD(word, x_base) { \
  uint word_value = (word); \
  uint quad_base = (x_base); \
  Q4_QUAD(word_value, quad_base, 0u) \
  Q4_QUAD(word_value >> 16u, quad_base + 4u, 0u) \
}
#endif
// Block epilogue: result += fma(scale, dot, sum * bias) with the group
// of word w (every word of a lane's block sits in one group). S and B
// name the scale and bias buffers so the multi-weight variant can
// instantiate the same chain per weight.
#define Q4_BLOCK_FINISH(w, S, B) { \
  uint group = (w) / 8u; \
  float scale = LOAD_VALUE(S.values[scale_base + group]); \
  float bias = LOAD_VALUE(B.values[bias_base + group]); \
  precise float bias_term = input_sum * bias; \
  accumulator += fma(scale, dot, bias_term); \
}
// One output column of one transposed 4-bit/group-64 weight, native qmv
// arithmetic (metal/kernels/quantized.h qmv_impl / qmv_fast_impl +
// load_vector + qdot, T=half, U=float): a lane owns one word (two when
// K % 512 == 0 and N % 8 == 0, the qmv_fast tile) per 256- or 512-wide
// block. Per block it forms the half-precision chain sum of each x
// quad, accumulates those in float, and the dot against the nibbles in
// source order, then result += fma(scale, dot, sum * bias). Metal
// compiles with -fno-fast-math: it contracts scale * accum + sum * bias
// into that fma, leaves sum * bias separate, and keeps every add in
// source order. Honeykrisp's NIR reassociates add chains into fma
// ladders unless the ops are exact, so accumulator, dot, and input_sum
// are precise (receipts/2026-09-09-q4-gemv-order). Straight-line
// bodies: the qmv_fast tile and the qmv tile each get their own loop so
// no runtime-count inner loop sits between the loads and the math.
// Expects w_base, scale_base, bias_base, x_row, words_per_row, n and
// lane_in_slot in scope and accumulates into `accumulator`.
#define Q4_ROW(W, S, B) { \
  if (params.matrix_k % 512u == 0u && n % 8u == 0u) { \
    for (uint w = lane_in_slot * 2u; w < words_per_row; \
         w += LANES * 2u) { \
      precise float dot = 0.0; \
      precise float input_sum = 0.0; \
      Q4_WORD(W.values[w_base + w], x_row + w * 8u) \
      Q4_WORD(W.values[w_base + w + 1u], x_row + w * 8u + 8u) \
      Q4_BLOCK_FINISH(w, S, B) \
    } \
  } else { \
    for (uint w = lane_in_slot; w < words_per_row; w += LANES) { \
      precise float dot = 0.0; \
      precise float input_sum = 0.0; \
      Q4_WORD(W.values[w_base + w], x_row + w * 8u) \
      Q4_BLOCK_FINISH(w, S, B) \
    } \
  } \
}
#if ROWS_PER_SLOT > 1
// Multi-row form of Q4_ROW: ROWS_PER_SLOT rows starting at `column`
// (rows past n are clamped to row n - 1 and their results discarded, so
// every load stays in bounds without a branch). Per row the chain is
// exactly Q4_ROW's: the same quads in the same order into dot, the same
// block epilogue; the x quads and input_sum are shared because they do
// not depend on the row. Expects the batch bases w_base, s_base, b_base
// (0 for the multi-weight kernel), x_row, words_per_row, groups_per_row,
// n, column and lane_in_slot in scope; accumulates into acc[ROWS_PER_SLOT].
#define Q4_QUAD_ROWS(P_EXPR, a, b) { \
  Q4_QUAD_LOAD(a, b) \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    uint p = (P_EXPR); \
    dot[r] += fma(x3, Q4_NIB(p, 12u), \
        fma(x2, Q4_NIB(p, 8u), \
            fma(x1, Q4_NIB(p, 4u), \
                x0 * Q4_NIB(p, 0u)))); \
  } \
}
#define Q4_ROWS_FINISH(w, S, B) { \
  uint group = (w) / 8u; \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    float scale = \
        LOAD_VALUE(S.values[s_base + row_base[r] * groups_per_row + group]); \
    float bias = \
        LOAD_VALUE(B.values[b_base + row_base[r] * groups_per_row + group]); \
    precise float bias_term = input_sum * bias; \
    acc[r] += fma(scale, dot[r], bias_term); \
  } \
}
#define Q4_ROWS(W, S, B) { \
  uint row_base[ROWS_PER_SLOT]; \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    row_base[r] = min(column + r, n - 1u); \
  } \
  if (params.matrix_k % 512u == 0u && n % 8u == 0u) { \
    for (uint w = lane_in_slot * 2u; w < words_per_row; \
         w += LANES * 2u) { \
      precise float dot[ROWS_PER_SLOT]; \
      precise float input_sum = 0.0; \
      uint wa[ROWS_PER_SLOT]; \
      uint wb[ROWS_PER_SLOT]; \
      for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
        dot[r] = 0.0; \
        wa[r] = W.values[w_base + row_base[r] * words_per_row + w]; \
        wb[r] = W.values[w_base + row_base[r] * words_per_row + w + 1u]; \
      } \
      uvec4 xa = OUTGATE_XWORDS(x_row + w * 8u); \
      uvec4 xb = OUTGATE_XWORDS(x_row + w * 8u + 8u); \
      Q4_QUAD_ROWS(wa[r], xa.x, xa.y) \
      Q4_QUAD_ROWS(wa[r] >> 16u, xa.z, xa.w) \
      Q4_QUAD_ROWS(wb[r], xb.x, xb.y) \
      Q4_QUAD_ROWS(wb[r] >> 16u, xb.z, xb.w) \
      Q4_ROWS_FINISH(w, S, B) \
    } \
  } else { \
    for (uint w = lane_in_slot; w < words_per_row; w += LANES) { \
      precise float dot[ROWS_PER_SLOT]; \
      precise float input_sum = 0.0; \
      uint wa[ROWS_PER_SLOT]; \
      for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
        dot[r] = 0.0; \
        wa[r] = W.values[w_base + row_base[r] * words_per_row + w]; \
      } \
      uvec4 xa = OUTGATE_XWORDS(x_row + w * 8u); \
      Q4_QUAD_ROWS(wa[r], xa.x, xa.y) \
      Q4_QUAD_ROWS(wa[r] >> 16u, xa.z, xa.w) \
      Q4_ROWS_FINISH(w, S, B) \
    } \
  } \
}
// Multi-token (verify / small-batch) forms: the token (query-row)
// dimension sits INSIDE the k walk so one weight-word load feeds every
// token. Per token and slot column the chain is instruction-for-
// instruction Q4_ROWS': same quad order into dot, same per-column
// input_sum chain, same block epilogue fma, same subgroupAdd tree, same
// rounding - so each row's result is bit-identical to that row computed
// alone. params.matrix_m carries the live token count (1..M_TOKENS);
// rows at or past it do no work (loads and stores are guarded, not
// clamped). bf16 only: x quad words widen exactly like Q4_QUAD_LOAD_T.
#define Q4_QUAD_LOAD_T(a, b, isum) \
  float x0 = uintBitsToFloat(((a) & 0xFFFFu) << 16u); \
  float x1 = uintBitsToFloat((a) & 0xFFFF0000u); \
  float x2 = uintBitsToFloat(((b) & 0xFFFFu) << 16u); \
  float x3 = uintBitsToFloat((b) & 0xFFFF0000u); \
  isum += ((x0 + x1) + x2) + x3;
#define Q4_TOK_DOT(dst, p) \
  (dst) += fma(x3, Q4_NIB(p, 12u), \
      fma(x2, Q4_NIB(p, 8u), \
          fma(x1, Q4_NIB(p, 4u), \
              x0 * Q4_NIB(p, 0u))))
// One block (one or two weight words per lane step) for all tokens:
// weight words load once, x quads load once per token and are shared by
// every slot column; dot and input_sum accumulate per (column, token)
// exactly as the single-token kernel's per-column chain does.
#define Q4_TOK_BLOCK(W, S, B, words_this_step) { \
  uint wa[ROWS_PER_SLOT]; \
  uint wb[ROWS_PER_SLOT]; \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    wa[r] = W.values[w_base + row_base[r] * words_per_row + w]; \
    if ((words_this_step) == 2u) { \
      wb[r] = W.values[w_base + row_base[r] * words_per_row + w + 1u]; \
    } \
  } \
  precise float dot_t[ROWS_PER_SLOT][M_TOKENS]; \
  precise float input_sum_t[ROWS_PER_SLOT][M_TOKENS]; \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    for (uint m = 0u; m < M_TOKENS; ++m) { \
      dot_t[r][m] = 0.0; \
      input_sum_t[r][m] = 0.0; \
    } \
  } \
  for (uint m = 0u; m < M_TOKENS; ++m) { \
    if (m >= token_count) { \
      continue; \
    } \
    uint x_row_m = params.lhs_offset + m * params.matrix_k; \
    uvec4 xa = input_x.values[(x_row_m + w * 8u) / 8u]; \
    uvec4 xb; \
    if ((words_this_step) == 2u) { \
      xb = input_x.values[(x_row_m + w * 8u + 8u) / 8u]; \
    } \
    for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
      { Q4_QUAD_LOAD_T(xa.x, xa.y, input_sum_t[r][m]) \
        uint p = wa[r]; Q4_TOK_DOT(dot_t[r][m], p); } \
      { Q4_QUAD_LOAD_T(xa.z, xa.w, input_sum_t[r][m]) \
        uint p = wa[r] >> 16u; Q4_TOK_DOT(dot_t[r][m], p); } \
      if ((words_this_step) == 2u) { \
        { Q4_QUAD_LOAD_T(xb.x, xb.y, input_sum_t[r][m]) \
          uint p = wb[r]; Q4_TOK_DOT(dot_t[r][m], p); } \
        { Q4_QUAD_LOAD_T(xb.z, xb.w, input_sum_t[r][m]) \
          uint p = wb[r] >> 16u; Q4_TOK_DOT(dot_t[r][m], p); } \
      } \
    } \
  } \
  uint group = w / 8u; \
  for (uint m = 0u; m < M_TOKENS; ++m) { \
    if (m >= token_count) { \
      continue; \
    } \
    for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
      float scale = \
          LOAD_VALUE(S.values[s_base + row_base[r] * groups_per_row + group]); \
      float bias = \
          LOAD_VALUE(B.values[b_base + row_base[r] * groups_per_row + group]); \
      precise float bias_term = input_sum_t[r][m] * bias; \
      acc_t[m][r] += fma(scale, dot_t[r][m], bias_term); \
    } \
  } \
}
#endif
#endif

#ifdef QMM_VEC_MULTI
// Multi-weight main: workgroup ranges [0, g0), [g0, g0 + g1), [.., + g2),
// and the rest select weight 0, 1, 2, 3; the selection is uniform per workgroup so
// the barrier rounds of the tree reduction stay uniform. Each weight's
// column runs the same Q4_ROW chain the single kernel runs for that
// weight alone (n is that weight's N, so the qmv_fast tile choice is
// the same). The epilogue must add the STORED value: the per-node Add
// reads the rounded output back from memory. A float16_t round trip
// in registers does not survive the AGX compiler (the epilogue then
// added the unrounded total; 270 of 896 sums differed on the M1), so
// the rounding goes through integer packing, as fused_chain.comp
// does, and both the output and the sum derive from that rounded
// value (converting an f16-representable float to float16_t is exact).
#ifdef USE_FP16
#define ROUND_STORAGE(f) (unpackHalf2x16(packHalf2x16(vec2(f, 0.0))).x)
#elif defined(USE_BF16)
#define ROUND_STORAGE(f) LOAD_VALUE(bf16_store(f))
#else
#define ROUND_STORAGE(f) (f)
#endif
// Workgroup reduction of `accumulator` into `total`, both flavors.
// The paired SwiGLU epilogue (flags bit 16) runs it twice per
// workgroup (gate, then up); the barrier rounds stay uniform because
// the fold flag is workgroup-uniform.
#ifdef USE_SUBGROUP
#define Q4_REDUCE(total) { (total) = subgroupAdd(accumulator); }
#else
#define Q4_REDUCE(total) { \
  reduce_scratch[lane] = accumulator; \
  barrier(); \
  for (uint offset = 1u; offset < LANES; offset <<= 1u) { \
    if ((lane_in_slot & (2u * offset - 1u)) == 0u) { \
      reduce_scratch[lane] += reduce_scratch[lane + offset]; \
    } \
    barrier(); \
  } \
  (total) = reduce_scratch[lane]; \
}
#endif
#define Q4_MULTI_STORE(I, rounded) { \
  output##I.values[column] = STORE_VALUE(rounded); \
  bool raw_kv_i = ((params.flags & 262144u) != 0u) && \
      ((params.flags & (4096u << I)) != 0u) && \
      ((params.flags & (256u << I)) == 0u); \
  if ((params.flags & (256u << I)) != 0u || raw_kv_i) { \
    uint sum_column = column; \
    if ((params.flags & (4096u << I)) != 0u) { \
      sum_column = params.out_strides[I] + \
          (column / params.matrix_m) * params.in_strides[I] + \
          (column % params.matrix_m); \
    } \
    sum##I.values[sum_column] = STORE_VALUE( \
        raw_kv_i ? (rounded) \
                 : ((rounded) + LOAD_VALUE(addend##I.values[column]))); \
  } \
}
#if defined(QMM_VEC_TOKENS)
// Multi-token main: same workgroup -> weight partition, fold contract
// and reduction structure as the single-token main, with the token
// dimension inside the k walk (see Q4_TOK_BLOCK). Output and Add-
// epilogue rows are strided by the weight's n; the epilogue addend row
// stride arrives via params.in_strides[which] (n for a full addend, 0
// for a row-broadcast bias). The kv-window and out-gate folds are not
// built here (host never selects them for rows > 1).
#if !defined(USE_BF16) || defined(USE_FP16) || \
    !defined(QMM_VEC_Q4_WORD) || !defined(QMM_VEC_MULTI) || \
    ROWS_PER_SLOT != 2 || defined(QMM_VEC_OUTGATE) || !defined(M_TOKENS)
#error "QMM_VEC_TOKENS builds on the bf16 packed-x multi column only"
#endif
void main() {
  uint lane = gl_LocalInvocationID.x;
  uint column_slot = lane / LANES;
  uint lane_in_slot = lane % LANES;
  uint token_count = params.matrix_m;
  // Two-pass rows 9..16: out_strides[0] is this pass's first token row
  // (0 for rows 0..7, 8 for rows 8..15); each pass runs the identical
  // token8 chain over its own half, so per-row bit-identity holds and
  // the token16 unroll is never compiled into the shipped path.
  uint row0 = params.out_strides[0];
  uint n0 = params.shape[0];
  uint n1 = params.shape[1];
  uint n2 = params.shape[2];
  uint n3 = params.shape[3];
  uint groups0 = (n0 + COLUMNS_PER_GROUP - 1u) / COLUMNS_PER_GROUP;
  uint groups1 = (n1 + COLUMNS_PER_GROUP - 1u) / COLUMNS_PER_GROUP;
  uint groups2 = (n2 + COLUMNS_PER_GROUP - 1u) / COLUMNS_PER_GROUP;
  uint workgroup = gl_WorkGroupID.x;
  uint which;
  uint n;
  if ((params.flags & 65536u) != 0u) {
    which = 0u;
    n = n0;
  } else if (workgroup < groups0) {
    which = 0u;
    n = n0;
  } else if (workgroup < groups0 + groups1) {
    which = 1u;
    workgroup -= groups0;
    n = n1;
  } else if (workgroup < groups0 + groups1 + groups2) {
    which = 2u;
    workgroup -= groups0 + groups1;
    n = n2;
  } else {
    which = 3u;
    workgroup -= groups0 + groups1 + groups2;
    n = n3;
  }
  uint column = workgroup * COLUMNS_PER_GROUP + column_slot * uint(ROWS_PER_SLOT);
  bool column_active = column < n;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint w_base = 0u;
  uint s_base = 0u;
  uint b_base = 0u;
  uint row_base[ROWS_PER_SLOT];
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) {
    row_base[r] = min(column + r, n - 1u);
  }
  precise float acc_t[M_TOKENS][ROWS_PER_SLOT];
  for (uint m = 0u; m < M_TOKENS; ++m) {
    for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) {
      acc_t[m][r] = 0.0;
    }
  }
#ifdef USE_SUBGROUP
#define Q4_TOK_REDUCE() { \
    for (uint m = 0u; m < M_TOKENS; ++m) { \
      for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
        acc_t[m][r] = subgroupAdd(acc_t[m][r]); \
      } \
    } \
  }
#else
// The plain build's five-round shared tree per (token, column), the same
// order Q4_REDUCE runs for the single-token column; the slot lead lane
// holds the total exactly like the single-token store contract.
#define Q4_TOK_REDUCE() { \
    for (uint m = 0u; m < M_TOKENS; ++m) { \
      for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
        reduce_scratch[lane] = acc_t[m][r]; \
        barrier(); \
        for (uint offset = 1u; offset < LANES; offset <<= 1u) { \
          if ((lane_in_slot & (2u * offset - 1u)) == 0u) { \
            reduce_scratch[lane] += reduce_scratch[lane + offset]; \
          } \
          barrier(); \
        } \
        acc_t[m][r] = reduce_scratch[lane]; \
      } \
    } \
  }
#endif
#define Q4_TOK_ROWS(W, S, B) { \
    if (column_active) { \
      if (params.matrix_k % 512u == 0u && n % 8u == 0u) { \
        for (uint w = lane_in_slot * 2u; w < words_per_row; \
             w += LANES * 2u) { \
          Q4_TOK_BLOCK(W, S, B, 2u) \
        } \
      } else { \
        for (uint w = lane_in_slot; w < words_per_row; w += LANES) { \
          Q4_TOK_BLOCK(W, S, B, 1u) \
        } \
      } \
    } \
  }
  if ((params.flags & 65536u) != 0u) {
    // SwiGLU store epilogue: weight 0 is the gate, weight 1 the up; the
    // product row is silu(gate)*up rounded through ROUND_STORAGE exactly
    // as the single-token path and swiglu.comp round it.
    float gate_rounded[M_TOKENS][ROWS_PER_SLOT];
    Q4_TOK_ROWS(input_w0, scales0, biases0)
    Q4_TOK_REDUCE()
    for (uint m = 0u; m < M_TOKENS; ++m) {
      for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) {
        gate_rounded[m][r] = ROUND_STORAGE(acc_t[m][r]);
      }
    }
    for (uint m = 0u; m < M_TOKENS; ++m) {
      for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) {
        acc_t[m][r] = 0.0;
      }
    }
    Q4_TOK_ROWS(input_w1, scales1, biases1)
    Q4_TOK_REDUCE()
    if (lane_in_slot == 0u) {
      for (uint m = 0u; m < M_TOKENS; ++m) {
        if (m >= token_count) {
          continue;
        }
        for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) {
          if (column + r < n) {
            float up_rounded = ROUND_STORAGE(acc_t[m][r]);
            float sig = ROUND_STORAGE(1.0 / (1.0 + exp(-gate_rounded[m][r])));
            float silu = ROUND_STORAGE(gate_rounded[m][r] * sig);
            output0.values[m * n + column + r] =
                STORE_VALUE(ROUND_STORAGE(silu * up_rounded));
          }
        }
      }
    }
    return;
  }
  if (which == 0u) {
    Q4_TOK_ROWS(input_w0, scales0, biases0)
  } else if (which == 1u) {
    Q4_TOK_ROWS(input_w1, scales1, biases1)
  } else if (which == 2u) {
    Q4_TOK_ROWS(input_w2, scales2, biases2)
  } else {
    Q4_TOK_ROWS(input_w3, scales3, biases3)
  }
  Q4_TOK_REDUCE()
  if (lane_in_slot == 0u) {
    for (uint m = 0u; m < M_TOKENS; ++m) {
      if (m >= token_count) {
        continue;
      }
      for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) {
        uint column_r = column + r;
        if (column_r < n) {
          float rounded = ROUND_STORAGE(acc_t[m][r]);
          uint out_index = (row0 + m) * n + column_r;
          if (which == 0u) {
            output0.values[out_index] = STORE_VALUE(rounded);
          } else if (which == 1u) {
            output1.values[out_index] = STORE_VALUE(rounded);
          } else if (which == 2u) {
            output2.values[out_index] = STORE_VALUE(rounded);
          } else {
            output3.values[out_index] = STORE_VALUE(rounded);
          }
          if ((params.flags & (256u << which)) != 0u) {
            // Add epilogue: sum = rounded output + addend; the addend
            // row stride is params.in_strides[which] (n for a full
            // (tokens, n) addend, 0 for a broadcast bias vector). The
            // stored value is read back exactly like Q4_MULTI_STORE.
            uint addend_index = m * params.in_strides[which] + column_r;
            if (which == 0u) {
              sum0.values[out_index] = STORE_VALUE(
                  rounded + LOAD_VALUE(addend0.values[addend_index]));
            } else if (which == 1u) {
              sum1.values[out_index] = STORE_VALUE(
                  rounded + LOAD_VALUE(addend1.values[addend_index]));
            } else if (which == 2u) {
              sum2.values[out_index] = STORE_VALUE(
                  rounded + LOAD_VALUE(addend2.values[addend_index]));
            } else {
              sum3.values[out_index] = STORE_VALUE(
                  rounded + LOAD_VALUE(addend3.values[addend_index]));
            }
          }
        }
      }
    }
  }
}
