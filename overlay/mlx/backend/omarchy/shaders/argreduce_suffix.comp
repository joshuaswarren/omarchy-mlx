//
// ArgMin/ArgMax over the last axis. One workgroup handles one row with a
// shared-memory (value, index) reduction. Matches the upstream Metal kernel:
// the running pair starts at the type's extreme with index 0, a candidate
// wins only on a strict compare, ties keep the smaller index (first
// occurrence), and a NaN never wins because every comparison against it is
// false. Floats compare in float32 for every storage dtype; integers
// compare in their exact signed or unsigned width so 64-bit values stay
// distinct.

#version 460
#if defined(USE_FP16) || defined(USE_BF16) || defined(USE_I16) ||              \
    defined(USE_U16)
#extension GL_EXT_shader_16bit_storage : require
#endif
// Requested unconditionally: the byte/half lane helpers below carry
// uint16_t signatures in every variant.
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#if defined(USE_I64) || defined(USE_U64)
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#endif
// every integer storage so 64-bit values never collide in a 24-bit
// mantissa. Byte inputs ride the gather-style word load and the
// constant-shift select chain proven in scatter.comp; half inputs bind a
// uint16_t storage view.
#ifdef USE_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define VAL_TYPE float
#define ACC_LOWEST uintBitsToFloat(0xff800000u)
#define ACC_HIGHEST uintBitsToFloat(0x7f800000u)
#define LOAD_AT(addr) float(input_data.values[addr])
#define AR_IS_FLOAT 1
#elif defined(USE_BF16)
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define STORAGE_TYPE uint16_t
#define VAL_TYPE float
#define ACC_LOWEST uintBitsToFloat(0xff800000u)
#define ACC_HIGHEST uintBitsToFloat(0x7f800000u)
#define LOAD_AT(addr) uintBitsToFloat(uint(input_data.values[addr]) << 16u)
#define AR_IS_FLOAT 1
#elif defined(USE_I8)
#define BYTE 1
#define VAL_TYPE int
#define ACC_LOWEST (-2147483647 - 1)
#define ACC_HIGHEST 2147483647
#define LOAD_AT(addr) byte_extend(input_data.values[(addr) >> 2u], (addr) & 3u)
#elif defined(USE_U8)
#define BYTE 1
#define VAL_TYPE uint
#define ACC_LOWEST 0u
#define ACC_HIGHEST 0xffffffffu
#define LOAD_AT(addr) byte_lane(input_data.values[(addr) >> 2u], (addr) & 3u)
#elif defined(USE_I16)
#define VAL_TYPE int
#define ACC_LOWEST (-2147483647 - 1)
#define ACC_HIGHEST 2147483647
#define LOAD_AT(addr) half_extend(input_data.values[addr])
#elif defined(USE_U16)
#define VAL_TYPE uint
#define ACC_LOWEST 0u
#define ACC_HIGHEST 0xffffffffu
#define LOAD_AT(addr) uint(input_data.values[addr])
#elif defined(USE_I32)
#define STORAGE_TYPE int
#define VAL_TYPE int
#define ACC_LOWEST (-2147483647 - 1)
#define ACC_HIGHEST 2147483647
#define LOAD_AT(addr) input_data.values[addr]
#elif defined(USE_U32)
#define STORAGE_TYPE uint
#define VAL_TYPE uint
#define ACC_LOWEST 0u
#define ACC_HIGHEST 0xffffffffu
#define LOAD_AT(addr) input_data.values[addr]
#elif defined(USE_I64)
#define STORAGE_TYPE int64_t
#define VAL_TYPE int64_t
#define ACC_LOWEST (-9223372036854775807L - 1)
#define ACC_HIGHEST 9223372036854775807L
#define LOAD_AT(addr) input_data.values[addr]
#elif defined(USE_U64)
#define STORAGE_TYPE uint64_t
#define VAL_TYPE uint64_t
#define ACC_LOWEST 0UL
#define ACC_HIGHEST 0xffffffffffffffffUL
#define LOAD_AT(addr) input_data.values[addr]
#else
#define STORAGE_TYPE float
#define VAL_TYPE float
#define ACC_LOWEST uintBitsToFloat(0xff800000u)
#define ACC_HIGHEST uintBitsToFloat(0x7f800000u)
#define LOAD_AT(addr) float(input_data.values[addr])
#define AR_IS_FLOAT 1
#endif

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Input {
#ifdef BYTE
  uint values[];
#elif defined(USE_I16) || defined(USE_U16)
  uint16_t values[];
#else
  STORAGE_TYPE values[];
#endif
} input_data;
layout(set = 0, binding = 2, std430) writeonly buffer Output {
  uint values[];
} output_data;

// Honeykrisp miscompiles shift-then-mask byte extraction with a
// data-dependent shift amount (receipt 2026-09-02-masked-scatter-m1-fix,
// diag68); the constant-shift select chain is the receipt-proven
// equivalent (the same macro compare_bool.comp and cast_int.comp use).
uint byte_lane(uint word, uint lane) {
  return (lane) == 0u ? ((word) & 0xFFu)
       : (lane) == 1u ? (((word) >> 8u) & 0xFFu)
       : (lane) == 2u ? (((word) >> 16u) & 0xFFu)
                      : (((word) >> 24u) & 0xFFu);
}
int byte_extend(uint word, uint lane) {
  uint byte = byte_lane(word, lane);
  return (byte & 0x80u) != 0u ? int(byte) - 256 : int(byte);
}
int half_extend(uint16_t bits) {
  uint extended = uint(bits);
  return (extended & 0x8000u) != 0u ? int(extended) - 65536 : int(extended);
}
layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint flags;
} params;

shared VAL_TYPE block_values[256];
shared uint block_indices[256];

// Each thread walks its strided elements (thread, thread + 256, ...) in
// ascending order. The walk issues the loads of 16 consecutive steps before
// the compares consume them in the same order (one element per memory round
// trip made a 248320-wide logits row latency-bound at ~0.5 ms); every
// thread's (value, index) pair, and so the result, is unchanged.
//
// Float inputs follow the mlx reduction semantics: NaN propagates and the
// FIRST NaN index wins (upstream arg_reduce_tests.cpp "test arg reduce
// NaN"). A challenger therefore beats the incumbent only when the
// challenger is NaN and the incumbent is not (within a thread the walk is
// ascending, so a later NaN never displaces an earlier one; in the
// cross-thread tree the index tiebreak keeps the first NaN). Integer
// inputs keep the plain strict compare.
#if defined(AR_IS_FLOAT)
#define AR_CHALLENGES(next, incumbent) \
  (isnan(next) ? !isnan(incumbent) \
               : (!isnan(incumbent) && \
                  (is_max ? (next) > (incumbent) : (next) < (incumbent))))
#define AR_CHALLENGES_AT(next, incumbent, next_index, incumbent_index) \
  (isnan(next) ? (!isnan(incumbent) || (next_index) < (incumbent_index)) \
               : (!isnan(incumbent) && \
                  (((is_max ? (next) > (incumbent) : (next) < (incumbent))) || \
                   ((next) == (incumbent) && \
                    (next_index) < (incumbent_index)))))
#else
#define AR_CHALLENGES(next, incumbent) \
  (is_max ? (next) > (incumbent) : (next) < (incumbent))
#define AR_CHALLENGES_AT(next, incumbent, next_index, incumbent_index) \
  (((is_max ? (next) > (incumbent) : (next) < (incumbent))) || \
   ((next) == (incumbent) && (next_index) < (incumbent_index)))
#endif
#define AR_LOAD(b) VAL_TYPE v##b = LOAD_AT(base + (b) * 256u);
#define AR_LOAD16 AR_LOAD(0u) AR_LOAD(1u) AR_LOAD(2u) AR_LOAD(3u) AR_LOAD(4u) \
  AR_LOAD(5u) AR_LOAD(6u) AR_LOAD(7u) AR_LOAD(8u) AR_LOAD(9u) AR_LOAD(10u) \
  AR_LOAD(11u) AR_LOAD(12u) AR_LOAD(13u) AR_LOAD(14u) AR_LOAD(15u)
#define AR_STEP(b) { \
  bool wins = AR_CHALLENGES(v##b, local_value); \
  if (wins) { \
    local_value = v##b; \
    local_index = index + (b) * 256u; \
  } \
}
#define AR_STEP16 AR_STEP(0u) AR_STEP(1u) AR_STEP(2u) AR_STEP(3u) AR_STEP(4u) \
  AR_STEP(5u) AR_STEP(6u) AR_STEP(7u) AR_STEP(8u) AR_STEP(9u) AR_STEP(10u) \
  AR_STEP(11u) AR_STEP(12u) AR_STEP(13u) AR_STEP(14u) AR_STEP(15u)

void main() {
  uint thread = gl_LocalInvocationID.x;
  uint row_length = params.reduce_size;
  bool is_max = params.operation == 1u;
  for (uint row = gl_WorkGroupID.x; row < params.output_size;
       row += gl_NumWorkGroups.x) {
    uint start = params.lhs_offset + row * row_length;
    VAL_TYPE local_value = is_max ? ACC_LOWEST : ACC_HIGHEST;
    uint local_index = 0u;
    // Flag bit 31: legacy walk, one load per element per round trip,
    // identical element order and compares (bit-identical to the
    // prefetch arm; chosen per chip and by
    // MLX_OMARCHY_LSE_ARGREDUCE_PREFETCH).
    if ((params.flags & 0x80000000u) != 0u) {
      for (uint index = thread; index < row_length; index += 256u) {
        VAL_TYPE next = LOAD_AT(start + index);
        bool wins = AR_CHALLENGES(next, local_value);
        if (wins) {
          local_value = next;
          local_index = index;
        }
      }
    } else {
      uint index = thread;
      for (; index + 15u * 256u < row_length; index += 16u * 256u) {
        uint base = start + index;
        AR_LOAD16
        AR_STEP16
      }
      for (; index < row_length; index += 256u) {
        VAL_TYPE next = LOAD_AT(start + index);
        bool wins = AR_CHALLENGES(next, local_value);
        if (wins) {
          local_value = next;
          local_index = index;
        }
      }
    }
    block_values[thread] = local_value;
    block_indices[thread] = local_index;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (thread < stride) {
        VAL_TYPE mine = block_values[thread];
        VAL_TYPE theirs = block_values[thread + stride];
        bool wins = AR_CHALLENGES_AT(
            theirs,
            mine,
            block_indices[thread + stride],
            block_indices[thread]);
        if (wins) {
          block_values[thread] = theirs;
          block_indices[thread] = block_indices[thread + stride];
        }
      }
      barrier();
    }
    output_data.values[params.output_offset + row] = block_indices[0];
    barrier();
  }
}
