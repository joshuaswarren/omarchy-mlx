+std::vector<array> gdn_conv_delta_update(
+    const array& conv_state,
+    const array& qkv,
+    const array& conv_weight,
+    const array& a_in,
+    const array& b_in,
+    const array& A_log,
+    const array& dt_bias,
+    const array& delta_state,
+    int key_dim,
+    float qk_scale_q,
+    float qk_scale_k,
+    float qk_eps,
+    const std::optional<array>& norm_gate,
+    const std::optional<array>& norm_weight,
+    float norm_eps,
+    StreamOrDevice s_) {
+  auto s = to_stream(s_);
+  if (norm_gate.has_value() != norm_weight.has_value()) {
+    throw std::invalid_argument(
+        "[gdn_conv_delta_update] norm_gate and norm_weight go together");
+  }
+  // The composition the model runs today: the fused conv (SiLU and the q/k
+  // norm folded), the q|k|v split, the raw-gates gated-delta step and, when
+  // asked, the gated norm.
+  auto fallback = [s, key_dim, qk_scale_q, qk_scale_k, qk_eps, norm_eps](
+                      std::vector<array> in) {
+    auto conv = gdn_conv_update(
+        in[0], in[1], in[2], true, key_dim, qk_scale_q, qk_scale_k, qk_eps, s);
+    int b = in[1].shape(0);
+    int heads = key_dim / 128;
+    int v_heads = (in[1].shape(2) - 2 * key_dim) / 128;
+    auto parts = split(conv[0], {key_dim, 2 * key_dim}, -1, s);
+    auto delta = gated_delta_update_raw(
+        reshape(parts[0], Shape{b, 1, heads, 128}, s),
+        reshape(parts[1], Shape{b, 1, heads, 128}, s),
+        reshape(parts[2], Shape{b, 1, v_heads, 128}, s),
+        in[3],
+        in[4],
+        in[5],
+        in[6],
+        in[7],
+        std::nullopt,
+        s);
+    array y = in.size() == 10 ? rms_norm_gated(delta[0], in[8], in[9], norm_eps, s)
+                              : delta[0];
+    return std::vector<array>{y, delta[1], conv[1]};
+  };
+  std::vector<array> inputs{
+      conv_state, qkv, conv_weight, a_in, b_in, A_log, dt_bias, delta_state};
+  if (norm_gate.has_value()) {
+    inputs.push_back(*norm_gate);
+    inputs.push_back(*norm_weight);
+  }
+  if (GdnConvDeltaUpdate::use_fallback(inputs, key_dim, s)) {
+    return fallback(inputs);
+  }
+  int B = qkv.shape(0);
+  int C = qkv.shape(2);
+  int K = conv_weight.shape(1);
+  int Hv = a_in.shape(2);
+  return array::make_arrays(
+      /* output shapes */ {{B, 1, Hv, 128}, {B, Hv, 128, 128}, {B, K - 1, C}},
+      /* dtypes */ {bfloat16, float32, bfloat16},
+      /* primitive */
+      std::make_shared<GdnConvDeltaUpdate>(
+          s, fallback, key_dim, qk_scale_q, qk_scale_k, qk_eps, norm_eps),
+      /* inputs */ inputs);
+}
