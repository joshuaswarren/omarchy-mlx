+  // 128 with the conv state concatenation folded into the read. The value
+  // segment must be Hv * 128 so the primitive's fixed output shapes are
+  // exact; everything else composes the exact model ops.
+  static bool use_fallback(
+      const array& conv_state,
+      const array& state,
+      const array& x,
+      const array& weight,
+      const array& a_in,
+      const array& b_in,
+      const array& A_log,
