+std::vector<array> gdn_conv_delta_update(
+    const array& conv_state,
+    const array& state,
+    const array& x,
+    const array& weight,
+    const array& a_in,
+    const array& b_in,
+    const array& A_log,
+    const array& dt_bias,
+    bool activate,
+    int qk_key_dim,
+    float qk_scale_q,
+    float qk_scale_k,
+    float qk_eps,
+    StreamOrDevice s_) {
+  auto s = to_stream(s_);
+  if (qk_key_dim <= 0 || qk_key_dim % 128 != 0) {
+    throw std::invalid_argument(
+        "gdn_conv_delta_update requires qk_key_dim > 0 and a multiple of 128");
+  }
+  // Fallback composes the exact chain the fused dispatch replaces:
+  // gdn_conv_update (conv + silu + ring + the q/k rms_norm_scaled pair),
+  // the per-head split/reshape, and the raw-gates decode update. Every
+  // intermediate is the model's own op output, so the composition is the
+  // deployed decode path verbatim.
+  auto fallback = [s, activate, qk_key_dim, qk_scale_q, qk_scale_k, qk_eps](
+                      std::vector<array> inputs) {
+    auto conv = gdn_conv_update(
+        inputs[0],
+        inputs[2],
+        inputs[3],
+        activate,
+        qk_key_dim,
+        qk_scale_q,
+        qk_scale_k,
+        qk_eps,
+        s);
+    auto& conv_out = conv[0];
+    int b = conv_out.shape(0);
+    int t = conv_out.shape(1);
+    int value_dim = conv_out.shape(2) - 2 * qk_key_dim;
+    int hv = inputs[5].shape(-1);
+    int hk = qk_key_dim / 128;
+    int head_k = qk_key_dim / hk;
+    if (value_dim % hv != 0) {
+      throw std::invalid_argument(
+          "gdn_conv_delta_update value_dim is not a multiple of the value "
+          "head count");
+    }
+    int head_v = value_dim / hv;
+    auto parts = split(conv_out, Shape{qk_key_dim, 2 * qk_key_dim}, -1, s);
+    auto q = reshape(parts[0], Shape{b, t, hk, head_k}, s);
+    auto k = reshape(parts[1], Shape{b, t, hk, head_k}, s);
+    auto v = reshape(parts[2], Shape{b, t, hv, head_v}, s);
+    auto r = gated_delta_update_raw(
+        q,
+        k,
+        v,
+        inputs[4],
+        inputs[5],
+        inputs[6],
+        inputs[7],
+        inputs[1],
+        std::nullopt,
+        s);
+    return std::vector<array>{r[0], conv[1], r[1]};
+  };
+  if (GdnConvDeltaUpdate::use_fallback(
+          conv_state, state, x, weight, a_in, b_in, A_log, dt_bias, s)) {
+    return fallback({conv_state, state, x, weight, a_in, b_in, A_log, dt_bias});
+  }
+  // The primitive's fixed output shapes assume 128-wide heads and the
+  // value segment = Hv * 128; anything else composes (the exact chain the
+  // fused route replaces).
+  int value_dim = x.shape(2) - 2 * qk_key_dim;
+  int hv_check = b_in.shape(-1);
+  if (value_dim <= 0 || value_dim != hv_check * 128 ||
+      hv_check % a_in.shape(-1) != 0) {
+    return fallback({conv_state, state, x, weight, a_in, b_in, A_log, dt_bias});
+  }
+  int B = x.shape(0);
+  int C = x.shape(2);
+  int K = weight.shape(1);
+  int Hv = b_in.shape(-1);
