+      /* output shapes */
+      {{B, 1, Hv, 128}, {B, K - 1, C}, {B, Hv, 128, 128}},
+      /* dtypes */ {bfloat16, bfloat16, float32},
+      /* primitive */
+      std::make_shared<GdnConvDeltaUpdate>(
+          s,
+          fallback,
+          activate,
+          qk_key_dim,
+          qk_scale_q,
+          qk_scale_k,
+          qk_eps),
+      /* inputs */
+      std::vector<array>{conv_state, state, x, weight, a_in, b_in, A_log, dt_bias});
+}
