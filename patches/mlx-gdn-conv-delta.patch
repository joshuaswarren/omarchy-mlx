+// Fused GDN decode conv + gated-delta step (MLX_OMARCHY_GDN_CONV_DELTA=1, default off). Qwen3.8-2B
+// geometry only: B == 1, bf16, head dim 128, equal key and value head counts, 4 conv taps. Everything
+// else, the flag being off, and non-GPU streams compose gdn_conv_update + gated_delta_update_raw.
+class GdnConvDeltaUpdate : public Custom {
+ public:
+  GdnConvDeltaUpdate(
+      Stream stream,
+      std::function<std::vector<array>(std::vector<array>)> fallback,
+      int key_dim,
+      float qk_scale_q,
+      float qk_scale_k,
+      float qk_eps)
+      : Custom(stream, std::move(fallback)),
+        key_dim_{key_dim},
+        qk_scale_q_{qk_scale_q},
+        qk_scale_k_{qk_scale_k},
+        qk_eps_{qk_eps} {}
+  // Inputs: conv state [1, K-1, C], qkv [1, 1, C], conv weight [C, K, 1], a [1, 1, Hv], b [1, 1, Hv],
+  // A_log [Hv], dt_bias [Hv] (all bf16), recurrent state [1, Hv, 128, 128] (f32).
+  static bool use_fallback(
+      const std::vector<array>& in,
+      int key_dim,
+      Stream s) {
+    const char* flag = std::getenv("MLX_OMARCHY_GDN_CONV_DELTA");
+    if (s.device == Device::cpu || flag == nullptr || flag[0] != '1' ||
+        flag[1] != '\0' || in.size() != 8 || key_dim <= 0 || key_dim % 128 != 0) {
+      return true;
+    }
+    const array& state = in[0];
+    const array& x = in[1];
+    const array& weight = in[2];
+    if (state.ndim() != 3 || x.ndim() != 3 || weight.ndim() != 3 ||
+        in[3].ndim() != 3 || in[4].ndim() != 3 || in[5].ndim() != 1 ||
+        in[6].ndim() != 1 || in[7].ndim() != 4) {
+      return true;
+    }
+    const int C = x.shape(2);
+    const int Hv = (C - 2 * key_dim) / 128;
+    for (int i = 0; i < 7; ++i) {
+      if (in[i].dtype() != bfloat16) {
+        return true;
+      }
+    }
+    return in[7].dtype() != float32 || x.shape(0) != 1 || x.shape(1) != 1 ||
+        state.shape(0) != 1 || state.shape(2) != C ||
+        weight.shape(0) != C || weight.shape(1) != 4 || weight.shape(2) != 1 ||
+        state.shape(1) != 3 || C != 3 * key_dim || Hv != key_dim / 128 ||
+        in[3].shape(2) != Hv || in[4].shape(2) != Hv || in[5].shape(0) != Hv ||
+        in[6].shape(0) != Hv || in[7].shape(1) != Hv || in[7].shape(2) != 128 ||
+        in[7].shape(3) != 128;
+  }
+  void eval_cpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override {
+    throw std::runtime_error("NYI");
+  }
+  void eval_gpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override;
+  int key_dim() const {
+    return key_dim_;
+  }
+  float qk_scale_q() const {
+    return qk_scale_q_;
+  }
+  float qk_scale_k() const {
+    return qk_scale_k_;
+  }
+  float qk_eps() const {
+    return qk_eps_;
+  }
+  DEFINE_NAME(GdnConvDeltaUpdate)
+  DEFINE_INPUT_OUTPUT_SHAPE()
+
+ private:
+  int key_dim_;
+  float qk_scale_q_;
+  float qk_scale_k_;
+  float qk_eps_;
+};
