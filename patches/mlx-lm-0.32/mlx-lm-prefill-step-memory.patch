@@ -48,6 +48,61 @@
 DEFAULT_PREFILL_STEP_SIZE = 2048
 
 
+# Memory-aware prefill chunk (mlx-omarchy). Honeykrisp's heap is mesa's 50% of MemTotal unless HK_SYSMEM says otherwise. On a
+# 16 GB host that leaves a 9B 4-bit model about 3 GiB for the prefill chunk, and the 2048-token default fails there with
+# VK_ERROR_OUT_OF_DEVICE_MEMORY at an 8k prompt (512 completes). When the caller gives no chunk, take the largest of the old
+# default and its halvings whose estimated scratch fits the heap headroom. An explicit value always wins and the result never
+# exceeds 2048, so a host with room is unchanged. The estimate is serve/mlx_omarchy_serve/budget.py PREFILL_*;
+# tests/test_mlxlm_prefill_step.py keeps the two in step.
+_OMARCHY_PREFILL_TOKEN_BYTES = 161 * 1024
+_OMARCHY_PREFILL_SCORE_HEADS = 32
+_OMARCHY_PREFILL_SCORE_TENSOR_BYTES = 8
+_OMARCHY_PREFILL_MARGIN = 1.15
+_OMARCHY_PREFILL_STEPS = (2048, 1024, 512, 256, 128, 64)
+
+
+def _omarchy_prefill_step(requested, context_tokens, headroom_bytes):
+    if requested is not None:
+        return requested
+    if headroom_bytes is None:
+        return _OMARCHY_PREFILL_STEPS[0]
+    for step in _OMARCHY_PREFILL_STEPS:
+        tokens = min(step, context_tokens)
+        scratch = (
+            tokens * _OMARCHY_PREFILL_TOKEN_BYTES
+            + tokens
+            * context_tokens
+            * _OMARCHY_PREFILL_SCORE_HEADS
+            * _OMARCHY_PREFILL_SCORE_TENSOR_BYTES
+        ) * _OMARCHY_PREFILL_MARGIN
+        if scratch <= headroom_bytes:
+            return step
+    return _OMARCHY_PREFILL_STEPS[-1]
+
+
+def _omarchy_prefill_headroom_bytes():
+    """Honeykrisp heap bytes not held by live arrays, or None where this does not apply."""
+    import importlib.metadata
+    import os
+
+    try:
+        importlib.metadata.version("mlx-omarchy")
+        with open("/proc/meminfo") as meminfo:
+            heap = int(meminfo.readline().split()[1]) * 1024 // 2
+        override = os.environ.get("HK_SYSMEM", "")
+        if override.isdigit():
+            heap = int(override)
+        return heap - mx.get_active_memory()
+    except (
+        importlib.metadata.PackageNotFoundError,
+        OSError,
+        ValueError,
+        IndexError,
+        AttributeError,
+    ):
+        return None
+
+
 def str2bool(string):
     return string.lower() not in ["false", "f"]
 
