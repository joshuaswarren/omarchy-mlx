+# KV reserve (mlx-omarchy). KVCache grows by one block per prefill chunk, and each growth builds the larger buffer while the old
+# one is alive. On a 13-inch M1 (15.1 GiB), a 16384-token prompt on Qwen3-4B 4-bit failed twice at a growth step with a GPU
+# allocation error and completed when the cache was allocated once. generate_step now tells each KVCache how many tokens the
+# call needs: the prompt plus the first decode tokens, up to a bound so a short prompt with a huge max_tokens does not hold KV
+# it will not use. Quantized KV and the other cache classes are unchanged. MLX_OMARCHY_KV_PRESIZE=0 restores upstream growth.
+# The chunk is chosen before the cache exists, so that choice cannot count it. With a reserve the first chunk makes the cache
+# resident, and generate_step then chooses the chunk again from the headroom that is left. The new choice never exceeds the old.
+_OMARCHY_KV_DECODE_RESERVE = 1024
+_OMARCHY_PREFILL_WORKSPACE_BYTES = 1 << 30
+
+
+def _omarchy_reserve_kv(prompt_cache, prompt_tokens, max_tokens, kv_bits):
+    """Set the reserve on each KVCache. True when the first prefill chunk will make the cache resident."""
+    if kv_bits is not None or os.environ.get("MLX_OMARCHY_KV_PRESIZE") == "0":
+        return False
+    decode = _OMARCHY_KV_DECODE_RESERVE
+    if max_tokens >= 0:
+        decode = min(max_tokens, decode)
+    reserved = False
+    for c in prompt_cache:
+        if isinstance(c, KVCache):
+            c.reserve = c.offset + prompt_tokens + decode
+            reserved = True
+    return reserved
+
+
+def _omarchy_rechoose_step(step, prompt_cache, remaining_tokens):
+    headroom = _omarchy_prefill_headroom_bytes()
+    if headroom is None:
+        return step
+    context = max((getattr(c, "offset", 0) for c in prompt_cache), default=0) + remaining_tokens
+    return min(step, _omarchy_prefill_step(None, context, headroom - _OMARCHY_PREFILL_WORKSPACE_BYTES))
+
+
 def str2bool(string):
     return string.lower() not in ["false", "f"]
 
