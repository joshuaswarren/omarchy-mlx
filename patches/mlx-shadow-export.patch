--- a/python/src/buffer.h	2026-11-25 11:55:09.640271563 -0600
+++ b/python/src/buffer.h	2026-11-25 11:55:09.620271736 -0600
@@ -7,6 +7,9 @@
 #include "mlx/array.h"
 #include "mlx/utils.h"
 #include "mlx/ops.h"
+#ifdef MLX_OMARCHY_BACKEND
+#include "mlx/backend/omarchy/allocator.h"
+#endif
 
 // Only defined in >= Python 3.9
 // https://github.com/python/cpython/blob/f6cdc6b4a191b75027de342aa8b5d344fb31313e/Include/typeslots.h#L2-L3
@@ -99,6 +102,22 @@
       nb::gil_scoped_release nogil;
       a.eval();
     }
+#ifdef MLX_OMARCHY_BACKEND
+    // Shadow-backed buffers (device-local or inference-weight placement) are
+    // unmapped: their host storage is a detached shadow that device writes
+    // can rewrite. Buffer views over them are read-only snapshots, and
+    // writable requests fail rather than exposing an alias whose edits never
+    // reach the device. Hold mx.array(np.frombuffer(...)) copies for stable
+    // data; mapped placements keep true aliasing.
+    const bool shadow = mx::omarchy::buffer_is_shadow(a.buffer());
+    if (shadow && (flags & PyBUF_WRITABLE) == PyBUF_WRITABLE) {
+      PyErr_SetString(PyExc_BufferError,
+                      "buffer is read-only: shadow-backed device memory");
+      return -1;
+    }
+#else
+    const bool shadow = false;
+#endif
 
     // Flags are valid only after eval: a lazy array's descriptor starts
     // with every flag true; eval installs the real values.
@@ -164,7 +183,7 @@
     view->buf = p.data<void>();
     view->itemsize = p.itemsize();
     view->len = p.nbytes();
-    view->readonly = copied;  // a packed copy is detached; the array is not
+    view->readonly = copied || shadow;  // a packed copy is detached; the array is not
     if ((flags & PyBUF_FORMAT) == PyBUF_FORMAT) {
       view->format = const_cast<char*>(info->format.c_str());
     }
