+array rms_norm_gated(
+    const array& x,
+    const array& gate,
+    const array& weight,
+    float eps,
+    StreamOrDevice s_ /* = {} */) {
+  if (x.ndim() == 0) {
+    std::ostringstream msg;
+    msg << "[rms_norm_gated] Input must have at least 1 dimension but got "
+           "input with 0 dimensions.";
+    throw std::invalid_argument(msg.str());
+  }
+  if (gate.shape() != x.shape()) {
+    std::ostringstream msg;
+    msg << "[rms_norm_gated] Gate must have the same shape as x; got gate "
+        << gate.shape() << " for x " << x.shape() << ".";
+    throw std::invalid_argument(msg.str());
+  }
+  if (weight.ndim() != 1) {
+    std::ostringstream msg;
+    msg << "[rms_norm_gated] weight must have 1 dimension but has "
+        << weight.ndim() << " dimensions.";
+    throw std::invalid_argument(msg.str());
+  }
+  if (!(weight.size() == 1 || weight.size() == x.shape(-1))) {
+    std::ostringstream msg;
+    msg << "[rms_norm_gated] weight must have one element or the same size "
+           "as the last dimension of x but has "
+        << weight.size() << " elements.";
+    throw std::invalid_argument(msg.str());
+  }
+
+  auto out_type = result_type(x, weight);
+  if (!issubdtype(out_type, floating)) {
+    std::ostringstream msg;
+    msg << "[rms_norm_gated] Received unsupported type " << out_type << ".";
+    throw std::invalid_argument(msg.str());
+  }
+  if (!issubdtype(gate.dtype(), floating)) {
+    std::ostringstream msg;
+    msg << "[rms_norm_gated] Received unsupported gate type "
+        << gate.dtype() << ".";
+    throw std::invalid_argument(msg.str());
+  }
+
+  auto s = to_stream(s_);
+  // Bit-exact to mlx-lm's Qwen3NextRMSNormGated: rms_norm then
+  // silu(gate_f32) * normed_f32, rounded once to the input dtype.
+  auto fallback = [eps, out_type, s](const std::vector<array>& inputs) {
+    auto y = rms_norm(inputs[0], inputs[2], eps, s);
+    auto g = astype(inputs[1], float32, s);
+    auto silu = multiply(g, sigmoid(g, s), s);
+    auto out = multiply(astype(y, float32, s), silu, s);
+    return std::vector<array>{astype(out, out_type, s)};
+  };
+
+  if (!RMSNormGated::use_fallback(s)) {
+    return array(
+        x.shape(),
+        out_type,
+        std::make_shared<RMSNormGated>(s, fallback, eps),
+        {astype(x, out_type, s),
+         astype(gate, out_type, s),
+         astype(weight, out_type, s)});
+  }
+  return fallback({x, gate, weight})[0];
+}
+
+array rms_norm_scaled(
+    const array& x,
+    const std::optional<array>& weight,
+    float scale,
+    float eps,
+    StreamOrDevice s_ /* = {} */) {
+  if (x.ndim() == 0) {
+    std::ostringstream msg;
+    msg << "[rms_norm_scaled] Input must have at least 1 dimension but got "
+           "input with 0 dimensions.";
+    throw std::invalid_argument(msg.str());
+  }
+  if (weight.has_value()) {
+    if ((*weight).ndim() != 1) {
+      std::ostringstream msg;
+      msg << "[rms_norm_scaled] weight must have 1 dimension but has "
+          << (*weight).ndim() << " dimensions.";
+      throw std::invalid_argument(msg.str());
+    }
+    if (!((*weight).size() == 1 || (*weight).size() == x.shape(-1))) {
+      std::ostringstream msg;
+      msg << "[rms_norm_scaled] weight must have one element or the same "
+             "size as the last dimension of x but has "
+          << (*weight).size() << " elements.";
+      throw std::invalid_argument(msg.str());
+    }
+  }
+
+  auto out_type = (weight.has_value()) ? result_type(x, (*weight)) : x.dtype();
+  if (!issubdtype(out_type, floating)) {
+    std::ostringstream msg;
+    msg << "[rms_norm_scaled] Received unsupported type " << out_type << ".";
+    throw std::invalid_argument(msg.str());
+  }
+
+  auto s = to_stream(s_);
+  // Bit-exact to `scale * mx.fast.rms_norm(x, weight, eps)`: the scalar
+  // wraps as float32 and the multiply promotes exactly like the graph.
+  // The weightless leg (the qwen3.5 qk-scaled q/k path calls this with
+  // weight = None) must differentiate through a WEIGHTLESS rms_norm: the
+  // {1} placeholder is a 0-D array and fast::rms_norm refuses 0-D
+  // weights, so routing the placeholder through the fallback threw
+  // "[rms_norm] (*weight) must have 1 dimension but has 0 dimensions."
+  // on the first backward of every weightless scaled norm while the
+  // forward ran fused (found by the M2Lane 2B LoRA smoke, 2026-10-04).
+  const bool has_weight = weight.has_value();
+  auto fallback = [scale, eps, out_type, s, has_weight](
+                      const std::vector<array>& inputs) {
+    auto y = has_weight ? rms_norm(inputs[0], inputs[1], eps, s)
+                        : rms_norm(inputs[0], std::nullopt, eps, s);
+    return std::vector<array>{multiply(array(scale, float32), y, s)};
+  };
+
+  auto passed_weight =
+      (weight.has_value()) ? astype(*weight, out_type, s) : array(1, out_type);
+  if (!RMSNormScaled::use_fallback(s)) {
+    return array(
+        x.shape(),
+        out_type,
+        std::make_shared<RMSNormScaled>(s, fallback, eps, scale),
+        {astype(x, out_type, s), passed_weight});
+  }
+  return fallback({x, passed_weight})[0];
+}
