+// Inputs (queries, keys, weights); single 16-bit-float output. See
+// fast::dsa_indexer_scores. The composed fallback materializes three
+// [B,H,L,K] 16-bit passes (scores, relu, weighted) before the head
+// sum; the Omarchy GPU route fuses all of it into one dispatch
+// (shaders/dsa_indexer.comp) with float32 accumulation.
+class DsaIndexerScores : public Custom {
+ public:
+  DsaIndexerScores(
+      Stream stream,
+      std::function<std::vector<array>(std::vector<array>)> fallback,
+      bool causal,
+      int causal_q_offset,
+      int mask_ratio)
+      : Custom(stream, std::move(fallback)),
+        causal_(causal),
+        causal_q_offset_(causal_q_offset),
+        mask_ratio_(mask_ratio) {}
+
+  static bool use_fallback(Stream s);
+
+  bool causal() const {
+    return causal_;
+  }
+  int causal_q_offset() const {
+    return causal_q_offset_;
+  }
+  int mask_ratio() const {
+    return mask_ratio_;
+  }
+
+  void eval_cpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override {
+    throw std::runtime_error("NYI");
+  }
+
+  void eval_gpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override;
+
+  DEFINE_NAME(DsaIndexerScores);
+  bool is_equivalent(const Primitive& other) const override {
+    const auto& p = static_cast<const DsaIndexerScores&>(other);
+    return p.causal_ == causal_ && p.causal_q_offset_ == causal_q_offset_ &&
+        p.mask_ratio_ == mask_ratio_;
+  }
+  auto state() const {
+    return std::make_tuple(nullptr, causal_, causal_q_offset_, mask_ratio_);
+  }
+
+ private:
+  bool causal_;
+  int causal_q_offset_;
+  int mask_ratio_;
+};
