+array dsa_indexer_scores(
+    const array& queries,
+    const array& keys,
+    const array& weights,
+    bool causal,
+    int causal_q_offset,
+    int mask_ratio,
+    StreamOrDevice s_) {
+  auto s = to_stream(s_);
+  if (queries.ndim() != 4 || keys.ndim() != 4 || weights.ndim() != 3) {
+    throw std::invalid_argument(
+        "[dsa_indexer_scores] q/k must be 4D and weights 3D.");
+  }
+  int B = queries.shape(0);
+  int H = queries.shape(1);
+  int L = queries.shape(2);
+  int D = queries.shape(3);
+  if (keys.shape(0) != B || keys.shape(1) != 1 || keys.shape(3) != D) {
+    throw std::invalid_argument(
+        "[dsa_indexer_scores] keys must be [B, 1, K, D] matching queries.");
+  }
+  if (weights.shape() != Shape{B, L, H}) {
+    throw std::invalid_argument(
+        "[dsa_indexer_scores] weights must be [B, L, H].");
+  }
+  if (H != 32 && H != 64) {
+    throw std::invalid_argument(
+        "[dsa_indexer_scores] H must be 32 or 64.");
+  }
+  if (D != 128) {
+    throw std::invalid_argument("[dsa_indexer_scores] D must be 128.");
+  }
+  if (keys.shape(2) < 64) {
+    throw std::invalid_argument("[dsa_indexer_scores] K must be >= 64.");
+  }
+  auto dtype = queries.dtype();
+  if (dtype != float16 && dtype != bfloat16) {
+    throw std::invalid_argument(
+        "[dsa_indexer_scores] q/k/w must be float16 or bfloat16.");
+  }
+  if (keys.dtype() != dtype || weights.dtype() != dtype) {
+    throw std::invalid_argument("[dsa_indexer_scores] dtype mismatch.");
+  }
+  if (causal && causal_q_offset < 0) {
+    causal_q_offset = keys.shape(2) - L;
+  }
+  if (mask_ratio < 0) {
+    throw std::invalid_argument(
+        "[dsa_indexer_scores] mask_ratio must be >= 0.");
+  }
+  // Accumulation and masking run in float32; the only 16-bit round is
+  // the final store, which matches the metal kernel's contract.
+  std::function<std::vector<array>(std::vector<array>)> fallback =
+      [s, causal, causal_q_offset, mask_ratio, B, L, H, D](
+          std::vector<array> inputs) {
+        auto dt = inputs[0].dtype();
+        array floor_min = astype(
+            array(std::numeric_limits<float>::lowest()), dt, s);
+        // scores [B, H, L, K] via batched matmul over the head axis.
+        array scores = matmul(
+            inputs[0], swapaxes(inputs[1], -1, -2, s), s);
+        int Kk = scores.shape(3);
+        int off = causal_q_offset;
+        array l_idx = expand_dims(
+            expand_dims(arange(L, int32, s), 0, s), -1, s);
+        array c_idx = expand_dims(
+            expand_dims(arange(Kk, int32, s), 0, s), 0, s);
+        std::vector<array> masks;
+        if (mask_ratio > 0) {
+          array thr = floor_divide(
+              array(off + 1) + l_idx, array(mask_ratio), s);
+          masks.push_back(less(c_idx, thr, s));
+        }
+        if (causal) {
+          masks.push_back(
+              less_equal(c_idx, array(off) + l_idx, s));
+        }
+        array valid = masks[0];
+        for (size_t i = 1; i < masks.size(); ++i) {
+          valid = logical_and(valid, masks[i], s);
+        }
+        array masked = where(valid, scores, floor_min, s);
+        array relu = maximum(masked, array(0.0f), s);
+        array wq = reshape(
+            transpose(
+                reshape(inputs[2], {B, 1, L, H}, s),
+                {0, 3, 1, 2},
+                s),
+            {B, H, L, 1},
+            s);
+        array weighted = multiply(relu, wq, s);
+        array out = sum(weighted, 1, true, s);
+        return std::vector<array>{out};
+      };
+  bool routed = !DsaIndexerScores::use_fallback(s);
+  std::vector<array> inputs{queries, keys, weights};
+  if (!routed) {
+    return fallback(inputs)[0];
+  }
+  auto outputs = array::make_arrays(
+      {{B, 1, L, keys.shape(2)}},
+      {dtype},
+      std::make_shared<DsaIndexerScores>(
+          s, fallback, causal, causal_q_offset, mask_ratio),
+      std::move(inputs));
+  return std::move(outputs[0]);
+}
