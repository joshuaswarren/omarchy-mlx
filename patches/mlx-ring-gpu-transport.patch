+// The ring transport bodies are host-side code: they move bytes through
+// sockets and mapped buffers. On a CPU communication stream they are
+// dispatched through the CPU command encoder exactly as upstream. On an
+// accelerator stream - the omarchy backend evaluates the distributed
+// primitives on the GPU stream - the CPU command encoder does not exist
+// for that stream, so the body runs inline on the calling thread. The
+// accelerator's eval_gpu synchronizes its stream before the transport and
+// after every GPU reduction step, so inline execution is correctly
+// ordered with the device work.
+void dispatch_transport(Stream stream, std::function<void()> body) {
+  if (stream.device == Device::cpu) {
+    auto& encoder = cpu::get_command_encoder(stream);
+    encoder.dispatch(std::move(body));
+  } else {
+    body();
+  }
+}
+
+} // namespace
