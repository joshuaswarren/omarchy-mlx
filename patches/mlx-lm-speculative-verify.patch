+# mlx-omarchy speculative verify. A verify pass scores every drafted position, so
+# it needs the full logits that the last-logits patch trims to one row. It is a
+# short pass (num_draft + 1 rows), and MLX_OMARCHY_QMV_SMALL_T sends its 4-bit
+# linears to the batch-shared GEMV, whose rows match the single-token decode
+# kernel bit for bit, so greedy speculative output equals plain greedy decode.
+# Both variables are read live, so the pass is evaluated inside the block. A
+# QMV_SMALL_T value already set in the environment is left as it is.
+@contextlib.contextmanager
+def _omarchy_verify_pass(rows):
+    keys = ("MLX_OMARCHY_FULL_LOGITS", "MLX_OMARCHY_QMV_SMALL_T")
+    saved = {k: os.environ.get(k) for k in keys}
+    os.environ["MLX_OMARCHY_FULL_LOGITS"] = "1"
+    if saved["MLX_OMARCHY_QMV_SMALL_T"] is None and rows > 1:
+        os.environ["MLX_OMARCHY_QMV_SMALL_T"] = str(min(rows, 8))
+    try:
+        yield
+    finally:
+        for k, v in saved.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+
+
+def _omarchy_lookup_draft(history, num_draft, ngram_max, ngram_min):
+    """Prompt-lookup draft: the tokens that followed the most recent earlier
+    occurrence of the longest matching suffix n-gram (ngram_max down to
+    ngram_min) of ``history``."""
+    for n in range(ngram_max, ngram_min - 1, -1):
+        if len(history) <= n:
+            continue
+        pattern = history[-n:]
+        for i in range(len(history) - n - 1, -1, -1):
+            if history[i : i + n] == pattern:
+                draft = history[i + n : i + n + num_draft]
+                if draft:
+                    return draft
+    return []
+
+
+def _omarchy_snapshot(prompt_cache):
+    # Recurrent layers (ArraysCache: GDN, conv state) cannot be trimmed; keep
+    # their state so a rejected draft can be rolled back.
+    return [None if c.is_trimmable() else list(c.state) for c in prompt_cache]
+
+
+def _omarchy_restore(prompt_cache, snapshot, num_tokens):
+    cache.trim_prompt_cache([c for c in prompt_cache if c.is_trimmable()], num_tokens)
+    for c, s in zip(prompt_cache, snapshot):
+        if s is not None:
+            c.state = s
+
