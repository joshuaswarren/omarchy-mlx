# Upstream: ml-explore/mlx (carried by mlx-omarchy); issue 537.
# Load::eval_cpu defers the byte fill to the I/O thread pool while the
# evaluator fences cross-stream consumers immediately after eval_cpu
# returns. That fence does not order against the I/O worker, so a scalar
# copy that host-reads the constant got a stale word and broadcast it
# into the output (issue 537 on the M6: counts of zeros, 5/100 under a
# widened I/O window, 40/100 indices-first in the original report).
# Size-1 loads publish synchronously so the fence is truthful; every
# multi-element load keeps the pipelined I/O path.
--- a/mlx/backend/common/load.cpp
+++ b/mlx/backend/common/load.cpp
@@ -50,6 +50,14 @@ void Load::eval_cpu(const std::vector<array>& inputs, array& out) {
       }
     }
   };
+  if (out.size() == 1) {
+    // Publish before returning: the evaluator fences cross-stream
+    // consumers immediately after this call, and a deferred I/O read
+    // leaves that fence lying about the bytes (issue 537: a scalar
+    // copy host-read the constant before the I/O worker wrote it).
+    read_task();
+    return;
+  }
   auto fut = io::thread_pool().enqueue(std::move(read_task)).share();
   scheduler::enqueue(stream(), [fut = std::move(fut)]() { fut.get(); });
 }
