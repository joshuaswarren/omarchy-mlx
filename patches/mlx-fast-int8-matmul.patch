+// Inputs (x, xscale, w, wscale, bias); single bfloat16 output. See
+// fast::int8_matmul. The composed fallback runs the same math through
+// per-group float32 matmuls; the Omarchy GPU route runs the fused int8
+// shader.
+class Int8Matmul : public Custom {
+ public:
+  Int8Matmul(
+      Stream stream,
+      std::function<std::vector<array>(std::vector<array>)> fallback,
+      int group,
+      bool swiglu)
+      : Custom(stream, std::move(fallback)),
+        group_(group),
+        swiglu_(swiglu) {}
+
+  static bool use_fallback(Stream s);
+
+  int group() const {
+    return group_;
+  }
+
+  bool swiglu() const {
+    return swiglu_;
+  }
+
+  void eval_cpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override {
+    throw std::runtime_error("NYI");
+  }
+
+  void eval_gpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override;
+
+  DEFINE_NAME(Int8Matmul);
+  bool is_equivalent(const Primitive& other) const override;
+  auto state() const {
+    return std::make_tuple(nullptr, group_, swiglu_);
+  }
+
+ private:
+  int group_;
+  bool swiglu_;
+};
