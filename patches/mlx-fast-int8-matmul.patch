+
+array int8_matmul(
+    const array& x,
+    const array& xscale,
+    const array& w,
+    const array& wscale,
+    const array& bias,
+    int group,
+    bool swiglu,
+    StreamOrDevice s_) {
+  auto s = to_stream(s_);
+  if (x.ndim() < 2 || w.ndim() != 2) {
+    throw std::invalid_argument(
+        "[int8_matmul] x must be at least 2D and w must be 2D.");
+  }
+  int k = x.shape(-1);
+  int n_out = w.shape(0);
+  if (w.shape(1) != k) {
+    throw std::invalid_argument(
+        "[int8_matmul] w's second dimension must equal x's last dimension.");
+  }
+  if (swiglu && (n_out % 2 != 0)) {
+    throw std::invalid_argument(
+        "[int8_matmul] swiglu needs an even output dimension for the fused "
+        "[gate; value] weight.");
+  }
+  int n = swiglu ? n_out / 2 : n_out;
+  if (k % group != 0) {
+    throw std::invalid_argument(
+        "[int8_matmul] the group size must divide the reduction dimension.");
+  }
+  if (x.dtype() != int8 || w.dtype() != int8) {
+    throw std::invalid_argument(
+        "[int8_matmul] x and w must be int8 arrays.");
+  }
+  if (xscale.dtype() != float32 || wscale.dtype() != float32 ||
+      bias.dtype() != float32) {
+    throw std::invalid_argument(
+        "[int8_matmul] xscale, wscale and bias must be float32.");
+  }
+  Shape lead(x.shape().begin(), x.shape().end() - 1);
+  Shape xscale_shape = xscale.shape();
+  Shape expected_scale(lead);
+  expected_scale.push_back(k / group);
+  if (xscale_shape != expected_scale) {
+    throw std::invalid_argument(
+        "[int8_matmul] xscale must have shape [..., K / group].");
+  }
+  if (wscale.shape() != Shape{n_out} || bias.shape() != Shape{n_out}) {
+    throw std::invalid_argument(
+        "[int8_matmul] wscale and bias must be [N] (swiglu: [2N], one per "
+        "packed weight row).");
+  }
+  auto fallback = [group, swiglu, n, s](const std::vector<array>& in) {
+    // Exact per group: int8 values cast to float32, an in-group dot of
+    // integers with magnitude at most 127*127*group, which float32
+    // represents exactly for group <= 131072, and float32 group sums
+    // exactly as the reference kernel's per-group fp32 accumulation.
+    array xf = astype(in[0], float32, s);
+    array wf = astype(in[2], float32, s);
+    int rows = xf.shape(0);
+    int k_dim = xf.shape(1);
+    int groups = k_dim / group;
+    array acc = zeros({rows, n}, float32, s);
+    for (int g = 0; g < groups; g++) {
+      array xg = slice(xf, {0, g * group}, {rows, (g + 1) * group}, s);
+      array wg = slice(wf, {0, g * group}, {static_cast<int>(wf.shape(0)), (g + 1) * group}, s);
+      array partial = matmul(xg, transpose(wg, {1, 0}, s), s);
+      array scale = multiply(
+          slice(in[1], {0, g}, {rows, g + 1}, s),
+          reshape(in[3], {1, n}, s),
+          s);
+      acc = add(acc, multiply(partial, scale, s), s);
+    }
+    acc = add(acc, reshape(in[4], {1, in[4].shape(0)}, s), s);
+    if (swiglu) {
+      array gate = slice(acc, {0, 0}, {rows, n}, s);
+      array value = slice(acc, {0, n}, {rows, 2 * n}, s);
+      acc = multiply(gate, multiply(sigmoid(gate, s), value, s), s);
+    }
+    return std::vector<array>{astype(acc, bfloat16, s)};
+  };
+  bool routed = !Int8Matmul::use_fallback(s);
+  std::vector<array> inputs{x, xscale, w, wscale, bias};
+  if (!routed) {
+    return fallback(inputs)[0];
+  }
+  Shape out_shape(lead);
+  out_shape.push_back(swiglu ? n : n_out);
+  auto outputs = array::make_arrays(
+      {std::move(out_shape)},
+      {bfloat16},
+      std::make_shared<Int8Matmul>(s, fallback, group, swiglu),
+      std::move(inputs));
+  return std::move(outputs[0]);
+}
