+TEST_CASE("scalar load publishes before cross-stream consumers read it") {
+  // Issue 537, the upstream export unique indices before counts shape:
+  // Load::eval_cpu defers the byte fill to the I/O thread pool; the
+  // evaluator fences cross-stream consumers immediately after it returns.
+  // The exported graph bakes size-1 constants (the bool boundary seed
+  // array({true}) and the uint32 offset array(1, uint32)), and a size-1
+  // load is exactly what the fix publishes synchronously, so a counts
+  // read that races the I/O worker broadcasts a stale word into the
+  // counts. With no fill_value the padding is a runtime slice of the
+  // sorted values, not a constant. Reading the indices first, then the
+  // counts, is the exact ordering of the original report (40/100 wrong
+  // counts indices-first in that report; 17/100 in the python control
+  // arm here; this C++ case fails on the unfixed library).
+  // Each trial imports the function again, matching the python
+  // reproduction in the fork's qualification kit: the fresh import is
+  // what widens the window.
+  if (!gpu::is_available()) {
+    MESSAGE("Skipping: requires a qualifying Vulkan device.");
+    return;
+  }
+
+  std::string file_path =
+      get_temp_file("unique_indices_before_counts.mlxfn");
+  auto x = array({3, 1, 2, 1, 3, 2, 1, 0, 2, 1}, int32);
+
+  Stream gpu_stream = new_stream(Device::gpu);
+  {
+    StreamContext on_gpu(gpu_stream);
+    auto fun = [](const std::vector<array>& args) -> std::vector<array> {
+      return unique(args[0], 10, true, true, true);
+    };
+    export_function(file_path, fun, {x});
+  }
+  const int32_t expected[10] = {1, 4, 3, 2, 0, 0, 0, 0, 0, 0};
+  // Saturate the I/O pool: the deferred scalar fill then queues behind
+  // sleeping tasks and the consumer's host read always wins the race,
+  // instead of winning only on devices that lose it natively.
+  std::vector<std::future<void>> saturation;
+  for (int i = 0; i < 8; ++i) {
+    saturation.push_back(io::thread_pool().enqueue([]() {
+      std::this_thread::sleep_for(std::chrono::milliseconds(60));
+    }));
+  }
+
+  for (int trial = 0; trial < 100; ++trial) {
+    StreamContext on_gpu(gpu_stream);
+    auto imported = import_function(file_path);
+    auto out = imported({x});
+    eval(out[1]);
+    synchronize(gpu_stream);
+    eval(out[3]);
+    synchronize(gpu_stream);
+    auto* data = static_cast<int32_t*>(out[3].data<int32_t>());
+    for (int i = 0; i < 10; ++i) {
+      CHECK_EQ(data[i], expected[i]);
+      if (data[i] != expected[i]) {
+        MESSAGE("wrong counts at trial " << trial << ": first mismatch "
+            << "position " << i << " value " << data[i]);
+        break;
+      }
+    }
+  }
+  for (auto& pending : saturation) {
+    pending.get();
+  }
+}
