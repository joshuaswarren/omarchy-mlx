+TEST_CASE("scalar load publishes before cross-stream consumers read it") {
+  // Issue 537: Load::eval_cpu defers the byte fill; the evaluator fences
+  // cross-stream consumers immediately after it returns. The fence
+  // cannot order a host-thread write, so a small import graph whose
+  // scalar constant is consumed on a GPU stream raced the I/O read and
+  // broadcast a stale word into the output. Sizes > 1 keep pipelined
+  // I/O; size 1 (the shape a scalar copy host-reads) must publish
+  // before eval_cpu returns.
+  if (!gpu::is_available()) {
+    MESSAGE("Skipping: requires a qualifying Vulkan device.");
+    return;
+  }
+
+  std::string file_path = get_temp_file("scalar_publish.mlxfn");
+
+  // Trace shape fixed at trace time: the constant is baked in as a
+  // constant load, and the broadcast fill is the scalar-copy path.
+  Stream gpu_stream = new_stream(Device::gpu);
+  auto fun = [](const std::vector<array>& args) -> std::vector<array> {
+    auto counts = full({10}, 0.0f, float32);
+    return {add(counts, astype(full({2}, 1.0f, float32), int32))};
+  };
+  export_function(file_path, fun, {array({0})});
+  auto imported = import_function(file_path);
+
+  for (int trial = 0; trial < 100; ++trial) {
+    StreamContext on_gpu(gpu_stream);
+    auto out = imported({array({0})});
+    eval(out);
+    synchronize(gpu_stream);
+    auto* data = static_cast<int32_t*>(out[0].data<int32_t>());
+    int32_t expected = 2;
+    for (int i = 0; i < 10; ++i) {
+      CHECK_EQ(data[i], expected);
+      if (data[i] != expected) {
+        MESSAGE("scalar constant consumed stale at trial " << trial << " position " << i);
+        break;
+      }
+    }
+  }
+}
