@@ -88,6 +88,22 @@
 _bitlinear_kernel = make_bitlinear_kernel()
 
 
+def _bitlinear_matmul_fallback(x, packed_weights, weight_scale, *, out_features, invert_weight_scales):
+    """Pure-MLX bitlinear matmul for non-Metal builds (e.g. CPU-only).
+
+    Byte (r, c) of ``packed_weights`` holds the ternary weights of the four
+    outputs ``r + j * (out_features // 4)`` for input ``c`` in 2-bit fields,
+    so unpacking a field j and stacking them yields the weight matrix in
+    output order.
+    """
+    fields = mx.stack([(packed_weights >> s) & 3 for s in (0, 2, 4, 6)])
+    weights = (fields.astype(x.dtype) - 1).reshape(-1, x.shape[-1])
+    scale = weight_scale[0]
+    if invert_weight_scales:
+        scale = mx.reciprocal(scale)
+    return (x @ weights.T * scale).astype(weight_scale.dtype)
+
+
 class BitLinear(nn.Module):
     """
     BitLinear module with memory-efficient weight handling.
