+#ifdef MLX_OMARCHY_BACKEND
+// Device-local weight placement defaults on: every safetensors file load is
+// an inference-weight candidate. The allocator's weight_memory_type_for_size()
+// and the Load primitive's mapped-path fallback keep the route safe on
+// devices without mapped device-local memory (#871), and Buffer::raw_ptr()
+// keeps host readback working (host shadow for pure-VRAM buffers, direct
+// mapping where the heap is host-visible). MLX_OMARCHY_VRAM_WEIGHTS stays
+// the override both ways: =0 or any non-absolute value disables the route;
+// an absolute path flags only loads from that checkpoint directory.
+static bool is_inference_checkpoint(const std::string& file) {
+  const char* root = std::getenv("MLX_OMARCHY_VRAM_WEIGHTS");
+  if (root && *root && !std::filesystem::path(root).is_absolute()) {
+    return false;
+  }
+  if (root && *root) {
+    auto directory = std::filesystem::path(root).lexically_normal();
+    if (directory.filename().empty() && directory.has_relative_path()) {
+      directory = directory.parent_path();
+    }
+    return std::filesystem::absolute(file)
+        .lexically_normal()
+        .parent_path() == directory;
+  }
+  return true;
+}
+#endif
