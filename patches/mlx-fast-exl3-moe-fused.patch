+// Fused EXL3 MoE layer arm (shaders/exl3_moe_fused.comp on the omarchy
+// backend, M3d): trellis decode + gate/up GEMV, clamped SwiGLU, down GEMV
+// and router combine as two dispatches of one shader. Scalar state carries
+// the full layer geometry so the packed rate can never be misread; the
+// arm serves only rows in the verified fused range at the harness-covered
+// pack geometry (see accepts) and the op falls back to the composed graph
+// for everything else.
+class Exl3MoeFused : public Custom {
+ public:
+  Exl3MoeFused(
+      Stream stream,
+      std::function<std::vector<array>(std::vector<array>)> fallback,
+      int rows,
+      int hidden,
+      int inter,
+      int topk,
+      int window,
+      float limit,
+      Dtype out_dtype)
+      : Custom(stream, std::move(fallback)),
+        rows_(rows),
+        hidden_(hidden),
+        inter_(inter),
+        topk_(topk),
+        window_(window),
+        limit_(limit),
+        out_dtype_(out_dtype) {}
+
+  static bool use_fallback(Stream stream);
+
+  // The harness-covered pack geometry the fused arm qualifies on. A false
+  // return fills |decline| with a one-line reason for
+  // MLX_OMARCHY_EXL3_DEBUG=1.
+  static bool accepts(
+      int rows,
+      int hidden,
+      int inter,
+      const array& x,
+      const array& gate_trellis,
+      const array& up_trellis,
+      const array& down_trellis,
+      const array& gate_suh,
+      const array& gate_svh,
+      const array& up_suh,
+      const array& up_svh,
+      const array& down_suh,
+      const array& down_svh,
+      Dtype out_dtype,
+      int window,
+      std::string* decline);
+
+  void eval_cpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override {
+    throw std::runtime_error("NYI");
+  }
+  void eval_gpu(const std::vector<array>& inputs, std::vector<array>& outputs)
+      override;
+
+  DEFINE_NAME(Exl3MoeFused)
+  bool is_equivalent(const Primitive& other) const override;
+  DEFINE_INPUT_OUTPUT_SHAPE()
+
+  auto state() const {
+    return std::make_tuple(
+        nullptr, std::make_tuple(rows_, hidden_, inter_, topk_, window_));
+  }
+
+ private:
+  int rows_;
+  int hidden_;
+  int inter_;
+  int topk_;
+  int window_;
+  float limit_;
+  Dtype out_dtype_;
+};
