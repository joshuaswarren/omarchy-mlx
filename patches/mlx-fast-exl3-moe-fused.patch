+  return rows_ == a_other.rows_ && hidden_ == a_other.hidden_ &&
+      inter_ == a_other.inter_ && topk_ == a_other.topk_ &&
+      window_ == a_other.window_ && limit_ == a_other.limit_ &&
+      out_dtype_ == a_other.out_dtype_;
+}
