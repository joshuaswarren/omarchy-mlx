+array exl3_moe(
+    const array& x,
+    const array& gate_trellis,
+    const array& gate_suh,
+    const array& gate_svh,
+    const array& up_trellis,
+    const array& up_suh,
+    const array& up_svh,
+    const array& down_trellis,
+    const array& down_suh,
+    const array& down_svh,
+    const array& slots,
+    const array& scores,
+    int topk,
+    int window,
+    float limit,
+    Dtype out_dtype,
+    StreamOrDevice s_ /* = {} */) {
+  if (x.dtype() != float16 && x.dtype() != bfloat16 && x.dtype() != float32) {
+    throw std::invalid_argument(
+        "[exl3_moe] x must be float16, bfloat16 or float32.");
+  }
+  if (x.ndim() != 1 && x.ndim() != 2) {
+    throw std::invalid_argument(
+        "[exl3_moe] x must be 1D (one row) or 2D [rows, hidden].");
+  }
+  int rows = (x.ndim() == 2) ? x.shape(0) : 1;
+  int hidden = x.shape(-1);
+  if (hidden % 128 != 0) {
+    throw std::invalid_argument(
+        "[exl3_moe] hidden must be a multiple of 128 (EXL3 packs are "
+        "128x128 block quantized).");
+  }
+  auto check_trellis = [](const array& t, const char* name) {
+    if (t.dtype() != uint16 || t.ndim() != 4) {
+      throw std::invalid_argument(
+          std::string("[exl3_moe] ") + name +
+          " must be a 4D [E, in/16, out/16, packed] uint16 array.");
+    }
+  };
+  auto check_scale = [](const array& v, int size, const char* name) {
+    if (v.ndim() != 1 || v.shape(0) != size ||
+        (v.dtype() != float16 && v.dtype() != uint16)) {
+      throw std::invalid_argument(
+          std::string("[exl3_moe] ") + name +
+          " must be a 1D float16/uint16 (bit pattern) array of the "
+          "projection's axis length.");
+    }
+  };
+  check_trellis(gate_trellis, "gate_trellis");
+  check_trellis(up_trellis, "up_trellis");
+  check_trellis(down_trellis, "down_trellis");
+  int experts = gate_trellis.shape(0);
+  int inter = gate_trellis.shape(2) * 16;
+  if (gate_trellis.shape(1) * 16 != hidden || inter % 128 != 0 ||
+      up_trellis.shape(1) * 16 != hidden || up_trellis.shape(2) * 16 != inter ||
+      down_trellis.shape(1) * 16 != inter ||
+      down_trellis.shape(2) * 16 != hidden) {
+    throw std::invalid_argument(
+        "[exl3_moe] the trellis banks disagree with the projection "
+        "geometry (gate/up map hidden -> inter, down maps inter -> "
+        "hidden).");
+  }
+  check_scale(gate_suh, hidden, "gate_suh");
+  check_scale(gate_svh, inter, "gate_svh");
+  check_scale(up_suh, hidden, "up_suh");
+  check_scale(up_svh, inter, "up_svh");
+  check_scale(down_suh, inter, "down_suh");
+  check_scale(down_svh, hidden, "down_svh");
+  if (gate_trellis.shape(0) != experts ||
+      up_trellis.shape(0) != experts ||
+      down_trellis.shape(0) != experts) {
+    throw std::invalid_argument(
+        "[exl3_moe] the three trellis banks must carry the same expert "
+        "count.");
+  }
+  if (slots.ndim() != 1 && slots.ndim() != 2) {
+    throw std::invalid_argument(
+        "[exl3_moe] slots must be 1D [rows*topk] or 2D [rows, topk].");
+  }
+  if (slots.dtype() != uint32 && slots.dtype() != int32) {
+    throw std::invalid_argument(
+        "[exl3_moe] slots must be uint32 or int32 router ids.");
+  }
+  if (scores.shape() != slots.shape()) {
+    throw std::invalid_argument(
+        "[exl3_moe] scores must have the same shape as slots.");
+  }
+  if (scores.dtype() != float16 && scores.dtype() != bfloat16 &&
+      scores.dtype() != float32) {
+    throw std::invalid_argument(
+        "[exl3_moe] scores must be float16, bfloat16 or float32.");
+  }
+  int slot_rows = (slots.ndim() == 2) ? slots.shape(0) : 1;
+  if (topk <= 0 || slots.shape(-1) != topk ||
+      (slot_rows != 1 && slot_rows != rows)) {
+    std::ostringstream msg;
+    msg << "[exl3_moe] topk must match slots' last axis (" << topk
+        << " given, slots " << slots.shape() << ") and the slot rows must "
+           "be 1 or the x row count ("
+        << rows << ").";
+    throw std::invalid_argument(msg.str());
+  }
+  Dtype out_type = out_dtype;
+  if (out_type != float16 && out_type != bfloat16 && out_type != float32) {
+    throw std::invalid_argument(
+        "[exl3_moe] out_dtype must be float16, bfloat16 or float32.");
+  }
+
+  auto s = to_stream(s_);
+  // Composed route on every stream (see fast.h): the router ids and
+  // scores materialize, each expert decodes through exl3_decode, and the
+  // clamped-SwiGLU routing runs with core ops in f32.
+  auto fallback = [rows, hidden, inter, experts, topk, window, limit,
+                   out_type, s](std::vector<array> inputs) {
+    array xg = inputs[0];
+    if (xg.ndim() == 1) {
+      xg = reshape(xg, {1, xg.shape(0)}, s);
+    }
+    xg = astype(xg, float32, s);
+    array slot_ids = inputs[10];
+    array sc = inputs[11];
+    if (slot_ids.ndim() == 1) {
+      slot_ids = reshape(slot_ids, {1, slot_ids.shape(0)}, s);
+      sc = reshape(sc, {1, sc.shape(0)}, s);
+    }
+    auto decode_stack = [&](const array& t,
+                            const array& suh,
+                            const array& svh,
+                            int in_f,
+                            int out_f) {
+      std::vector<array> ws;
+      ws.reserve(experts);
+      for (int e = 0; e < experts; e++) {
+        array te = reshape(
+            slice(
+                t,
+                {e, 0, 0, 0},
+                {e + 1, t.shape(1), t.shape(2), t.shape(3)},
+                {1, 1, 1, 1},
+                s),
+            {-1},
+            s);
+        ws.push_back(
+            exl3_decode(te, suh, svh, in_f, out_f, t.shape(3) / 16, window,
+                        float16, s));
+      }
+      // The production kernel emits f16 weights; round the CPU fallback
+      // through f16 too so the composed math sees the same values.
+      return astype(stack(ws, 0, s), float32, s);
+    };
+    array wg = decode_stack(
+        inputs[1], inputs[2], inputs[3], hidden, inter); // [E, hidden, inter]
+    array wu = decode_stack(
+        inputs[4], inputs[5], inputs[6], hidden, inter);
+    array wd = decode_stack(
+        inputs[7], inputs[8], inputs[9], inter, hidden); // [E, inter, hidden]
+    std::optional<array> out;
+    for (int k = 0; k < topk; k++) {
+      // Column k of the slot/score tables: slice it, drop the axis.
+      array ids = astype(
+          reshape(
+              slice(
+                  slot_ids,
+                  {0, k},
+                  {slot_ids.shape(0), k + 1},
+                  {1, 1},
+                  s),
+              {slot_ids.shape(0)},
+              s),
+          int32,
+          s);
+      array scorev = reshape(
+          slice(sc, {0, k}, {sc.shape(0), k + 1}, {1, 1}, s),
+          {sc.shape(0)},
+          s);
+      array wgt = take(wg, ids, 0, s); // [rows, hidden, inter]
+      array hut = take(wu, ids, 0, s);
+      array h = squeeze(
+          matmul(expand_dims(xg, 1, s), wgt, s), 1, s); // [rows, inter]
+      array u = squeeze(
+          matmul(expand_dims(xg, 1, s), hut, s), 1, s);
+      if (limit > 0.0f) {
+        // GLM convention (sushi plainMoeFused): the gate clamps above
+        // only, the up branch symmetrically.
+        h = minimum(h, array(limit, float32), s);
+        u = clip(u, array(-limit, float32), array(limit, float32), s);
+      }
+      array act = multiply(sigmoid(h, s), u, s);
+      array wdt = take(wd, ids, 0, s); // [rows, inter, hidden]
+      array y = squeeze(
+          matmul(expand_dims(act, 1, s), wdt, s), 1, s); // [rows, hidden]
+      array contrib = multiply(
+          y, expand_dims(astype(scorev, float32, s), 1, s), s);
+      out = out.has_value() ? add(*out, contrib, s) : contrib;
+    }
+    return std::vector<array>{astype(*out, out_type, s)};
+  };
+  // No Exl3Moe primitive yet (M3b is the C surface; the fused GPU arms
+  // are M3d): the composed graph answers on every stream, with the decode
+  // legs taking the GPU kernel where the stream provides one.
+  return fallback(
+      {x,
+       gate_trellis, gate_suh, gate_svh,
+       up_trellis, up_suh, up_svh,
+       down_trellis, down_suh, down_svh,
+       slots, scores})[0];
+}
