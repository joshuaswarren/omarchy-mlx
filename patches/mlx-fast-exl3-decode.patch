+constexpr uint32_t exl3_mcg_mult = 0xCBAC1FEDu;
+constexpr float exl3_had_scale = 0.08838834764831845f;
+
+// f16 bit pattern -> f32, exact (integer widen; no host rounding rules).
+inline float exl3_f16_to_f32(uint16_t h) {
+  uint32_t sign = (h >> 15) & 1u;
+  uint32_t exp = (h >> 10) & 0x1Fu;
+  uint32_t man = h & 0x3FFu;
+  uint32_t bits;
+  if (exp == 0u) {
+    if (man == 0u) {
+      bits = sign << 31;
+    } else {
+      uint32_t m = man;
+      uint32_t s = 0u;
+      while ((m & 0x200u) == 0u) {
+        m <<= 1;
+        s++;
+      }
+      bits = (sign << 31) | ((112u - s) << 23) | ((m & 0x1FFu) << 14);
+    }
+  } else if (exp == 0x1Fu) {
+    bits = (sign << 31) | (0xFFu << 23) | (man << 13);
+  } else {
+    bits = (sign << 31) | ((exp + 112u) << 23) | (man << 13);
+  }
+  float v;
+  std::memcpy(&v, &bits, sizeof(v));
+  return v;
+}
+
+// f32 -> f16 bits, round-to-nearest-even (matches Zig @floatCast).
+inline uint16_t exl3_f32_to_f16(float v) {
+  uint32_t b;
+  std::memcpy(&b, &v, sizeof(b));
+  uint32_t sign = (b >> 16) & 0x8000u;
+  uint32_t exp = (b >> 23) & 0xFFu;
+  uint32_t man = b & 0x7FFFFFu;
+  if (exp == 0xFFu) {
+    return static_cast<uint16_t>(sign | 0x7C00u | (man != 0u ? 0x0200u : 0u));
+  }
+  int ne = static_cast<int>(exp) - 127 + 15;
+  if (ne >= 31) {
+    return static_cast<uint16_t>(sign | 0x7C00u);
+  }
+  if (ne <= 0) {
+    if (ne < -10) {
+      return static_cast<uint16_t>(sign);
+    }
+    uint32_t m = man | 0x800000u;
+    uint32_t shift = static_cast<uint32_t>(14 - ne);
+    uint32_t rem = m & ((1u << shift) - 1u);
+    uint32_t h16 = m >> shift;
+    uint32_t half_ulp = 1u << (shift - 1u);
+    if (rem > half_ulp || (rem == half_ulp && (h16 & 1u) == 1u)) {
+      h16++;
+    }
+    return static_cast<uint16_t>(sign | h16);
+  }
+  uint32_t h16 = (static_cast<uint32_t>(ne) << 10) | (man >> 13);
+  uint32_t rem = man & 0x1FFFu;
+  if (rem > 0x1000u || (rem == 0x1000u && ((man >> 13) & 1u) == 1u)) {
+    h16++;
+  }
+  if (h16 >= 0x7C00u) {
+    return static_cast<uint16_t>(sign | 0x7C00u);
+  }
+  return static_cast<uint16_t>(sign | h16);
+}
+
+// expert_exl3.zig decodeMcg: u32 mul + XOR, f32 add of the f16 halves,
+// integer RNE round. The C++ uint32_t multiply wraps exactly like Zig *%.
+inline uint16_t exl3_decode_mcg(uint16_t cw) {
+  uint32_t mixed = static_cast<uint32_t>(cw) * exl3_mcg_mult;
+  uint32_t pair = 0x3B603B60u ^ (mixed & 0x8FFF8FFFu);
+  float lo = exl3_f16_to_f32(static_cast<uint16_t>(pair & 0xFFFFu));
+  float hi = exl3_f16_to_f32(static_cast<uint16_t>(pair >> 16));
+  return exl3_f32_to_f16(lo + hi);
+}
+
+inline uint32_t exl3_word_u32(const uint16_t* words, size_t index) {
+  return static_cast<uint32_t>(words[2 * index]) |
+      (static_cast<uint32_t>(words[2 * index + 1]) << 16);
+}
+
+// unpackTile: the tail-biting 16-bit windows of two consecutive codewords
+// per iteration, exactly the Zig reference arithmetic.
+void exl3_unpack_tile(const uint16_t* words, uint32_t n, uint16_t* cw) {
+  size_t wc = n / 2;
+  size_t total = static_cast<size_t>(n) * 16;
+  for (size_t t = 0; t < 128; t++) {
+    size_t e0 = ((t * 2 + 1) * static_cast<size_t>(n)) >> 4;
+    size_t e1 = ((t * 2 + 2) * static_cast<size_t>(n)) >> 4;
+    size_t bit0 = e0 + total - 16;
+    size_t bit2 = e1 + total;
+    size_t i0 = bit0 >> 5;
+    size_t i1 = (bit2 - 1) >> 5;
+    size_t shift = (i1 + 1) * 32 - bit2;
+    uint64_t merged =
+        (static_cast<uint64_t>(exl3_word_u32(words, i0 % wc)) << 32) |
+        exl3_word_u32(words, i1 % wc);
+    uint32_t funnel = static_cast<uint32_t>(merged >> shift);
+    size_t fresh = e1 - e0;
+    cw[t * 2] = static_cast<uint16_t>((funnel >> fresh) & 0xFFFFu);
+    cw[t * 2 + 1] = static_cast<uint16_t>(funnel & 0xFFFFu);
+  }
+}
+
+// decodeTile: unpack, tensor-core permute, MCG-decode under the window mask.
+void exl3_decode_tile(
+    const uint16_t* words,
+    uint32_t n,
+    uint16_t mask,
+    uint16_t* out) {
+  uint16_t cw[256];
+  exl3_unpack_tile(words, n, cw);
+  size_t perm[256];
+  for (size_t thread = 0; thread < 32; thread++) {
+    size_t row0 = (thread % 4) * 2;
+    size_t row1 = row0 + 1;
+    size_t row2 = row0 + 8;
+    size_t row3 = row0 + 9;
+    size_t col0 = thread / 4;
+    size_t col1 = col0 + 8;
+    size_t base = thread * 8;
+    perm[base + 0] = row0 * 16 + col0;
+    perm[base + 1] = row1 * 16 + col0;
+    perm[base + 2] = row2 * 16 + col0;
+    perm[base + 3] = row3 * 16 + col0;
+    perm[base + 4] = row0 * 16 + col1;
+    perm[base + 5] = row1 * 16 + col1;
+    perm[base + 6] = row2 * 16 + col1;
+    perm[base + 7] = row3 * 16 + col1;
+  }
+  for (size_t i = 0; i < 256; i++) {
+    out[perm[i]] = exl3_decode_mcg(cw[i] & mask);
+  }
+}
+
+// reconstructInner + reconstructPublic: tile decode into [in, out] row
+// major, then the row H128 + suh and column H128 + svh stages in the
+// reference's exact f32 accumulation order. Returns f32; the caller rounds
+// to the output dtype.
+void exl3_reconstruct(
+    const uint16_t* trellis,
+    const uint16_t* suh,
+    const uint16_t* svh,
+    int in_features,
+    int out_features,
+    int bits,
+    int window,
+    float* out) {
+  const uint32_t n = static_cast<uint32_t>(bits) * 16;
+  const uint16_t mask = static_cast<uint16_t>((1u << window) - 1u);
+  const int in_tiles = in_features / 128;
+  const int out_tiles = out_features / 128;
+  const size_t packed_n = n;
+  uint16_t tile[256];
+  std::vector<uint16_t> inner(
+      static_cast<size_t>(in_features) * out_features);
+  for (int tk = 0; tk < in_tiles; tk++) {
+    for (int tn = 0; tn < out_tiles; tn++) {
+      const uint16_t* src =
+          trellis + (static_cast<size_t>(tk) * out_tiles + tn) * packed_n;
+      exl3_decode_tile(src, n, mask, tile);
+      for (int r = 0; r < 16; r++) {
+        std::memcpy(
+            &inner[(static_cast<size_t>(tk) * 16 + r) * out_features +
+                   static_cast<size_t>(tn) * 16],
+            &tile[static_cast<size_t>(r) * 16],
+            16 * sizeof(uint16_t));
+      }
+    }
+  }
+  // Row blocks: H128 then suh.
+  for (int rb = 0; rb < in_features; rb += 128) {
+    for (int col = 0; col < out_features; col++) {
+      float vec[128];
+      for (int r = 0; r < 128; r++) {
+        vec[r] = exl3_f16_to_f32(
+            inner[static_cast<size_t>(rb + r) * out_features + col]);
+      }
+      float hv[128];
+      for (int r = 0; r < 128; r++) {
+        float acc = 0.0f;
+        for (int k = 0; k < 128; k++) {
+          float entry =
+              (__builtin_popcount(static_cast<unsigned>(r) &
+                                  static_cast<unsigned>(k)) &
+               1)
+                  ? -exl3_had_scale
+                  : exl3_had_scale;
+          acc = acc + entry * vec[k];
+        }
+        hv[r] = acc;
+      }
+      for (int r = 0; r < 128; r++) {
+        out[static_cast<size_t>(rb + r) * out_features + col] =
+            hv[r] * exl3_f16_to_f32(suh[rb + r]);
+      }
+    }
+  }
+  // Column blocks: H128 then svh.
+  for (int cb = 0; cb < out_features; cb += 128) {
+    for (int row = 0; row < in_features; row++) {
+      float vec[128];
+      for (int c = 0; c < 128; c++) {
+        vec[c] = out[static_cast<size_t>(row) * out_features + cb + c];
+      }
+      float hv[128];
+      for (int c = 0; c < 128; c++) {
+        float acc = 0.0f;
+        for (int k = 0; k < 128; k++) {
+          float entry =
+              (__builtin_popcount(static_cast<unsigned>(c) &
+                                  static_cast<unsigned>(k)) &
+               1)
+                  ? -exl3_had_scale
+                  : exl3_had_scale;
+          acc = acc + entry * vec[k];
+        }
+        hv[c] = acc;
+      }
+      for (int c = 0; c < 128; c++) {
+        out[static_cast<size_t>(row) * out_features + cb + c] =
+            hv[c] * exl3_f16_to_f32(svh[cb + c]);
+      }
+    }
+  }
+}
