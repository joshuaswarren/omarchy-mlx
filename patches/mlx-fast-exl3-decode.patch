+array exl3_decode(
+    const array& trellis,
+    const array& suh,
+    const array& svh,
+    int in_features,
+    int out_features,
+    int bits,
+    int window,
+    Dtype out_type_,
+    StreamOrDevice s_ /* = {} */) {
+  int64_t packed = static_cast<int64_t>(bits) * 16;
+  if (packed < 16 || packed > 128) {
+    std::ostringstream msg;
+    msg << "[exl3_decode] the packed rate n = bits * 16 must be in [16, "
+           "128] but got bits = "
+        << bits << ".";
+    throw std::invalid_argument(msg.str());
+  }
+  if (window < 8 || window > 16) {
+    std::ostringstream msg;
+    msg << "[exl3_decode] window must be in [8, 16] but got " << window
+        << ".";
+    throw std::invalid_argument(msg.str());
+  }
+  if (in_features <= 0 || out_features <= 0 || in_features % 128 != 0 ||
+      out_features % 128 != 0) {
+    std::ostringstream msg;
+    msg << "[exl3_decode] in_features and out_features must be positive "
+           "multiples of 128 (EXL3 packs are 128x128 block quantized) but "
+           "got "
+        << in_features << " x " << out_features << ".";
+    throw std::invalid_argument(msg.str());
+  }
+  // suh/svh travel as float16-typed arrays in sushi (the host path reads
+  // their raw bit patterns); uint16 carries the identical bytes. The
+  // trellis is uint16 everywhere.
+  if (trellis.dtype() != uint16 ||
+      !(suh.dtype() == uint16 || suh.dtype() == float16) ||
+      !(svh.dtype() == uint16 || svh.dtype() == float16)) {
+    throw std::invalid_argument(
+        "[exl3_decode] trellis must be uint16 and suh/svh uint16 or "
+        "float16 (they are read as raw bit patterns).");
+  }
+  int in_tiles = in_features / 128;
+  int out_tiles = out_features / 128;
+  Shape want_trellis{
+      static_cast<int>(in_tiles) * out_tiles * 64 *
+      static_cast<int>(packed)};
+  if (trellis.ndim() != 1 || trellis.shape() != want_trellis) {
+    std::ostringstream msg;
+    msg << "[exl3_decode] trellis must be a flat [" << want_trellis[0]
+        << "] uint16 array for the given shape/rate but got shape "
+        << trellis.shape() << ".";
+    throw std::invalid_argument(msg.str());
+  }
+  if (suh.ndim() != 1 || suh.shape(0) != in_features) {
+    std::ostringstream msg;
+    msg << "[exl3_decode] suh must be [" << in_features
+        << "] but got shape " << suh.shape() << ".";
+    throw std::invalid_argument(msg.str());
+  }
+  if (svh.ndim() != 1 || svh.shape(0) != out_features) {
+    std::ostringstream msg;
+    msg << "[exl3_decode] svh must be [" << out_features
+        << "] but got shape " << svh.shape() << ".";
+    throw std::invalid_argument(msg.str());
+  }
+  Dtype out_type = out_type_;
+  if (out_type != float16 && out_type != bfloat16 && out_type != float32) {
+    throw std::invalid_argument(
+        "[exl3_decode] out_dtype must be float16, bfloat16 or float32.");
+  }
+
+  auto s = to_stream(s_);
+  // The trellis bit plumbing has no composed-op form that preserves the
+  // reference's exact f32 accumulation order, so the CPU fallback
+  // materializes its inputs and runs the bit-exact reference decoder here
+  // (CPU-stream arrays only: use_fallback gates the primitive route).
+  auto fallback = [in_features, out_features, bits, window, out_type, s](
+                      std::vector<array> inputs) {
+    for (auto& a : inputs) {
+      a.eval();
+    }
+    std::vector<float> w(
+        static_cast<size_t>(in_features) * static_cast<size_t>(out_features));
+    exl3_reconstruct(
+        inputs[0].data<uint16_t>(),
+        inputs[1].data<uint16_t>(),
+        inputs[2].data<uint16_t>(),
+        in_features,
+        out_features,
+        bits,
+        window,
+        w.data());
+    array out(w.data(), Shape{in_features, out_features}, float32);
+    return std::vector<array>{astype(out, out_type, s)};
+  };
+
+  if (!Exl3Decode::use_fallback(s)) {
+    return array(
+        Shape{in_features, out_features},
+        out_type,
+        std::make_shared<Exl3Decode>(
+            s, fallback, in_features, out_features, bits, window),
+        {trellis, suh, svh});
+  }
+  return fallback({trellis, suh, svh})[0];
+}
