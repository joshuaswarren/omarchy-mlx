diff --git a/mlx/backend/no_gpu/primitives.cpp b/mlx/backend/no_gpu/primitives.cpp
index c37515f..695a697 100644
--- a/mlx/backend/no_gpu/primitives.cpp
+++ b/mlx/backend/no_gpu/primitives.cpp
@@ -193,6 +193,11 @@ NO_GPU_MULTI(GatedDeltaUpdate)
 NO_GPU_MULTI(ConvertFP8)
 NO_GPU_MULTI(Quantize)
 NO_GPU_MULTI(CustomKernel)
+// Bonsai 1-bit / 2-bit affine decode kernels: GPU-only; the composed
+// fallback in fast.cpp fires on every CPU dispatch.
+NO_GPU_MULTI(BonsaiQ1AffineQmv)
+NO_GPU_MULTI(BonsaiQmvWide)
+NO_GPU_MULTI(BonsaiQ1Dequantize)
 } // namespace fast
 
