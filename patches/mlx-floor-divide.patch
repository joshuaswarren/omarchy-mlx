index 626dd93df9..b24bc9d011 100644
--- a/mlx/backend/cpu/simd/base_simd.h
+++ b/mlx/backend/cpu/simd/base_simd.h
@@ -218,6 +218,29 @@ Simd<T, 1> divide(Simd<T, 1> a_, Simd<T, 1> b_) {
   return a / b;
 }
 
+template <typename T>
+Simd<T, 1> floor_divide(Simd<T, 1> a_, Simd<T, 1> b_) {
+  T a = a_.value;
+  T b = b_.value;
+  if constexpr (std::is_integral_v<T>) {
+    // Integer division by zero gives 0. See divide above.
+    if (b == 0) {
+      return T(0);
+    }
+    T q = a / b;
+    if constexpr (is_signed_v<T>) {
+      if (a % b != 0 && (a < 0 != b < 0)) {
+        q -= 1;
+      }
+    }
+    return q;
+  } else if constexpr (is_complex<T>) {
+    return a / b;
+  } else {
+    return floor(divide(a_, b_));
+  }
+}
