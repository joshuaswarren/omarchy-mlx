+    def test_speculative_installs_never_evict(self, tmp_path, monkeypatch):
+        monkeypatch.setenv("OMLX_MOE_OFFLOAD_IO_WORKERS", "4")
+        monkeypatch.setenv("OMLX_MOE_OFFLOAD_LOOKAHEAD", "1")
+        _shutdown_io_pool()
+        try:
+            import time
+
+            model = self._model(tmp_path, n_layers=2)
+            apply_moe_expert_offload(model, tmp_path, 0.25)
+            glu = model.layers[0].experts.switch_glu
+            cache = glu.cache
+            cache.next_cache = self._glus(model)[1].cache
+            residents = set(range(cache.capacity))
+            cache._spec_queue(residents)
+            assert cache.pred_sent == cache.capacity
+            deadline = time.time() + 10
+            while any(
+                not all(f.done() for _, _, _, f in g)
+                for g in cache.spec_pending.values()
+            ):
+                assert time.time() < deadline, "speculative reads never finished"
+                time.sleep(0.01)
+            cache._spec_install()
+            assert set(cache.slot_of) == residents  # predictions installed
+            cache._spec_queue(range(cache.capacity, cache.capacity + 4))
+            assert cache.pred_sent == cache.capacity + 4  # reads queue freely
+            cache._spec_install()
+            assert set(cache.slot_of) == residents  # nothing evicted
+        finally:
+            _shutdown_io_pool()
+
+    def test_admission_refuses_below_floor_layer(self, tmp_path, monkeypatch, caplog):
+        model = _MiniMoE([_make_glu(seed=0, e=4)])
