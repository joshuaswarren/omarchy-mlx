+            assert 20 in c1.spec_pending and c1.pred_sent >= 1
+            # the prediction is adopted by the next real decode step
+            out = model(x, idx)
+            mx.eval(out)
+            assert c1.pred_installed >= 1
+            assert 20 in c1.slot_of
+        finally:
+            _shutdown_io_pool()
+
+    def test_eviction_ring_feeds_prediction(self, tmp_path, monkeypatch):
+        monkeypatch.setenv("OMLX_MOE_OFFLOAD_IO_WORKERS", "4")
+        monkeypatch.setenv("OMLX_MOE_OFFLOAD_LOOKAHEAD", "1")
+        _shutdown_io_pool()
+        try:
+            model = self._model(tmp_path, n_layers=2)
+            apply_moe_expert_offload(model, tmp_path, 0.25)
+            c1 = self._caches(model)[1]
+            c1._ensure_ids(set(range(8)))  # fill all slots
+            assert len(c1.recently_evicted) == 0
+            c1._ensure_ids(set(range(8, 12)))  # evict the four oldest
+            assert len(c1.recently_evicted) == 4
+            assert set(c1.recently_evicted) <= set(range(4))
+            # the next real ensure finds ring members resident when the
+            # prediction got there first: kick from layer 0 queues them
+            glus = self._glus(model)
+            glus[0]._kick(None)
+            assert c1.spec_pending
+            assert c1.pred_sent > 0
+        finally:
+            _shutdown_io_pool()
