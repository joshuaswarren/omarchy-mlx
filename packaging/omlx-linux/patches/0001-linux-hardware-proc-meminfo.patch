+def device_total_memory(info: dict) -> int:
+    """Total unified memory in bytes from an mx.device_info() dict.
+
+    Metal builds report "memory_size"; the omarchy (Linux/Vulkan) build
+    reports "total_memory". Same unified-RAM semantic on Apple Silicon.
+    Returns 0 when neither key carries a positive value.
+    """
+    return int(info.get("memory_size") or info.get("total_memory") or 0)
