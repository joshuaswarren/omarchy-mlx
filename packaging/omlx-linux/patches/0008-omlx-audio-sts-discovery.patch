+def _looks_like_deepfilternet_config(config: dict) -> bool:
+    """Return True for DeepFilterNet exports that omit HF ``model_type``.
+
+    mlx-community/DeepFilterNet-mlx keeps the original DeepFilterNet training
+    config (``df_order`` / ``nb_erb`` / ``nb_df`` spectral fields plus a
+    ``model_version`` string like ``DeepFilterNet3``) with no HF-style
+    ``model_type`` or ``architectures``.  The STS engine loads these by
+    family, but discovery must classify them as ``audio_sts`` or they fall
+    through to the LLM engine and fail with ``KeyError: 'model_type'``.
+    """
+    if not isinstance(config, dict):
+        return False
+    version = config.get("model_version")
+    return (
+        "df_order" in config
+        and "nb_erb" in config
+        and "nb_df" in config
+        and isinstance(version, str)
+        and version.startswith("DeepFilterNet")
+    )
+
+
+def _looks_like_sam_audio_config(config: dict) -> bool:
+    """Return True for SAM Audio exports that omit HF ``model_type``.
+
+    mlx-community/sam-audio-small keeps the original SAM Audio config with
+    component sections (``audio_codec``, ``text_encoder``, ``transformer``,
+    ...) and no HF ``model_type``/``architectures``.  Requiring
+    ``span_predictor`` alongside ``audio_codec`` keeps the heuristic away
+    from other codecs that only share a codec section.
+    """
+    if not isinstance(config, dict):
+        return False
+    return isinstance(config.get("audio_codec"), dict) and "span_predictor" in config
+
+
+def _audio_sts_name_hint(model_path: Path) -> str | None:
+    """Return the STS family implied by the model directory name, if any.
+
+    Mirrors the family rules in :func:`omlx.engine.sts._detect_sts_family` so
+    discovery and the engine agree on directory names like
+    ``DeepFilterNet-mlx`` or ``sam-audio-base``.
+    """
+    name_lower = _model_name_hint(model_path)
+    if "deepfilter" in name_lower:
+        return "deepfilternet"
+    if "mossformer" in name_lower:
+        return "mossformer2"
+    if "sam-audio" in name_lower or "sam_audio" in name_lower:
+        return "sam_audio"
+    return None
+
