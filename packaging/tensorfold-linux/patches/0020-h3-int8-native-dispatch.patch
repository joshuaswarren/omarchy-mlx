+def quantize_rows_native(x: mx.array, group: int) -> tuple[mx.array, mx.array]:
+    """(M, K) -> int8 (M, K) + float32 (M, K / group) scales, same math as the
+    MSL quantize kernel (per-group max magnitude / 127, round-to-nearest)."""
+
+    m, k = x.shape
+    groups = x.reshape(m, k // group, group).astype(mx.float32)
+    top = mx.abs(groups).max(axis=-1, keepdims=True)
+    top = mx.maximum(top, mx.array(1e-12, mx.float32))
+    scale = top / 127.0
+    q = mx.round(groups / scale).astype(mx.int8)
+    return q.reshape(m, k), scale.reshape(m, k // group)
+
