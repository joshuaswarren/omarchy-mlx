 class Attention(nn.Module):
     """Full self-attention within a tile; q and k take a weightless RMS norm in float32."""
 
+    # One unchunked SDPA dispatch binds the fp32 scores (heads x rows x rows x 4 B; a demo tile's
+    # 5083 rows need 3.1 GiB), over Vulkan's 2 GiB maxStorageBufferRange. Query blocks keep each
+    # dispatch's scores under ~0.7 GiB. Softmax is per query row and k/v are whole, so blocks are
+    # bit-identical to the single call.
+    QUERY_CHUNK = 1024
+
     def __init__(self, config: DecoderConfig):
         super().__init__()
         self.heads, self.head_dim, self.eps = config.heads, config.head_dim, config.eps
