# Vendored with pip download --no-deps (packaging/vendor-wheels.sh); their
# runtime dependencies are in requirements-lock.in, and
# check-nodeps-closure.py fails when one is missing. A dependency left out on
# purpose is declared on a "not-vendored" line.
# mlx-audio: declares upstream mlx, which would replace the mlx-omarchy wheel.
# openwakeword: its legacy tflite-runtime requirement has no cp314 wheel; the
#   ONNX inference path never imports it.
# num2words: its only dependency, docopt, is for its command line and ships
#   no wheel; the library import does not need it.
mlx-audio==0.5.6
openwakeword==0.6.0
num2words==0.5.14

# not-vendored: mlx  the mlx-omarchy wheel provides the mlx package
# not-vendored: tflite-runtime  no cp314 wheel; openwakeword's ONNX path does not import it
# not-vendored: docopt  num2words' command line only; no wheel
