{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a4-schema.json",
  "title": "A4 - M2 decode-gap reference decode result",
  "description": "One row per producer invocation under the fixed contract: ctx 512, greedy, load once, 5 rounds with a fresh prompt cache, median of per-round decode tok/s, rate = (max_tokens-1)/(t_last-t_first).",
  "type": "object",
  "required": ["schema_version", "hf_repo", "snapshot", "ctx", "max_tokens", "prompt",
               "prompt_ids_count", "prompt_ids_sha256", "greedy", "rounds",
               "median_decode_tps", "rate_formula", "argv", "started"],
  "properties": {
    "schema_version": { "const": "A4" },
    "hf_repo": { "const": "SiddhJagani/Qwen3.8-2B-mlx-4Bit" },
    "snapshot": { "const": "0867d98bfb174b042d88461c0e7c97b86b34b381" },
    "snapshot_dir": { "type": "string" },
    "ctx": { "const": 512 },
    "max_tokens": { "const": 128 },
    "prompt": { "const": "The history of France begins in antiquity. " },
    "prompt_ids_count": { "const": 512 },
    "prompt_ids_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "greedy": { "const": true },
    "rounds": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["round", "decode_tps", "n_tokens", "t_first", "t_last"],
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "decode_tps": { "type": "number" },
          "n_tokens": { "const": 128 },
          "t_first": { "type": "number" },
          "t_last": { "type": "number" }
        }
      }
    },
    "median_decode_tps": { "type": "number" },
    "rate_formula": { "const": "127/(t_last - t_first)" },
    "argv": { "type": "array", "items": { "type": "string" } },
    "started": { "type": "string" }
  }
}
