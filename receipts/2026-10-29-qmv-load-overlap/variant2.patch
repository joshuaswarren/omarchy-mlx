+// Load-overlapped form of the 4-bit multi-row column walk. The arithmetic is
+// exactly the plain loop's (same quads into dot, same block epilogue, same
+// precise accumulators); only the placement of the loads moves: the weight
+// words, scales, biases and x words of the NEXT step are issued before the
+// math of the current one, so consecutive steps overlap their memory latency
+// (the loop carries no dependency between a step's loads and the previous
+// step's math). Same technique as TensorFold unit 8a.
+#define Q4_ROWS_LOAD2(Wb, Sb, Bb, w_, wa_, wb_, xa_, xb_, sc_, bi_) { \
+  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
+    wa_[r] = Wb.values[w_base + row_base[r] * words_per_row + (w_)]; \
+    wb_[r] = Wb.values[w_base + row_base[r] * words_per_row + (w_) + 1u]; \
+    sc_[r] = LOAD_VALUE( \
+        Sb.values[s_base + row_base[r] * groups_per_row + Q4_ROWS_GROUP(w_)]); \
+    bi_[r] = LOAD_VALUE( \
+        Bb.values[b_base + row_base[r] * groups_per_row + Q4_ROWS_GROUP(w_)]); \
+  } \
+  xa_ = OUTGATE_XWORDS(x_row + (w_) * 8u); \
+  xb_ = OUTGATE_XWORDS(x_row + (w_) * 8u + 8u); \
+}
+#define Q4_ROWS_LOAD1(Wb, Sb, Bb, w_, wa_, xa_, sc_, bi_) { \
+  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
+    wa_[r] = Wb.values[w_base + row_base[r] * words_per_row + (w_)]; \
+    sc_[r] = LOAD_VALUE( \
+        Sb.values[s_base + row_base[r] * groups_per_row + Q4_ROWS_GROUP(w_)]); \
+    bi_[r] = LOAD_VALUE( \
+        Bb.values[b_base + row_base[r] * groups_per_row + Q4_ROWS_GROUP(w_)]); \
+  } \
+  xa_ = OUTGATE_XWORDS(x_row + (w_) * 8u); \
+}
+#define Q4_ROWS_FINISH_PRE(sc_, bi_) { \
+  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
+    precise float bias_term = input_sum * bi_[r]; \
+    acc[r] += fma(sc_[r], dot[r], bias_term); \
+  } \
+}
