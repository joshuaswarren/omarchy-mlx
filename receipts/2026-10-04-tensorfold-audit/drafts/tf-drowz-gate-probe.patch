diff --git a/src/tensorfold/kernels/device.py b/src/tensorfold/kernels/device.py
index 24650f1..cb1fea9 100644
--- a/src/tensorfold/kernels/device.py
+++ b/src/tensorfold/kernels/device.py
@@ -23,6 +23,40 @@ def generation() -> int:
     return int(found.group(1)) if found else 0
 
 
+@functools.cache
+def custom_kernels() -> bool:
+    """Whether this backend runs ``mx.fast.metal_kernel`` custom kernels.
+
+    macOS Metal answers directly. Other MLX builds (Omarchy's Vulkan
+    backend) route the same Python API through their own shader path while
+    ``mx.metal.is_available()`` stays false, so the gate is answered by a
+    one-time canary kernel instead of by the backend's namespace.
+    """
+
+    if mx.default_device() != mx.gpu:
+        return False
+    if mx.metal.is_available():
+        return True
+    try:
+        canary = mx.fast.metal_kernel(
+            name="tensorfold_custom_kernel_gate",
+            input_names=["a"],
+            output_names=["o"],
+            source="o[thread_position_in_grid.x] = a[thread_position_in_grid.x] + 1.0f;",
+        )
+        out = canary(
+            inputs=[mx.zeros(4, dtype=mx.float32)],
+            output_shapes=[(4,)],
+            output_dtypes=[mx.float32],
+            grid=(4, 1, 1),
+            threadgroup=(4, 1, 1),
+            stream=mx.gpu,
+        )[0]
+        mx.eval(out)
+        return bool(out[3] == 1.0)
+    except Exception:
+        return False
+
 def tensor_units() -> bool:
     """Whether this GPU has the M5 generation's tensor units."""
 
