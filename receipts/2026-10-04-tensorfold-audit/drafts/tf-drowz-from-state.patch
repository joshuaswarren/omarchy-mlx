+    @classmethod
+    def from_state(cls, w1: mx.array, s1: mx.array, w2: mx.array, s2: mx.array,
+                   b1: mx.array | None = None, b2: mx.array | None = None,
+                   fc2_group: int = FC2_GROUP) -> "Int8MLP":
+        """Wrap an already-quantized state (saved after a swap on another host) without re-quantizing.
+
+        The int8 weights and float32 scales are bit-identical to the normal swap path
+        because they were produced by the same quantize_weight code; only the host that
+        performed the swap differs.
+        """
+
+        self = cls.__new__(cls)
+        self.width = w2.shape[0]
+        self.hidden = w1.shape[1]
+        self.fc2_group = fc2_group if self.width % fc2_group == 0 else self.width
+        self.w1, self.s1, self.w2, self.s2 = w1, s1, w2, s2
+        self.b1 = None if b1 is None else b1.astype(mx.float32)
+        self.b2 = None if b2 is None else b2.astype(mx.float32)
+        return self
+
     def __call__(self, x: mx.array) -> mx.array:
