
inline bfloat16_t mlx_sigmoid(bfloat16_t x) {
    bfloat16_t e = (bfloat16_t)metal::exp(metal::abs((float)x));
    bfloat16_t den = (bfloat16_t)(1.0f + (float)e);
    bfloat16_t y = (bfloat16_t)(1.0f / (float)den);
    return ((float)x < 0.0f) ? y : (bfloat16_t)(1.0f - (float)y);
}

[[kernel]] void custom_kernel_kda_glue_post_bfloat16_t_bfloat16_t_bfloat16_t_floatc_bfloat16_t(
  const device bfloat16_t* inp [[buffer(0)]],
  const device bfloat16_t* hp [[buffer(1)]],
  const device bfloat16_t* w [[buffer(2)]],
  const constant float* cons [[buffer(3)]],
  device bfloat16_t* y [[buffer(4)]],
  uint3 thread_position_in_threadgroup [[thread_position_in_threadgroup]],
  uint3 threadgroup_position_in_grid [[threadgroup_position_in_grid]]) {

    uint h = threadgroup_position_in_grid.x;
    uint d = thread_position_in_threadgroup.x;
    uint c = h * 128u + d;
    constant float* cs = cons;           // [eps]

    float x = (float)inp[c];
    threadgroup float tgs[4];
    uint sg = d >> 5;
    float p = simd_sum(x * x);
    if ((d & 31u) == 0u) { tgs[sg] = p; }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    float m = (tgs[0] + tgs[1] + tgs[2] + tgs[3]) / 128.0f + cs[0];
    // 가중치형 rms_norm은 2회 반올림(정규화→bf16, ×w→bf16 — 실측 0-불일치)
    bfloat16_t nx0 = (bfloat16_t)(x * rsqrt(m));
    bfloat16_t nx = (bfloat16_t)((float)nx0 * (float)w[d]);
    bfloat16_t sg_ = mlx_sigmoid(hp[36864u + c]);
    y[c] = (bfloat16_t)((float)nx * (float)sg_);

}
