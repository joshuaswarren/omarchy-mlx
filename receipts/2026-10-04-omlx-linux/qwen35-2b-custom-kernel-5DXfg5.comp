#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#define __FAST_MATH__ 0
layout(local_size_x=32, local_size_y=1, local_size_z=1) in;
layout(set=0, binding=0, std430) readonly buffer _MlxBuffer0 { uint16_t data[]; } _b0;
layout(set=0, binding=1, std430) readonly buffer _MlxBuffer1 { uint16_t data[]; } _b1;
layout(set=0, binding=2, std430) readonly buffer _MlxBuffer2 { uint16_t data[]; } _b2;
layout(set=0, binding=3, std430) readonly buffer _MlxBuffer3 { uint16_t data[]; } _b3;
layout(set=0, binding=4, std430) readonly buffer _MlxBuffer4 { uint16_t data[]; } _b4;
layout(set=0, binding=5, std430) buffer _MlxBuffer5 { uint16_t data[]; } _b5;
layout(set=0, binding=6, std430) buffer _MlxBuffer6 { uint16_t data[]; } _b6;
layout(set=0, binding=7, std430) buffer _MlxBuffer7 { uint16_t data[]; } _b7;
layout(set=0, binding=8, std430) buffer _MlxBuffer8 { uint16_t data[]; } _b8;
float _mlx_bf16_to_float(uint16_t value) { return uintBitsToFloat(uint(value) << 16); }
uint16_t _mlx_float_to_bf16(float value) { uint bits = floatBitsToUint(value); uint rounded = bits + 0x7fffu + ((bits >> 16) & 1u); return uint16_t(rounded >> 16); }
float _mlx_bf16_round(float value) { return _mlx_bf16_to_float(_mlx_float_to_bf16(value)); }

void main() {
if (gl_GlobalInvocationID.x >= 32u || gl_GlobalInvocationID.y >= 1u || gl_GlobalInvocationID.z >= 48u) return;


    uint lane = gl_LocalInvocationID.x;
    uint batch_idx = gl_WorkGroupID.y / uint(1);
    uint row = gl_WorkGroupID.y % uint(1);
    uint logical_head = gl_WorkGroupID.z;
    const uint q_heads = uint(16);
    const uint k_head_base = uint(16);
    const uint v_head_base = 2 * uint(16);
    bool is_q = logical_head < q_heads;
    bool is_k = logical_head >= k_head_base && logical_head < v_head_base;
    uint head = is_q ? logical_head
               : (is_k ? logical_head - k_head_base : logical_head - v_head_base);
    uint channel_base = is_q ? head * uint(128)
                       : (is_k ? uint(16) * uint(128) + head * uint(128)
                               : 2 * uint(16) * uint(128) + head * uint(128));
    uint16_t activated[4];
    float sumsq = 0.0f;
    uint16_t l2acc = uint16_t(0);
    for (uint i = 0; i < 4; ++i) {
        uint channel = channel_base + lane * 4 + i;
        float acc = 0.0f;
        for (uint tap = 0; tap < 4; ++tap) {
            uint input_row = row + tap;
            const uint16_t xv = input_row < uint(3)
                ? _mlx_bf16_to_float(_b1.data[(batch_idx * uint(3) + input_row) * uint(6144) + channel])
                : _mlx_bf16_to_float(_b0.data[(batch_idx * uint(1) + input_row - uint(3)) * uint(6144) + channel]);
            acc += float(xv) * float(_mlx_bf16_to_float(_b2.data[channel * 4 + tap]));
        }
        const uint16_t conv = uint16_t(acc);
        uint16_t sy = uint16_t(1) / (uint16_t(1) + exp(abs(conv)));
        const uint16_t act = conv * ((conv < uint16_t(0)) ? sy : uint16_t(1) - sy);
        activated[i] = act;
        if (0) {
            const uint16_t sqv = uint16_t(float(act) * float(act));
            l2acc = uint16_t(float(l2acc) + float(sqv));
        } else {
            float value = float(act);
            sumsq += value * value;
        }
    }
    if (is_q || is_k) {
        uint out_base = ((batch_idx * uint(1) + row) * uint(16) + head) * uint(128) + lane * 4;
        if (0) {
            // Stock Qwen4 0 chain: x * rsqrt(sum(square(x), -1) + 1e-6),
            // with dk^-0.5 applied to q only.  mx.square rounds per
            // element; mx.sum accumulates each lane's four contiguous
            // bf16 values sequentially, reduces with an fp32 xor tree and
            // rounds once.  Mirror every rounding site exactly.
            float tv = float(l2acc);
            tv += subgroupShuffleXor(tv, short(16));
            tv += subgroupShuffleXor(tv, short(8));
            tv += subgroupShuffleXor(tv, short(4));
            tv += subgroupShuffleXor(tv, short(2));
            tv += subgroupShuffleXor(tv, short(1));
            const uint16_t eps = uint16_t(float(uint16_t(tv)) + float(uint16_t(1e-6f)));
            const uint16_t inv = uint16_t(rsqrt(float(eps)));
            for (uint i = 0; i < 4; ++i) {
                const uint16_t l2 = uint16_t(float(activated[i]) * float(inv));
                const uint16_t value = is_q ? uint16_t(float(l2) * float(_mlx_bf16_to_float(_b3.data[0]))) : l2;
                if (is_q) {
                    _b5.data[out_base + i] = _mlx_float_to_bf16(value);
                } else {
                    _b6.data[out_base + i] = _mlx_float_to_bf16(value);
                }
            }
        } else {
            sumsq = subgroupAdd(sumsq);
            // normalize_qk: the l2norm eps 1e-6 lands on sum(x^2), so the
            // RMS form uses 1e-6 / 128.
            float inv = rsqrt(sumsq / float(128) + 1e-6f / float(128));
            const uint16_t scale = is_q ? _mlx_bf16_to_float(_b3.data[0]) : _mlx_bf16_to_float(_b4.data[0]);
            for (uint i = 0; i < 4; ++i) {
                const uint16_t rms = uint16_t(1) * uint16_t(float(activated[i]) * inv);
                const uint16_t value = scale * rms;
                if (is_q) {
                    _b5.data[out_base + i] = _mlx_float_to_bf16(value);
                } else {
                    _b6.data[out_base + i] = _mlx_float_to_bf16(value);
                }
            }
        }
    } else {
        uint out_base = ((batch_idx * uint(1) + row) * uint(16) + head) * uint(128) + lane * 4;
        for (uint i = 0; i < 4; ++i) {
            _b7.data[out_base + i] = _mlx_float_to_bf16(activated[i]);
        }
    }
    if (1 < 3 && row == 0) {
        for (uint old_row = 0; old_row < uint(3 - 1); ++old_row) {
            uint dst = (batch_idx * uint(3) + old_row) * uint(6144)
                       + channel_base + lane * 4;
            uint src = (batch_idx * uint(3) + old_row + uint(1)) * uint(6144)
                       + channel_base + lane * 4;
            for (uint i = 0; i < 4; ++i) {
                _b8.data[dst + i] = _mlx_float_to_bf16(_mlx_bf16_to_float(_b1.data[src + i]));
            }
        }
    }
    if (row + uint(3) >= uint(1)) {
        uint state_row = row + uint(3) - uint(1);
        uint raw_base = (batch_idx * uint(1) + row) * uint(6144) + channel_base + lane * 4;
        uint state_base = (batch_idx * uint(3) + state_row) * uint(6144) + channel_base + lane * 4;
        for (uint i = 0; i < 4; ++i) {
            _b8.data[state_base + i] = _mlx_float_to_bf16(_mlx_bf16_to_float(_b0.data[raw_base + i]));
        }
    }


}
