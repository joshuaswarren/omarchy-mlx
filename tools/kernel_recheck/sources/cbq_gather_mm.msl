
    uint o = thread_position_in_grid.x;
    uint r = thread_position_in_grid.y;
    if (o >= (uint)O || r >= (uint)R) return;
    uint e = eidx[r];
    const device uint8_t*  qs = cb_qs + ((size_t)e * O + o) * (K / 8);
    const device uint16_t* qh = cb_qh + ((size_t)e * O + o) * (K / 32);
    const device DT*       dd = cb_d  + ((size_t)e * O + o) * (K / 256);
    const device InT*      xx = x + (size_t)tokidx[r] * K;
    float acc = 0.0f;
    for (uint sb = 0; sb < (uint)(K / 32); ++sb) {
        uint16_t h = qh[sb];
