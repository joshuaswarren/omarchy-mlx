
    uint i = thread_position_in_grid.x;
    float g = (float)ga[i];
    float u = (float)ub[i];
    constant float* cs = cons;                       // [b1, b2]
    float y = (cs[0] * metal::tanh(g / cs[0])) * (1.0f / (1.0f + metal::exp(-g)))
              * (cs[1] * metal::tanh(u / cs[1]));
    out[i] = (bfloat16_t)y;
