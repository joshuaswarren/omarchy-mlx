
    constexpr int TG = 256;
    uint r = threadgroup_position_in_grid.y;
    uint tid = thread_position_in_threadgroup.x;
    if (r >= (uint)R) return;
    threadgroup InT xs[K];
    const device InT* xg = x + (size_t)tokidx[r] * K;
    for (uint k = tid; k < (uint)K; k += TG) xs[k] = xg[k];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    uint e = eidx[r];
    for (uint o = tid; o < (uint)O; o += TG) {
        const device uint8_t*  qs = cb_qs + ((size_t)e * O + o) * (K / 8);
        const device uint16_t* qh = cb_qh + ((size_t)e * O + o) * (K / 32);
        const device DT*       dd = cb_d  + ((size_t)e * O + o) * (K / 256);
        float acc = 0.0f;
        for (uint sb = 0; sb < (uint)(K / 32); ++sb) {
            uint16_t h = qh[sb];
            float dl = (float)dd[sb / 8] * (float)(2 * ((h >> 12) & 7) + 1);
            float del = (h & 0x8000) ? -0.125f : 0.125f;
            float part = 0.0f;
            for (uint l = 0; l < 4; ++l) {
                uint gi = (uint)qs[sb * 4 + l] | ((uint)((h >> (3 * l)) & 7) << 8);
                int64_t gv = *((const device int64_t*)(grid + (size_t)gi * 8));
                const threadgroup InT* xv = xs + sb * 32 + l * 8;
                for (uint j = 0; j < 8; ++j) {
                    float gj = (float)(char)((gv >> (8 * j)) & 0xFF);
                    part += (gj + del) * (float)xv[j];
                }
            }
            acc += dl * part;
        }
        y[(size_t)r * O + o] = (InT)acc;
    }
