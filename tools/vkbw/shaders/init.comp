#version 450
// vkbw: fill a buffer with a deterministic pattern: word i = hash(i). The host computes the same sum on the CPU.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) writeonly buffer Dst { uint dst[]; };
layout(push_constant) uniform PC { uint words; } pc;

uint hash(uint i) {
  uint x = i * 2654435761u;
  x ^= x >> 15;
  x *= 2246822519u;
  x ^= x >> 13;
  return x;
}

void main() {
  for (uint i = gl_GlobalInvocationID.x; i < pc.words; i += gl_NumWorkGroups.x * gl_WorkGroupSize.x) dst[i] = hash(i);
}
