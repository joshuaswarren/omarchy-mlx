#version 460

// G17C (M5 Max) q4 GEMV ceiling arm for the bench --m5 table (n=320,
// k=2560, group 32): the bandwidth-optimal mapping from Main's ceiling
// table (2026-11-19). The production geometry puts eight 32-lane
// subgroups on eight rows (256 threads); G17C dispatches 10 SIMDs per
// workgroup, so this variant widens the workgroup to 320 threads and
// gives every row a 40-thread slice instead:
//   * workgroups      n/8 row-groups (grid = ceil(n/8), no k-split;
//                     every workgroup streams the full k)
//   * rows per WG     8, one 40-thread slice per row
//   * load width      uint4 = 4 packed words = exactly one affine
//                     group of 32 nibbles, plus that group's fp16
//                     scale and bias, per load
//   * per lane        ceil(groups/40) group iterations, groups strided
//                     by LANES_PER_ROW, so a row slice's first round
//                     covers 40 consecutive 16 B blocks (640 B) per row
//   * in flight       one uint4 weight load per thread
//   * reduction       40 per-lane partials per row in threadgroup
//                     memory (8 rows x 40 x 4 B = 1280 B scratch), one
//                     barrier, then a serial fold by slice lane 0 --
//                     the 40-lane slice spans subgroup boundaries, so
//                     the hardware subgroupAdd of the production kernel
//                     is not available
// The group-dot form (per-group fma(scale, dot, sum * bias)) and the
// 40-lane split change the summation order against the production
// general kernel's per-element chain, so bit-identity is not universal;
// under the bench eq fill (scale 1.0, bias 0) every product and partial
// sum is exact in fp32 and the eq lines report 0 mismatches (proven on
// the llvmpipe screening run). The nibble decode and the fp16 x-quad
// chains are the production Q4 macros verbatim.
//
// Contract: the single-weight transposed affine layout (flags bit 0
// clear, batch shape[0] == 1, matrix_n the row count) and
// matrix_k % reduce_size == 0 so a uint4 never straddles a group
// boundary; the --m5 fill_params provides exactly that.

#ifndef USE_FP16
#error "the m5 arm compiles with -DUSE_FP16=1 (fp16 activations)"
#endif
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define STORAGE_TYPE float16_t
#define LOAD_VALUE(x) float(x)
#define STORE_VALUE(f) STORAGE_TYPE(f)

#ifndef ROWS_PER_WG
#define ROWS_PER_WG 8u
#endif
#ifndef LANES_PER_ROW
#define LANES_PER_ROW 40u
#endif
const uint LOCAL_SIZE = ROWS_PER_WG * LANES_PER_ROW;

layout(local_size_x = LOCAL_SIZE) in;

// Packed views: x as 8 fp16 halves per uint4 (rows are 16-byte aligned
// by dispatch), w as 4 words per uint4 = one 32-nibble group.
layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uvec4 values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uvec4 values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  STORAGE_TYPE values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  STORAGE_TYPE values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  STORAGE_TYPE values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float row_scratch[LOCAL_SIZE];

// Exact float(n) for a nibble n in [0, 15] (see qmm_vec_base.comp):
// insert the nibble into the exponent word of 2^23 and subtract.
#define Q4_NIB(p, shift) \
  (uintBitsToFloat((((p) >> (shift)) & 0xfu) | 0x4B000000u) - 8388608.0)
// One x quad (four fp16 halves) against the low 16 bits of `packed`:
// the half chain sum joins input_sum, the fma chain joins dot.
#define Q4_QUAD(packed, a, b) { \
  f16vec2 h01 = unpackFloat2x16(a); \
  f16vec2 h23 = unpackFloat2x16(b); \
  float16_t h0 = h01.x; \
  float16_t h1 = h01.y; \
  float16_t h2 = h23.x; \
  float16_t h3 = h23.y; \
  input_sum += float(((h0 + h1) + h2) + h3); \
  float x0 = float(h0); \
  float x1 = float(h1); \
  float x2 = float(h2); \
  float x3 = float(h3); \
  uint p = (packed); \
  dot += fma(x3, Q4_NIB(p, 12u), \
      fma(x2, Q4_NIB(p, 8u), \
          fma(x1, Q4_NIB(p, 4u), \
              x0 * Q4_NIB(p, 0u)))); \
}

void main() {
  uint lane = gl_LocalInvocationID.x;
  uint row_in_wg = lane / LANES_PER_ROW;
  uint slice_lane = lane % LANES_PER_ROW;
  uint column = gl_WorkGroupID.x * ROWS_PER_WG + row_in_wg;
  bool column_active = column < params.matrix_n;
  precise float accumulator = 0.0;
  if (column_active) {
    // One uint4 of w per group; the quads of one row are back to back
    // (words_per_row = k / 8 words = k / 32 quads).
    uint w_quad_base =
        column * (params.matrix_k / 8u) / 4u;
    uint scale_base = column * (params.matrix_k / params.reduce_size);
    uint bias_base = params.aux_size + scale_base;
    uint x_quad_base = 0u;
    for (uint g = slice_lane; g < params.matrix_k / params.reduce_size;
         g += LANES_PER_ROW) {
      precise float dot = 0.0;
      precise float input_sum = 0.0;
      uvec4 quad = input_w.values[w_quad_base + g];
      uvec4 x0 = input_x.values[x_quad_base + g * 4u];
      uvec4 x1 = input_x.values[x_quad_base + g * 4u + 1u];
      uvec4 x2 = input_x.values[x_quad_base + g * 4u + 2u];
      uvec4 x3 = input_x.values[x_quad_base + g * 4u + 3u];
      Q4_QUAD(quad.x, x0.x, x0.y)
      Q4_QUAD(quad.x >> 16u, x0.z, x0.w)
      Q4_QUAD(quad.y, x1.x, x1.y)
      Q4_QUAD(quad.y >> 16u, x1.z, x1.w)
      Q4_QUAD(quad.z, x2.x, x2.y)
      Q4_QUAD(quad.z >> 16u, x2.z, x2.w)
      Q4_QUAD(quad.w, x3.x, x3.y)
      Q4_QUAD(quad.w >> 16u, x3.z, x3.w)
      float scale = LOAD_VALUE(
          scales.values[scale_base + g]);
      float bias = LOAD_VALUE(
          biases.values[bias_base + g]);
      precise float bias_term = input_sum * bias;
      accumulator += fma(scale, dot, bias_term);
    }
  }
  // 40 partials per row through threadgroup memory: one barrier, then
  // slice lane 0 folds its row's 40 entries left to right.
  row_scratch[lane] = accumulator;
  barrier();
  if (column_active && slice_lane == 0u) {
    float total = 0.0;
    uint row_base = row_in_wg * LANES_PER_ROW;
    for (uint i = 0u; i < LANES_PER_ROW; ++i) {
      total += row_scratch[row_base + i];
    }
    output_data.values[params.output_offset + column] =
        STORE_VALUE(total);
  }
}
